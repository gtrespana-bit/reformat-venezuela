</BaseLayout>

<style>
  .zones-list {
    columns: 2;
    column-gap: 2rem;
    margin: 2rem 0;
  }
  
  @media (max-width: 768px) {
    .zones-list {
      columns: 1;
    }
  }
  
  .zones-list li {
    break-inside: avoid;
    margin-bottom: 0.5rem;
    color: var(--text-color);
  }
  
  .btn-link {
    display: inline-block;
    color: var(--gold);
    text-decoration: none;
    font-weight: 600;
    margin-top: 1rem;
    transition: all 0.3s ease;
  }
  
  .btn-link:hover {
    color: var(--gold-light);
    transform: translateX(5px);
  }
  
  blockquote.testimonial {
    border-left: 4px solid var(--gold);
    padding-left: 1.5rem;
    margin: 2rem 0;
    font-style: italic;
    background: rgba(212, 175, 55, 0.05);
    padding: 1.5rem;
    border-radius: 0 8px 8px 0;
  }
  
  blockquote.testimonial cite {
    display: block;
    margin-top: 1rem;
    font-weight: 600;
    color: var(--gold);
    font-style: normal;
  }
</style>
