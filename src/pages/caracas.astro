---
import BaseLayout from '../layouts/BaseLayout.astro';
import FAQ from '../components/FAQ.astro';
import { getCollection } from 'astro:content';

const services = await getCollection('services');

const cityData = {
  name: "Caracas",
  state: "Distrito Capital",
  title: "Remodelaciones en Caracas | Expertos en Distrito Capital 2026",
  description: "Especialistas en remodelación de apartamentos, casas y oficinas en Caracas. Trabajamos en Chacao, Baruta, El Hatillo, Sucre y toda el área metropolitana. Presupuestos sin compromiso.",
  h1: "Remodelaciones en Caracas - Distrito Capital",
  heroImage: "/images/integrales-proyecto-completo.webp",
  introImage: "/images/cocina-terminada-final.webp",
  intro: `¿Buscas expertos en **remodelaciones en Caracas**? En ReformaT Venezuela transformamos tu apartamento, casa u oficina en la capital con la más alta calidad y profesionalismo.

Con más de 15 años de experiencia en el **Distrito Capital**, conocemos las particularidades de los edificios caraqueños, las normativas de condominios y los mejores materiales para el clima de la ciudad.`,
  zones: [
    "Chacao (Altamira, Los Palos Grandes, Chuao)",
    "Baruta (El Cafetal, Las Mercedes, La Trinidad)",
    "El Hatillo (El Retorno, Barlovento)",
    "Sucre (Petare, Bello Monte, Los Caobos)",
    "Libertador (El Centro, La Candelaria, San Bernardino)",
    "El Ávila, Montalbán, El Paraíso, Los Chaguaramos"
  ],
  prices: {
    cocina: "Desde $1.800 USD",
    bano: "Desde $950 USD",
    integral: "Desde $150 USD/m²"
  },
  testimonials: [
    {
      name: "María Fernanda Torres",
      location: "Altamira, Chacao",
      text: "Excelente trabajo en mi apartamento de Altamira. Cumplieron con los tiempos y el acabado fue impecable. Totalmente recomendados."
    },
    {
      name: "Carlos Andrés Pérez",
      location: "Las Mercedes, Baruta",
      text: "Remodelaron mi oficina en Las Mercedes de manera profesional. El equipo fue muy respetuoso y limpio durante toda la obra."
    }
  ]
};
---

<BaseLayout
  title={cityData.title}
  description={cityData.description}
  image="/images/integrales-proyecto-completo.webp"
  canonical={`https://reformat-venezuela.online/caracas`}
  schemaType="LocalBusiness"
>
  <main class="city-page">
    <!-- Hero Section -->
    <header class="article-hero">
      <div class="hero-bg" style="background-image: url({cityData.heroImage})"></div>
      <div class="hero-overlay"></div>
      <div class="hero-content">
        <span class="article-category">Servicio Local</span>
        <h1 class="article-title"><span class="line">{cityData.h1}</span></h1>
        <p class="article-excerpt">Especialistas en remodelación de apartamentos, casas y oficinas en todo el Distrito Capital</p>
        <a href="/contacto" class="btn-premium btn-primary-premium">
          Solicitar Presupuesto Gratis
          <svg class="btn-arrow" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          <span class="btn-shine"></span>
        </a>
      </div>
    </header>

    <!-- Intro Section -->
    <section class="intro-section">
      <div class="container">
        <div class="content-grid">
          <div class="text-content">
            <h2>Expertos en Remodelaciones en Caracas</h2>
            <p set:html={cityData.intro}></p>
            
            <div class="trust-badges">
              <div class="badge">
                <span class="icon">✓</span>
                <span>Más de 15 años en Caracas</span>
              </div>
              <div class="badge">
                <span class="icon">✓</span>
                <span>Conocemos normativas de condominios</span>
              </div>
              <div class="badge">
                <span class="icon">✓</span>
                <span>Garantía por escrito</span>
              </div>
            </div>
          </div>
          <div class="image-content">
            <img 
              src={cityData.introImage} 
              alt="Remodelación de cocina en Caracas"
              loading="lazy"
              width="500"
              height="350"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Services Section -->
    <section class="services-section">
      <div class="container">
        <h2>Nuestros Servicios de Remodelación en Caracas</h2>
        <p class="section-subtitle">Soluciones integrales para apartamentos, casas y oficinas en el Distrito Capital</p>
        
        <div class="services-grid">
          {services.slice(0, 6).map((service) => (
            <div class="service-card bg-white rounded-xl shadow-lg overflow-hidden hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1">
              <div class="p-6">
                <h3 class="text-xl font-bold mb-3 text-gray-900">{service.data.title}</h3>
                <p class="text-gray-600 mb-4 leading-relaxed">{service.data.description}</p>
                <a href={`/servicios/${service.slug}`} class="inline-flex items-center text-primary font-semibold hover:text-primary/80 transition-colors">
                  Saber más
                  <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                  </svg>
                </a>
              </div>
            </div>
          ))}
        </div>
        
        <div class="cta-center">
          <a href="/servicios" class="btn btn-secondary">Ver Todos los Servicios</a>
        </div>
      </div>
    </section>

    <!-- Zones Section -->
    <section class="zones-section">
      <div class="container">
        <h2>Zonas que Atendemos en Caracas</h2>
        <p class="section-subtitle">Llegamos a todos los municipios del Distrito Capital y área metropolitana</p>
        
        <div class="zones-grid">
          {cityData.zones.map((zone) => (
            <div class="zone-card">
              <span class="icon">📍</span>
              <span>{zone}</span>
            </div>
          ))}
        </div>
        
        <div class="info-box">
          <h3>¿Trabajas en otros municipios de Caracas?</h3>
          <p>Sí, atendemos todas las parroquias del Distrito Capital y municipios adyacentes como Petare, Catia, El Valle, Antímano, Caricuao, etc. ¡Consúltanos!</p>
        </div>
      </div>
    </section>

    <!-- Pricing Section -->
    <section class="pricing-section">
      <div class="container">
        <h2>Precios de Remodelación en Caracas 2026</h2>
        <p class="section-subtitle">Precios referenciales en dólares americanos (USD)</p>
        
        <div class="pricing-grid">
          <div class="price-card">
            <h3>Remodelación de Cocina</h3>
            <div class="price">{cityData.prices.cocina}</div>
            <ul>
              <li>Diseño 3D incluido</li>
              <li>Gabinetes a medida</li>
              <li>Instalación de granito o cuarzo</li>
              <li>Plomería y electricidad básica</li>
            </ul>
          </div>
          
          <div class="price-card featured">
            <div class="badge-popular">Más Popular</div>
            <h3>Remodelación de Baño</h3>
            <div class="price">{cityData.prices.bano}</div>
            <ul>
              <li>Demolición incluida</li>
              <li>Porcelanato antideslizante</li>
              <li>Sanitarios modernos</li>
              <li>Duchas de vidrio templado</li>
            </ul>
          </div>
          
          <div class="price-card">
            <h3>Remodelación Integral</h3>
            <div class="price">{cityData.prices.integral}</div>
            <ul>
              <li>Proyectos desde 30m²</li>
              <li>Llave en mano</li>
              <li>Supervisión constante</li>
              <li>Entrega en tiempo récord</li>
            </ul>
          </div>
        </div>
        
        <div class="pricing-note">
          <p><strong>Nota:</strong> Precios sujetos a evaluación previa. Aceptamos pagos en efectivo (USD), transferencia bancaria, Zelle y Pago Móvil al cambio del BCV.</p>
        </div>
      </div>
    </section>

    <!-- Testimonials Section -->
    <section class="testimonials-section">
      <div class="container">
        <h2>Lo Que Dicen Nuestros Clientes en Caracas</h2>
        
        <div class="testimonials-grid">
          {cityData.testimonials.map((testimonial) => (
            <div class="testimonial-card">
              <div class="stars">★★★★★</div>
              <p class="text">"{testimonial.text}"</p>
              <div class="author">
                <strong>{testimonial.name}</strong>
                <span>{testimonial.location}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="faq-section">
      <div class="container">
        <h2>Preguntas Frecuentes sobre Remodelaciones en Caracas</h2>
        
        <FAQ items={[
          { 
            question: "¿Cuánto tiempo tarda una remodelación en Caracas?", 
            answer: "Depende del tipo de proyecto. Una cocina o baño toma entre 2-4 semanas. Una remodelación integral de apartamento puede tomar 6-12 semanas. Siempre entregamos cronograma detallado." 
          },
          { 
            question: "¿Trabajan con permisos de condominios en Caracas?", 
            answer: "Sí, gestionamos todos los permisos requeridos por tu condominio. Conocemos las normativas de los principales edificios de Chacao, Baruta y otras zonas de Caracas." 
          },
          { 
            question: "¿Qué formas de pago aceptan en Venezuela?", 
            answer: "Aceptamos pagos en efectivo (USD), transferencia bancaria en bolívares al cambio BCV, Zelle, PayPal y Pago Móvil. Ofrecemos facilidades de pago según el proyecto." 
          },
          { 
            question: "¿Dan garantía por el trabajo realizado?", 
            answer: "Sí, todos nuestros trabajos cuentan con garantía por escrito de 12 meses en acabados y 24 meses en instalaciones eléctricas e hidrosanitarias." 
          },
          { 
            question: "¿El presupuesto es gratuito?", 
            answer: "Sí, realizamos visitas técnicas sin costo en todo Caracas y ofrecemos presupuestos detallados sin compromiso de contratación." 
          }
        ]} />
      </div>
    </section>

    <!-- CTA Final -->
    <section class="cta-final">
      <div class="container">
        <h2>¿Listo para Transformar tu Espacio en Caracas?</h2>
        <p>Solicita tu presupuesto gratuito hoy mismo y recibe asesoría personalizada</p>
        <div class="cta-buttons">
          <a href="/contacto" class="btn-premium btn-primary-premium">
            Solicitar Presupuesto Gratis
            <svg class="btn-arrow" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            <span class="btn-shine"></span>
          </a>
          <a href="https://wa.me/584123456789" class="btn-premium btn-whatsapp-premium">
            <svg class="btn-icon" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
            Contactar por WhatsApp
          </a>
        </div>
      </div>
    </section>
  </main>

  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "HomeAndConstructionBusiness",
      "name": "ReformaT Venezuela - Caracas",
      "description": "Especialistas en remodelaciones en Caracas y Distrito Capital. Cocinas, baños, reformas integrales y más.",
      "url": "https://reformat-venezuela.online/caracas",
      "telephone": "+58-412-345-6789",
      "areaServed": {
        "@type": "City",
        "name": "Caracas",
        "containedInPlace": {
          "@type": "AdministrativeArea",
          "name": "Distrito Capital"
        }
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": "10.4806",
        "longitude": "-66.9036"
      },
      "openingHoursSpecification": {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
        "opens": "08:00",
        "closes": "17:00"
      },
      "priceRange": "$$"
    }
  </script>
</BaseLayout>

<style>
  .city-page {
    padding-top: 0;
<style>
  /* City Page Base */
  .city-page {
    padding-top: 0;
  }
  
  /* Intro Section */
  .intro-section,
  .services-section,
  .zones-section,
  .pricing-section,
  .testimonials-section,
  .faq-section {
    padding: 80px 0;
  }
  
  .intro-section {
    background: var(--white);
  }
  
  .content-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
  }
  
  .text-content h2 {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 4vw, 2.8rem);
    color: var(--text);
    margin-bottom: 25px;
    line-height: 1.2;
  }
  
  .text-content p {
    font-size: 1.1rem;
    line-height: 1.8;
    color: var(--text-light);
    margin-bottom: 20px;
  }
  
  .image-content img {
    width: 100%;
    height: auto;
    border-radius: 12px;
    box-shadow: 0 20px 50px rgba(0,0,0,0.12);
    transition: transform 0.4s ease;
  }
  
  .image-content img:hover {
    transform: scale(1.02);
  }
  
  /* Trust Badges */
  .trust-badges {
    display: flex;
    gap: 20px;
    margin-top: 35px;
    flex-wrap: wrap;
  }
  
  .badge {
    display: flex;
    align-items: center;
    gap: 12px;
    background: linear-gradient(135deg, #faf8f5 0%, #fff 100%);
    padding: 14px 22px;
    border-radius: 8px;
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--text);
    border: 1px solid rgba(201, 169, 97, 0.2);
    transition: all 0.3s ease;
  }
  
  .badge:hover {
    transform: translateY(-2px);
    box-shadow: 0 5px 15px rgba(201, 169, 97, 0.15);
  }
  
  .badge .icon {
    color: var(--gold);
    font-size: 1.3rem;
    font-weight: bold;
  }
  
  /* Services Section */
  .services-section {
    background: var(--gray);
  }
  
  .services-section h2,
  .zones-section h2,
  .pricing-section h2,
  .testimonials-section h2,
  .faq-section h2 {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 4vw, 2.8rem);
    text-align: center;
    margin-bottom: 15px;
    color: var(--text);
  }
  
  .section-subtitle {
    text-align: center;
    color: var(--text-light);
    font-size: 1.1rem;
    max-width: 600px;
    margin: 0 auto 50px;
  }
  
  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 30px;
    margin-bottom: 40px;
  }
  
  .service-card {
    background: var(--white);
    padding: 35px 30px;
    border-radius: 12px;
    box-shadow: 0 5px 20px rgba(0,0,0,0.06);
    transition: all 0.3s ease;
    border: 1px solid transparent;
  }
  
  .service-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 15px 40px rgba(0,0,0,0.12);
    border-color: rgba(201, 169, 97, 0.3);
  }
  
  .service-card h3 {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    color: var(--text);
    margin-bottom: 15px;
  }
  
  .service-card p {
    color: var(--text-light);
    line-height: 1.7;
    margin-bottom: 20px;
  }
  
  .service-card a {
    color: var(--gold);
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: gap 0.3s ease;
  }
  
  .service-card a:hover {
    gap: 12px;
  }
  
  .cta-center {
    text-align: center;
    margin-top: 40px;
  }
  
  .btn-secondary {
    background: transparent;
    color: var(--gold);
    border: 2px solid var(--gold);
    padding: 16px 40px;
    font-weight: 600;
    font-size: 0.95rem;
    border-radius: 4px;
    transition: all 0.3s ease;
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }
  
  .btn-secondary:hover {
    background: var(--gold);
    color: var(--bg);
    transform: translateY(-2px);
  }
  
  /* Zones Section */
  .zones-section {
    background: var(--white);
  }
  
  .zones-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 18px;
    margin-top: 40px;
  }
  
  .zone-card {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 18px 24px;
    background: linear-gradient(135deg, #faf8f5 0%, #fff 100%);
    border-radius: 8px;
    transition: all 0.3s ease;
    border: 1px solid rgba(201, 169, 97, 0.15);
  }
  
  .zone-card:hover {
    transform: translateX(8px);
    background: var(--white);
    box-shadow: 0 5px 20px rgba(201, 169, 97, 0.15);
    border-color: var(--gold);
  }
  
  .zone-card .icon {
    font-size: 1.4rem;
  }
  
  /* Info Box - Fixed with brand colors */
  .info-box {
    background: linear-gradient(135deg, var(--dark-blue) 0%, var(--navy) 100%);
    color: white;
    padding: 40px;
    border-radius: 12px;
    margin-top: 50px;
    text-align: center;
    box-shadow: 0 15px 40px rgba(26, 54, 93, 0.25);
  }
  
  .info-box h3 {
    font-family: var(--font-serif);
    font-size: clamp(1.4rem, 3vw, 1.8rem);
    margin-bottom: 18px;
    color: var(--gold);
  }
  
  .info-box p {
    font-size: 1.05rem;
    line-height: 1.7;
    opacity: 0.95;
    max-width: 700px;
    margin: 0 auto;
  }
  
  /* Pricing Section */
  .pricing-section {
    background: var(--gray);
  }
  
  .pricing-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 30px;
    margin-top: 40px;
  }
  
  @media (min-width: 768px) {
    .pricing-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  
  .price-card {
    background: var(--white);
    padding: 40px 30px;
    border-radius: 12px;
    box-shadow: 0 5px 20px rgba(0,0,0,0.08);
    position: relative;
    border: 2px solid transparent;
    transition: all 0.3s ease;
  }
  
  .price-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 15px 40px rgba(0,0,0,0.15);
  }
  
  .price-card.featured {
    border-color: var(--gold);
    transform: scale(1.05);
    box-shadow: 0 10px 35px rgba(201, 169, 97, 0.2);
  }
  
  .price-card.featured:hover {
    transform: scale(1.05) translateY(-8px);
  }
  
  .badge-popular {
    position: absolute;
    top: -14px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--gold);
    color: var(--bg);
    padding: 6px 20px;
    border-radius: 20px;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
  }
  
  .price-card h3 {
    font-family: var(--font-serif);
    font-size: 1.4rem;
    color: var(--text);
    margin-bottom: 15px;
    text-align: center;
  }
  
  .price-card .price {
    font-size: 2rem;
    font-weight: 700;
    color: var(--gold);
    text-align: center;
    margin-bottom: 25px;
    font-family: var(--font-serif);
  }
  
  .price-card ul {
    list-style: none;
    padding: 0;
  }
  
  .price-card li {
    padding: 12px 0;
    padding-left: 30px;
    position: relative;
    color: var(--text-light);
    border-bottom: 1px solid #f0f0f0;
  }
  
  .price-card li:last-child {
    border-bottom: none;
  }
  
  .price-card li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--gold);
    font-weight: bold;
    font-size: 1.1rem;
  }
  
  .pricing-note {
    background: var(--white);
    padding: 25px 30px;
    border-radius: 8px;
    margin-top: 40px;
    text-align: center;
    border-left: 4px solid var(--gold);
  }
  
  .pricing-note p {
    color: var(--text-light);
    font-size: 0.95rem;
    line-height: 1.6;
  }
  
  /* Testimonials Section */
  .testimonials-section {
    background: var(--white);
  }
  
  .testimonials-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 30px;
    margin-top: 40px;
  }
  
  .testimonial-card {
    background: linear-gradient(135deg, #faf8f5 0%, #fff 100%);
    padding: 35px;
    border-radius: 12px;
    box-shadow: 0 5px 20px rgba(0,0,0,0.06);
    border: 1px solid rgba(201, 169, 97, 0.15);
    transition: all 0.3s ease;
  }
  
