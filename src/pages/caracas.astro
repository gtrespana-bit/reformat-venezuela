---
import BaseLayout from '../layouts/BaseLayout.astro';
import GodHero from '../components/GodHero.astro';
import GodMarquee from '../components/GodMarquee.astro';
import FAQ from '../components/FAQ.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import GuaranteeMatrix from '../components/GuaranteeMatrix.astro';

const services = [
  { slug: 'remodelacion-cocina', data: { title: 'Remodelación de Cocinas', description: 'Cocinas funcionales y modernas con materiales premium y acabados impecables.' } },
  { slug: 'remodelacion-bano', data: { title: 'Remodelación de Baños', description: 'Baños renovados con diseño premium, griferías y acabados de alta gama.' } },
  { slug: 'remodelacion-integral', data: { title: 'Remodelación Integral', description: 'Transformación completa de apartamentos, casas y oficinas llave en mano.' } },
  { slug: 'instalacion-pisos', data: { title: 'Instalación de Pisos', description: 'Porcelanato, cerámica, laminado y madera con instalación certificada.' } },
  { slug: 'pintura-acabados', data: { title: 'Pintura y Acabados', description: 'Pintura profesional interior y exterior, microcemento y texturas.' } },
  { slug: 'fontaneria-plomeria', data: { title: 'Fontanería y Plomería', description: 'Instalaciones, fugas, tuberías y mantenimiento preventivo certificado.' } },
];

const cityData = {
  name: "Caracas",
  state: "Distrito Capital",
  title: "Remodelaciones en Caracas | RemodelaT Venezuela",
  description: "Especialistas en remodelación de apartamentos y casas en Caracas: Chacao, Baruta, El Hatillo y área metropolitana. Presupuesto sin compromiso.",
  heroImage: "/images/cocina-isla-central.webp",
  introImage: "/images/cocina-terminada-final.webp",
  zones: [
    "Chacao (Altamira, Los Palos Grandes, Chuao)",
    "Baruta (Las Mercedes, El Cafetal, Santa Fe)",
    "El Hatillo (La Lagunita, Los Naranjos)",
    "Sucre (Los Dos Caminos, La Carlota)",
    "Libertador (Centro, San Bernardino)",
    "Guarenas, Guatire, Los Teques"
  ],
  testimonials: [
    { name: "María González", location: "Chacao, Caracas", text: "Remodelaron mi cocina en Altamira y quedó espectacular. El equipo fue muy profesional y cumplieron con los plazos.", rating: 5 },
    { name: "Carlos Rodríguez", location: "Las Mercedes, Caracas", text: "Excelente trabajo en la remodelación de mi oficina en Las Mercedes. Atención al detalle impecable y precios justos.", rating: 5 },
    { name: "Ana Martínez", location: "El Hatillo, Caracas", text: "Transformaron completamente mi apartamento en El Hatillo. El diseño superó mis expectativas.", rating: 5 }
  ]
};

const faqItems = [
  { question: `¿Cuánto cuesta una remodelación en Caracas?`, answer: `Los precios varían según el alcance: una remodelación de cocina desde $2,500, baño desde $1,800, y remodelaciones integrales desde $15,000. Ofrecemos valoración técnica inicial sin compromiso.` },
  { question: `¿Trabajan en edificios con normativas de condominio?`, answer: `Sí, tenemos amplia experiencia trabajando en edificios residenciales y comerciales de Caracas. Conocemos las normativas de los principales condominios en Chacao, Baruta, El Hatillo y Sucre.` },
  { question: `¿Cuánto tiempo toma una remodelación en Caracas?`, answer: `Depende del proyecto: una cocina toma 3-4 semanas, un baño 2-3 semanas, y una remodelación integral 2-3 meses. Siempre establecemos un cronograma claro.` },
  { question: `¿Ofrecen garantía en los trabajos?`, answer: `Sí, todos nuestros trabajos incluyen garantía por escrito por partidas: impermeabilización, instalaciones, pisos y acabados. Se documenta en contrato.` },
  { question: `¿Atienden zonas fuera de Caracas?`, answer: `Sí, además del Distrito Capital atendemos Guarenas, Guatire, Los Teques y zonas cercanas. Contáctanos para verificar disponibilidad.` }
];
---

<BaseLayout title={cityData.title} description={cityData.description}>

  <GodHero
    eyebrow="Distrito Capital · 23+ años"
    title="Remodelaciones en"
    titleGold="Caracas"
    lead="Transformamos apartamentos, casas y oficinas con diseño de autor, materiales premium y ejecución impecable en toda el área metropolitana."
    image={cityData.heroImage}
    imageAlt="Remodelaciones y reformas de apartamentos y casas en Caracas"
    badges={["Equipo propio", "Presupuesto por partidas", "Garantía escrita"]}
    watermark="CARACAS"
  />

  <GodMarquee />

  <Breadcrumb items={[ { name: 'Inicio', url: '/' }, { name: 'Caracas', url: '/caracas' } ]} />

  <section class="section intro-god" data-reveal>
    <div class="container intro-grid">
      <div class="intro-media">
        <img src={cityData.introImage} alt={`Proyecto de remodelación en ${cityData.name}`} loading="lazy" />
      </div>
      <div class="intro-body">
        <span class="eyebrow-god on-light">Por qué RemodelaT</span>
        <h2>Expertos en remodelaciones<br/>en el Distrito Capital</h2>
        <p>Con más de 23 años de experiencia, conocemos las particularidades de los edificios caraqueños, las normativas de condominios y los mejores materiales para el clima de la ciudad.</p>
        <p>Transformamos tu apartamento, casa u oficina con método técnico, materiales adecuados y acabados de lujo.</p>
        <ul class="intro-checks">
          <li>Equipo propio certificado, sin subcontratas</li>
          <li>Presupuesto cerrado y cronograma garantizado</li>
          <li>Gestión de permisos de condominio</li>
          <li>Garantía por escrito en todos los trabajos</li>
        </ul>
        <a href="#contacto" class="btn-premium btn-primary-premium"><span class="btn-content">Conocer más sobre nosotros</span><span class="btn-arrow">→</span></a>
      </div>
    </div>
  </section>

  <div class="premium-divider"><i></i></div>

  <section class="section section-alt">
    <div class="container">
      <div class="section-header" data-reveal>
        <span class="eyebrow-god on-light">Servicios</span>
        <h2>Soluciones integrales de remodelación</h2>
        <p>Desde una renovación puntual hasta un proyecto llave en mano, cubrimos cada etapa con estándares premium.</p>
      </div>
      <div class="services-grid-god">
        {services.slice(0, 6).map((service) => (
          <article class="service-card-god" data-reveal>
            <div class="service-icon-god">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
            </div>
            <h3>{service.data.title}</h3>
            <p>{service.data.description}</p>
            <a href={`/servicios/${service.slug}`} class="card-link-god">Ver detalles <span>→</span></a>
          </article>
        ))}
      </div>
      <div class="cta-center" data-reveal><a href="/servicios" class="btn-premium btn-primary-premium"><span class="btn-content">Ver todos los servicios</span><span class="btn-arrow">→</span></a></div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header" data-reveal>
        <span class="eyebrow-god on-light">Cobertura</span>
        <h2>Atendemos toda el área metropolitana</h2>
        <p>Nuestro equipo se desplaza a los principales municipios y urbanizaciones de Caracas.</p>
      </div>
      <div class="zones-grid-god">
        {cityData.zones.map((zone) => (
          <div class="zone-item-god">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            <span>{zone}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="section-header" data-reveal>
        <span class="eyebrow-god on-light">Cómo trabajamos</span>
        <h2>Método para edificios caraqueños</h2>
        <p>Trabajar en Caracas exige conocer sus edificios, normativas de condominio y logística urbana.</p>
      </div>
      <div class="process-grid-god">
        <div class="process-item-god"><strong>01</strong><h4>Valoración técnica</h4><p>Evaluamos el espacio, tomamos medidas y escuchamos tu visión.</p></div>
        <div class="process-item-god"><strong>02</strong><h4>Presupuesto por partidas</h4><p>Recibes detalle en USD con materiales, mano de obra y cronograma.</p></div>
        <div class="process-item-god"><strong>03</strong><h4>Diseño y permisos</h4><p>Definimos materiales y gestionamos condominio.</p></div>
        <div class="process-item-god"><strong>04</strong><h4>Ejecución supervisada</h4><p>Equipo propio con supervisión diaria y reportes.</p></div>
        <div class="process-item-god"><strong>05</strong><h4>Entrega y garantía</h4><p>Limpio, funcionando, con garantía escrita por partidas.</p></div>
      </div>
    </div>
  </section>

  <GuaranteeMatrix compact eyebrow="Garantía documentada" title="Garantía por partidas, no promesas genéricas" />

  <section class="section">
    <div class="container">
      <div class="section-header" data-reveal>
        <span class="eyebrow-god on-light">Testimonios</span>
        <h2>Lo que dicen nuestros clientes en Caracas</h2>
      </div>
      <div class="testimonials-grid-god">
        {cityData.testimonials.map((t) => (
          <figure class="testimonial-card-god" data-reveal>
            <div class="stars-god">{"★★★★★"}</div>
            <blockquote>“{t.text}”</blockquote>
            <figcaption><strong>{t.name}</strong><span>{t.location}</span></figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container container-narrow">
      <div class="section-header" data-reveal>
        <span class="eyebrow-god on-light">FAQ</span>
        <h2>Preguntas frecuentes en Caracas</h2>
      </div>
      <FAQ items={faqItems} />
    </div>
  </section>

  <section class="god-cta" id="contacto">
    <div class="cta-wrapper">
      <span class="eyebrow-god">Da el primer paso</span>
      <h2 class="cta-title">¿Listo para transformar tu espacio en Caracas?</h2>
      <p class="cta-text">Agenda una valoración técnica inicial. Evaluamos tu proyecto y te entregamos un presupuesto detallado sin compromiso.</p>
      <div class="cta-actions-home">
        <a href="https://wa.me/584227997043?text=Hola,%20quiero%20un%20presupuesto%20para%20mi%20remodelación%20en%20Caracas" class="btn-premium btn-primary-premium" target="_blank" rel="noopener">
          <span class="btn-content">WhatsApp directo</span><span class="btn-arrow">→</span>
        </a>
        <a href="/contacto" class="btn-premium btn-outline-premium"><span class="btn-content">Formulario de contacto</span><span class="btn-arrow">→</span></a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .container { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
  .container-narrow { max-width: 860px; margin: 0 auto; padding: 0 24px; }
  .section { padding: clamp(72px, 10vw, 112px) 0; }
  .section-alt { background: var(--bone); }
  .section-header { text-align: center; max-width: 680px; margin: 0 auto clamp(36px, 6vw, 64px); }
  .section-header h2 { font-family: var(--font-serif); font-size: clamp(1.9rem, 4vw, 2.7rem); font-weight: 500; letter-spacing: -0.02em; color: var(--ink); line-height: 1.12; margin: 12px 0 14px; }
  .section-header p { color: var(--text-muted); font-size: 1.05rem; line-height: 1.7; }

  .intro-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(40px, 6vw, 84px); align-items: center; }
  .intro-media img { width: 100%; border-radius: var(--r-md); box-shadow: var(--e-3); border: var(--hairline); }
  .intro-body h2 { font-family: var(--font-serif); font-size: clamp(1.9rem, 3.5vw, 2.6rem); line-height: 1.12; letter-spacing: -0.02em; margin: 12px 0 18px; color: var(--ink); }
  .intro-body p { color: var(--text-muted); line-height: 1.78; margin-bottom: 14px; }
  .intro-checks { list-style: none; padding: 0; margin: 22px 0 28px; display: grid; gap: 10px; }
  .intro-checks li { position: relative; padding-left: 28px; font-size: 0.95rem; color: var(--ink); line-height: 1.5; }
  .intro-checks li::before { content: ""; position: absolute; left: 0; top: 0.6em; width: 8px; height: 8px; border-radius: 50%; background: var(--gold-ink); box-shadow: 0 0 0 5px rgba(201,169,97,0.12); }

  .services-grid-god { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; }
  .service-card-god { background: var(--white); border: var(--hairline); border-radius: var(--r-md); padding: 32px 28px; transition: transform var(--dur-base) var(--ease-out), box-shadow var(--dur-base) var(--ease-out), border-color var(--dur-base) var(--ease-out); }
  .service-card-god:hover { transform: translateY(-6px); box-shadow: var(--e-3); border-color: rgba(201,169,97,0.38); }
  .service-icon-god { width: 48px; height: 48px; border-radius: var(--r-sm); background: var(--gold-soft); color: var(--gold-ink); display: flex; align-items: center; justify-content: center; margin-bottom: 18px; }
  .service-card-god h3 { font-family: var(--font-serif); font-size: 1.28rem; font-weight: 600; margin-bottom: 8px; color: var(--ink); }
  .service-card-god p { color: var(--text-muted); font-size: 0.93rem; line-height: 1.66; margin-bottom: 16px; }
  .card-link-god { color: var(--gold-ink); font-weight: 700; font-size: 0.84rem; display: inline-flex; gap: 8px; transition: gap 0.25s; }
  .service-card-god:hover .card-link-god { gap: 12px; }

  .zones-grid-god { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
  .zone-item-god { display: flex; align-items: center; gap: 12px; padding: 16px 18px; background: var(--white); border: var(--hairline-ink); border-radius: var(--r-md); transition: all 0.28s var(--ease-out); font-size: 0.92rem; }
  .zone-item-god:hover { border-color: rgba(201,169,97,0.38); transform: translateY(-2px); box-shadow: var(--e-1); }
  .zone-item-god svg { color: var(--gold-ink); flex-shrink: 0; }

  .process-grid-god { display: grid; grid-template-columns: repeat(5, 1fr); gap: 16px; }
  .process-item-god { background: var(--white); border: var(--hairline-ink); border-radius: var(--r-md); padding: 24px 20px; }
  .process-item-god strong { font-family: var(--font-serif); font-size: 1.8rem; color: rgba(201,169,97,0.55); line-height: 1; display: block; margin-bottom: 12px; }
  .process-item-god h4 { font-family: var(--font-serif); font-size: 1.1rem; margin-bottom: 8px; color: var(--ink); }
  .process-item-god p { font-size: 0.88rem; color: var(--text-muted); line-height: 1.6; }

  .testimonials-grid-god { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; }
  .testimonial-card-god { background: var(--white); border: var(--hairline-ink); border-radius: var(--r-md); padding: 32px 26px; box-shadow: var(--e-1); margin: 0; }
  .stars-god { color: var(--gold-ink); letter-spacing: 3px; font-size: 0.95rem; margin-bottom: 14px; }
  .testimonial-card-god blockquote { font-style: italic; color: var(--ink); line-height: 1.7; margin: 0 0 18px; font-size: 0.98rem; }
  .testimonial-card-god figcaption strong { display: block; font-size: 0.92rem; color: var(--ink); }
  .testimonial-card-god figcaption span { font-size: 0.82rem; color: var(--text-muted); }

  .cta-center { text-align: center; margin-top: 36px; }
  .cta-actions-home { display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; margin-top: 28px; }

  @media (max-width: 1024px) {
    .services-grid-god, .zones-grid-god, .process-grid-god, .testimonials-grid-god { grid-template-columns: repeat(2, 1fr); }
    .intro-grid { grid-template-columns: 1fr; gap: 40px; }
  }
  @media (max-width: 640px) {
    .services-grid-god, .zones-grid-god, .process-grid-god, .testimonials-grid-god { grid-template-columns: 1fr; }
  }
</style>

<script>
  (() => {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const targets = document.querySelectorAll('[data-reveal]');
    if (reduce || !('IntersectionObserver' in window)) { targets.forEach(el => el.classList.add('is-revealed')); return; }
    const io = new IntersectionObserver((entries) => {
      entries.forEach((entry) => { if (!entry.isIntersecting) return; entry.target.classList.add('is-revealed','god-reveal'); io.unobserve(entry.target); });
    }, { rootMargin: '0px 0px -10% 0px', threshold: 0.12 });
    targets.forEach(el => { el.classList.add('god-reveal'); io.observe(el); });
  })();
</script>
