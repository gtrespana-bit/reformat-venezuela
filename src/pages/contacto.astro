---
import BaseLayout from '../layouts/BaseLayout.astro';
import GuaranteeMatrix from '../components/GuaranteeMatrix.astro';
---

<BaseLayout 
  title="Valoración Técnica | Remodelaciones de Lujo en Venezuela" 
  description="Solicita una valoración técnica para remodelaciones residenciales de alto estándar en Valencia, San Diego, Carabobo y Caracas. Método técnico, acabados de lujo y garantía por escrito." 
  activePage="contacto"
>
  <header class="page-hero">
    <img class="hero-bg" src="/images/integrales-800.webp" alt="Proyecto de remodelación residencial en Venezuela | ReformaT" fetchpriority="high" loading="eager" decoding="async" />
    <div class="hero-overlay"></div>
    <div class="hero-content">
      <span class="hero-tag">Valoración técnica</span>
      <h1 class="page-title">Cuéntanos tu <span class="gold">proyecto</span></h1>
      <p class="page-subtitle">Atendemos remodelaciones residenciales de alto estándar en Carabobo y Caracas. Revisamos alcance, ubicación y nivel de acabado antes de proponer una solución.</p>
    </div>
  </header>

  <section class="contact-prelude">
    <div class="container prelude-grid">
      <article>
        <span>01</span>
        <h2>Filtro técnico</h2>
        <p>Revisamos ubicación, alcance, tipo de vivienda y nivel de acabado antes de avanzar.</p>
      </article>
      <article>
        <span>02</span>
        <h2>Valoración ordenada</h2>
        <p>Pedimos datos útiles para preparar una propuesta seria, no una cifra improvisada.</p>
      </article>
      <article>
        <span>03</span>
        <h2>Garantía documentada</h2>
        <p>Cuando el proyecto avanza, cada partida queda respaldada por condiciones claras.</p>
      </article>
    </div>
  </section>

  <section class="section contact-premium-section">
    <div class="container contact-full-grid">
      <div class="contact-info-panel">
        <span class="panel-kicker">Acceso privado a valoración</span>
        <h2 class="section-title">Antes de presupuestar, entendemos tu proyecto</h2>
        <p>Mientras más información tengamos, mejor podremos orientarte: zona, tipo de vivienda, alcance, metraje aproximado, nivel de acabado y fecha estimada de inicio.</p>
        <div class="contact-method-link">
          <a href="/metodo-reformat">Conocer el Método ReformaT <span>→</span></a>
        </div>
        
        <div class="contact-detail">
          <h3><svg class="ci" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg> Cobertura</h3>
          <p>Valencia, San Diego, Carabobo y Caracas</p>
        </div>
        <div class="contact-detail">
          <h3><svg class="ci" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.68 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.32 1.85.55 2.81.68A2 2 0 0 1 22 16.92z"/></svg> Teléfono / WhatsApp</h3>
          <p><a href="https://wa.me/584227997043" class="gold-link">+58 422 799 7043</a></p>
        </div>
        <div class="contact-detail">
          <h3><svg class="ci" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg> Horario de Atención</h3>
          <p>Lunes a Viernes: 8:00 AM - 6:00 PM</p>
        </div>
      </div>

      <form class="contact-form-large" action="https://formsubmit.co/contacto@reformat-venezuela.online" method="POST">
        <div class="form-heading">
          <span>Formulario técnico</span>
          <h2>Solicitud de valoración</h2>
          <p>Completa los datos clave. Si tienes fotos, planos o referencias de acabados, podrás enviarlos por WhatsApp después.</p>
        </div>
        <input type="hidden" name="_subject" value="Nueva valoración técnica desde página de contacto">
        <input type="hidden" name="_captcha" value="false">
        <input type="text" name="_honey" style="display:none" tabindex="-1" autocomplete="off">
        
        <div class="form-row">
          <div class="form-group">
            <label for="nombre-c">Nombre completo</label>
            <input type="text" id="nombre-c" name="nombre" required placeholder="Tu nombre" />
          </div>
          <div class="form-group">
            <label for="telefono-c">Teléfono</label>
            <input type="tel" id="telefono-c" name="telefono" required placeholder="04XX XXX XXXX" />
          </div>
        </div>
        <div class="form-group">
          <label for="email-c">Correo electrónico</label>
          <input type="email" id="email-c" name="email" required placeholder="correo@ejemplo.com" />
        </div>
        <div class="form-group">
          <label for="proyecto-c">Tipo de proyecto</label>
          <select id="proyecto-c" name="proyecto" required>
            <option value="" disabled selected>Selecciona una opción</option>
            <option value="integral">Remodelación integral</option>
            <option value="cocina">Cocina de diseño</option>
            <option value="bano">Baño tipo spa</option>
            <option value="pisos-revestimientos">Pisos y revestimientos</option>
            <option value="exteriores-piscina">Exteriores / piscina</option>
            <option value="otro">Otro alcance</option>
          </select>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label for="zona-c">Zona / urbanización</label>
            <input type="text" id="zona-c" name="zona" required placeholder="Ej. La Lagunita, Guataparo, Altamira..." />
          </div>
          <div class="form-group">
            <label for="propiedad-c">Tipo de propiedad</label>
            <select id="propiedad-c" name="propiedad" required>
              <option value="" disabled selected>Selecciona una opción</option>
              <option value="casa-quinta">Casa / quinta</option>
              <option value="apartamento">Apartamento</option>
              <option value="townhouse">Townhouse</option>
              <option value="local-oficina">Local u oficina</option>
            </select>
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label for="acabado-c">Nivel de acabado deseado</label>
            <select id="acabado-c" name="nivel_acabado" required>
              <option value="" disabled selected>Selecciona una opción</option>
              <option value="alto-estandar">Alto estándar</option>
              <option value="lujo">Lujo</option>
              <option value="signature">Proyecto personalizado / signature</option>
            </select>
          </div>
          <div class="form-group">
            <label for="inicio-c">Fecha estimada de inicio</label>
            <select id="inicio-c" name="fecha_inicio" required>
              <option value="" disabled selected>Selecciona una opción</option>
              <option value="inmediato">Lo antes posible</option>
              <option value="1-3-meses">1 a 3 meses</option>
              <option value="3-6-meses">3 a 6 meses</option>
              <option value="sin-fecha">Aún estoy evaluando</option>
            </select>
          </div>
        </div>
        <div class="form-group">
          <label for="inversion-c">Rango de inversión estimado</label>
          <select id="inversion-c" name="rango_inversion" required>
            <option value="" disabled selected>Selecciona una opción</option>
            <option value="por-definir">Prefiero definirlo tras la valoración</option>
            <option value="3000-8000">USD 3.000 – 8.000</option>
            <option value="8000-20000">USD 8.000 – 20.000</option>
            <option value="20000-50000">USD 20.000 – 50.000</option>
            <option value="50000-plus">USD 50.000+</option>
          </select>
        </div>
        <div class="form-group">
          <label for="mensaje-c">Cuéntanos los detalles</label>
          <textarea id="mensaje-c" name="mensaje" rows="5" required placeholder="Describe alcance, metraje aproximado, materiales deseados, si tienes fotos/planos y si la vivienda estará habitada durante la obra..."></textarea>
        </div>
        <button type="submit" class="btn-premium btn-primary-premium full-width">
          <span class="btn-content">Solicitar valoración técnica</span>
          <span class="btn-border"></span>
          <span class="btn-shine"></span>
          <span class="btn-arrow">→</span>
        </button>
      </form>
    </div>
  </section>

  <GuaranteeMatrix
    compact
    eyebrow="Garantía documentada"
    title="Antes de contratar, sabrás qué queda cubierto y cómo se respalda"
    description="La garantía no es una frase comercial: se vincula a partidas concretas, materiales instalados, pruebas realizadas y condiciones de uso."
  />
</BaseLayout>

<style>
  .hero-overlay { position: absolute; inset: 0; background: linear-gradient(to bottom, rgba(0,0,0,0.5), rgba(0,0,0,0.7)); z-index: 2; }
  .hero-content { position: relative; z-index: 3; max-width: 800px; }
  .hero-tag { display: block; color: var(--gold); font-size: 0.9rem; text-transform: uppercase; letter-spacing: 2px; margin-bottom: 15px; font-weight: 600; }
  .page-title { font-family: var(--font-serif); font-size: clamp(2.5rem, 6vw, 4.5rem); font-weight: 400; margin-bottom: 20px; }
  .page-subtitle { font-size: 1.2rem; color: rgba(255,255,255,0.9); }
  
  .contact-prelude {
    position: relative;
    z-index: 4;
    margin-top: -54px;
    padding: 0 20px;
  }
  .prelude-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    overflow: hidden;
    border-radius: var(--r-lg);
    border: 1px solid rgba(201,169,97,.28);
    background: rgba(201,169,97,.28);
    box-shadow: var(--e-3);
  }
  .prelude-grid article {
    background: rgba(255,255,255,.97);
    padding: 28px 30px;
  }
  .prelude-grid span {
    display: inline-block;
    font-family: var(--font-serif);
    font-size: 2.1rem;
    line-height: 1;
    color: rgba(201,169,97,.64);
    margin-bottom: 12px;
  }
  .prelude-grid h2 {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    margin-bottom: 8px;
    color: var(--ink);
  }
  .prelude-grid p {
    color: var(--text-muted);
    line-height: 1.65;
    font-size: .94rem;
  }

  .contact-premium-section {
    background:
      linear-gradient(90deg, var(--bone) 0%, var(--bone) 50%, var(--white) 50%, var(--white) 100%);
    padding-top: var(--s-6);
  }


  .contact-full-grid { display: grid; grid-template-columns: .82fr 1.18fr; gap: 54px; align-items: start; max-width: 1180px; margin: 0 auto; padding: 56px 20px 90px; }
  .contact-info-panel { position: sticky; top: 120px; padding: 38px 34px; border-radius: var(--r-lg); background: var(--ink); color: var(--white); box-shadow: var(--e-3); border: 1px solid rgba(201,169,97,.26); }
  .panel-kicker { display: inline-block; color: var(--gold); font-size: .75rem; font-weight: 700; letter-spacing: .15em; text-transform: uppercase; margin-bottom: 18px; }
  .contact-info-panel h2 { margin-bottom: 22px; color: var(--white); font-size: clamp(2rem, 4vw, 3.05rem); }
  .contact-info-panel > p { color: rgba(255,255,255,.76); line-height: 1.78; margin-bottom: 28px; }
  .contact-detail { margin-bottom: 24px; padding-bottom: 24px; border-bottom: 1px solid rgba(255,255,255,.12); }
  .contact-detail:last-child { border-bottom: none; }
  .contact-detail h3, .contact-detail h4 { display: flex; align-items: center; gap: 10px; font-size: 1.02rem; margin-bottom: 8px; color: var(--white); }
  .contact-detail p { color: rgba(255,255,255,.72); font-size: 1rem; line-height: 1.6; }
  .gold-link { color: var(--gold); text-decoration: none; font-weight: 700; transition: 0.3s; }
  .gold-link:hover { text-decoration: underline; }
  
  .contact-form-large { background: var(--white); padding: clamp(28px, 4vw, 48px); border-radius: var(--r-lg); box-shadow: var(--e-3); border: 1px solid var(--sand); position: relative; overflow: hidden; }
  .contact-form-large::before { content: ""; position: absolute; inset: 0 0 auto; height: 5px; background: linear-gradient(90deg, var(--gold), var(--gold-light), var(--gold)); }
  .form-heading { margin-bottom: 30px; padding-bottom: 24px; border-bottom: 1px solid var(--sand); }
  .form-heading span { display: inline-block; color: var(--gold-ink); font-size: .75rem; font-weight: 800; letter-spacing: .15em; text-transform: uppercase; margin-bottom: 10px; }
  .form-heading h2 { font-family: var(--font-serif); font-size: clamp(2rem, 4vw, 3rem); line-height: 1.05; letter-spacing: var(--track-tight); font-weight: 500; color: var(--ink); margin-bottom: 12px; }
  .form-heading p { color: var(--text-muted); line-height: 1.7; }
  .form-group { margin-bottom: 25px; }
  .form-group label { display: block; margin-bottom: 8px; font-weight: 700; color: var(--ink); font-size: 0.9rem; letter-spacing: .02em; }
  .contact-form-large input, .contact-form-large select, .contact-form-large textarea { width: 100%; padding: 16px; border: 1px solid var(--sand); border-radius: var(--r-sm); font-size: 1rem; background: var(--bone); transition: border-color var(--dur-fast) var(--ease-out), background var(--dur-fast) var(--ease-out), box-shadow var(--dur-fast) var(--ease-out); }
  .contact-form-large input:focus, .contact-form-large select:focus, .contact-form-large textarea:focus { outline: none; border-color: var(--gold); background: #fff; box-shadow: 0 0 0 4px rgba(201,169,97,.12); }
  .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  
  .btn-premium { display: inline-flex; align-items: center; justify-content: center; gap: 10px; padding: 18px 35px; background: var(--gold); color: var(--bg); font-weight: 600; font-size: 1rem; text-decoration: none; border: none; cursor: pointer; transition: 0.3s; position: relative; overflow: hidden; }
  .btn-border { position: absolute; inset: 0; border: 2px solid rgba(255,255,255,0.3); border-radius: inherit; }
  .btn-shine { display: none; }
  .btn-premium:hover { transform: translateY(-2px); box-shadow: 0 10px 25px rgba(201, 169, 97, 0.4); }
  .full-width { width: 100%; justify-content: center; }
  .contact-method-link { margin: 8px 0 28px; }
  .contact-method-link a { display: inline-flex; align-items: center; gap: 8px; color: var(--gold); font-weight: 700; text-transform: uppercase; letter-spacing: .08em; font-size: .82rem; }
  .contact-method-link span { transition: transform var(--dur-base) var(--ease-out); }
  .contact-method-link a:hover span { transform: translateX(5px); }
  
  @media (max-width: 900px) {
    .contact-full-grid { grid-template-columns: 1fr; gap: 40px; }
    .contact-info-panel { order: 2; position: static; }
    .contact-premium-section { background: var(--bone); }
    .prelude-grid { grid-template-columns: 1fr; margin: 0 20px; }
    .contact-form-large { order: 1; padding: 25px; }
    .form-row { grid-template-columns: 1fr; }
  }

  .contact-detail h3, .contact-detail h4 { display: flex; align-items: center; gap: 10px; }
  .contact-detail .ci { color: var(--gold-ink); flex-shrink: 0; }

  /* Estilos para mensaje de éxito */
  .form-success-message {
    background: var(--white);
    padding: 60px 40px;
    border-radius: var(--r-md);
    box-shadow: var(--e-2);
    text-align: center;
    border: 1px solid var(--sand);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    max-width: 550px;
    margin: 0 auto;
    animation: fadeIn var(--dur-base) var(--ease-out);
  }
  .success-icon-wrapper {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background: rgba(201, 169, 97, 0.1);
    color: var(--gold-ink-strong);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 25px;
  }
  .form-success-message h3 {
    font-family: var(--font-serif);
    font-size: 2rem;
    color: var(--ink);
    margin-bottom: 15px;
  }
  .form-success-message p {
    color: var(--text-muted);
    font-size: 1.05rem;
    line-height: 1.6;
    margin-bottom: 15px;
  }
  .success-note {
    font-size: 0.9rem !important;
    opacity: 0.8;
  }
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>

<script>
  function initContactForm() {
    const form = document.querySelector('.contact-form-large') as HTMLFormElement;
    if (!form) return;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const button = form.querySelector('button[type="submit"]') as HTMLButtonElement;
      const btnText = button?.querySelector('.btn-content') as HTMLElement;
      
      if (!button || !btnText) return;

      const originalText = btnText.textContent;
      btnText.textContent = 'Enviando...';
      button.disabled = true;

      try {
        const formData = new FormData(form);
        const response = await fetch(form.action, {
          method: 'POST',
          body: formData,
          headers: {
            'Accept': 'application/json'
          }
        });

        if (response.ok) {
          const successDiv = document.createElement('div');
          successDiv.className = 'form-success-message';
          successDiv.innerHTML = `
            <div class="success-icon-wrapper">
              <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                <polyline points="22 4 12 14.01 9 11.01"></polyline>
              </svg>
            </div>
            <h3>Solicitud recibida</h3>
            <p>Gracias por contactarnos. Un asesor técnico revisará la información de tu proyecto y te responderá para coordinar los próximos pasos.</p>
            <p class="success-note">Si puedes enviar fotos o planos por WhatsApp, podremos orientarte con mayor precisión.</p>
          `;
          form.replaceWith(successDiv);
        } else {
          throw new Error('Response not OK');
        }
      } catch (err) {
        alert('Hubo un error al enviar el formulario. Por favor, inténtalo de nuevo o contáctanos por WhatsApp.');
        btnText.textContent = originalText;
        button.disabled = false;
      }
    });
  }

  initContactForm();
  document.addEventListener('astro:page-load', initContactForm);
</script>