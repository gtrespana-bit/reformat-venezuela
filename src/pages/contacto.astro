---
import BaseLayout from '../layouts/BaseLayout.astro';
import GodHero from '../components/GodHero.astro';
import GodMarquee from '../components/GodMarquee.astro';
import GuaranteeMatrix from '../components/GuaranteeMatrix.astro';
---

<BaseLayout 
  title="Valoración Técnica | Remodelaciones de Lujo en Venezuela" 
  description="Solicita una valoración técnica para remodelaciones residenciales de alto estándar en Valencia, San Diego, Carabobo y Caracas. Método técnico, acabados de lujo y garantía por escrito." 
  activePage="contacto"
>
  <GodHero
    eyebrow="Valoración técnica"
    title="Cuéntanos tu"
    titleGold="proyecto"
    lead="Atendemos remodelaciones residenciales de alto estándar en Carabobo y Caracas. Revisamos alcance, ubicación y nivel de acabado antes de proponer una solución."
    image="/images/integrales-800.webp"
    imageAlt="Proyecto de remodelación residencial en Venezuela"
    badges={["Filtro técnico", "Respuesta en 48h", "Presupuesto por partidas"]}
    watermark="CONTACTO"
  />

  <GodMarquee />

  <section class="contact-prelude-god">
    <div class="container prelude-grid-god">
      <article data-reveal><span>01</span><h2>Filtro técnico</h2><p>Revisamos ubicación, alcance, tipo de vivienda y nivel de acabado antes de avanzar.</p></article>
      <article data-reveal><span>02</span><h2>Valoración ordenada</h2><p>Pedimos datos útiles para preparar una propuesta seria, no una cifra improvisada.</p></article>
      <article data-reveal><span>03</span><h2>Garantía documentada</h2><p>Cuando el proyecto avanza, cada partida queda respaldada por condiciones claras.</p></article>
    </div>
  </section>

  <section class="section contact-premium-section">
    <div class="container contact-full-grid">
      <div class="contact-info-panel" data-reveal>
        <span class="panel-kicker">Acceso privado a valoración</span>
        <h2 class="section-title">Antes de presupuestar, entendemos tu proyecto</h2>
        <p>Mientras más información tengamos, mejor podremos orientarte: zona, tipo de vivienda, alcance, metraje, nivel de acabado y fecha estimada.</p>
        <div class="contact-method-link"><a href="/metodo-remodelat">Conocer el Método RemodelaT <span>→</span></a></div>
        <div class="contact-detail"><h3><svg class="ci" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg> Cobertura</h3><p>Valencia, San Diego, Carabobo y Caracas</p></div>
        <div class="contact-detail"><h3><svg class="ci" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.68 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.32 1.85.55 2.81.68A2 2 0 0 1 22 16.92z"/></svg> Teléfono / WhatsApp</h3><p><a href="https://wa.me/584227997043" class="gold-link">+58 422 799 7043</a></p></div>
        <div class="contact-detail"><h3><svg class="ci" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg> Horario</h3><p>Lunes a Viernes: 8:00 AM - 6:00 PM</p></div>
      </div>

      <form class="contact-form-large" action="https://formsubmit.co/contacto@remodelat.net" method="POST" data-reveal>
        <div class="form-heading">
          <span class="eyebrow-god on-light">Formulario técnico</span>
          <h2>Solicitud de valoración</h2>
          <p>Completa los datos clave. Si tienes fotos, planos o referencias, podrás enviarlos por WhatsApp después.</p>
        </div>
        <input type="hidden" name="_subject" value="Nueva valoración técnica desde página de contacto">
        <input type="hidden" name="_captcha" value="false">
        <input type="text" name="_honey" style="display:none" tabindex="-1" autocomplete="off">
        
        <div class="form-row">
          <div class="form-group"><label for="nombre-c">Nombre completo</label><input type="text" id="nombre-c" name="nombre" required placeholder="Tu nombre" /></div>
          <div class="form-group"><label for="telefono-c">Teléfono</label><input type="tel" id="telefono-c" name="telefono" required placeholder="04XX XXX XXXX" /></div>
        </div>
        <div class="form-group"><label for="email-c">Correo electrónico</label><input type="email" id="email-c" name="email" required placeholder="correo@ejemplo.com" /></div>
        <div class="form-group"><label for="proyecto-c">Tipo de proyecto</label><select id="proyecto-c" name="proyecto" required><option value="" disabled selected>Selecciona una opción</option><option value="integral">Remodelación integral</option><option value="cocina">Cocina de diseño</option><option value="bano">Baño tipo spa</option><option value="pisos-revestimientos">Pisos y revestimientos</option><option value="exteriores-piscina">Exteriores / piscina</option><option value="otro">Otro alcance</option></select></div>
        <div class="form-row">
          <div class="form-group"><label for="zona-c">Zona / urbanización</label><input type="text" id="zona-c" name="zona" required placeholder="Ej. La Lagunita, Guataparo, Altamira..." /></div>
          <div class="form-group"><label for="propiedad-c">Tipo de propiedad</label><select id="propiedad-c" name="propiedad" required><option value="" disabled selected>Selecciona una opción</option><option value="casa-quinta">Casa / quinta</option><option value="apartamento">Apartamento</option><option value="townhouse">Townhouse</option><option value="local-oficina">Local u oficina</option></select></div>
        </div>
        <div class="form-row">
          <div class="form-group"><label for="acabado-c">Nivel de acabado deseado</label><select id="acabado-c" name="nivel_acabado" required><option value="" disabled selected>Selecciona una opción</option><option value="alto-estandar">Alto estándar</option><option value="lujo">Lujo</option><option value="signature">Proyecto signature</option></select></div>
          <div class="form-group"><label for="inicio-c">Fecha estimada</label><select id="inicio-c" name="fecha_inicio" required><option value="" disabled selected>Selecciona una opción</option><option value="inmediato">Lo antes posible</option><option value="1-3-meses">1 a 3 meses</option><option value="3-6-meses">3 a 6 meses</option><option value="sin-fecha">Aún estoy evaluando</option></select></div>
        </div>
        <div class="form-group"><label for="inversion-c">Rango de inversión</label><select id="inversion-c" name="rango_inversion" required><option value="" disabled selected>Selecciona una opción</option><option value="por-definir">Prefiero definirlo tras la valoración</option><option value="3000-8000">USD 3.000 – 8.000</option><option value="8000-20000">USD 8.000 – 20.000</option><option value="20000-50000">USD 20.000 – 50.000</option><option value="50000-plus">USD 50.000+</option></select></div>
        <div class="form-group"><label for="mensaje-c">Detalles del proyecto</label><textarea id="mensaje-c" name="mensaje" rows="5" required placeholder="Alcance, metraje, materiales deseados, fotos/planos, ¿habitada durante obra?..."></textarea></div>
        <button type="submit" class="btn-premium btn-primary-premium full-width"><span class="btn-content">Solicitar valoración técnica</span><span class="btn-arrow">→</span></button>
      </form>
    </div>
  </section>

  <GuaranteeMatrix compact eyebrow="Garantía documentada" title="Antes de contratar, sabrás qué queda cubierto" description="La garantía se vincula a partidas concretas, materiales instalados y pruebas realizadas." />
</BaseLayout>

<style>
  .contact-prelude-god{position:relative;z-index:4;margin-top:-54px;padding:0 20px}
  .prelude-grid-god{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;overflow:hidden;border-radius:var(--r-lg);border:var(--hairline);background:rgba(201,169,97,.22);box-shadow:var(--e-3)}
  .prelude-grid-god article{background:rgba(255,255,255,.97);padding:28px 30px}
  .prelude-grid-god span{display:block;font-family:var(--font-serif);font-size:2rem;line-height:1;color:rgba(201,169,97,.62);margin-bottom:10px}
  .prelude-grid-god h2{font-family:var(--font-serif);font-size:1.28rem;margin-bottom:8px;color:var(--ink)}
  .prelude-grid-god p{color:var(--text-muted);line-height:1.6;font-size:.92rem}

  .contact-premium-section{background:linear-gradient(90deg,var(--bone) 0%,var(--bone) 50%,var(--white) 50%,var(--white) 100%);padding-top:64px}
  .contact-full-grid{display:grid;grid-template-columns:.82fr 1.18fr;gap:54px;align-items:start;max-width:1180px;margin:0 auto;padding:56px 20px 90px}
  .contact-info-panel{position:sticky;top:120px;padding:38px 34px;border-radius:var(--r-lg);background:var(--ink);color:var(--white);box-shadow:var(--e-3);border:var(--hairline)}
  .panel-kicker{display:inline-block;color:var(--gold);font-size:.72rem;font-weight:800;letter-spacing:.15em;text-transform:uppercase;margin-bottom:16px}
  .contact-info-panel h2{margin-bottom:20px;color:var(--white);font-size:clamp(2rem,4vw,3rem);line-height:1.05;letter-spacing:-.02em;font-family:var(--font-serif)}
  .contact-info-panel > p{color:rgba(255,255,255,.72);line-height:1.75;margin-bottom:24px}
  .contact-detail{margin-bottom:20px;padding-bottom:20px;border-bottom:1px solid rgba(255,255,255,.12)}.contact-detail:last-child{border-bottom:none}
  .contact-detail h3{display:flex;align-items:center;gap:10px;font-size:1rem;margin-bottom:6px;color:var(--white)}
  .contact-detail p{color:rgba(255,255,255,.7);font-size:.95rem;line-height:1.6}
  .gold-link{color:var(--gold);text-decoration:none;font-weight:700}.gold-link:hover{text-decoration:underline}

  .contact-form-large{background:var(--white);padding:clamp(28px,4vw,44px);border-radius:var(--r-lg);box-shadow:var(--e-3);border:var(--hairline-ink);position:relative;overflow:hidden}
  .contact-form-large::before{content:"";position:absolute;inset:0 0 auto;height:4px;background:linear-gradient(90deg,var(--gold),var(--gold-light),var(--gold))}
  .form-heading{margin-bottom:26px;padding-bottom:20px;border-bottom:var(--hairline-ink)}
  .form-heading h2{font-family:var(--font-serif);font-size:clamp(1.9rem,3.6vw,2.7rem);line-height:1.05;letter-spacing:-.02em;font-weight:500;color:var(--ink);margin:8px 0 10px}
  .form-heading p{color:var(--text-muted);line-height:1.65}
  .form-group{margin-bottom:22px}.form-group label{display:block;margin-bottom:7px;font-weight:700;color:var(--ink);font-size:.88rem;letter-spacing:.02em}
  .contact-form-large input,.contact-form-large select,.contact-form-large textarea{width:100%;padding:14px 16px;border:var(--hairline-ink);border-radius:var(--r-sm);font-size:1rem;background:var(--bone);transition:all .2s var(--ease-out)}
  .contact-form-large input:focus,.contact-form-large select:focus,.contact-form-large textarea:focus{outline:none;border-color:var(--gold);background:#fff;box-shadow:0 0 0 4px rgba(201,169,97,.12)}
  .form-row{display:grid;grid-template-columns:1fr 1fr;gap:18px}
  .full-width{width:100%;justify-content:center}
  .contact-method-link{margin:6px 0 22px}.contact-method-link a{display:inline-flex;align-items:center;gap:8px;color:var(--gold);font-weight:700;text-transform:uppercase;letter-spacing:.08em;font-size:.8rem}
  .contact-method-link span{transition:transform var(--dur-base) var(--ease-out)}.contact-method-link a:hover span{transform:translateX(5px)}
  .ci{color:var(--gold);flex-shrink:0}

  .form-success-message{background:var(--white);padding:56px 36px;border-radius:var(--r-md);box-shadow:var(--e-2);text-align:center;border:var(--hairline-ink);max-width:550px;margin:0 auto}
  .success-icon-wrapper{width:72px;height:72px;border-radius:50%;background:rgba(201,169,97,.1);color:var(--gold-ink-strong);display:flex;align-items:center;justify-content:center;margin:0 auto 20px}
  .form-success-message h3{font-family:var(--font-serif);font-size:1.9rem;color:var(--ink);margin-bottom:12px}
  .form-success-message p{color:var(--text-muted);font-size:1rem;line-height:1.6;margin-bottom:10px}
  .success-note{font-size:.88rem !important;opacity:.8}

  @media(max-width:900px){
    .contact-full-grid{grid-template-columns:1fr;gap:36px}.contact-info-panel{order:2;position:static}.contact-premium-section{background:var(--bone)}
    .prelude-grid-god{grid-template-columns:1fr;margin:0 20px}.contact-form-large{order:1;padding:24px}.form-row{grid-template-columns:1fr}
  }
</style>

<script>
  function initContactForm(){
    const form=document.querySelector('.contact-form-large');
    if(!form || form.dataset.bound==='true') return;
    form.dataset.bound='true';
    form.addEventListener('submit', async (e)=>{
      e.preventDefault();
      const btn=form.querySelector('button[type=submit]');
      const btnText=btn?.querySelector('.btn-content');
      if(!btn||!btnText) return;
      const orig=btnText.textContent;
      btnText.textContent='Enviando...'; btn.disabled=true;
      try{
        const fd=new FormData(form);
        const res=await fetch(form.action,{method:'POST',body:fd,headers:{'Accept':'application/json'}});
        if(res.ok){
          const div=document.createElement('div'); div.className='form-success-message';
          div.innerHTML=`<div class="success-icon-wrapper"><svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg></div><h3>Solicitud recibida</h3><p>Gracias por contactarnos. Un asesor técnico revisará tu proyecto y te responderá para coordinar los próximos pasos.</p><p class="success-note">Si puedes enviar fotos o planos por WhatsApp, podremos orientarte con mayor precisión.</p>`;
          form.replaceWith(div);
        } else throw new Error('no ok');
      }catch(err){ alert('Error al enviar. Intenta por WhatsApp.'); btnText.textContent=orig; btn.disabled=false; }
    });
  }
  initContactForm();
  document.addEventListener('astro:page-load', initContactForm);

  (() => {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const targets = document.querySelectorAll('[data-reveal]');
    if (reduce || !('IntersectionObserver' in window)) { targets.forEach(el => el.classList.add('is-revealed')); return; }
    const io = new IntersectionObserver((entries) => {
      entries.forEach((entry) => { if (!entry.isIntersecting) return; entry.target.classList.add('is-revealed','god-reveal'); io.unobserve(entry.target); });
    }, { rootMargin: '0px 0px -10% 0px', threshold: 0.12 });
    targets.forEach(el => { el.classList.add('god-reveal'); io.observe(el); });
  })();
</script>
