  }
  .god-hero-inner {
    position: relative;
    z-index: 4;
    max-width: 980px;
    width: 100%;
  }
  .god-back {
    display: inline-block;
    color: var(--gold);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    margin-bottom: 32px;
    text-decoration: none;
    transition: opacity 0.3s;
  }
  .god-back:hover { opacity: 0.7; }
  .god-eyebrow {
    display: block;
    color: var(--gold-light);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    margin-bottom: 20px;
  }
  .god-title {
    font-family: var(--font-serif);
