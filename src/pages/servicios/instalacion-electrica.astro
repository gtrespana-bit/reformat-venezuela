    font-size: clamp(1.1rem, 1.8vw, 1.35rem);
    color: rgba(255,255,255,0.82);
    max-width: 600px;
    line-height: 1.55;
    margin-bottom: 40px;
  }
  .god-badges {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }
