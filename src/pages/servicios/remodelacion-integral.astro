<style>

  :root {
    --gold-dim: rgba(201,169,97,0.18);
    --gold-mid: rgba(201,169,97,0.55);
    --ink-deep: #0f0d0a;
  }

  /* ============ HERO CINEMATOGRÁFICO DE NIVEL DIOS ============ */
  .god-hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    overflow: hidden;
    background: var(--ink-deep);
    padding: 160px 24px 120px;
  }
  .god-glow {
    position: absolute;
    top: -20%;
    right: -10%;
    width: 70vw;
    height: 70vw;
    background: radial-gradient(circle, rgba(201,169,97,0.35) 0%, transparent 70%);
    filter: blur(80px);
    pointer-events: none;
    z-index: 2;
  }
  .god-hero-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.35;
    filter: contrast(1.15) brightness(0.85);
    z-index: 1;
  }
  .god-hero-overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to top, rgba(10,8,6,0.96) 0%, rgba(10,8,6,0.45) 45%, rgba(10,8,6,0.25) 100%),
      linear-gradient(100deg, rgba(10,8,6,0.7) 0%, transparent 60%);
    z-index: 3;
  }
  .god-hero-inner {
    position: relative;
    z-index: 4;
    max-width: 1080px;
    width: 100%;
  }
  .god-back {
    display: inline-block;
    color: var(--gold);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    margin-bottom: 32px;
    text-decoration: none;
    transition: opacity 0.3s;
  }
  .god-back:hover { opacity: 0.7; }
  .god-eyebrow {
    display: block;
    color: var(--gold-light);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    margin-bottom: 20px;
  }
  .god-title {
    font-family: var(--font-serif);
    font-size: clamp(3.2rem, 8vw, 7.5rem);
    font-weight: 500;
    line-height: 0.92;
    letter-spacing: var(--track-tight);
    color: var(--white);
    margin-bottom: 28px;
  }
  .god-title .line { display: block; }
  .god-title .gold { color: var(--gold); }
  .god-lead {
    font-size: clamp(1.1rem, 1.8vw, 1.35rem);
    color: rgba(255,255,255,0.82);
    max-width: 600px;
    line-height: 1.55;
    margin-bottom: 40px;
  }
  .god-badges {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }
  .god-badges span {
    padding: 9px 20px;
    border: 1px solid rgba(201,169,97,0.35);
    border-radius: 999px;
    color: rgba(255,255,255,0.9);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.08em;
  }

  /* ============ MANIFIESTO ============ */
  .god-manifesto {
    background: var(--ink);
    padding: 160px 24px;
    position: relative;
    overflow: hidden;
  }
  .god-manifesto-inner {
    max-width: 960px;
    margin: 0 auto;
    position: relative;
    z-index: 2;
  }
  .god-manifesto h2 {
    font-family: var(--font-serif);
    font-size: clamp(2.6rem, 5vw, 4rem);
    line-height: 1.05;
    color: var(--white);
    margin-bottom: 28px;
  }
  .god-manifesto p {
    font-size: 1.1rem;
    line-height: 1.75;
    color: rgba(255,255,255,0.72);
    max-width: 680px;
  }

  /* ============ EDITORIAL PREMIUM ============ */
  .god-editorial {
    background: var(--bone);
    padding: 120px 24px;
  }
  .god-editorial-body {
    max-width: 840px;
    margin: 0 auto;
    font-family: var(--font-serif);
    font-size: 1.15rem;
    line-height: 1.85;
    color: var(--text);
  }
  .god-editorial-body h2 {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 3.8vw, 2.8rem);
    line-height: 1.1;
    color: var(--ink);
    margin-top: 80px;
    margin-bottom: 22px;
    letter-spacing: var(--track-tight);
  }
  .god-editorial-body h3 {
    font-size: 1.35rem;
    color: var(--ink-soft);
    margin-top: 48px;
    margin-bottom: 14px;
  }
  .god-editorial-body p {
    margin-bottom: 24px;
  }
  .god-figure {
    margin: 60px 0;
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 30px 80px rgba(0,0,0,0.12);
    position: relative;
  }
  .god-figure img {
    width: 100%;
    display: block;
    aspect-ratio: 3/2;
    object-fit: cover;
  }
  .god-figure figcaption {
    padding: 20px 26px;
    background: linear-gradient(180deg, var(--ink) 0%, var(--ink-soft) 100%);
    color: rgba(255,255,255,0.75);
    font-size: 0.95rem;
    font-style: italic;
    border-top: 1px solid rgba(201,169,97,0.2);
  }
  .god-checks {
    list-style: none;
    padding: 0;
    margin: 28px 0 32px;
  }
  .god-checks li {
    position: relative;
