---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GodHero from '../../components/GodHero.astro';
import GodMarquee from '../../components/GodMarquee.astro';

const services = [
  { slug: "remodelacion-integral", title: "Remodelación Integral de Alto Estándar", desc: "Transformación completa de viviendas con planificación, instalaciones, acabados y coordinación técnica.", image: "/images/integrales-800.webp", srcset: "/images/integrales-400.webp 400w, /images/integrales-800.webp 800w", features: ["Proyecto completo", "Supervisión continua", "Garantía por escrito"] },
  { slug: "remodelacion-cocina", title: "Cocinas de Diseño", desc: "Cocinas a medida con mobiliario, encimeras, iluminación técnica y materiales de alta durabilidad.", image: "/images/cocina-800.webp", srcset: "/images/cocina-400.webp 400w, /images/cocina-800.webp 800w", features: ["Diseño personalizado", "Herrajes y encimeras", "Acabados de precisión"] },
  { slug: "remodelacion-bano", title: "Baños Tipo Spa", desc: "Baños con impermeabilización documentada, pendientes correctas, grifería premium y remates limpios.", image: "/images/bano-800.webp", srcset: "/images/bano-400.webp 400w, /images/bano-800.webp 800w", features: ["Impermeabilización", "Prueba de estanqueidad", "Diseño spa"] },
  { slug: "instalacion-pisos", title: "Instalación de Pisos", desc: "Porcelanato, madera, laminado y SPC instalados con nivelación, adhesivo correcto y juntas limpias.", image: "/images/suelo-porcelanato-800.webp", srcset: "/images/suelo-porcelanato-400.webp 400w, /images/suelo-porcelanato-800.webp 800w", features: ["Nivelación", "Porcelanato XL", "Madera / SPC"] },
  { slug: "revestimientos-pared", title: "Revestimientos de Pared", desc: "Porcelanato, piedra, wall panels y microcemento con cortes, encuentros y remates cuidados.", image: "/images/revestimientos-800.webp", srcset: "/images/revestimientos-400.webp 400w, /images/revestimientos-800.webp 800w", features: ["Porcelanato XL", "Wall panels", "Cortes precisos"] },
  { slug: "instalacion-electrica", title: "Instalación Eléctrica", desc: "Tableros, cableado, iluminación LED, protecciones y preparación para domótica dentro de remodelaciones.", image: "/images/electricidad-800.webp", srcset: "/images/electricidad-400.webp 400w, /images/electricidad-800.webp 800w", features: ["Protecciones", "Iluminación técnica", "Domótica"] },
  { slug: "domotica-automatizacion", title: "Domótica y Automatización", desc: "Control inteligente de iluminación, climatización, seguridad, accesos y energía integrado a la reforma con diseño técnico.", image: "/images/electricidad-800.webp", srcset: "/images/electricidad-400.webp 400w, /images/electricidad-800.webp 800w", features: ["Escenas automáticas", "Control por voz", "Integración estética"] },
  { slug: "fontaneria-plomeria", title: "Fontanería y Plomería", desc: "Renovación de tuberías, puntos de agua, desagües, presión, pruebas y grifería de calidad.", image: "/images/fontaneria-800.webp", srcset: "/images/fontaneria-400.webp 400w, /images/fontaneria-800.webp 800w", features: ["Pruebas", "Grifería", "Tuberías"] },
  { slug: "pintura-acabados", title: "Pintura y Acabados", desc: "Preparación de superficies, corrección de imperfecciones, microcemento y terminaciones limpias.", image: "/images/pintura-800.webp", srcset: "/images/pintura-400.webp 400w, /images/pintura-800.webp 800w", features: ["Preparación", "Microcemento", "Acabado fino"] },
  { slug: "piscinas-mantenimiento", title: "Piscinas y Exteriores", desc: "Revestimientos, filtración, mantenimiento, áreas exteriores y acabados para viviendas de alto valor.", image: "/images/piscinas-800.webp", srcset: "/images/piscinas-400.webp 400w, /images/piscinas-800.webp 800w", features: ["Revestimientos", "Filtración", "Exteriores"] },
  { slug: "remodelacion-vivienda", title: "Remodelación de Viviendas", desc: "Casas, apartamentos, quintas y townhouses para propietarios que buscan durabilidad y acabado superior.", image: "/images/integrales-proyecto-completo.webp", srcset: "/images/integrales-400.webp 400w, /images/integrales-800.webp 800w", features: ["Viviendas completas", "Casas y apartamentos", "Método técnico"] },
  { slug: "remodelacion-apartamentos", title: "Remodelación de Apartamentos", desc: "Apartamentos de alto valor con gestión de condominio, protección de áreas comunes y control de escombros.", image: "/images/cocina-terminada-final.webp", srcset: "/images/cocina-400.webp 400w, /images/cocina-800.webp 800w", features: ["Gestión condominio", "Protección de áreas", "Acabados premium"] },
  { slug: "remodelacion-casas", title: "Remodelación de Casas", desc: "Casas familiares y de lujo con ampliaciones, fachadas, exteriores, áreas sociales y acabados a medida.", image: "/images/arquitectura-600.webp", srcset: "/images/arquitectura-400.webp 400w, /images/arquitectura-600.webp 600w", features: ["Fachadas y techos", "Ampliaciones", "Exteriores"] }
];
---

<BaseLayout title="Servicios de Remodelación de Lujo en Venezuela | RemodelaT" description="Servicios de remodelación residencial de alto estándar: reformas integrales, cocinas, baños, pisos y revestimientos con método técnico, materiales adecuados y garantía por escrito." activePage="servicios">

  <GodHero
    eyebrow="Servicios de alto estándar"
    title="Remodelaciones"
    titleGold="para propietarios exigentes"
    lead="Más de 23 años ejecutando cocinas, baños y reformas integrales con precisión técnica, materiales adecuados y acabados de lujo."
    image="/images/integrales-800.webp"
    imageAlt="Interior moderno después de reforma integral"
    badges={["Método técnico", "Materiales especificados", "Garantía por escrito"]}
    watermark="SERVICIOS"
  />

  <GodMarquee />

  <section class="services-page god-services">
    <div class="container">
      <div class="section-header" data-reveal>
        <span class="eyebrow-god on-light">Especialidades RemodelaT</span>
        <h2 class="section-title">Controlamos todas las partidas necesarias para una remodelación impecable</h2>
        <p class="section-desc">No somos una empresa para “hacer de todo” de cualquier forma. Coordinamos las especialidades técnicas que requiere una vivienda de alto valor: diseño, instalaciones, acabados, pisos, revestimientos y entrega con garantía.</p>
      </div>
      <div class="services-vertical-grid">
        {services.map((svc) => (
          <a href={`/servicios/${svc.slug}`} class="service-vertical-card" data-reveal>
            <div class="card-img-wrap">
              <img 
                src={svc.image} 
                srcset={svc.srcset}
                sizes="(max-width: 768px) 100vw, 50vw"
                alt={svc.title} 
                loading="lazy"
                decoding="async"
                width="800"
                height="533"
              />
              <div class="card-overlay"></div>
              <span class="home-service-kicker">Alto estándar</span>
            </div>
            <div class="card-body">
              <h3>{svc.title}</h3>
              <p>{svc.desc}</p>
              <ul class="card-features">{svc.features.map(f => <li>{f}</li>)}</ul>
              <span class="card-link">Ver más detalles <span class="arrow">→</span></span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <div class="premium-divider"><i></i></div>

  <section class="god-cta">
    <div class="cta-wrapper">
      <span class="eyebrow-god">Valoración técnica</span>
      <h2 class="cta-title">¿Tu vivienda necesita una remodelación bien ejecutada?</h2>
      <p class="cta-text">Solicita una valoración técnica. Revisamos alcance, ubicación, nivel de acabado y condiciones reales antes de preparar una propuesta detallada.</p>
      <a href="/contacto" class="btn-premium btn-primary-premium">
        <span class="btn-content">Solicitar valoración técnica</span><span class="btn-border"></span><span class="btn-arrow">→</span>
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .god-services { padding: 96px 0; background: var(--bone); }
  .services-vertical-grid { display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: 28px; }
  .service-vertical-card { background: var(--white); border-radius: var(--r-md); overflow: hidden; box-shadow: var(--e-1); border: var(--hairline); transition: transform var(--dur-base) var(--ease-out), box-shadow var(--dur-base) var(--ease-out), border-color var(--dur-base) var(--ease-out); text-decoration: none; color: inherit; display: flex; flex-direction: column; }
  .service-vertical-card:hover { transform: translateY(-8px); box-shadow: var(--e-3); border-color: rgba(201,169,97,.42); }
  .card-img-wrap { position: relative; height: 260px; overflow: hidden; background: var(--ink); }
  .card-img-wrap img { width: 100%; height: 100%; object-fit: cover; transition: transform var(--dur-god) var(--ease-god); }
  .service-vertical-card:hover .card-img-wrap img { transform: scale(1.06); }
  .card-overlay { position: absolute; inset: 0; background: linear-gradient(to top, rgba(0,0,0,0.45) 0%, transparent 55%); }
  .home-service-kicker { position: absolute; left: 18px; bottom: 16px; z-index: 2; background: rgba(201,169,97,.94); color: var(--ink); border-radius: var(--r-full); padding: 6px 12px; font-size: .71rem; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; }
  .card-body { padding: 28px 24px; flex: 1; display: flex; flex-direction: column; }
  .card-body h3 { font-family: var(--font-serif); font-size: 1.45rem; margin-bottom: 10px; font-weight: 600; letter-spacing: -0.01em; }
  .card-body p { color: var(--text-muted); font-size: 0.95rem; line-height: 1.65; margin-bottom: 18px; }
  .card-features { list-style: none; padding: 0; margin: 0 0 20px 0; }
  .card-features li { color: var(--text-muted); font-size: 0.88rem; padding: 5px 0 5px 20px; position: relative; }
  .card-features li::before { content: "✓"; position: absolute; left: 0; color: var(--gold-ink); font-weight: 700; }
  .card-link { color: var(--gold-ink); font-weight: 700; font-size: 0.84rem; display: inline-flex; align-items: center; gap: 8px; margin-top: auto; }
  .service-vertical-card:hover .card-link { gap: 14px; }
  .card-link .arrow { transition: transform var(--dur-base) var(--ease-out); }
  .service-vertical-card:hover .arrow { transform: translateX(5px); }

  @media (max-width: 1100px) { .services-vertical-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 700px) { .services-vertical-grid { grid-template-columns: 1fr; } .card-img-wrap { height: 240px; } }
</style>

<script>
  (() => {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const targets = document.querySelectorAll('[data-reveal]');
    if (reduce || !('IntersectionObserver' in window)) { targets.forEach(el => el.classList.add('is-revealed')); return; }
    const io = new IntersectionObserver((entries) => {
      entries.forEach((entry) => { if (!entry.isIntersecting) return; entry.target.classList.add('is-revealed','god-reveal'); io.unobserve(entry.target); });
    }, { rootMargin: '0px 0px -10% 0px', threshold: 0.12 });
    targets.forEach(el => { el.classList.add('god-reveal'); io.observe(el); });
  })();
</script>
