---
import BaseLayout from '../layouts/BaseLayout.astro';
import GodHero from '../components/GodHero.astro';
import GodMarquee from '../components/GodMarquee.astro';
import FAQ from '../components/FAQ.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import GuaranteeMatrix from '../components/GuaranteeMatrix.astro';

const services = [
  { slug: 'remodelacion-cocina', data: { title: 'Remodelación de Cocinas', description: 'Cocinas funcionales y modernas con materiales premium.' } },
  { slug: 'remodelacion-bano', data: { title: 'Remodelación de Baños', description: 'Baños renovados con diseño premium y griferías de alta gama.' } },
  { slug: 'remodelacion-integral', data: { title: 'Remodelación Integral', description: 'Transformación completa llave en mano.' } },
  { slug: 'instalacion-pisos', data: { title: 'Instalación de Pisos', description: 'Porcelanato, cerámica y madera certificada.' } },
  { slug: 'pintura-acabados', data: { title: 'Pintura y Acabados', description: 'Pintura profesional y microcemento.' } },
  { slug: 'fontaneria-plomeria', data: { title: 'Fontanería y Plomería', description: 'Instalaciones y mantenimiento certificado.' } },
];

const cityData = {
  name: "Valencia",
  state: "Carabobo",
  title: "Remodelaciones en Valencia | Expertos en Carabobo 2026",
  description: "Especialistas en remodelación de apartamentos, casas y oficinas en Valencia, San Diego, Naguanagua y toda la región central.",
  heroImage: "/images/cocina-800.webp",
  introImage: "/images/cocina-terminada-final.webp",
  zones: [
    "Valencia Centro (El Viñedo, El Palotal, Candelaria)",
    "San Diego (Urb. San José, El Bosque)",
    "Naguanagua (El Trigal, Vistahermosa)",
    "Guacara, Puerto Cabello",
    "Los Guayos, Tocuyito",
    "Prebo, El Parral, La Trigaleña"
  ],
  testimonials: [
    { name: "Ana María Rodríguez", location: "El Viñedo, Valencia", text: "Transformaron completamente mi apartamento. El diseño de la cocina quedó espectacular.", rating: 5 },
    { name: "Luis Eduardo Mendoza", location: "San Diego, Carabobo", text: "Excelente servicio profesional. Mi oficina en San Diego quedó moderna y funcional.", rating: 5 },
    { name: "Gabriela Hernández", location: "Naguanagua, Carabobo", text: "Renovaron el baño de mi casa en Naguanagua. Excelente comunicación y acabados de primera.", rating: 5 }
  ]
};

const faqItems = [
  { question: `¿Cuánto tiempo tarda una remodelación en Valencia?`, answer: `Una cocina o baño toma entre 2-4 semanas. Una remodelación integral 6-12 semanas. Cronograma detallado garantizado.` },
  { question: `¿Trabajan con permisos de condominios?`, answer: `Sí, gestionamos todos los permisos requeridos. Conocemos las normativas de Valencia, San Diego y Naguanagua.` },
  { question: `¿Formas de pago?`, answer: `Efectivo USD, transferencia BCV, Zelle, PayPal y Pago Móvil. Facilidades según proyecto.` },
  { question: `¿Garantía?`, answer: `Garantía por escrito según partida: acabados, instalaciones, impermeabilización y fabricante documentado.` },
  { question: `¿Valoración técnica?`, answer: `Revisamos ubicación, alcance y acabado. Si encaja con nuestro estándar, visita técnica y presupuesto por partidas.` }
];
---

<BaseLayout title={cityData.title} description={cityData.description}>
  <GodHero
    eyebrow="Carabobo · Casa Matriz"
    title="Remodelaciones en"
    titleGold="Valencia"
    lead="Transformamos apartamentos, casas y oficinas con diseño de autor, materiales premium y ejecución impecable en toda la región central."
    image={cityData.heroImage}
    imageAlt="Remodelaciones en Valencia, Carabobo"
    badges={["Sede principal", "23+ años", "Garantía escrita"]}
    watermark="VALENCIA"
  />
  <GodMarquee />
  <Breadcrumb items={[ { name: 'Inicio', url: '/' }, { name: 'Valencia', url: '/valencia' } ]} />

  <section class="section" data-reveal>
    <div class="container intro-grid">
      <div class="intro-media"><img src={cityData.introImage} alt={`Proyecto en ${cityData.name}`} loading="lazy" /></div>
      <div class="intro-body">
        <span class="eyebrow-god on-light">Por qué RemodelaT</span>
        <h2>Sede principal en Carabobo,<br/>respuesta en 48h</h2>
        <p>Desde Valencia operamos para toda la región central con el mayor volumen de proyectos y clientes satisfechos.</p>
        <ul class="intro-checks">
          <li>Equipo propio certificado, sin subcontratas</li>
          <li>Presupuesto cerrado y cronograma garantizado</li>
          <li>Gestión de permisos de condominio</li>
          <li>Garantía por escrito</li>
        </ul>
        <a href="#contacto" class="btn-premium btn-primary-premium"><span class="btn-content">Solicitar valoración</span><span class="btn-arrow">→</span></a>
      </div>
    </div>
  </section>

  <div class="premium-divider"><i></i></div>

  <section class="section section-alt">
    <div class="container">
      <div class="section-header" data-reveal>
        <span class="eyebrow-god on-light">Servicios</span>
        <h2>Soluciones integrales</h2>
        <p>Desde renovación puntual hasta llave en mano con estándares premium.</p>
      </div>
      <div class="services-grid-god">
        {services.map(s => (
          <article class="service-card-god" data-reveal>
            <div class="service-icon-god"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg></div>
            <h3>{s.data.title}</h3><p>{s.data.description}</p>
            <a href={`/servicios/${s.slug}`} class="card-link-god">Ver detalles <span>→</span></a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header" data-reveal>
        <span class="eyebrow-god on-light">Cobertura</span>
        <h2>Atendemos toda la región central</h2>
        <p>Valencia, San Diego, Naguanagua, Guacara y Puerto Cabello.</p>
      </div>
      <div class="zones-grid-god">
        {cityData.zones.map(z => (
          <div class="zone-item-god"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg><span>{z}</span></div>
        ))}
      </div>
    </div>
  </section>

  <GuaranteeMatrix compact eyebrow="Garantía documentada" title="Cada partida con su cobertura" />

  <section class="section">
    <div class="container">
      <div class="section-header" data-reveal>
        <span class="eyebrow-god on-light">Testimonios</span>
        <h2>Clientes en Carabobo</h2>
      </div>
      <div class="testimonials-grid-god">
        {cityData.testimonials.map(t => (
          <figure class="testimonial-card-god" data-reveal>
            <div class="stars-god">★★★★★</div>
            <blockquote>“{t.text}”</blockquote>
            <figcaption><strong>{t.name}</strong><span>{t.location}</span></figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container container-narrow">
      <div class="section-header" data-reveal>
        <span class="eyebrow-god on-light">FAQ</span>
        <h2>Preguntas frecuentes en Valencia</h2>
      </div>
      <FAQ items={faqItems} />
    </div>
  </section>

  <section class="god-cta" id="contacto">
    <div class="cta-wrapper">
      <span class="eyebrow-god">Sede Carabobo</span>
      <h2 class="cta-title">¿Listo para transformar tu espacio en Valencia?</h2>
      <p class="cta-text">Valoración técnica en 48h, presupuesto por partidas y garantía escrita.</p>
      <div class="cta-actions-home">
        <a rel="noopener" href="https://wa.me/584227997043?text=Hola,%20quiero%20presupuesto%20en%20Valencia" class="btn-premium btn-primary-premium" target="_blank"><span class="btn-content">WhatsApp directo</span><span class="btn-arrow">→</span></a>
        <a href="/contacto" class="btn-premium btn-outline-premium"><span class="btn-content">Formulario</span><span class="btn-arrow">→</span></a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .container{max-width:1200px;margin:0 auto;padding:0 24px}.container-narrow{max-width:860px;margin:0 auto;padding:0 24px}.section{padding:clamp(72px,10vw,112px) 0}.section-alt{background:var(--bone)}.section-header{text-align:center;max-width:680px;margin:0 auto clamp(36px,6vw,64px)}.section-header h2{font-family:var(--font-serif);font-size:clamp(1.9rem,4vw,2.7rem);font-weight:500;letter-spacing:-.02em;color:var(--ink);line-height:1.12;margin:12px 0 14px}.section-header p{color:var(--text-muted);font-size:1.05rem;line-height:1.7}
  .intro-grid{display:grid;grid-template-columns:1fr 1fr;gap:clamp(40px,6vw,84px);align-items:center}.intro-media img{width:100%;border-radius:var(--r-md);box-shadow:var(--e-3);border:var(--hairline)}.intro-body h2{font-family:var(--font-serif);font-size:clamp(1.9rem,3.5vw,2.6rem);line-height:1.12;letter-spacing:-.02em;margin:12px 0 18px;color:var(--ink)}.intro-body p{color:var(--text-muted);line-height:1.78;margin-bottom:14px}.intro-checks{list-style:none;padding:0;margin:22px 0 28px;display:grid;gap:10px}.intro-checks li{position:relative;padding-left:28px;font-size:.95rem;color:var(--ink);line-height:1.5}.intro-checks li::before{content:"";position:absolute;left:0;top:.6em;width:8px;height:8px;border-radius:50%;background:var(--gold-ink);box-shadow:0 0 0 5px rgba(201,169,97,.12)}
  .services-grid-god{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}.service-card-god{background:var(--white);border:var(--hairline);border-radius:var(--r-md);padding:32px 28px;transition:all .32s var(--ease-out)}.service-card-god:hover{transform:translateY(-6px);box-shadow:var(--e-3);border-color:rgba(201,169,97,.38)}.service-icon-god{width:48px;height:48px;border-radius:var(--r-sm);background:var(--gold-soft);color:var(--gold-ink);display:flex;align-items:center;justify-content:center;margin-bottom:18px}
  .service-card-god h3{font-family:var(--font-serif);font-size:1.28rem;font-weight:600;margin-bottom:8px;color:var(--ink)}.service-card-god p{color:var(--text-muted);font-size:.93rem;line-height:1.66;margin-bottom:16px}.card-link-god{color:var(--gold-ink);font-weight:700;font-size:.84rem;display:inline-flex;gap:8px}.service-card-god:hover .card-link-god{gap:12px}
  .zones-grid-god{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.zone-item-god{display:flex;align-items:center;gap:12px;padding:16px 18px;background:var(--white);border:var(--hairline-ink);border-radius:var(--r-md);transition:all .28s;font-size:.92rem}.zone-item-god:hover{border-color:rgba(201,169,97,.38);transform:translateY(-2px);box-shadow:var(--e-1)}.zone-item-god svg{color:var(--gold-ink);flex-shrink:0}
  .testimonials-grid-god{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}.testimonial-card-god{background:var(--white);border:var(--hairline-ink);border-radius:var(--r-md);padding:32px 26px;box-shadow:var(--e-1);margin:0}.stars-god{color:var(--gold-ink);letter-spacing:3px;font-size:.95rem;margin-bottom:14px}.testimonial-card-god blockquote{font-style:italic;color:var(--ink);line-height:1.7;margin:0 0 18px;font-size:.98rem}.testimonial-card-god figcaption strong{display:block;font-size:.92rem;color:var(--ink)}.testimonial-card-god figcaption span{font-size:.82rem;color:var(--text-muted)}
  .cta-actions-home{display:flex;gap:14px;justify-content:center;flex-wrap:wrap;margin-top:28px}
  @media(max-width:1024px){.services-grid-god,.zones-grid-god,.testimonials-grid-god{grid-template-columns:repeat(2,1fr)}.intro-grid{grid-template-columns:1fr;gap:40px}}
  @media(max-width:640px){.services-grid-god,.zones-grid-god,.testimonials-grid-god{grid-template-columns:1fr}}
</style>

<script>
  (() => {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const targets = document.querySelectorAll('[data-reveal]');
    if (reduce || !('IntersectionObserver' in window)) { targets.forEach(el => el.classList.add('is-revealed')); return; }
    const io = new IntersectionObserver((entries) => {
      entries.forEach((entry) => { if (!entry.isIntersecting) return; entry.target.classList.add('is-revealed','god-reveal'); io.unobserve(entry.target); });
    }, { rootMargin: '0px 0px -10% 0px', threshold: 0.12 });
    targets.forEach(el => { el.classList.add('god-reveal'); io.observe(el); });
  })();
</script>
