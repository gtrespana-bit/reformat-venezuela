---
import BaseLayout from '../layouts/BaseLayout.astro';
import FAQ from '../components/FAQ.astro';
import { getCollection } from 'astro:content';

const services = await getCollection('services');

const cityData = {
  name: "La Guaira",
  state: "Estado Vargas",
  title: "Remodelaciones en La Guaira | Expertos en Vargas 2026",
  description: "Especialistas en remodelación de apartamentos, casas y locales comerciales en La Guaira y todo el estado Vargas. Materiales resistentes a la salinidad. Presupuestos sin compromiso.",
  h1: "Remodelaciones en La Guaira - Estado Vargas",
  intro: `¿Buscas expertos en **remodelaciones en La Guaira**? En ReformaT Venezuela transformamos tu espacio en la costa varguense con materiales especiales resistentes a la salinidad y humedad del mar Caribe.

Con amplia experiencia en el **estado Vargas**, conocemos los desafíos del clima costero y utilizamos productos anticorrosivos y tratamientos especiales para garantizar la durabilidad de tu inversión.`,
  zones: [
    "La Guaira (Centro, El Malecón, Caraballeda)",
    "Catia La Mar (Carayaca, Carlos Soublette)",
    "Maiquetía (Bachaquero, Los Cedros)",
    "Macuto (Pueblo, Carmen de Uria)",
    "Naiguatá, Caraballeda, Camurí Chico",
    "Los Totumos, Playa Grande, Cerro Grande"
  ],
  prices: {
    cocina: "Desde $1.900 USD",
    bano: "Desde $1.050 USD",
    integral: "Desde $160 USD/m²"
  },
  testimonials: [
    {
      name: "Roberto Martínez",
      location: "Caraballeda, Vargas",
      text: "Excelente trabajo en mi apartamento frente al mar. Usaron materiales especiales contra la salinidad y quedó perfecto. Muy profesionales."
    },
    {
      name: "Ana Gabriela Silva",
      location: "Catia La Mar",
      text: "Remodelaron mi casa en Catia La Mar con acabados de primera. El equipo fue limpio y respetuoso. Totalmente recomendados en Vargas."
    }
  ]
};
---

<BaseLayout
  title={cityData.title}
  description={cityData.description}
  image="/og-la-guaira.jpg"
  canonical={`https://reformat-venezuela.online/la-guaira`}
  schemaType="LocalBusiness"
>
  <main class="city-page">
    <!-- Hero Section -->
    <section class="hero-city">
      <div class="container">
        <h1>{cityData.h1}</h1>
        <p class="lead">Especialistas en remodelación con materiales resistentes a la salinidad en el litoral varguense</p>
        <a href="/contacto" class="btn btn-primary">Solicitar Presupuesto Gratis</a>
      </div>
    </section>

    <!-- Intro Section -->
    <section class="intro-section">
      <div class="container">
        <div class="content-grid">
          <div class="text-content">
            <h2>Expertos en Remodelaciones en La Guaira</h2>
            <p set:html={cityData.intro}></p>
            
            <div class="trust-badges">
              <div class="badge">
                <span class="icon">✓</span>
                <span>Materiales anticorrosivos</span>
              </div>
              <div class="badge">
                <span class="icon">✓</span>
                <span>Tratamientos anti-humedad</span>
              </div>
              <div class="badge">
                <span class="icon">✓</span>
                <span>Experiencia en clima costero</span>
              </div>
            </div>
          </div>
          <div class="image-content">
            <img 
              src="/images/remodelacion-bano.webp" 
              alt="Remodelación de baño en La Guaira"
              loading="lazy"
              width="500"
              height="350"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Services Section -->
    <section class="services-section">
      <div class="container">
        <h2>Nuestros Servicios de Remodelación en La Guaira</h2>
        <p class="section-subtitle">Soluciones especializadas para el clima costero de Vargas</p>
        
        <div class="services-grid">
          {services.slice(0, 6).map((service) => (
            <div class="service-card bg-white rounded-xl shadow-lg overflow-hidden hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1">
              <div class="p-6">
                <h3 class="text-xl font-bold mb-3 text-gray-900">{service.data.title}</h3>
                <p class="text-gray-600 mb-4 leading-relaxed">{service.data.description}</p>
                <a href={`/servicios/${service.slug}`} class="inline-flex items-center text-primary font-semibold hover:text-primary/80 transition-colors">
                  Saber más
                  <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                  </svg>
                </a>
              </div>
            </div>
          ))}
        </div>
        
        <div class="cta-center">
          <a href="/servicios" class="btn btn-secondary">Ver Todos los Servicios</a>
        </div>
      </div>
    </section>

    <!-- Zones Section -->
    <section class="zones-section">
      <div class="container">
        <h2>Zonas que Atendemos en La Guaira y Vargas</h2>
        <p class="section-subtitle">Cubrimos todo el litoral central del estado Vargas</p>
        
        <div class="zones-grid">
          {cityData.zones.map((zone) => (
            <div class="zone-card">
              <span class="icon">📍</span>
              <span>{zone}</span>
            </div>
          ))}
        </div>
        
        <div class="info-box">
          <h3>¿Trabajas en otras zonas de Vargas?</h3>
          <p>Sí, atendemos todas las parroquias del estado Vargas desde Naiguatá hasta Carayaca. ¡Consúltanos para tu proyecto costero!</p>
        </div>
      </div>
    </section>

    <!-- Pricing Section -->
    <section class="pricing-section">
      <div class="container">
        <h2>Precios de Remodelación en La Guaira 2026</h2>
        <p class="section-subtitle">Precios referenciales en dólares americanos (USD)</p>
        
        <div class="pricing-grid">
          <div class="price-card">
            <h3>Remodelación de Cocina</h3>
            <div class="price">{cityData.prices.cocina}</div>
            <ul>
              <li>Gabinetes con tratamiento anti-humedad</li>
              <li>Encimeras de cuarzo o granito</li>
              <li>Instalaciones protegidas contra salinidad</li>
              <li>Ventilación especializada</li>
            </ul>
          </div>
          
          <div class="price-card featured">
            <div class="badge-popular">Más Popular</div>
            <h3>Remodelación de Baño</h3>
            <div class="price">{cityData.prices.bano}</div>
            <ul>
              <li>Impermeabilización reforzada</li>
              <li>Porcelanato antideslizante</li>
              <li>Grifería inoxidable grado marino</li>
              <li>Ventilación contra humedad</li>
            </ul>
          </div>
          
          <div class="price-card">
            <h3>Remodelación Integral</h3>
            <div class="price">{cityData.prices.integral}</div>
            <ul>
              <li>Proyectos desde 30m²</li>
              <li>Tratamientos anticorrosivos</li>
              <li>Materiales grado marino</li>
              <li>Garantía extendida por clima</li>
            </ul>
          </div>
        </div>
        
        <div class="pricing-note">
          <p><strong>Nota:</strong> Precios sujetos a evaluación previa. Aceptamos pagos en efectivo (USD), transferencia bancaria, Zelle y Pago Móvil al cambio del BCV.</p>
        </div>
      </div>
    </section>

    <!-- Testimonials Section -->
    <section class="testimonials-section">
      <div class="container">
        <h2>Lo Que Dicen Nuestros Clientes en La Guaira</h2>
        
        <div class="testimonials-grid">
          {cityData.testimonials.map((testimonial) => (
            <div class="testimonial-card">
              <div class="stars">★★★★★</div>
              <p class="text">"{testimonial.text}"</p>
              <div class="author">
                <strong>{testimonial.name}</strong>
                <span>{testimonial.location}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="faq-section">
      <div class="container">
        <h2>Preguntas Frecuentes sobre Remodelaciones en La Guaira</h2>
        
        <FAQ items={[
          { 
            question: "¿Qué materiales usan para resistir la salinidad?", 
            answer: "Utilizamos acero inoxidable grado marino, aluminio anodizado, maderas tratadas con preservantes, pinturas epóxicas y selladores especiales para ambientes costeros." 
          },
          { 
            question: "¿Cuánto tiempo tarda una remodelación en La Guaira?", 
            answer: "Depende del proyecto. Una cocina o baño toma entre 2-4 semanas. Una remodelación integral puede tomar 6-12 semanas. Consideramos factores climáticos en el cronograma." 
          },
          { 
            question: "¿Dan garantía especial por el clima costero?", 
            answer: "Sí, ofrecemos garantía extendida de 18 meses en acabados y 30 meses en instalaciones, considerando las condiciones especiales del ambiente marino." 
          },
          { 
            question: "¿Qué formas de pago aceptan en Vargas?", 
            answer: "Aceptamos pagos en efectivo (USD), transferencia bancaria en bolívares al cambio BCV, Zelle, PayPal y Pago Móvil. Ofrecemos facilidades según el proyecto." 
          },
          { 
            question: "¿El presupuesto incluye visita técnica?", 
            answer: "Sí, realizamos visitas técnicas sin costo en toda La Guaira y estado Vargas, evaluamos condiciones específicas de salinidad y humedad." 
          }
        ]} />
      </div>
    </section>

    <!-- CTA Final -->
    <section class="cta-final">
      <div class="container">
        <h2>¿Listo para Transformar tu Espacio en La Guaira?</h2>
        <p>Solicita tu presupuesto gratuito hoy mismo con asesoría especializada en clima costero</p>
        <div class="cta-buttons">
          <a href="/contacto" class="btn btn-primary">Solicitar Presupuesto</a>
          <a href="https://wa.me/584123456789" class="btn btn-whatsapp">
            <span class="icon">💬</span>
            Contactar por WhatsApp
          </a>
        </div>
      </div>
    </section>
  </main>

  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "HomeAndConstructionBusiness",
      "name": "ReformaT Venezuela - La Guaira",
      "description": "Especialistas en remodelaciones en La Guaira y estado Vargas. Materiales resistentes a salinidad y humedad.",
      "url": "https://reformat-venezuela.online/la-guaira",
      "telephone": "+58-412-345-6789",
      "areaServed": {
        "@type": "AdministrativeArea",
        "name": "Estado Vargas"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": "10.5938",
        "longitude": "-66.8786"
      },
      "openingHoursSpecification": {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
        "opens": "08:00",
        "closes": "17:00"
      },
      "priceRange": "$$"
    }
  </script>
</BaseLayout>

<style>
  .city-page {
    padding-top: 0;
  }
  
  .hero-city {
    background: linear-gradient(135deg, #1e3a5f 0%, #2d5a87 100%);
    color: white;
    padding: 100px 0 80px;
    text-align: center;
  }
  
  .hero-city h1 {
    font-size: 3rem;
    margin-bottom: 20px;
    font-weight: 700;
  }
  
  .hero-city .lead {
    font-size: 1.3rem;
    margin-bottom: 30px;
    opacity: 0.95;
  }
  
  .intro-section,
  .services-section,
  .zones-section,
  .pricing-section,
  .testimonials-section,
  .faq-section {
    padding: 80px 0;
  }
  
  .content-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 50px;
    align-items: center;
  }
  
  .image-content img {
    width: 100%;
    height: auto;
    border-radius: 12px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.15);
  }
  
  .trust-badges {
    display: flex;
    gap: 20px;
    margin-top: 30px;
    flex-wrap: wrap;
  }
  
  .badge {
    display: flex;
    align-items: center;
    gap: 10px;
    background: #f8f9fa;
    padding: 12px 20px;
    border-radius: 8px;
    font-weight: 500;
  }
  
  .badge .icon {
    color: #27ae60;
    font-size: 1.2rem;
    font-weight: bold;
  }
  
  .zones-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 15px;
    margin-top: 40px;
  }
  
  .zone-card {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 15px 20px;
    background: #f8f9fa;
    border-radius: 8px;
    transition: transform 0.3s ease;
  }
  
  .zone-card:hover {
    transform: translateY(-3px);
    background: #e9ecef;
  }
  
  .zone-card .icon {
    font-size: 1.3rem;
  }
  
  .info-box {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    padding: 30px;
    border-radius: 12px;
    margin-top: 40px;
    text-align: center;
  }
  
  .info-box h3 {
    margin-bottom: 15px;
    font-size: 1.4rem;
  }
  
  .pricing-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 30px;
    margin-top: 40px;
  }
  
  .price-card {
    background: white;
    padding: 35px;
    border-radius: 12px;
    box-shadow: 0 5px 20px rgba(0,0,0,0.08);
    position: relative;
    border: 2px solid transparent;
    transition: all 0.3s ease;
  }
  
  .price-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 30px rgba(0,0,0,0.15);
  }
  
  .price-card.featured {
    border-color: #667eea;
    transform: scale(1.05);
  }
  
  .badge-popular {
    position: absolute;
    top: -12px;
    left: 50%;
    transform: translateX(-50%);
    background: #667eea;
    color: white;
    padding: 6px 20px;
    border-radius: 20px;
    font-size: 0.85rem;
    font-weight: 600;
  }
  
  .price-card h3 {
    font-size: 1.4rem;
    margin-bottom: 15px;
    color: #1e3a5f;
  }
  
  .price {
    font-size: 2rem;
    font-weight: 700;
    color: #667eea;
    margin-bottom: 20px;
  }
  
  .price-card ul {
    list-style: none;
    padding: 0;
  }
  
  .price-card li {
    padding: 10px 0;
    border-bottom: 1px solid #eee;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  
  .price-card li:last-child {
    border-bottom: none;
  }
  
  .price-card li::before {
    content: "✓";
    color: #27ae60;
    font-weight: bold;
  }
  
  .pricing-note {
    background: #fff3cd;
    border-left: 4px solid #ffc107;
    padding: 20px;
    margin-top: 30px;
    border-radius: 8px;
  }
  
  .testimonials-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 30px;
    margin-top: 40px;
  }
  
  .testimonial-card {
    background: white;
    padding: 30px;
    border-radius: 12px;
    box-shadow: 0 5px 20px rgba(0,0,0,0.08);
  }
  
  .stars {
    color: #ffc107;
    font-size: 1.3rem;
    margin-bottom: 15px;
  }
  
  .testimonial-card .text {
    font-style: italic;
    color: #555;
    margin-bottom: 20px;
    line-height: 1.6;
  }
  
  .testimonial-card .author {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }
  
  .testimonial-card .author strong {
    color: #1e3a5f;
  }
  
  .testimonial-card .author span {
    color: #888;
    font-size: 0.9rem;
  }
  
  .cta-final {
    background: linear-gradient(135deg, #1e3a5f 0%, #2d5a87 100%);
    color: white;
    padding: 80px 0;
    text-align: center;
  }
  
  .cta-final h2 {
    font-size: 2.5rem;
    margin-bottom: 20px;
  }
  
  .cta-final p {
    font-size: 1.2rem;
    margin-bottom: 30px;
    opacity: 0.95;
  }
  
  .cta-buttons {
    display: flex;
    gap: 20px;
    justify-content: center;
    flex-wrap: wrap;
  }
  
  .btn-whatsapp {
    background: #25D366;
    color: white;
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }
  
  .btn-whatsapp:hover {
    background: #20bd5a;
  }
  
  @media (max-width: 768px) {
    .hero-city h1 {
      font-size: 2.2rem;
    }
    
    .content-grid {
      grid-template-columns: 1fr;
      gap: 30px;
    }
    
    .price-card.featured {
      transform: none;
    }
    
    .cta-buttons {
      flex-direction: column;
      align-items: center;
    }
  }
</style>
