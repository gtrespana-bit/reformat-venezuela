---
import BaseLayout from '../layouts/BaseLayout.astro';
import GodHero from '../components/GodHero.astro';
import GodMarquee from '../components/GodMarquee.astro';
import FAQ from '../components/FAQ.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import GuaranteeMatrix from '../components/GuaranteeMatrix.astro';

const zones = ["Caraballeda", "Catia La Mar", "Maiquetía", "Macuto", "Naiguatá", "Carmen de Uria"];
const testimonials = [
  { name: "Carmen Elena Vivas", location: "Caraballeda", text: "Acabados resisten perfectamente humedad y salinidad.", rating: 5 },
  { name: "Roberto José Martínez", location: "Maiquetía", text: "Muy profesionales y puntuales. Local moderno y funcional.", rating: 5 },
  { name: "Daniela Pérez", location: "Macuto", text: "Materiales resistentes al clima costero. Superó expectativas.", rating: 5 }
];
const faqItems = [
  { question: "¿Tiempo en La Guaira?", answer: "Cocina/baño 2-4 semanas, integral 6-12 semanas." },
  { question: "¿Materiales marinos?", answer: "Sí, acero inoxidable, pinturas antihumedad, maderas tratadas, revestimientos salinidad." },
  { question: "¿Permisos?", answer: "Gestionamos permisos en Caraballeda, Catia La Mar, Maiquetía." },
  { question: "¿Pagos?", answer: "USD efectivo, BCV, Zelle, PayPal, Pago Móvil." },
  { question: "¿Valoración?", answer: "Revisamos ubicación, alcance y acabado; si encaja, visita y presupuesto por partidas." }
];
---

<BaseLayout title="Remodelaciones en La Guaira | Expertos en Vargas 2026" description="Especialistas en remodelación en La Guaira, Catia La Mar, Maiquetía y todo el estado Vargas.">
  <GodHero
    eyebrow="Vargas · Litoral Central"
    title="Remodelaciones en"
    titleGold="La Guaira"
    lead="Transformamos apartamentos y casas frente al mar con materiales resistentes a humedad y salinidad, acabados premium."
    image="/images/bano-800.webp"
    imageAlt="Remodelaciones en La Guaira"
    badges={["Materiales marinos", "Anticorrosivo", "Garantía escrita"]}
    watermark="LA GUAIRA"
  />
  <GodMarquee />
  <Breadcrumb items={[ { name: 'Inicio', url: '/' }, { name: 'La Guaira', url: '/la-guaira' } ]} />

  <section class="section" data-reveal>
    <div class="container intro-grid">
      <div class="intro-media"><img src="/images/suelo-madera.webp" alt="Proyecto La Guaira" loading="lazy" /></div>
      <div class="intro-body">
        <span class="eyebrow-god on-light">Litoral central</span>
        <h2>Remodelaciones resistentes<br/>al clima marino</h2>
        <p>Clima costero exige herrajes inox, pinturas antihumedad y revestimientos salinidad. Lo aplicamos en cada obra.</p>
        <ul class="intro-checks">
          <li>Herrajes y grifería acero inoxidable</li>
          <li>Pinturas antihumedad y anticorrosivas</li>
          <li>Gestión de permisos en Vargas</li>
          <li>Garantía por escrito</li>
        </ul>
        <a href="#contacto" class="btn-premium btn-primary-premium"><span class="btn-content">Solicitar valoración La Guaira</span><span class="btn-arrow">→</span></a>
      </div>
    </div>
  </section>

  <div class="premium-divider"><i></i></div>

  <section class="section section-alt">
    <div class="container">
      <div class="section-header" data-reveal>
        <span class="eyebrow-god on-light">Cobertura Vargas</span>
        <h2>Todo el litoral central</h2>
      </div>
      <div class="zones-grid-god">
        {zones.map(z => (
          <div class="zone-item-god"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg><span>{z}</span></div>
        ))}
      </div>
    </div>
  </section>

  <GuaranteeMatrix compact title="Garantía adaptada al clima costero" description="Materiales y mano de obra documentados para ambientes marinos." />

  <section class="section">
    <div class="container">
      <div class="testimonials-grid-god">
        {testimonials.map(t => (
          <figure class="testimonial-card-god" data-reveal>
            <div class="stars-god">★★★★★</div>
            <blockquote>“{t.text}”</blockquote>
            <figcaption><strong>{t.name}</strong><span>{t.location}</span></figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container container-narrow"><FAQ items={faqItems} /></div>
  </section>

  <section class="god-cta" id="contacto">
    <div class="cta-wrapper">
      <span class="eyebrow-god">La Guaira · Vargas</span>
      <h2 class="cta-title">¿Listo para remodelar en La Guaira?</h2>
      <p class="cta-text">Materiales marinos, presupuesto por partidas y entrega con garantía escrita.</p>
      <a rel="noopener" href="https://wa.me/584227997043?text=Hola,%20quiero%20presupuesto%20en%20La%20Guaira" class="btn-premium btn-primary-premium" target="_blank"><span class="btn-content">WhatsApp La Guaira</span><span class="btn-arrow">→</span></a>
    </div>
  </section>
</BaseLayout>

<style>
  .container{max-width:1200px;margin:0 auto;padding:0 24px}.container-narrow{max-width:860px;margin:0 auto;padding:0 24px}.section{padding:clamp(72px,10vw,112px) 0}.section-alt{background:var(--bone)}.section-header{text-align:center;max-width:680px;margin:0 auto clamp(36px,6vw,64px)}.section-header h2{font-family:var(--font-serif);font-size:clamp(1.9rem,4vw,2.7rem);font-weight:500;letter-spacing:-.02em;color:var(--ink);line-height:1.12;margin:12px 0 14px}
  .intro-grid{display:grid;grid-template-columns:1fr 1fr;gap:clamp(40px,6vw,84px);align-items:center}.intro-media img{width:100%;border-radius:var(--r-md);box-shadow:var(--e-3);border:var(--hairline)}.intro-body h2{font-family:var(--font-serif);font-size:clamp(1.9rem,3.5vw,2.6rem);line-height:1.12;letter-spacing:-.02em;margin:12px 0 18px;color:var(--ink)}.intro-body p{color:var(--text-muted);line-height:1.78;margin-bottom:14px}.intro-checks{list-style:none;padding:0;margin:22px 0 28px;display:grid;gap:10px}.intro-checks li{position:relative;padding-left:28px;font-size:.95rem;color:var(--ink)}.intro-checks li::before{content:"";position:absolute;left:0;top:.6em;width:8px;height:8px;border-radius:50%;background:var(--gold-ink);box-shadow:0 0 0 5px rgba(201,169,97,.12)}
  .zones-grid-god{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.zone-item-god{display:flex;align-items:center;gap:12px;padding:16px 18px;background:var(--white);border:var(--hairline-ink);border-radius:var(--r-md)}.zone-item-god svg{color:var(--gold-ink)}
  .testimonials-grid-god{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}.testimonial-card-god{background:var(--white);border:var(--hairline-ink);border-radius:var(--r-md);padding:32px 26px;box-shadow:var(--e-1);margin:0}.stars-god{color:var(--gold-ink);letter-spacing:3px;margin-bottom:14px}.testimonial-card-god blockquote{font-style:italic;color:var(--ink);line-height:1.7;margin:0 0 18px;font-size:.98rem}.testimonial-card-god figcaption strong{display:block;font-size:.92rem}.testimonial-card-god figcaption span{font-size:.82rem;color:var(--text-muted)}
  @media(max-width:1024px){.zones-grid-god,.testimonials-grid-god{grid-template-columns:repeat(2,1fr)}.intro-grid{grid-template-columns:1fr}}
  @media(max-width:640px){.zones-grid-god,.testimonials-grid-god{grid-template-columns:1fr}}
</style>
<script>
  (() => {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const targets = document.querySelectorAll('[data-reveal]');
    if (reduce || !('IntersectionObserver' in window)) { targets.forEach(el => el.classList.add('is-revealed')); return; }
    const io = new IntersectionObserver((entries) => {
      entries.forEach((entry) => { if (!entry.isIntersecting) return; entry.target.classList.add('is-revealed','god-reveal'); io.unobserve(entry.target); });
    }, { rootMargin: '0px 0px -10% 0px', threshold: 0.12 });
    targets.forEach(el => { el.classList.add('god-reveal'); io.observe(el); });
  })();
</script>
