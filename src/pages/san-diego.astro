---
import BaseLayout from '../layouts/BaseLayout.astro';
import FAQ from '../components/FAQ.astro';
import { getCollection } from 'astro:content';

const services = await getCollection('services');

const cityData = {
  name: "Caracas",
  state: "Distrito Capital",
  title: "Remodelaciones en Caracas | Expertos en Distrito Capital 2026",
  description: "Especialistas en remodelación de apartamentos, casas y oficinas en Caracas. Trabajamos en Chacao, Baruta, El Hatillo, Sucre y toda el área metropolitana. Presupuestos sin compromiso.",
  h1: "Remodelaciones en Caracas - Distrito Capital",
  intro: `¿Buscas expertos en **remodelaciones en Caracas**? En ReformaT Venezuela transformamos tu apartamento, casa u oficina en la capital con la más alta calidad y profesionalismo.

Con más de 15 años de experiencia en el **Distrito Capital**, conocemos las particularidades de los edificios caraqueños, las normativas de condominios y los mejores materiales para el clima de la ciudad.`,
  zones: [
    "Chacao (Altamira, Los Palos Grandes, Chuao)",
    "Baruta (El Cafetal, Las Mercedes, La Trinidad)",
    "El Hatillo (El Retorno, Barlovento)",
    "Sucre (Petare, Bello Monte, Los Caobos)",
    "Libertador (El Centro, La Candelaria, San Bernardino)",
    "El Ávila, Montalbán, El Paraíso, Los Chaguaramos"
  ],
  prices: {
    cocina: "Desde $1.800 USD",
    bano: "Desde $950 USD",
    integral: "Desde $150 USD/m²"
  },
  testimonials: [
    {
      name: "María Fernanda Torres",
      location: "Altamira, Chacao",
      text: "Excelente trabajo en mi apartamento de Altamira. Cumplieron con los tiempos y el acabado fue impecable. Totalmente recomendados."
    },
    {
      name: "Carlos Andrés Pérez",
      location: "Las Mercedes, Baruta",
      text: "Remodelaron mi oficina en Las Mercedes de manera profesional. El equipo fue muy respetuoso y limpio durante toda la obra."
    }
  ]
};
---

<BaseLayout
  title={cityData.title}
  description={cityData.description}
  image="/og-caracas.jpg"
  canonical={`https://reformat-venezuela.online/caracas`}
  schemaType="LocalBusiness"
>
  <main class="city-page">
    <!-- Hero Section -->
    <header class="article-hero">
      <div class="hero-bg" style="background-image: url('/images/remodelacion-cocina.webp')"></div>
      <div class="hero-overlay"></div>
      <div class="hero-content">
        <span class="article-category">Servicio Local</span>
        <h1 class="article-title"><span class="line">{cityData.h1}</span></h1>
        <p class="article-excerpt">Especialistas en remodelación de apartamentos, casas y oficinas en todo San Diego</p>
        <a href="/contacto" class="btn-premium btn-primary-premium">
          Solicitar Presupuesto Gratis
          <svg class="btn-arrow" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          <span class="btn-shine"></span>
        </a>
      </div>
    </header>

    <!-- Intro Section -->
    <section class="intro-section">
      <div class="container">
        <div class="content-grid">
          <div class="text-content">
            <h2>Expertos en Remodelaciones en Caracas</h2>
            <p set:html={cityData.intro}></p>
            
            <div class="trust-badges">
              <div class="badge">
                <span class="icon">✓</span>
                <span>Más de 15 años en Caracas</span>
              </div>
              <div class="badge">
                <span class="icon">✓</span>
                <span>Conocemos normativas de condominios</span>
              </div>
              <div class="badge">
                <span class="icon">✓</span>
                <span>Garantía por escrito</span>
              </div>
            </div>
          </div>
          <div class="image-content">
            <img 
              src="/images/remodelacion-cocina.webp" 
              alt="Remodelación de cocina en Caracas"
              loading="lazy"
              width="500"
              height="350"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Services Section -->
    <section class="services-section">
      <div class="container">
        <h2>Nuestros Servicios de Remodelación en Caracas</h2>
        <p class="section-subtitle">Soluciones integrales para apartamentos, casas y oficinas en el Distrito Capital</p>
        
        <div class="services-grid">
          {services.slice(0, 6).map((service) => (
            <div class="service-card bg-white rounded-xl shadow-lg overflow-hidden hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1">
              <div class="p-6">
                <h3 class="text-xl font-bold mb-3 text-gray-900">{service.data.title}</h3>
                <p class="text-gray-600 mb-4 leading-relaxed">{service.data.description}</p>
                <a href={`/servicios/${service.slug}`} class="inline-flex items-center text-primary font-semibold hover:text-primary/80 transition-colors">
                  Saber más
                  <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                  </svg>
                </a>
              </div>
            </div>
          ))}
        </div>
        
        <div class="cta-center">
          <a href="/servicios" class="btn btn-secondary">Ver Todos los Servicios</a>
        </div>
      </div>
    </section>

    <!-- Zones Section -->
    <section class="zones-section">
      <div class="container">
        <h2>Zonas que Atendemos en Caracas</h2>
        <p class="section-subtitle">Llegamos a todos los municipios del Distrito Capital y área metropolitana</p>
        
        <div class="zones-grid">
          {cityData.zones.map((zone) => (
            <div class="zone-card">
              <span class="icon">📍</span>
              <span>{zone}</span>
            </div>
          ))}
        </div>
        
        <div class="info-box">
          <h3>¿Trabajas en otros municipios de Caracas?</h3>
          <p>Sí, atendemos todas las parroquias del Distrito Capital y municipios adyacentes como Petare, Catia, El Valle, Antímano, Caricuao, etc. ¡Consúltanos!</p>
        </div>
      </div>
    </section>

    <!-- Pricing Section -->
    <section class="pricing-section">
      <div class="container">
        <h2>Precios de Remodelación en Caracas 2026</h2>
        <p class="section-subtitle">Precios referenciales en dólares americanos (USD)</p>
        
        <div class="pricing-grid">
          <div class="price-card">
            <h3>Remodelación de Cocina</h3>
            <div class="price">{cityData.prices.cocina}</div>
            <ul>
              <li>Diseño 3D incluido</li>
              <li>Gabinetes a medida</li>
              <li>Instalación de granito o cuarzo</li>
              <li>Plomería y electricidad básica</li>
            </ul>
          </div>
          
          <div class="price-card featured">
            <div class="badge-popular">Más Popular</div>
            <h3>Remodelación de Baño</h3>
            <div class="price">{cityData.prices.bano}</div>
            <ul>
              <li>Demolición incluida</li>
              <li>Porcelanato antideslizante</li>
              <li>Sanitarios modernos</li>
              <li>Duchas de vidrio templado</li>
            </ul>
          </div>
          
          <div class="price-card">
            <h3>Remodelación Integral</h3>
            <div class="price">{cityData.prices.integral}</div>
            <ul>
              <li>Proyectos desde 30m²</li>
              <li>Llave en mano</li>
              <li>Supervisión constante</li>
              <li>Entrega en tiempo récord</li>
            </ul>
          </div>
        </div>
        
        <div class="pricing-note">
          <p><strong>Nota:</strong> Precios sujetos a evaluación previa. Aceptamos pagos en efectivo (USD), transferencia bancaria, Zelle y Pago Móvil al cambio del BCV.</p>
        </div>
      </div>
    </section>

    <!-- Testimonials Section -->
    <section class="testimonials-section">
      <div class="container">
        <h2>Lo Que Dicen Nuestros Clientes en Caracas</h2>
        
        <div class="testimonials-grid">
          {cityData.testimonials.map((testimonial) => (
            <div class="testimonial-card">
              <div class="stars">★★★★★</div>
              <p class="text">"{testimonial.text}"</p>
              <div class="author">
                <strong>{testimonial.name}</strong>
                <span>{testimonial.location}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="faq-section">
      <div class="container">
        <h2>Preguntas Frecuentes sobre Remodelaciones en Caracas</h2>
        
        <FAQ items={[
          { 
            question: "¿Cuánto tiempo tarda una remodelación en Caracas?", 
            answer: "Depende del tipo de proyecto. Una cocina o baño toma entre 2-4 semanas. Una remodelación integral de apartamento puede tomar 6-12 semanas. Siempre entregamos cronograma detallado." 
          },
          { 
            question: "¿Trabajan con permisos de condominios en Caracas?", 
            answer: "Sí, gestionamos todos los permisos requeridos por tu condominio. Conocemos las normativas de los principales edificios de Chacao, Baruta y otras zonas de Caracas." 
          },
          { 
            question: "¿Qué formas de pago aceptan en Venezuela?", 
            answer: "Aceptamos pagos en efectivo (USD), transferencia bancaria en bolívares al cambio BCV, Zelle, PayPal y Pago Móvil. Ofrecemos facilidades de pago según el proyecto." 
          },
          { 
            question: "¿Dan garantía por el trabajo realizado?", 
            answer: "Sí, todos nuestros trabajos cuentan con garantía por escrito de 12 meses en acabados y 24 meses en instalaciones eléctricas e hidrosanitarias." 
          },
          { 
            question: "¿El presupuesto es gratuito?", 
            answer: "Sí, realizamos visitas técnicas sin costo en todo Caracas y ofrecemos presupuestos detallados sin compromiso de contratación." 
          }
        ]} />
      </div>
    </section>

    <!-- CTA Final -->
    <section class="cta-final">
      <div class="container">
        <h2>¿Listo para Transformar tu Espacio en Caracas?</h2>
        <p>Solicita tu presupuesto gratuito hoy mismo y recibe asesoría personalizada</p>
        <div class="cta-buttons">
          <a href="/contacto" class="btn btn-primary">Solicitar Presupuesto</a>
          <a href="https://wa.me/584123456789" class="btn btn-whatsapp">
            <span class="icon">💬</span>
            Contactar por WhatsApp
          </a>
        </div>
      </div>
    </section>
  </main>

  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "HomeAndConstructionBusiness",
      "name": "ReformaT Venezuela - Caracas",
      "description": "Especialistas en remodelaciones en Caracas y Distrito Capital. Cocinas, baños, reformas integrales y más.",
      "url": "https://reformat-venezuela.online/caracas",
      "telephone": "+58-412-345-6789",
      "areaServed": {
        "@type": "City",
        "name": "Caracas",
        "containedInPlace": {
          "@type": "AdministrativeArea",
          "name": "Distrito Capital"
        }
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": "10.4806",
        "longitude": "-66.9036"
      },
      "openingHoursSpecification": {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
        "opens": "08:00",
        "closes": "17:00"
      },
      "priceRange": "$$"
    }
  </script>
</BaseLayout>

<style>
  .city-page {
    padding-top: 0;
  }
  
  /* Hero section uses global article-hero styles */
    background: linear-gradient(135deg, var(--dark-blue) 0%, var(--navy) 100%);
    color: white;
    padding: 100px 0 80px;
    text-align: center;
  }
  
  
    font-size: 3rem;
    margin-bottom: 20px;
    font-weight: 700;
  }
  
  
    font-size: 1.3rem;
    margin-bottom: 30px;
    opacity: 0.95;
  }
  
  .intro-section,
  .services-section,
  .zones-section,
  .pricing-section,
  .testimonials-section,
  .faq-section {
    padding: 80px 0;
  }
  
  .content-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 50px;
    align-items: center;
  }
  
  .image-content img {
    width: 100%;
    height: auto;
    border-radius: 12px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.15);
  }
  
  .trust-badges {
    display: flex;
    gap: 20px;
    margin-top: 30px;
    flex-wrap: wrap;
  }
  
  .badge {
    display: flex;
    align-items: center;
    gap: 10px;
    background: #f8f9fa;
    padding: 12px 20px;
    border-radius: 8px;
    font-weight: 500;
  }
  
  .badge .icon {
    color: #27ae60;
    font-size: 1.2rem;
    font-weight: bold;
  }
  
  .zones-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 15px;
    margin-top: 40px;
  }
  
  .zone-card {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 15px 20px;
    background: #f8f9fa;
    border-radius: 8px;
    transition: transform 0.3s ease;
  }
  
  .zone-card:hover {
    transform: translateY(-3px);
    background: #e9ecef;
  }
  
  .zone-card .icon {
    font-size: 1.3rem;
  }
  
  .info-box {
    background: linear-gradient(135deg, var(--gold) 0%, #764ba2 100%);
    color: white;
    padding: 30px;
    border-radius: 12px;
    margin-top: 40px;
    text-align: center;
  }
  
  .info-box h3 {
    margin-bottom: 15px;
    font-size: 1.4rem;
  }
  
  .pricing-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 30px;
    margin-top: 40px;
  }
  
  .price-card {
    background: white;
    padding: 35px;
    border-radius: 12px;
    box-shadow: 0 5px 20px rgba(0,0,0,0.08);
    position: relative;
    border: 2px solid transparent;
    transition: all 0.3s ease;
  }
  
  .price-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 30px rgba(0,0,0,0.15);
  }
  
  .price-card.featured {
    border-color: var(--gold);
    transform: scale(1.05);
  }
  
  .badge-popular {
    position: absolute;
    top: -12px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--gold);
    color: white;
    padding: 6px 20px;
    border-radius: 20px;
    font-size: 0.85rem;
    font-weight: 600;
  }
  
  .price-card h3 {
    font-size: 1.4rem;
    margin-bottom: 15px;
    color: var(--dark-blue);
  }
  
  .price {
    font-size: 2rem;
    font-weight: 700;
    color: var(--gold);
    margin-bottom: 20px;
  }
  
  .price-card ul {
    list-style: none;
    padding: 0;
  }
  
  .price-card li {
    padding: 10px 0;
    border-bottom: 1px solid #eee;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  
  .price-card li:last-child {
    border-bottom: none;
  }
  
  .price-card li::before {
    content: "✓";
    color: #27ae60;
    font-weight: bold;
  }
  
  .pricing-note {
    background: #fff3cd;
    border-left: 4px solid #ffc107;
    padding: 20px;
    margin-top: 30px;
    border-radius: 8px;
  }
  
  .testimonials-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 30px;
    margin-top: 40px;
  }
  
  .testimonial-card {
    background: white;
    padding: 30px;
    border-radius: 12px;
    box-shadow: 0 5px 20px rgba(0,0,0,0.08);
  }
  
  .stars {
    color: #ffc107;
    font-size: 1.3rem;
    margin-bottom: 15px;
  }
  
  .testimonial-card .text {
    font-style: italic;
    color: #555;
    margin-bottom: 20px;
    line-height: 1.6;
  }
  
  .testimonial-card .author {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }
  
  .testimonial-card .author strong {
    color: var(--dark-blue);
  }
  
  .testimonial-card .author span {
    color: #888;
    font-size: 0.9rem;
  }
  
  .cta-final {
    background: linear-gradient(135deg, var(--dark-blue) 0%, var(--navy) 100%);
    color: white;
    padding: 80px 0;
    text-align: center;
  }
  
  .cta-final h2 {
    font-size: 2.5rem;
    margin-bottom: 20px;
  }
  
  .cta-final p {
    font-size: 1.2rem;
    margin-bottom: 30px;
    opacity: 0.95;
  }
  
  .cta-buttons {
    display: flex;
    gap: 20px;
    justify-content: center;
    flex-wrap: wrap;
  }
  
  .btn-whatsapp {
    background: #25D366;
    color: white;
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }
  
  .btn-whatsapp:hover {
    background: #20bd5a;
  }
  
  @media (max-width: 768px) {
    
      font-size: 2.2rem;
    }

    .content-grid {
      grid-template-columns: 1fr;
      gap: 30px;
    }

    .price-card.featured {
      transform: none;
    }

    .cta-buttons {
      flex-direction: column;
      align-items: center;
    }
    
    .services-grid {
      grid-template-columns: 1fr;
    }
    
    .pricing-grid {
      grid-template-columns: 1fr;
    }
    
    .testimonials-grid {
      grid-template-columns: 1fr;
    }
  }
  
  /* Botones - Estilos completos */
  .btn {
    display: inline-block;
    padding: 14px 32px;
    border-radius: 8px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.3s ease;
    cursor: pointer;
    border: none;
    font-size: 1rem;
    text-align: center;
  }
  
  .btn-primary {
    background: linear-gradient(135deg, var(--gold) 0%, #764ba2 100%);
    color: white;
    box-shadow: 0 4px 15px rgba(102, 126, 234, 0.4);
  }
  
  .btn-primary:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 25px rgba(102, 126, 234, 0.6);
  }
  
  .btn-secondary {
    background: transparent;
    color: var(--gold);
    border: 2px solid var(--gold);
  }
  
  .btn-secondary:hover {
    background: var(--gold);
    color: white;
    transform: translateY(-3px);
  }
  
  .btn-whatsapp {
    background: #25D366;
    color: white;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    box-shadow: 0 4px 15px rgba(37, 211, 102, 0.4);
  }
  
  .btn-whatsapp:hover {
    background: #20bd5a;
    transform: translateY(-3px);
    box-shadow: 0 8px 25px rgba(37, 211, 102, 0.6);
  }
  
  /* Services Grid */
  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 30px;
    margin-top: 40px;
  }
  
  .service-card {
    background: white;
    border-radius: 12px;
    box-shadow: 0 5px 20px rgba(0,0,0,0.08);
    transition: all 0.3s ease;
  }
  
  .service-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 30px rgba(0,0,0,0.15);
  }
  
  /* CTA Center */
  .cta-center {
    text-align: center;
    margin-top: 50px;
  }
  
  /* Section Subtitle */
  .section-subtitle {
    color: #666;
    font-size: 1.1rem;
    max-width: 700px;
    margin: 0 auto 40px;
    text-align: center;
  }
</style>
