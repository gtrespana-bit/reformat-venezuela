---
import BaseLayout from '../layouts/BaseLayout.astro';
import GodHero from '../components/GodHero.astro';
import GodMarquee from '../components/GodMarquee.astro';
import GuaranteeMatrix from '../components/GuaranteeMatrix.astro';

const getSrcSet = (baseName: string, widths: number[], ext = 'webp') => {
  return widths.map(w => `/images/${baseName}-${w}.${ext} ${w}w`).join(', ');
};
---

<BaseLayout
  title="Sobre RemodelaT | Remodelaciones de Lujo con Método Técnico"
  description="RemodelaT aplica experiencia europea y método técnico en remodelaciones residenciales de alto estándar en Venezuela: materiales adecuados, acabados de lujo…"
  activePage="nosotros"
>

<GodHero
  eyebrow="Sobre Nosotros · Desde 2003"
  title="Experiencia europea,"
  titleGold="ejecución sin improvisación"
  lead="Más de 23 años aplicados a remodelaciones residenciales de alto estándar en Venezuela: método técnico, materiales adecuados, supervisión directa y acabados de lujo."
  image="/images/integrales-800.webp"
  imageAlt="Reforma integral con estándares europeos"
  badges={["23+ años", "Método técnico", "Garantía escrita"]}
  watermark="REMODELAT"
  />

<GodMarquee />

<section class="story-section-god" data-reveal>
  <div class="container story-grid-god">
    <div class="story-text-god">
      <span class="eyebrow-god on-light">Nuestra Historia</span>
      <h2>De España a Venezuela:<br/>un estándar de trabajo claro</h2>
      <p>RemodelaT nació en España como una empresa especializada en remodelaciones integrales de alta calidad. Durante más de dos décadas construimos una forma de trabajar basada en precisión, planificación, cumplimiento y acabados impecables.</p>
      <p>En cualquier mercado existen distintos niveles de ejecución. Nosotros decidimos trabajar bajo un método claro: diagnóstico técnico, especificación correcta de materiales, supervisión directa, pruebas antes de cerrar y garantía documentada.</p>
      <p>Hoy operamos en <strong>Valencia, San Diego, Carabobo y Caracas</strong>, adaptando técnicas avanzadas de construcción europea a la arquitectura local.</p>
    </div>
    <div class="story-media-god">
      <img src="/images/cocina-800.webp" alt="Cocina reformada con acabados europeos" width="600" height="450" loading="lazy" />
      <div class="story-badge-god">
        <strong>23+</strong><span>Años de<br/>Experiencia</span>
      </div>
    </div>
  </div>
</section>

<section class="difference-god" data-reveal>
  <div class="container">
    <div class="section-header">
      <span class="eyebrow-god">Por Qué Elegirnos</span>
      <h2>Un estándar pensado para propietarios exigentes</h2>
      <p>Trabajamos con método, materiales compatibles, supervisión y garantía. Esa es la base de una remodelación que se mantiene impecable con el tiempo.</p>
    </div>
    <div class="diff-grid-god">
      <div class="diff-card-god"><div class="diff-icon-god">◈</div><h3>Materiales especificados</h3><p>Cada adhesivo, impermeabilizante, tubería o sellado se elige según soporte, uso, formato y exposición.</p></div>
      <div class="diff-card-god"><div class="diff-icon-god">◑</div><h3>Planificación realista</h3><p>Alcance definido y cronograma razonado. Planificar bien antes que prometer plazos irreales.</p></div>
      <div class="diff-card-god"><div class="diff-icon-god">⬙</div><h3>Presupuesto por partidas</h3><p>Materiales, mano de obra, alcance, exclusiones, tiempos y garantía sin partidas ambiguas.</p></div>
      <div class="diff-card-god"><div class="diff-icon-god">✦</div><h3>Acabados verificables</h3><p>Porcelanato XL, grifería premium y carpintería a medida solo valen si las juntas, cortes y nivelación son precisos.</p></div>
    </div>
  </div>
</section>

<section class="gallery-god" data-reveal>
  <div class="container">
    <div class="section-header">
      <span class="eyebrow-god on-light">Nuestro Trabajo</span>
      <h2>Proyectos que hablan por nosotros</h2>
      <p>Acabados precisos, materiales adecuados y atención al detalle visible y oculto.</p>
    </div>
    <div class="gallery-grid-god">
      <div class="gallery-item-god large"><img src="/images/cocina.webp" srcset={getSrcSet('cocina', [400, 800])} sizes="50vw" alt="Cocina reformada" loading="lazy" /><div class="gallery-caption-god"><strong>Reforma de Cocina</strong><span>Diseño moderno con materiales premium</span></div></div>
      <div class="gallery-item-god"><img src="/images/bano-terminado-final.webp" alt="Baño" loading="lazy" /><div class="gallery-caption-god"><strong>Baño Completo</strong><span>Porcelanato XL y ducha walk-in</span></div></div>
      <div class="gallery-item-god"><img src="/images/cocina2.webp" alt="Cocina moderna" loading="lazy" /><div class="gallery-caption-god"><strong>Reforma Integral</strong><span>Transformación completa</span></div></div>
      <div class="gallery-item-god"><img src="/images/revestimiento-wall-panels.webp" alt="Wall panels" loading="lazy" /><div class="gallery-caption-god"><strong>Revestimientos</strong><span>Wall panels decorativos</span></div></div>
      <div class="gallery-item-god"><img src="/images/suelo-porcelanato.webp" alt="Suelo porcelanato" loading="lazy" /><div class="gallery-caption-god"><strong>Suelos Premium</strong><span>Porcelanato gran formato</span></div></div>
    </div>
  </div>
</section>

<section class="process-god" data-reveal>
  <div class="container">
    <div class="section-header">
      <span class="eyebrow-god on-light">Cómo Trabajamos</span>
      <h2>Nuestro Proceso</h2>
      <p>Metodología probada durante más de dos décadas y adaptada al mercado venezolano sin perder rigor técnico.</p>
    </div>
    <div class="process-steps-god">
      <div class="step-god"><span>01</span><div><h3>Diagnóstico técnico inicial</h3><p>Visitamos tu hogar, escuchamos necesidades, evaluamos espacio y condiciones existentes.</p></div></div>
      <div class="step-god"><span>02</span><div><h3>Diseño, especificación y presupuesto</h3><p>Propuesta, selección de materiales, presupuesto por partidas y cronograma definido.</p></div></div>
      <div class="step-god"><span>03</span><div><h3>Ejecución supervisada</h3><p>Supervisor dedicado, control de calidad en fases críticas y comunicación del avance.</p></div></div>
      <div class="step-god"><span>04</span><div><h3>Entrega verificada y garantía</h3><p>Inspección final conjunta, checklist de remates, limpieza y garantía por escrito.</p></div></div>
    </div>
  </div>
</section>

<section class="stats-god" data-reveal>
  <div class="container stats-grid-god">
    <div class="stat-god"><strong>23+</strong><span>Años de Experiencia</span></div>
    <div class="stat-god"><strong>500+</strong><span>Proyectos en España</span></div>
    <div class="stat-god"><strong>2</strong><span>Años en Venezuela</span></div>
    <div class="stat-god"><strong>100%</strong><span>Método técnico</span></div>
  </div>
</section>

<GuaranteeMatrix variant="light" />

<section class="god-cta">
  <div class="container cta-inner-god">
    <span class="eyebrow-god">Siguiente paso</span>
    <h2>¿Listo para una remodelación con alto estándar?</h2>
    <p>Solicita una valoración técnica. Analizaremos tu espacio, el alcance deseado y el nivel de acabado antes de preparar una propuesta detallada.</p>
    <div class="cta-actions-home">
      <a href="/contacto" class="btn-premium btn-primary-premium"><span class="btn-content">Solicitar valoración técnica</span><span class="btn-arrow">→</span></a>
      <a rel="noopener" href="https://wa.me/584227997043" target="_blank" class="btn-premium btn-outline-premium"><span class="btn-content">WhatsApp Directo</span><span class="btn-arrow">→</span></a>
    </div>
  </div>
</section>

</BaseLayout>

<style>
  .container{max-width:1160px;margin:0 auto;padding:0 24px}.section-header{text-align:center;max-width:700px;margin:0 auto 52px}.section-header h2{font-family:var(--font-serif);font-size:clamp(1.9rem,3.6vw,2.8rem);font-weight:500;letter-spacing:-.02em;line-height:1.1;color:var(--ink);color:inherit;margin:12px 0 14px}.section-header p{color:var(--text-muted);line-height:1.7;font-size:1.05rem}
  .story-section-god{background:var(--white);padding:clamp(80px,8vw,110px) 24px}.story-grid-god{display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:center}.story-text-god h2{font-family:var(--font-serif);font-size:clamp(1.9rem,3.4vw,2.7rem);line-height:1.12;letter-spacing:-.02em;margin:14px 0 18px;color:var(--ink)}.story-text-god p{color:var(--text-muted);line-height:1.8;margin-bottom:14px;font-size:1.05rem}.story-media-god{position:relative;border-radius:var(--r-md);overflow:hidden;border:var(--hairline);box-shadow:var(--e-3)}.story-media-god img{width:100%;height:460px;object-fit:cover}.story-badge-god{position:absolute;bottom:18px;right:18px;background:var(--gold);color:var(--ink);padding:14px 18px;border-radius:var(--r-sm);display:flex;align-items:center;gap:10px;box-shadow:var(--e-2)}.story-badge-god strong{font-family:var(--font-serif);font-size:1.9rem;line-height:1}.story-badge-god span{font-size:.72rem;font-weight:700;text-transform:uppercase;line-height:1.2}

  .difference-god{background:var(--ink);padding:clamp(80px,8vw,110px) 24px;border-top:var(--hairline);border-bottom:var(--hairline)}.difference-god .section-header h2{color:var(--white)}.difference-god .section-header p{color:rgba(255,255,255,.68)}.diff-grid-god{display:grid;grid-template-columns:repeat(2,1fr);gap:20px}.diff-card-god{background:rgba(255,255,255,.045);border:var(--hairline);border-radius:var(--r-md);padding:34px 28px;transition:all .32s var(--ease-out)}.diff-card-god:hover{border-color:rgba(201,169,97,.38);transform:translateY(-4px)}.diff-icon-god{color:var(--gold);font-size:1.3rem;margin-bottom:14px}.diff-card-god h3{color:var(--white);font-family:var(--font-serif);font-size:1.25rem;margin-bottom:8px}.diff-card-god p{color:rgba(255,255,255,.66);font-size:.94rem;line-height:1.65}

  .gallery-god{background:var(--bone);padding:clamp(80px,8vw,110px) 24px}.gallery-grid-god{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.gallery-item-god{position:relative;border-radius:var(--r-md);overflow:hidden;aspect-ratio:4/3;background:var(--ink);border:var(--hairline-ink)}.gallery-item-god.large{grid-column:span 2;grid-row:span 2;aspect-ratio:auto}.gallery-item-god img{width:100%;height:100%;object-fit:cover;transition:transform var(--dur-god) var(--ease-god)}.gallery-item-god:hover img{transform:scale(1.06)}.gallery-caption-god{position:absolute;bottom:0;left:0;right:0;padding:24px 20px 16px;background:linear-gradient(transparent, rgba(0,0,0,.82));color:var(--white);opacity:0;transform:translateY(8px);transition:all .32s}.gallery-item-god:hover .gallery-caption-god{opacity:1;transform:none}.gallery-caption-god strong{display:block;font-family:var(--font-serif);font-size:1.05rem}.gallery-caption-god span{font-size:.82rem;color:rgba(255,255,255,.72)}

  .process-god{background:var(--white);padding:clamp(80px,8vw,110px) 24px}.process-steps-god{display:flex;flex-direction:column;gap:16px;max-width:760px;margin:0 auto}.step-god{display:flex;gap:20px;background:var(--bone);border:var(--hairline-ink);border-radius:var(--r-md);padding:26px 28px;transition:border-color .3s}.step-god:hover{border-color:rgba(201,169,97,.38)}.step-god span{font-family:var(--font-serif);font-size:2rem;color:rgba(201,169,97,.62);line-height:1;min-width:52px}.step-god h3{font-size:1.05rem;font-weight:700;margin-bottom:6px;color:var(--ink)}.step-god p{font-size:.93rem;color:var(--text-muted);line-height:1.6;margin:0}

  .stats-god{background:var(--ink);padding:52px 24px;border-top:var(--hairline);border-bottom:var(--hairline)}.stats-grid-god{display:grid;grid-template-columns:repeat(4,1fr);gap:28px;text-align:center}.stat-god strong{font-family:var(--font-serif);font-size:clamp(2rem,4vw,2.8rem);color:var(--gold);line-height:1;display:block;margin-bottom:6px}.stat-god span{font-size:.78rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:rgba(255,255,255,.6)}

  .cta-inner-god{max-width:720px;margin:0 auto;text-align:center}.cta-inner-god h2{font-family:var(--font-serif);font-size:clamp(2rem,4vw,3rem);color:var(--white);line-height:1.08;margin:14px 0 16px;letter-spacing:-.02em}.cta-inner-god p{color:rgba(255,255,255,.72);line-height:1.7;margin-bottom:28px}.cta-actions-home{display:flex;gap:14px;justify-content:center;flex-wrap:wrap}

  @media(max-width:900px){.story-grid-god,.diff-grid-god,.gallery-grid-god{grid-template-columns:1fr;gap:24px}.gallery-item-god.large{grid-column:span 1;grid-row:auto;aspect-ratio:16/9}.stats-grid-god{grid-template-columns:repeat(2,1fr)}}
</style>

<script>
  (() => {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const targets = document.querySelectorAll('[data-reveal]');
    if (reduce || !('IntersectionObserver' in window)) { targets.forEach(el => el.classList.add('is-revealed')); return; }
    const io = new IntersectionObserver((entries) => {
      entries.forEach((entry) => { if (!entry.isIntersecting) return; entry.target.classList.add('is-revealed','god-reveal'); io.unobserve(entry.target); });
    }, { rootMargin: '0px 0px -10% 0px', threshold: 0.12 });
    targets.forEach(el => { el.classList.add('god-reveal'); io.observe(el); });
  })();
</script>
