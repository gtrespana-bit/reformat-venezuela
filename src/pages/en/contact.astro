---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GodHero from '../../components/GodHero.astro';
import GodMarquee from '../../components/GodMarquee.astro';
import GuaranteeMatrix from '../../components/GuaranteeMatrix.astro';
---

<BaseLayout
  title="Technical Assessment | Luxury Remodeling in Venezuela"
  description="Request a technical assessment for high-standard residential remodeling in Valencia, San Diego, Carabobo and Caracas. Proper materials, flawless finishes…"
  activePage="contact"
>
  <GodHero
    eyebrow="High-standard remodeling"
    title="Luxury remodeling"
    titleGold="with technical precision"
    lead="Request a technical assessment for high-standard residential remodeling in Valencia, San Diego, Carabobo and Caracas. Proper materials, flawless finishes and written warranties."
    image="/images/integrales-800.webp"
    imageAlt="Remodeling project"
    badges={["23+ years", "Technical Method", "Written Warranty"]}
    watermark="REMODELAT"
  />
  <GodMarquee />

  <section class="contact-prelude"><div class="container prelude-grid"><article><span>01</span><h2>Technical filter</h2><p>We review location, scope, property type and finish level before moving forward.</p></article><article><span>02</span><h2>Organized assessment</h2><p>We ask for useful information to prepare a serious proposal, not an improvised number.</p></article><article><span>03</span><h2>Documented warranty</h2><p>When the project moves forward, each scope is backed by clear warranty conditions.</p></article></div></section>

  <section class="section contact-premium-section">
    <div class="container contact-full-grid">
      <div class="contact-info-panel">
        <span class="panel-kicker">Private project assessment</span>
        <h2 class="section-title">Before estimating, we understand the project</h2>
        <p>The more information we have, the better we can guide you: area, property type, scope, approximate size, finish level and estimated start date.</p>
        <div class="contact-method-link"><a href="/en/our-method">Discover the RemodelaT Method <span>→</span></a></div>
        <div class="contact-detail"><h3>Coverage</h3><p>Valencia, San Diego, Carabobo and Caracas</p></div>
        <div class="contact-detail"><h3>Phone / WhatsApp</h3><p><a rel="noopener" href="https://wa.me/584227997043" class="gold-link">+58 422 799 7043</a></p></div>
        <div class="contact-detail"><h3>Business hours</h3><p>Monday to Friday: 8:00 AM - 6:00 PM</p></div>
      </div>

      <form class="contact-form-large" action="https://formsubmit.co/contacto@remodelat.net" method="POST">
        <div class="form-heading"><span>Technical form</span><h2>Assessment request</h2><p>Complete the key details. If you have photos, plans or finish references, you can send them by WhatsApp afterwards.</p></div>
        <input type="hidden" name="_subject" value="New technical assessment from English contact page">
        <input type="hidden" name="_captcha" value="false">
        <input type="text" name="_honey" style="display:none" tabindex="-1" autocomplete="off">
        <div class="form-row"><div class="form-group"><label for="name-en">Full name</label><input type="text" id="name-en" name="name" required placeholder="Your name" /></div><div class="form-group"><label for="phone-en">Phone</label><input type="tel" id="phone-en" name="phone" required placeholder="+58..." /></div></div>
        <div class="form-group"><label for="email-en">Email</label><input type="email" id="email-en" name="email" required placeholder="name@example.com" /></div>
        <div class="form-group"><label for="project-en">Project type</label><select id="project-en" name="project_type" required><option value="" disabled selected>Select one</option><option value="whole-home">Whole-home remodeling</option><option value="kitchen">Designer kitchen</option><option value="bathroom">Spa-style bathroom</option><option value="flooring-coverings">Flooring / wall coverings</option><option value="exteriors-pool">Exteriors / pool</option><option value="other">Other scope</option></select></div>
        <div class="form-row"><div class="form-group"><label for="area-en">Area / neighborhood</label><input type="text" id="area-en" name="area" required placeholder="e.g. La Lagunita, Guataparo, Altamira..." /></div><div class="form-group"><label for="property-en">Property type</label><select id="property-en" name="property_type" required><option value="" disabled selected>Select one</option><option value="house-quinta">House / quinta</option><option value="apartment">Apartment</option><option value="townhouse">Townhouse</option><option value="commercial">Commercial / office</option></select></div></div>
        <div class="form-row"><div class="form-group"><label for="finish-en">Desired finish level</label><select id="finish-en" name="finish_level" required><option value="" disabled selected>Select one</option><option value="high-standard">High standard</option><option value="luxury">Luxury</option><option value="signature">Custom / signature project</option></select></div><div class="form-group"><label for="start-en">Estimated start date</label><select id="start-en" name="estimated_start" required><option value="" disabled selected>Select one</option><option value="asap">As soon as possible</option><option value="1-3-months">1 to 3 months</option><option value="3-6-months">3 to 6 months</option><option value="evaluating">Still evaluating</option></select></div></div>
        <div class="form-group"><label for="investment-en">Estimated investment range</label><select id="investment-en" name="investment_range" required><option value="" disabled selected>Select one</option><option value="define-after-assessment">Prefer to define after assessment</option><option value="3000-8000">USD 3,000 – 8,000</option><option value="8000-20000">USD 8,000 – 20,000</option><option value="20000-50000">USD 20,000 – 50,000</option><option value="50000-plus">USD 50,000+</option></select></div>
        <div class="form-group"><label for="message-en">Project details</label><textarea id="message-en" name="message" rows="5" required placeholder="Describe scope, approximate size, desired materials, whether you have photos/plans and whether the property will be occupied during work..."></textarea></div>
        <button type="submit" class="btn-premium btn-primary-premium full-width"><span class="btn-content">Request technical assessment</span><span class="btn-border"></span><span class="btn-arrow">→</span></button>
      </form>
    </div>
  </section>

  <GuaranteeMatrix lang="en" compact eyebrow="Documented warranty" title="Before hiring, you will know what is covered and how it is supported" description="Warranty is not a marketing phrase: it is tied to specific scopes, installed materials, tests performed and use conditions." />
</BaseLayout>

<style>
  .hero-overlay{position:absolute;inset:0;background:linear-gradient(to bottom,rgba(0,0,0,.5),rgba(0,0,0,.74));z-index:2}.hero-content{position:relative;z-index:3;max-width:820px}.hero-tag{display:block;color:var(--gold);font-size:.9rem;text-transform:uppercase;letter-spacing:2px;margin-bottom:15px;font-weight:600}.page-title{font-family:var(--font-serif);font-size:clamp(2.5rem,6vw,4.7rem);font-weight:400;margin-bottom:20px}.page-subtitle{font-size:1.2rem;color:rgba(255,255,255,.9)}
  .contact-prelude{position:relative;z-index:4;margin-top:-54px;padding:0 20px}.prelude-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;overflow:hidden;border-radius:var(--r-lg);border:1px solid rgba(201,169,97,.28);background:rgba(201,169,97,.28);box-shadow:var(--e-3)}.prelude-grid article{background:rgba(255,255,255,.97);padding:28px 30px}.prelude-grid span{display:inline-block;font-family:var(--font-serif);font-size:2.1rem;line-height:1;color:rgba(201,169,97,.64);margin-bottom:12px}.prelude-grid h2{font-family:var(--font-serif);font-size:1.35rem;margin-bottom:8px;color:var(--ink)}.prelude-grid p{color:var(--text-muted);line-height:1.65;font-size:.94rem}
  .contact-premium-section{background:linear-gradient(90deg,var(--bone) 0%,var(--bone) 50%,var(--white) 50%,var(--white) 100%);padding-top:var(--s-6)}.contact-full-grid{display:grid;grid-template-columns:.82fr 1.18fr;gap:54px;align-items:start;max-width:1180px;margin:0 auto;padding:56px 20px 90px}.contact-info-panel{position:sticky;top:120px;padding:38px 34px;border-radius:var(--r-lg);background:var(--ink);color:var(--white);box-shadow:var(--e-3);border:1px solid rgba(201,169,97,.26)}.panel-kicker{display:inline-block;color:var(--gold);font-size:.75rem;font-weight:700;letter-spacing:.15em;text-transform:uppercase;margin-bottom:18px}.contact-info-panel h2{margin-bottom:22px;color:var(--white);font-size:clamp(2rem,4vw,3.05rem)}.contact-info-panel>p{color:rgba(255,255,255,.76);line-height:1.78;margin-bottom:28px}.contact-detail{margin-bottom:24px;padding-bottom:24px;border-bottom:1px solid rgba(255,255,255,.12)}.contact-detail:last-child{border-bottom:none}.contact-detail h3{font-size:1.02rem;margin-bottom:8px;color:var(--white)}.contact-detail p{color:rgba(255,255,255,.72);line-height:1.6}.gold-link{color:var(--gold);font-weight:700}.contact-method-link{margin:8px 0 28px}.contact-method-link a{display:inline-flex;gap:8px;color:var(--gold);font-weight:700;text-transform:uppercase;letter-spacing:.08em;font-size:.82rem}.contact-method-link span{transition:transform var(--dur-base) var(--ease-out)}.contact-method-link a:hover span{transform:translateX(5px)}
  .contact-form-large{background:var(--white);padding:clamp(28px,4vw,48px);border-radius:var(--r-lg);box-shadow:var(--e-3);border:1px solid var(--sand);position:relative;overflow:hidden}.contact-form-large::before{content:"";position:absolute;inset:0 0 auto;height:5px;background:linear-gradient(90deg,var(--gold),var(--gold-light),var(--gold))}.form-heading{margin-bottom:30px;padding-bottom:24px;border-bottom:1px solid var(--sand)}.form-heading span{display:inline-block;color:var(--gold-ink);font-size:.75rem;font-weight:800;letter-spacing:.15em;text-transform:uppercase;margin-bottom:10px}.form-heading h2{font-family:var(--font-serif);font-size:clamp(2rem,4vw,3rem);line-height:1.05;letter-spacing:var(--track-tight);font-weight:500;color:var(--ink);margin-bottom:12px}.form-heading p{color:var(--text-muted);line-height:1.7}.form-group{margin-bottom:25px}.form-group label{display:block;margin-bottom:8px;font-weight:700;color:var(--ink);font-size:.9rem}.contact-form-large input,.contact-form-large select,.contact-form-large textarea{width:100%;padding:16px;border:1px solid var(--sand);border-radius:var(--r-sm);font-size:1rem;background:var(--bone);transition:border-color var(--dur-fast) var(--ease-out),background var(--dur-fast) var(--ease-out),box-shadow var(--dur-fast) var(--ease-out)}.contact-form-large input:focus,.contact-form-large select:focus,.contact-form-large textarea:focus{outline:none;border-color:var(--gold);background:#fff;box-shadow:0 0 0 4px rgba(201,169,97,.12)}.form-row{display:grid;grid-template-columns:1fr 1fr;gap:20px}.full-width{width:100%;justify-content:center}
  @media(max-width:900px){.contact-full-grid{grid-template-columns:1fr;gap:40px}.contact-info-panel{order:2;position:static}.contact-form-large{order:1;padding:25px}.form-row{grid-template-columns:1fr}.contact-premium-section{background:var(--bone)}.prelude-grid{grid-template-columns:1fr;margin:0 20px}}
</style>
