          </div>
          <div class="price-card">
            <span class="price-label">Full Home Remodeling</span>
            <span class="price-value">From $15,000</span>
          </div>
          <div class="price-card">
            <span class="price-label">Interior Design</span>
            <span class="price-value">Free consultation</span>
          </div>
      </div>
      <p class="pricing-note">* Reference prices in USD. Do not include materials unless stated otherwise.</p>
