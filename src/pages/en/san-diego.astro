---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GodHero from '../../components/GodHero.astro';
import GodMarquee from '../../components/GodMarquee.astro';
import FAQ from '../../components/FAQ.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
---

<BaseLayout title="Remodeling in San Diego | Carabobo Experts 2026" description="Specialists in apartment, home and office remodeling in San Diego, La Esmeralda, El Morro and the entire San Diego municipality of Carabobo. Detailed project proposals." image="/images/cocina-isla-central.webp">

  <GodHero
    eyebrow="High-standard remodeling"
    title="Luxury remodeling"
    titleGold="with technical precision"
    lead="Specialists in apartment, home and office remodeling in San Diego, La Esmeralda, El Morro and the entire San Diego municipality of Carabobo. Detailed project proposals."
    image="/images/integrales-800.webp"
    imageAlt="Remodeling project"
    badges={["23+ years", "Technical Method", "Written Warranty"]}
    watermark="REMODELAT"
  />
  <GodMarquee />

  <Breadcrumb items={[
    { name: 'Home', url: '/en' },
    { name: "San Diego", url: "/en/san-diego" }
  ]} />

  <section class="section intro">
    <div class="container intro-grid">
      <div class="intro-media">
        <img src="/images/cocina-terminada-final.webp" alt="Remodeling project in San Diego" loading="lazy" />
      </div>
      <div class="intro-body">
        <span class="section-tag">Why RemodelaT</span>
        <h2>Remodeling experts in San Diego, Carabobo</h2>
        <p>At RemodelaT Venezuela we transform your apartment, home or office in San Diego with the highest quality and professionalism.</p>
        <p>With more than 23 years of experience in <strong>San Diego</strong>, we know the particularities of its gated communities and the best materials for family homes in the municipality.</p>
        <ul class="intro-checks">
          <li>Certified in-house crew, no subcontractors</li>
          <li>Fixed quote and guaranteed schedule</li>
          <li>Gated-community permit management</li>
          <li>Written warranty on all work</li>
        </ul>
        <a href="#contacto" class="btn btn-dark">Learn more about us</a>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="section-header">
        <span class="section-tag">Services</span>
        <h2>Complete remodeling solutions</h2>
        <p>From a single renovation to a turnkey project, we cover every stage to premium standards.</p>
        <a href="/en/services" class="btn btn-dark" style="margin-top: 28px;">View all services</a>
      </div>
      <div class="services-grid">
        <article class="service-card">
            <div class="service-icon">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
            </div>
            <h3>Kitchen Remodeling</h3>
            <p>Custom kitchens with modern design and full functionality.</p>
            <a href="/en/services/kitchens" class="card-link">
              View details
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
          </article>
        <article class="service-card">
            <div class="service-icon">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
            </div>
            <h3>Bathroom Remodeling</h3>
            <p>Wellness spaces with premium finishes, fully waterproofed.</p>
            <a href="/en/services/bathrooms" class="card-link">
              View details
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
          </article>
        <article class="service-card">
            <div class="service-icon">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
            </div>
            <h3>Full Home Remodeling</h3>
            <p>Complete turnkey transformations of homes and apartments.</p>
            <a href="/en/services/whole-home" class="card-link">
              View details
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
          </article>
        <article class="service-card">
            <div class="service-icon">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
            </div>
            <h3>Flooring Installation</h3>
            <p>Porcelain, ceramic, laminate and solid wood flooring.</p>
            <a href="/en/services/flooring" class="card-link">
              View details
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
          </article>
        <article class="service-card">
            <div class="service-icon">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
            </div>
            <h3>Plumbing</h3>
            <p>Professional plumbing and waterproofing solutions.</p>
            <a href="/en/services/plumbing" class="card-link">
              View details
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
          </article>
        <article class="service-card">
            <div class="service-icon">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
            </div>
            <h3>Electrical</h3>
            <p>Safe, modern electrical installations and upgrades.</p>
            <a href="/en/services/electrical" class="card-link">
              View details
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
          </article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="section-tag">Coverage</span>
        <h2>We serve the entire area</h2>
        <p>Our team travels to the main municipalities and neighborhoods of San Diego.</p>
      </div>
      <div class="zones-grid">
          <div class="zone-item">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            <span>La Esmeralda (Campo Solo, La Esmeralda Norte)</span>
          </div>
          <div class="zone-item">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            <span>El Morro (Urb. El Morro, La Cumaca)</span>
          </div>
          <div class="zone-item">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            <span>Valle de Oro (El Remanso, La Floresta)</span>
          </div>
          <div class="zone-item">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            <span>Los Jarales (El Carmen, San Diego Centro)</span>
          </div>
          <div class="zone-item">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            <span>La Lagunita (El Trébol, Las Mercedes)</span>
          </div>
          <div class="zone-item">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            <span>Yuma, El Socorro, La Coromoto</span>
          </div>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="section-header">
        <span class="section-tag">How we work</span>
        <h2>Our remodeling process in San Diego</h2>
        <p>Working in San Diego demands knowledge of its gated communities and their internal regulations. Our process is designed to minimize disruption and meet deadlines.</p>
      </div>
      <div class="zones-grid">
        <div class="zone-item"><strong>1. Initial technical assessment</strong><span>We assess the space, take measurements and listen to your goals.</span></div>
        <div class="zone-item"><strong>2. Fixed quote</strong><span>You receive a detailed quote in USD with materials, labor and schedule.</span></div>
        <div class="zone-item"><strong>3. Design & planning</strong><span>We define materials, finishes and dates. We coordinate permits where needed.</span></div>
        <div class="zone-item"><strong>4. Supervised execution</strong><span>Our in-house crew executes the work with daily supervision and progress reports.</span></div>
        <div class="zone-item"><strong>5. Handover & warranty</strong><span>We deliver clean and working, with a written warranty on all work.</span></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="section-tag">Why RemodelaT</span>
        <h2>Why choose us in San Diego, Carabobo</h2>
        <p>More than 23 years remodeling apartments, homes and offices in San Diego make us the trusted choice for residential and commercial projects in the municipality.</p>
      </div>
      <div class="intro-grid">
        <div class="intro-body">
          <ul class="intro-checks">
          <li>Gated-community permit and board management in La Esmeralda, El Morro and Valle de Oro</li>
          <li>Coordination of loading/unloading schedules with each community's administration</li>
          <li>In-house crew that travels across the entire San Diego municipality</li>
          <li>Knowledge of the facade and schedule rules of each gated community</li>
          <li>Fixed quote in USD with a guaranteed written schedule</li>
          </ul>
          <a href="#contacto" class="btn btn-dark">Request assessment in San Diego</a>
        </div>
        <div class="intro-body">
          <p>We serve La Esmeralda, El Morro, Valle de Oro, Los Jarales and the rest of San Diego, with travel included and no hidden costs. Every project is executed to high standards adapted to the construction reality of Carabobo.</p>
          <p>Our commitment is simple: <strong>fixed quote, guaranteed schedule and flawless finishes</strong>. That is how we have built our reputation in San Diego.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-dark">
    <div class="container">
      <div class="section-header section-header-light">
        <span class="section-tag">Investment</span>
        <h2>Transparent prices, no surprises</h2>
        <p>Every project is unique. These are our starting points; the final quote is set after an initial technical assessment.</p>
      </div>
      <div class="pricing-grid">
          <div class="price-card">
            <span class="price-label">Kitchen Remodeling</span>
            <span class="price-value">From $2,200</span>
          </div>
          <div class="price-card">
            <span class="price-label">Bathroom Remodeling</span>
            <span class="price-value">From $1,500</span>
          </div>
          <div class="price-card">
            <span class="price-label">Floors & Wall Finishes</span>
            <span class="price-value">From $30/m²</span>
          </div>
          <div class="price-card">
            <span class="price-label">Professional Painting</span>
            <span class="price-value">From $7/m²</span>
          </div>
          <div class="price-card">
            <span class="price-label">Full Home Remodeling</span>
            <span class="price-value">From $12,000</span>
          </div>
          <div class="price-card">
            <span class="price-label">Interior Design</span>
            <span class="price-value">Technical assessment</span>
          </div>
      </div>
      <p class="pricing-note">* Reference prices in USD. Do not include materials unless stated otherwise.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="section-tag">Testimonials</span>
        <h2>What our clients say</h2>
      </div>
      <div class="testimonials-grid">
        <figure class="testimonial-card">
            <div class="stars" aria-label="5 of 5 stars">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            </div>
            <blockquote>"They remodeled my entire house in La Esmeralda. The finish is impeccable and the team very professional. They exceeded my expectations."</blockquote>
            <figcaption>
              <strong>María Alejandra Rojas</strong>
              <span>La Esmeralda, San Diego</span>
            </figcaption>
          </figure>
        <figure class="testimonial-card">
            <div class="stars" aria-label="5 of 5 stars">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            </div>
            <blockquote>"Excellent work on my apartment kitchen in El Morro. They met the schedule and the agreed budget."</blockquote>
            <figcaption>
              <strong>José Gregorio Herrera</strong>
              <span>El Morro, San Diego</span>
            </figcaption>
          </figure>
        <figure class="testimonial-card">
            <div class="stars" aria-label="5 of 5 stars">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            </div>
            <blockquote>"They renovated the bathroom and floors of my house in Valle de Oro. Very attentive to every detail. Fully recommended."</blockquote>
            <figcaption>
              <strong>Carolina Medina</strong>
              <span>Valle de Oro, San Diego</span>
            </figcaption>
          </figure>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container container-narrow">
      <div class="section-header">
        <span class="section-tag">FAQ</span>
        <h2>Frequently asked questions</h2>
      </div>
      <FAQ items={[
    { question: "How long does a remodel take in San Diego?", answer: "It depends on the project type. A kitchen or bathroom takes 2-4 weeks. A full apartment remodel can take 6-12 weeks. We always deliver a detailed schedule." },
    { question: "Do you handle condominium permits in San Diego?", answer: "Yes, we manage all the permits required by your condominium. We know the rules of the main San Diego communities: La Esmeralda, El Morro, Valle de Oro, Los Jarales and more." },
    { question: "What payment methods do you accept in Venezuela?", answer: "We accept cash (USD), bank transfer in bolívars at the BCV rate, Zelle, PayPal and Pago Móvil. We offer payment plans depending on the project." },
    { question: "Do you give a warranty on the work?", answer: "Yes, all our work carries a written warranty of 12 months on finishes and 24 months on electrical and plumbing installations." },
    { question: "How does the technical assessment work?", answer: "Yes, we do initial technical assessments across all of San Diego and prepare detailed proposals after reviewing scope, area and finish level." }
  ]} title="Frequently Asked Questions" />
    </div>
  </section>

  <section class="cta" id="contacto">
    <img class="cta-bg" src="/images/cocina-terminada-final.webp" alt="Finished modern kitchen ready for handover in San Diego | RemodelaT" loading="lazy" decoding="async" />
    <div class="cta-overlay"></div>
    <div class="cta-content">
      <span class="section-tag section-tag-light">Take the first step</span>
      <h2>Ready to transform your space in San Diego?</h2>
      <p>Book an initial technical assessment. We assess your project, advise you on materials and prepare a detailed proposal after a technical assessment.</p>
      <div class="cta-actions">
        <a href="https://wa.me/584227997043?text=Hello%2C%20I%20want%20a%20technical%20assessment%20for%20my%20remodel%20in%20San%20Diego" class="btn btn-gold" target="_blank" rel="noopener">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          Direct WhatsApp
        </a>
        <a href="/en/contact" class="btn btn-outline-light">Contact form</a>
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "name": `RemodelaT Venezuela - San Diego`,
    "description": "Specialists in apartment, home and office remodeling in San Diego, La Esmeralda, El Morro and the entire San Diego municipality of Carabobo. Detailed project proposals.",
    "areaServed": { "@type": "City", "name": "San Diego" },
    "address": { "@type": "PostalAddress", "addressLocality": "San Diego", "addressRegion": "Carabobo", "addressCountry": "VE" },
    "priceRange": "$$",
    "openingHours": "Mo-Fr 08:00-17:00"
  })} />
</BaseLayout>

<style>
.hero { position: relative; min-height: 80vh; display: flex; align-items: center; justify-content: center; overflow: hidden; padding: 120px 24px 60px; }
.hero-bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: 1; }
