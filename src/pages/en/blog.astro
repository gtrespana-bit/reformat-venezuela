---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const englishSlugs = [
  'kitchen-remodel-cost-caracas-valencia-2026',
  'porcelain-tile-vs-ceramic-tile-guide',
  'budget-remodel-mistakes-avoid',
  'bathroom-remodels-caracas-carabobo-2026',
  'kitchen-design-trends-2026',
  'kitchen-remodel-before-after-case-study',
  'how-to-choose-remodeling-company-venezuela',
  'bathroom-remodel-cost-caracas',
  'how-long-full-remodel-takes',
  'remodeling-mistakes-premium-areas-caracas',
  'plumbing-prices-caracas',
  'how-to-detect-water-leaks',
  'flooring-guide-porcelain-marble-wood',
  'electrical-installation-prices-venezuela',
  'pool-maintenance-venezuela',
  'microcement-vs-paint-finishes',
  'remodel-permits-apartment-condominium',
  'interior-painting-prices-m2-venezuela',
  'apartment-remodeling-caracas',
  'full-home-remodel-what-it-includes',
  'stone-wood-wall-cladding-prices',
  'signs-electrical-rewiring-needed'
];

// Mapeo de slugs a imágenes locales -400 para cards
const cardImages = {
  'kitchen-remodel-cost-caracas-valencia-2026': '/images/cocina-400.webp',
  'porcelain-tile-vs-ceramic-tile-guide': '/images/revestimientos-400.webp',
  'budget-remodel-mistakes-avoid': '/images/integrales-400.webp',
  'bathroom-remodels-caracas-carabobo-2026': '/images/bano-400.webp',
  'kitchen-design-trends-2026': '/images/cocina-400.webp',
  'kitchen-remodel-before-after-case-study': '/images/cocina-400.webp',
  'how-to-choose-remodeling-company-venezuela': '/images/equipo-400.webp',
  'bathroom-remodel-cost-caracas': '/images/bano-400.webp',
  'how-long-full-remodel-takes': '/images/integrales-400.webp',
  'remodeling-mistakes-premium-areas-caracas': '/images/arquitectura-400.webp',
  'plumbing-prices-caracas': '/images/fontaneria-400.webp',
  'how-to-detect-water-leaks': '/images/fontaneria-400.webp',
  'flooring-guide-porcelain-marble-wood': '/images/suelo-porcelanato-400.webp',
  'electrical-installation-prices-venezuela': '/images/electricidad-400.webp',
  'pool-maintenance-venezuela': '/images/piscinas-400.webp',
  'microcement-vs-paint-finishes': '/images/pintura-400.webp',
  'remodel-permits-apartment-condominium': '/images/arquitectura-400.webp',
  'interior-painting-prices-m2-venezuela': '/images/pintura-400.webp',
  'apartment-remodeling-caracas': '/images/arquitectura-400.webp',
  'full-home-remodel-what-it-includes': '/images/integrales-400.webp',
  'stone-wood-wall-cladding-prices': '/images/revestimientos-400.webp',
  'signs-electrical-rewiring-needed': '/images/electricidad-400.webp'
};

const posts = await getCollection('blog');
const englishPosts = posts.filter(post => englishSlugs.includes(post.id));
const sortedPosts = englishPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="Blog | Home Remodeling Tips & Guides" description="Expert advice, trends, and practical guides for your remodeling project in Venezuela." activePage="blog">
  <header class="page-hero">
    <img
      src="/images/arquitectura-600.webp"
      alt="Home remodeling ideas and tips"
      fetchpriority="high"
      loading="eager"
      decoding="async"
      width="600"
      height="400"
      class="hero-lcp-img"
    />
    <div class="hero-overlay"></div>
    <div class="hero-content">
      <span class="hero-tag">Blog & Tips</span>
      <h1 class="page-title">Ideas for <span class="gold">Your Home</span></h1>
      <p class="page-subtitle">Practical tips, trends, and guides to help you with your remodeling project.</p>
    </div>
  </header>

  <section class="blog-section">
    <div class="container">
      <div class="blog-grid">
        {sortedPosts.map(article => (
          <a href={`/en/blog/${article.id}`} class="blog-card">
            <div class="blog-img">
              <img 
                src={cardImages[article.id] || article.data.image} 
                alt={article.data.title} 
                loading="lazy"
                width="400"
                height="267"
                decoding="async"
              />
              <span class="blog-category">{article.data.category}</span>
            </div>
            <div class="blog-content">
              <div class="blog-meta">
                <span>{article.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
                <span>• {article.data.readTime} read</span>
              </div>
              <h3>{article.data.title}</h3>
              <p>{article.data.excerpt}</p>
              <span class="blog-link">Read article →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="cta-section">
    <div class="cta-wrapper">
      <h2 class="cta-title">Ready to Transform Your Space?</h2>
      <p class="cta-text">Request a technical assessment and receive a detailed proposal according to scope and finish level.</p>
      <a href="/en/contact" class="btn-premium btn-primary-premium">
        <span class="btn-content">Request technical assessment</span>
        <span class="btn-border"></span>
        <span class="btn-shine"></span>
        <span class="btn-arrow">→</span>
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero-overlay { position: absolute; inset: 0; background: linear-gradient(to top, rgba(0,0,0,0.95) 0%, rgba(0,0,0,0.4) 60%, rgba(0,0,0,0.2) 100%); z-index: 2; }
  .hero-content { position: relative; z-index: 3; max-width: 900px; padding: 0 20px; }
  .hero-tag { display: inline-block; background: rgba(201,169,97,0.2); border: 1px solid var(--gold); color: var(--gold); padding: 8px 20px; border-radius: var(--r-full); font-size: 0.85rem; font-weight: 600; text-transform: uppercase; letter-spacing: 2px; margin-bottom: 25px; backdrop-filter: blur(10px); }
  .page-title { font-family: var(--font-serif); font-size: clamp(3rem, 7vw, 6rem); font-weight: 300; margin-bottom: 20px; line-height: 1; }
  .gold { color: var(--gold); }
  .page-subtitle { font-size: 1.4rem; color: rgba(255,255,255,0.85); max-width: 650px; margin: 0 auto; line-height: 1.6; font-weight: 300; }
  .blog-section { padding: 80px 0; background: var(--gray); }
  .blog-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 30px; }
  .blog-card { display: block; background: var(--white); border-radius: var(--r-md); overflow: hidden; box-shadow: var(--e-1); transition: 0.4s; text-decoration: none; color: inherit; }
  .blog-card:hover { transform: translateY(-8px); box-shadow: var(--e-3); }
  .blog-img { position: relative; height: 220px; overflow: hidden; }
  .blog-img img { width: 100%; height: 100%; object-fit: cover; transition: 0.6s; }
  .blog-card:hover .blog-img img { transform: scale(1.05); }
  .blog-category { position: absolute; top: 15px; left: 15px; background: var(--gold); color: var(--bg); padding: 5px 12px; border-radius: var(--r-lg); font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; }
  .blog-content { padding: 25px; }
  .blog-meta { font-size: 0.8rem; color: var(--gray-text); margin-bottom: 12px; display: flex; gap: 10px; }
  .blog-content h3 { font-family: var(--font-serif); font-size: 1.5rem; margin-bottom: 12px; line-height: 1.3; color: var(--text); }
  .blog-content p { color: var(--gray-text); font-size: 0.95rem; line-height: 1.6; margin-bottom: 20px; }
  .blog-link { color: var(--gold); font-weight: 600; font-size: 0.9rem; letter-spacing: 0.5px; }
  @media (max-width: 900px) { .blog-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) { .blog-grid { grid-template-columns: 1fr; } }
</style>