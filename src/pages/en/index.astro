---
import BaseLayout from '../../layouts/BaseLayout.astro';

const getSrcSet = (baseName, widths, ext = 'webp') => {
  return widths.map(w => `/images/${baseName}-${w}.${ext} ${w}w`).join(', ');
};

const serviceImages = {
  cocina: { src: '/images/cocina-800.webp', srcset: getSrcSet('cocina', [400, 800, 1600]) },
  bano: { src: '/images/bano-800.webp', srcset: getSrcSet('bano', [400, 800, 1600]) },
  electricidad: { src: '/images/electricidad-800.webp', srcset: getSrcSet('electricidad', [400, 800, 1600]) },
  fontaneria: { src: '/images/fontaneria-800.webp', srcset: getSrcSet('fontaneria', [400, 800, 1600]) },
  revestimientos: { src: '/images/revestimientos-800.webp', srcset: getSrcSet('revestimientos', [400, 800, 1600]) },
  sueloPorcelanato: { src: '/images/suelo-porcelanato-800.webp', srcset: getSrcSet('suelo-porcelanato', [400, 800, 1600]) },
  piscinas: { src: '/images/piscinas-800.webp', srcset: getSrcSet('piscinas', [400, 800, 1600]) },
  integrales: { src: '/images/integrales-800.webp', srcset: getSrcSet('integrales', [400, 800, 1600]) },
  pintura: { src: '/images/pintura-800.webp', srcset: getSrcSet('pintura', [400, 800, 1600]) }
};

const services = [
  { title: "Designer kitchening", desc: "Custom kitchens with technical lighting, durable hardware and finishes installed with precision.", image: serviceImages.cocina, link: "/en/services/kitchens" },
  { title: "Spa-style bathroom", desc: "Spa-style bathrooms with documented waterproofing, correct slopes and premium fixtures.", image: serviceImages.bano, link: "/en/services/bathrooms" },
  { title: "Whole-home remodelinging", desc: "Complete home transformations with planning, utility coordination and finish control.", image: serviceImages.integrales, link: "/en/services/whole-home" },
  { title: "Electrical Services", desc: "Electrical panels, wiring, protections and LED lighting integrated into remodels.", image: serviceImages.electricidad, link: "/en/services/electrical" },
  { title: "Plumbing Services", desc: "Pipe renewal, water points, drains, testing and quality fixtures.", image: serviceImages.fontaneria, link: "/en/services/plumbing" },
  { title: "Painting & Finishes", desc: "Surface preparation, microcement, paint systems and clean final finishes.", image: serviceImages.pintura, link: "/en/services/painting" },
  { title: "Wall Coverings", desc: "Porcelain tiles, wall panels, and premium surface treatments.", image: serviceImages.revestimientos, link: "/en/services/wall-coverings" },
  { title: "Flooring", desc: "Porcelain, wood, laminate and SPC installed with leveling and proper substrate preparation.", image: serviceImages.sueloPorcelanato, link: "/en/services/flooring" },
  { title: "Swimming Pools", desc: "Pool finishes, filtration, maintenance and exterior upgrades for high-value homes.", image: serviceImages.piscinas, link: "/en/services/pools" }
];

const stats = [
  { number: "23+", label: "Years of Experience" },
  { number: "4", label: "Cities Served" },
  { number: "100%", label: "Quality Commitment" },
  { number: "Fast", label: "Professional Execution" }
];
---

<BaseLayout
  title="Luxury Remodeling in Venezuela | RemodelaT"
  description="High-standard residential remodeling in Venezuela. Kitchens, bathrooms and whole-home remodels with technical method, proper materials, flawless finishes and written warranties."
  activePage="home"
>

  <header class="hero">
    <img
      src="/images/hero-lcp.webp"
      alt="Modern luxury home interior after renovation"
      fetchpriority="high"
      loading="eager"
      decoding="async"
      width="2400"
      height="1600"
      class="hero-lcp-img"
    />

    <script is:inline>
      (function() {
        var isMobile = window.innerWidth < 1024;
        var videoSrc = isMobile ? '/videos/hero-mobile.mp4' : '/videos/hero-desktop.mp4';
        var posterSrc = '/images/hero-lcp.webp';
        var style = 'position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; z-index: 1; pointer-events: none; opacity: 0; transition: opacity 1s ease-in-out;';
        document.write('<video id="hero-video" class="hero-video" autoplay muted loop playsinline preload="metadata" poster="' + posterSrc + '" src="' + videoSrc + '" onplaying="this.style.opacity=1" style="' + style + '"></video>');
      })();
    </script>

    <noscript>
      <video id="hero-video" class="hero-video" autoplay muted loop playsinline preload="metadata" poster="/images/hero-lcp.webp" src="/videos/hero-desktop.mp4" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; z-index: 1;"></video>
    </noscript>

    <div class="hero-overlay"></div>

    <div class="hero-content">
      <span class="hero-tag">High-standard residential remodeling</span>
      <h1 class="hero-title">
        <span class="line">Luxury remodeling</span>
        <span class="line gold">with technical precision</span>
      </h1>
      <p class="hero-sub">Kitchens, bathrooms and whole-home remodels for demanding homeowners: proper materials, supervised execution, flawless finishes and written warranties.</p>
      <div class="hero-btns">
        <a href="/en/contact" class="btn-premium btn-primary-premium">
          <span class="btn-content">Request technical assessment</span>
          <span class="btn-border"></span>
          <span class="btn-shine"></span>
          <span class="btn-arrow">→</span>
        </a>
        <a href="/en/services" class="btn-premium btn-outline-premium">
          <span class="btn-content">Explore services</span>
          <span class="btn-border"></span>
          <span class="btn-shine"></span>
          <span class="btn-arrow">→</span>
        </a>
      </div>
    </div>
  </header>

  <section class="stats-section">
    <div class="container stats-grid">
      {stats.map((s) => (
        <div class="stat-item">
          <div class="stat-num">{s.number}</div>
          <div class="stat-label">{s.label}</div>
        </div>
      ))}
    </div>
  </section>

  <section class="section method-strip">
    <div class="container method-strip-grid">
      <div>
        <span class="tag">The RemodelaT Method</span>
        <h2 class="section-title">We do not compete to be the cheapest. We compete to do it correctly.</h2>
      </div>
      <div>
        <p>A high-end remodel is not defined only by how it looks on handover day. It is defined by how it ages, how its hidden utilities perform and how its finishes resist daily use.</p>
        <a href="/en/our-method" class="method-link">Discover the RemodelaT Method <span>→</span></a>
      </div>
    </div>
  </section>

  <section class="section bg-light">
    <div class="container">
      <div class="section-header">
        <span class="tag">Our Services</span>
        <h2 class="section-title">Remodeling for homes where details matter</h2>
        <p class="section-desc">Whole-home projects, kitchens, bathrooms, flooring and coverings executed with planning, coordinated technical trades and finishes built to last.</p>
      </div>

      <div class="services-slider-wrapper">
        <button class="slider-btn slider-prev" aria-label="Previous service">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M15 18l-6-6 6-6"/>
          </svg>
        </button>

        <div class="services-slider">
          {services.map((svc, index) => (
            <a href={svc.link} class="service-card-slider">
              <div class="card-img-wrap">
                {typeof svc.image === 'object' ? (
                  <img
                    src={svc.image.src}
                    srcset={svc.image.srcset}
                    sizes="(max-width: 768px) 300px, 800px"
                    alt={svc.title}
                    loading={index === 0 ? "eager" : "lazy"}
                    fetchpriority={index === 0 ? "high" : "auto"}
                    decoding="async"
                    width="800"
                    height="533"
                  />
                ) : (
                  <img
                    src={svc.image}
                    alt={svc.title}
                    loading="lazy"
                    decoding="async"
                    width="800"
                    height="533"
                  />
                )}
                <div class="card-overlay"></div>
                <span class="card-icon" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg></span>
              </div>
              <div class="card-body">
                <h3>{svc.title}</h3>
                <p>{svc.desc}</p>
                <span class="card-link">Learn more <span class="arrow">→</span></span>
              </div>
            </a>
          ))}
        </div>

        <button class="slider-btn slider-next" aria-label="Next service">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M9 18l6-6-6-6"/>
          </svg>
        </button>
      </div>

      <div class="slider-dots"></div>
    </div>
  </section>

  <section class="section">
    <div class="container about-grid">
      <div class="about-imgs">
        <div class="img-box tall">
          <img
            src="/images/arquitectura-600.webp"
            srcset="/images/arquitectura-400.webp 400w, /images/arquitectura-600.webp 600w"
            sizes="(max-width: 768px) 400px, 600px"
            alt="Modern residential architecture"
            loading="lazy"
            decoding="async"
            width="600"
            height="800"
          />
        </div>
        <div class="img-box small">
          <img
            src="/images/equipo-600.webp"
            srcset="/images/equipo-400.webp 400w, /images/equipo-600.webp 600w"
            sizes="(max-width: 768px) 400px, 600px"
            alt="Professional remodeling team at work"
            loading="lazy"
            decoding="async"
            width="600"
            height="400"
          />
        </div>
      </div>
      <div class="about-text">
        <span class="tag">About Us</span>
        <h2 class="section-title">European experience,<br/>local execution without improvisation</h2>
        <p>RemodelaT was founded in Spain with over 23 years of remodeling experience. In Venezuela we work under a clear standard: technical diagnosis, proper material specification, direct supervision and documented warranties.</p>
        <ul class="check-list">
          <li>Whole-home remodeling with planning, site control and warranty</li>
          <li>Electrical and plumbing work tested before closing</li>
          <li>Custom designs with materials compatible with each use</li>
          <li>Final finishes reviewed with the property owner before handover</li>
        </ul>
        <a href="/en/our-method" class="btn-premium btn-primary-premium">
          <span class="btn-content">Discover our standard</span>
          <span class="btn-border"></span>
          <span class="btn-shine"></span>
          <span class="btn-arrow">→</span>
        </a>
      </div>
    </div>
  </section>

  <section class="cta-section">
    <div class="cta-wrapper">
      <h2 class="cta-title">Does your project require a flawless finish?</h2>
      <p class="cta-text">Send us your area, property type and desired finish level. We will review whether the project fits our standard and guide you through a technical assessment.</p>
      <a href="/en/contact" class="btn-premium btn-white-premium">
        <span class="btn-content">Request technical assessment</span>
        <span class="btn-border"></span>
        <span class="btn-shine"></span>
        <span class="btn-arrow">→</span>
      </a>
    </div>
  </section>

  <section class="section bg-light" id="quick-contact">
    <div class="container contact-grid">
      <div class="contact-info">
        <h2 class="section-title">Let's Talk About Your Project</h2>
        <p>We are here to listen, advise, and build alongside you. We serve the entire Caracas metropolitan area and key zones across Carabobo.</p>
        <div class="info-item">
          <h4>Location</h4>
          <p>Valencia, San Diego, Carabobo and Caracas</p>
        </div>
        <div class="info-item">
          <h4>Phone</h4>
          <p><a href="tel:+584227997043" style="color: var(--gold); text-decoration: none;">0422 799 7043</a></p>
        </div>
      </div>
      <form class="contact-form" action="https://formsubmit.co/contacto@remodelat.net" method="POST">
        <input type="hidden" name="_subject" value="New inquiry from English website">
        <input type="hidden" name="_captcha" value="false">
        <input type="text" name="_honey" style="display:none" tabindex="-1" autocomplete="off">

        <div class="form-row">
          <input type="text" id="nombre" name="nombre" placeholder="Full Name" required aria-label="Your full name" />
          <input type="tel" id="telefono" name="telefono" placeholder="Phone Number" required aria-label="Your phone number" />
        </div>
        <input type="email" id="email" name="email" placeholder="Email Address" required aria-label="Your email address" />
        <select id="proyecto" name="proyecto" required aria-label="Project type">
          <option value="" disabled selected>Project type</option>
          <option value="cocina">Designer kitchen</option>
          <option value="bano">Spa-style bathroom</option>
          <option value="integral">Whole-home remodeling</option>
          <option value="electricidad">Electrical Services</option>
          <option value="fontaneria">Plumbing Services</option>
        </select>
        <textarea id="mensaje" name="mensaje" placeholder="Tell us about your project" rows="4" required aria-label="Project details"></textarea>
        <button type="submit" class="btn-premium btn-primary-premium full-width">
          <span class="btn-content">Request technical assessment</span>
          <span class="btn-border"></span>
          <span class="btn-shine"></span>
          <span class="btn-arrow">→</span>
        </button>
      </form>
    </div>
  </section>

</BaseLayout>

<style>
  .hero { position: relative; width: 100%; min-height: 100vh; min-height: 100svh; overflow: hidden; background: #111 url('/images/hero-lcp.webp') center/cover no-repeat; display: flex; align-items: center; justify-content: center; text-align: center; color: var(--white); }
  .hero-lcp-img { position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; z-index: 0; }
  .hero-video { z-index: 1; }
  .hero-overlay { position: absolute; inset: 0; background: linear-gradient(to bottom, rgba(0,0,0,0.45), rgba(0,0,0,0.55) 50%, rgba(0,0,0,0.85)); z-index: 2; }
  .hero-content { position: relative; z-index: 3; max-width: 900px; padding: 100px 20px 0; }
  .hero-tag { display: block; font-size: 0.85rem; letter-spacing: 2.5px; text-transform: uppercase; color: var(--gold); margin-bottom: 12px; }
  .hero-title { font-family: var(--font-serif); font-size: clamp(2.8rem, 7vw, 6rem); font-weight: 400; margin-bottom: 18px; line-height: 1.05; }
  .hero-title .line { display: block; }
  .hero-title .gold { color: var(--gold); }
  .hero-sub { font-size: 1.15rem; color: rgba(255, 255, 255, 0.95); margin: 0 auto 28px; max-width: 600px; line-height: 1.55; }
  .hero-btns { display: flex; gap: 18px; justify-content: center; flex-wrap: wrap; }
  .btn-outline-premium { background: transparent; color: var(--white); border: 1px solid rgba(255,255,255,0.4); backdrop-filter: blur(5px); }
  .btn-outline-premium:hover { transform: translateY(-3px); border-color: var(--gold); color: var(--gold); }
  .btn-white-premium { background: var(--white); color: var(--bg); box-shadow: 0 4px 15px rgba(0,0,0,0.2); }
  .btn-white-premium .btn-border { border: 2px solid var(--white); }
  .btn-white-premium:hover { transform: translateY(-3px); background: var(--gold); box-shadow: 0 8px 30px rgba(201, 169, 97, 0.5); }
  .btn-white-premium:hover .btn-arrow { transform: translateX(8px); }
  .btn-white-premium:hover .btn-shine { left: 150%; }

  .section { padding: 100px 0; }
  .bg-light { background: var(--gray); }
  .section-header { text-align: center; max-width: 700px; margin: 0 auto 60px; }
  .section-title { font-family: var(--font-serif); font-size: clamp(2rem, 5vw, 3.5rem); margin-bottom: 20px; font-weight: 400; }
  .tag { display: inline-block; color: #8B6914; font-size: 0.85rem; letter-spacing: 2px; text-transform: uppercase; margin-bottom: 15px; font-weight: 600; }
  .section-desc { color: var(--gray-text); font-size: 1.1rem; line-height: 1.8; font-weight: 400; }


  .method-strip { background: var(--white); }
  .method-strip-grid { display: grid; grid-template-columns: .95fr 1.05fr; gap: var(--s-5); align-items: center; }
  .method-strip p { color: var(--text-muted); font-size: 1.06rem; line-height: 1.85; margin-bottom: 20px; }
  .method-link { color: var(--gold-ink-strong); font-weight: 800; text-transform: uppercase; letter-spacing: .08em; font-size: .82rem; }
  .method-link span { display: inline-block; transition: transform var(--dur-base) var(--ease-out); }
  .method-link:hover span { transform: translateX(5px); }

  .stats-section { padding: 60px 0; background: var(--bg); color: var(--white); }
  .stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 30px; text-align: center; }
  .stat-num { font-family: var(--font-serif); font-size: 3.5rem; color: var(--gold); line-height: 1; margin-bottom: 10px; font-weight: 400; }
  .stat-label { font-size: 0.9rem; text-transform: uppercase; letter-spacing: 1px; opacity: 0.8; }

  .services-slider-wrapper { position: relative; display: flex; align-items: center; gap: 20px; }
  .services-slider { display: flex; gap: 30px; overflow-x: auto; scroll-snap-type: x mandatory; scroll-behavior: smooth; -webkit-overflow-scrolling: touch; scrollbar-width: none; -ms-overflow-style: none; padding: 20px 10px; flex: 1; }
  .services-slider::-webkit-scrollbar { display: none; }
  .service-card-slider { flex: 0 0 calc(33.333% - 20px); min-width: 300px; display: block; background: var(--white); border-radius: var(--r-md); overflow: hidden; box-shadow: var(--e-1); transition: 0.4s; text-decoration: none; color: inherit; scroll-snap-align: start; }
  .service-card-slider:hover { transform: translateY(-10px); box-shadow: var(--e-3); }
  .card-img-wrap { position: relative; height: 280px; overflow: hidden; }
  .card-img-wrap img { width: 100%; height: 100%; object-fit: cover; transition: 0.6s; }
  .service-card-slider:hover .card-img-wrap img { transform: scale(1.08); }
  .card-overlay { position: absolute; inset: 0; background: linear-gradient(to top, rgba(0,0,0,0.4) 0%, transparent 50%); }
  .card-icon { position: absolute; bottom: 15px; right: 15px; width: 45px; height: 45px; background: var(--gold); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 1.2rem; color: var(--bg); transition: 0.4s; }
  .service-card-slider:hover .card-icon { transform: scale(1.15) rotate(15deg); }
  .card-body { padding: 30px 25px; }
  .card-body h3 { font-family: var(--font-serif); font-size: 1.5rem; margin-bottom: 12px; font-weight: 500; }
  .card-body p { color: var(--gray-text); font-size: 0.95rem; line-height: 1.7; margin-bottom: 20px; font-weight: 400; }
  .card-link { color: var(--gold-ink); font-weight: 600; font-size: 0.85rem; display: inline-flex; align-items: center; gap: 8px; }
  .arrow { transition: transform 0.3s; }
  .service-card-slider:hover .card-link { gap: 14px; }
  .service-card-slider:hover .card-link .arrow { transform: translateX(5px); }

  .slider-btn { flex-shrink: 0; width: 50px; height: 50px; border-radius: 50%; background: var(--white); border: 2px solid var(--gold); color: var(--gold); display: flex; align-items: center; justify-content: center; cursor: pointer; transition: all 0.3s; box-shadow: 0 4px 15px rgba(0,0,0,0.1); }
  .slider-btn:hover { background: var(--gold); color: var(--bg); transform: scale(1.1); }
  .slider-dots { display: flex; justify-content: center; gap: 10px; margin-top: 30px; }
  .slider-dot { width: 10px; height: 10px; border-radius: 50%; background: #ddd; cursor: pointer; transition: all 0.3s; }
  .slider-dot.active { background: var(--gold); width: 30px; border-radius: var(--r-sm); }

  .about-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: center; }
  .about-imgs { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  .img-box { border-radius: var(--r-sm); overflow: hidden; }
  .img-box.tall { grid-row: span 2; }
  .img-box img { width: 100%; height: 100%; object-fit: cover; }
  .check-list { margin: 30px 0; list-style: none; }
  .check-list li { margin-bottom: 15px; padding-left: 25px; position: relative; color: var(--gray-text); line-height: 1.6; font-weight: 400; }
  .check-list li::before { content: "✓"; position: absolute; left: 0; color: var(--gold); font-weight: bold; }

  .cta-section { background: var(--bg); color: var(--white); text-align: center; padding: 110px 24px; width: 100%; }
  .cta-wrapper { max-width: 950px; margin: 0 auto; display: flex; flex-direction: column; align-items: center; }
  .cta-title { font-family: var(--font-serif); font-size: clamp(2.4rem, 5vw, 3.6rem); font-weight: 400; margin-bottom: 24px; line-height: 1.15; color: var(--white); text-align: center; width: 100%; }
  .cta-text { color: rgba(255,255,255,0.85); max-width: 800px; margin: 0 auto 45px; font-size: 1.25rem; line-height: 1.7; font-weight: 400; text-align: center; width: 100%; }
  .cta-section .btn-premium { padding: 20px 55px; font-size: 0.9rem; }

  .contact-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 60px; }
  .info-item { margin-bottom: 25px; }
  .info-item h4 { font-size: 1rem; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 5px; font-weight: 600; }
  .info-item p { color: var(--gray-text); }
  .contact-form { background: var(--white); padding: 40px; border-radius: var(--r-md); box-shadow: var(--e-2); }
  .contact-form input, .contact-form select, .contact-form textarea { width: 100%; padding: 15px; margin-bottom: 20px; border: 1px solid #ddd; background: #f9f9f9; border-radius: var(--r-sm); font-family: inherit; font-size: 1rem; }
  .contact-form input:focus, .contact-form textarea:focus { outline: none; border-color: var(--gold); }
  .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  .full-width { width: 100%; justify-content: center; }

  @media (max-width: 1023px) {
    .hero-content { padding: 90px 20px 0; }
    .hero-tag{font-size:0.75rem;letter-spacing:2px;margin-bottom:10px;}
    .hero-title{font-size:clamp(2rem,9vw,3.2rem);margin-bottom:15px;line-height:1.08;}
    .hero-sub{font-size:1.05rem;margin-bottom:24px;padding:0 10px;line-height:1.5;}
    .hero-btns{flex-direction:column;align-items:center;gap:12px;width:100%;padding:0 20px;}
    .hero-btns .btn-premium{width:100%;max-width:280px;justify-content:center;}
  }
  @media (max-width: 900px) {
    .stats-grid{grid-template-columns:repeat(2,1fr);}
    .service-card-slider { flex: 0 0 calc(50% - 15px); min-width: 250px; }
    .method-strip-grid,.about-grid,.contact-grid{grid-template-columns:1fr;}
  }
  @media (max-width: 600px) {
    .service-card-slider { flex: 0 0 100%; min-width: min(280px, 100%); }
    .slider-btn { display: none; }
    .form-row { grid-template-columns: 1fr; gap: 0; }
    .contact-form { padding: 26px 20px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-video{display:none!important;}
    .hero{background:url('/images/hero-lcp.webp') center/cover no-repeat;}
  }

  /* Success Message Styles (Phase 4) */
  .form-success-message {
    background: var(--white);
    padding: 60px 40px;
    border-radius: var(--r-md);
    box-shadow: var(--e-2);
    text-align: center;
    border: 1px solid var(--sand);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    max-width: 550px;
    margin: 0 auto;
    animation: fadeIn var(--dur-base) var(--ease-out);
  }
  .success-icon-wrapper {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background: rgba(201, 169, 97, 0.1);
    color: var(--gold-ink-strong);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 25px;
  }
  .form-success-message h3 {
    font-family: var(--font-serif);
    font-size: 2rem;
    color: var(--ink);
    margin-bottom: 15px;
  }
  .form-success-message p {
    color: var(--text-muted);
    font-size: 1.05rem;
    line-height: 1.6;
    margin-bottom: 15px;
  }
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>

<script>
  /* Gentle scroll reveal.
     Respects prefers-reduced-motion and degrades gracefully if no JS/IO. */
  (() => {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const targets = document.querySelectorAll('[data-reveal]');
    if (reduce || !('IntersectionObserver' in window)) {
      targets.forEach((el) => el.classList.add('is-revealed'));
      return;
    }
    const io = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        entry.target.classList.add('is-revealed');
        io.unobserve(entry.target);
      });
    }, { rootMargin: '0px 0px -10% 0px', threshold: 0.1 });
    targets.forEach((el) => io.observe(el));
  })();

  // AJAX form submission (Phase 4)
  function initHomeForm() {
    const form = document.querySelector('.contact-form') as HTMLFormElement;
    if (!form) return;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const button = form.querySelector('button[type="submit"]') as HTMLButtonElement;
      const btnText = button?.querySelector('.btn-content') as HTMLElement;
      
      if (!button || !btnText) return;

      const originalText = btnText.textContent;
      btnText.textContent = 'Sending...';
      button.disabled = true;

      try {
        const formData = new FormData(form);
        const response = await fetch(form.action, {
          method: 'POST',
          body: formData,
          headers: {
            'Accept': 'application/json'
          }
        });

        if (response.ok) {
          const successDiv = document.createElement('div');
          successDiv.className = 'form-success-message';
          successDiv.innerHTML = `
            <div class="success-icon-wrapper">
              <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                <polyline points="22 4 12 14.01 9 11.01"></polyline>
              </svg>
            </div>
            <h3>Inquiry Sent!</h3>
            <p>Thank you for contacting us. One of our technical advisors will review your request and reach out to you within a maximum of 2 business hours.</p>
          `;
          form.replaceWith(successDiv);
        } else {
          throw new Error('Response not OK');
        }
      } catch (err) {
        alert('There was an error sending the form. Please try again or contact us directly via WhatsApp.');
        btnText.textContent = originalText;
        button.disabled = false;
      }
    });
  }

  initHomeForm();
  document.addEventListener('astro:page-load', initHomeForm);
</script>