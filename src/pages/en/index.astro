    .form-row { grid-template-columns: 1fr; gap: 0; }
    .contact-form { padding: 26px 20px; }
  }
  /* NOTE: the hero video is deliberately NOT hidden under prefers-reduced-motion.
     That rule dated from when the background photo was a different scene from
     the video. The hero is a near-static house shot, not a UI animation, and
     "reduced motion" is switched on by default by Windows/macOS energy saver and
     by phones in battery mode - plenty of users have it without knowing, and
     they were left with no video at all.
     If the footage ever gains sharp movement, pause it (video.pause()) rather
     than hiding it: the poster is already frame 0. */

  /* Success Message Styles (Phase 4) */
  .form-success-message {
    background: var(--white);
    padding: 60px 40px;
    border-radius: var(--r-md);
    box-shadow: var(--e-2);
    text-align: center;
    border: 1px solid var(--sand);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    max-width: 550px;
    margin: 0 auto;
    animation: fadeIn var(--dur-base) var(--ease-out);
  }
  .success-icon-wrapper {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background: rgba(201, 169, 97, 0.1);
    color: var(--gold-ink-strong);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 25px;
  }
  .form-success-message h3 {
    font-family: var(--font-serif);
    font-size: 2rem;
    color: var(--ink);
    margin-bottom: 15px;
  }
  .form-success-message p {
    color: var(--text-muted);
    font-size: 1.05rem;
    line-height: 1.6;
    margin-bottom: 15px;
  }
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>

<script>
  /* Gentle scroll reveal.
     Respects prefers-reduced-motion and degrades gracefully if no JS/IO. */
  (() => {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const targets = document.querySelectorAll('[data-reveal]');
    if (reduce || !('IntersectionObserver' in window)) {
      targets.forEach((el) => el.classList.add('is-revealed'));
      return;
    }
    const io = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        entry.target.classList.add('is-revealed');
        io.unobserve(entry.target);
      });
    }, { rootMargin: '0px 0px -10% 0px', threshold: 0.1 });
    targets.forEach((el) => io.observe(el));
  })();

  // AJAX form submission (Phase 4)
  function initHomeForm() {
    const form = document.querySelector('.contact-form') as HTMLFormElement;
    if (!form) return;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const button = form.querySelector('button[type="submit"]') as HTMLButtonElement;
      const btnText = button?.querySelector('.btn-content') as HTMLElement;
      
      if (!button || !btnText) return;

      const originalText = btnText.textContent;
      btnText.textContent = 'Sending...';
      button.disabled = true;

      try {
        const formData = new FormData(form);
        const response = await fetch(form.action, {
          method: 'POST',
          body: formData,
          headers: {
            'Accept': 'application/json'
          }
        });

        if (response.ok) {
          const successDiv = document.createElement('div');
          successDiv.className = 'form-success-message';
          successDiv.innerHTML = `
            <div class="success-icon-wrapper">
              <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                <polyline points="22 4 12 14.01 9 11.01"></polyline>
              </svg>
            </div>
            <h3>Inquiry Sent!</h3>
            <p>Thank you for contacting us. One of our technical advisors will review your request and reach out to you within a maximum of 2 business hours.</p>
          `;
          form.replaceWith(successDiv);
        } else {
          throw new Error('Response not OK');
        }
      } catch (err) {
        alert('There was an error sending the form. Please try again or contact us directly via WhatsApp.');
        btnText.textContent = originalText;
        button.disabled = false;
      }
    });
  }

  initHomeForm();
  document.addEventListener('astro:page-load', initHomeForm);
</script>