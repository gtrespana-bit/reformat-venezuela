---
import BaseLayout from '../../layouts/BaseLayout.astro';

const whatsappBudgetTextEn = 'Hello,%20I%20would%20like%20to%20request%20a%20technical%20assessment%20for%20my%20remodel.%20I%20can%20send%20photos%20and%20location%20here.';

const getSrcSet = (baseName, widths, ext = 'webp') => {
  return widths.map(w => `/images/${baseName}-${w}.${ext} ${w}w`).join(', ');
};

const serviceImages = {
  cocina: { src: '/images/cocina-800.webp', srcset: getSrcSet('cocina', [400, 800, 1600]) },
  bano: { src: '/images/bano-800.webp', srcset: getSrcSet('bano', [400, 800, 1600]) },
  electricidad: { src: '/images/electricidad-800.webp', srcset: getSrcSet('electricidad', [400, 800, 1600]) },
  fontaneria: { src: '/images/fontaneria-800.webp', srcset: getSrcSet('fontaneria', [400, 800, 1600]) },
  revestimientos: { src: '/images/revestimientos-800.webp', srcset: getSrcSet('revestimientos', [400, 800, 1600]) },
  sueloPorcelanato: { src: '/images/suelo-porcelanato-800.webp', srcset: getSrcSet('suelo-porcelanato', [400, 800, 1600]) },
  piscinas: { src: '/images/piscinas-800.webp', srcset: getSrcSet('piscinas', [400, 800, 1600]) },
  integrales: { src: '/images/integrales-800.webp', srcset: getSrcSet('integrales', [400, 800, 1600]) },
  pintura: { src: '/images/pintura-800.webp', srcset: getSrcSet('pintura', [400, 800, 1600]) }
};

const services = [
  { title: "Designer Kitchens", desc: "Custom cabinetry, high-resistance surfaces, technical lighting and durable hardware installed with precision.", image: serviceImages.cocina, link: "/en/services/kitchens" },
  { title: "Spa-Style Bathrooms", desc: "Bathrooms with documented waterproofing, correct slopes, premium fixtures and precise tile work.", image: serviceImages.bano, link: "/en/services/bathrooms" },
  { title: "Whole-Home Remodels", desc: "Complete home transformations with planning, trade coordination and controlled finishes.", image: serviceImages.integrales, link: "/en/services/whole-home" },
  { title: "Electrical Services", desc: "Electrical panels, wiring, protections and LED lighting integrated into remodels.", image: serviceImages.electricidad, link: "/en/services/electrical" },
  { title: "Plumbing Services", desc: "Pipe renewal, water points, drains, testing and quality fixtures.", image: serviceImages.fontaneria, link: "/en/services/plumbing" },
  { title: "Painting & Finishes", desc: "Surface preparation, microcement, paint systems and clean final finishes.", image: serviceImages.pintura, link: "/en/services/painting" },
  { title: "Wall Coverings", desc: "Porcelain tiles, wall panels, and premium surface treatments.", image: serviceImages.revestimientos, link: "/en/services/wall-coverings" },
  { title: "Flooring", desc: "Porcelain, wood, laminate and SPC installed with leveling and proper substrate preparation.", image: serviceImages.sueloPorcelanato, link: "/en/services/flooring" },
  { title: "Swimming Pools", desc: "Pool finishes, filtration, maintenance and exterior upgrades for high-value homes.", image: serviceImages.piscinas, link: "/en/services/pools" }
];

const stats = [
  { number: "23+", label: "Years of Experience" },
  { number: "4", label: "Cities Served" },
  { number: "100%", label: "Quality Commitment" },
  { number: "Fast", label: "Professional Execution" }
];

const processSteps = [
  { step: "01", title: "Technical diagnosis", desc: "We measure, review existing installations, substrates, humidity, slopes and real conditions before promising a solution." },
  { step: "02", title: "Specification", desc: "We define materials compatible with each use: adhesives, waterproofing, fixtures, lighting, hardware and finishes." },
  { step: "03", title: "Itemized budget", desc: "You receive a clear proposal with scope, quality levels, timings, exclusions and written warranty conditions." },
  { step: "04", title: "Supervised execution", desc: "We control the site, suppliers, technical tests and finishes to avoid improvisation in critical phases." },
  { step: "05", title: "Verified handover", desc: "Joint review, finish checklist, final cleaning, photographic documentation and applicable warranty." }
];

const testimonials = [
  { text: "What we valued most was that they explained why each material had to be used in a specific area. It wasn't just about looking good; it was about being properly done.", name: "Homeowner", location: "San Diego, Carabobo" },
  { text: "The bathroom is flawless, but the difference was in the process: documented waterproofing, testing before closing walls and a check on every detail.", name: "Residential client", location: "Valencia, Carabobo" },
  { text: "We wanted a remodel without improvisation. We got a schedule, itemized budget and constant follow-up throughout the work.", name: "Apartment owner", location: "Caracas" }
];

const fitItems = [
  "You want a lasting remodel, not just a project that looks good on delivery day.",
  "You value correct materials, technical supervision, cleanliness, order and communication.",
  "You prefer to invest once in a well-executed result rather than correcting rework later.",
  "You are looking for high-standard finishes for a high-value house, apartment, quinta or townhouse."
];
---

<BaseLayout
  title="Luxury Remodeling in Venezuela | RemodelaT"
  description="High-standard residential remodeling in Venezuela. Kitchens, bathrooms and whole-home remodels with technical method, proper materials, flawless finishes…"
  activePage="home"
>

  <header class="hero hero-god">
    <div class="god-glow" aria-hidden="true"></div>
    <div class="god-watermark" aria-hidden="true">REMODELAT</div>

    <picture>
      <source
        media="(max-width: 1023.98px)"
        srcset="/images/hero-poster-mobile.webp"
        type="image/webp"
        width="360"
        height="640"
      />
      <img
        src="/images/hero-poster-desktop.webp"
        alt="Renovated residential interior with high-standard finishes"
        fetchpriority="high"
        loading="eager"
        decoding="async"
        width="960"
        height="540"
        class="hero-poster"
      />
    </picture>

    <video
      id="hero-video"
      class="hero-video"
      autoplay
      muted
      loop
      playsinline
      preload="auto"
      aria-hidden="true"
      tabindex="-1"
    ></video>

    <script is:inline>
      (function () {
        var video = document.getElementById('hero-video');
        if (!video) return;
        var isMobile = window.matchMedia('(max-width: 1023.98px)').matches;
        video.poster = isMobile
          ? '/images/hero-poster-mobile.webp'
          : '/images/hero-poster-desktop.webp';
        video.src = isMobile
          ? '/videos/hero-mobile.mp4'
          : '/videos/hero-desktop.mp4';
        var playing = video.play();
        if (playing && typeof playing.catch === 'function') {
          playing.catch(function () {});
        }
      })();
    </script>

    <div class="hero-overlay"></div>
    <div class="god-hairline" aria-hidden="true"></div>

    <div class="hero-content">
      <span class="god-eyebrow">High-standard residential remodeling</span>
      <h1 class="hero-title">
        <span class="line">Luxury remodeling</span>
        <span class="line gold">with technical precision</span>
      </h1>
      <p class="hero-sub">Kitchens, bathrooms and whole-home remodels for demanding homeowners: proper materials, supervised execution, flawless finishes and written warranties.</p>
      <div class="hero-btns">
        <a href={`https://wa.me/584227997043?text=${whatsappBudgetTextEn}`} target="_blank" rel="noopener" class="btn-premium btn-primary-premium">
          <span class="btn-content">Request technical assessment</span>
          <span class="btn-border"></span>
          <span class="btn-shine"></span>
          <span class="btn-arrow">→</span>
        </a>
        <a href="/en/projects" class="btn-premium btn-outline-premium">
          <span class="btn-content">See real projects</span>
          <span class="btn-border"></span>
          <span class="btn-shine"></span>
          <span class="btn-arrow">→</span>
        </a>
      </div>
      <p class="hero-proof" aria-label="Trust signals">
        <span>23+ years</span>
        <i></i>
        <span>Technical method</span>
        <i></i>
        <span>Written guarantee</span>
      </p>
    </div>

    <div class="god-scroll" aria-hidden="true">
      <span>Explore</span>
      <i></i>
    </div>
  </header>

  <section class="stats-section">
    <div class="container stats-grid">
      {stats.map((s) => (
        <div class="stat-item">
          <div class="stat-num">{s.number}</div>
          <div class="stat-label">{s.label}</div>
        </div>
      ))}
    </div>
  </section>

  <section class="section method-strip">
    <div class="container method-strip-grid">
      <div>
        <span class="tag">The RemodelaT Method</span>
        <h2 class="section-title">We do not compete to be the cheapest. We compete to do it correctly.</h2>
      </div>
      <div>
        <p>A high-end remodel is not defined only by how it looks on handover day. It is defined by how it ages, how its hidden utilities perform and how its finishes resist daily use.</p>
        <a href="/en/our-method" class="method-link">Discover the RemodelaT Method <span>→</span></a>
      </div>
    </div>
  </section>

  <section class="section bg-light">
    <div class="container">
      <div class="section-header">
        <span class="tag">Our Services</span>
        <h2 class="section-title">Remodeling for homes where details matter</h2>
        <p class="section-desc">Whole-home projects, kitchens, bathrooms, flooring and coverings executed with planning, coordinated technical trades and finishes built to last.</p>
      </div>

      <div class="services-slider-wrapper">
        <button class="slider-btn slider-prev" aria-label="Previous service">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M15 18l-6-6 6-6"/>
          </svg>
        </button>

        <div class="services-slider">
          {services.map((svc, index) => (
            <a href={svc.link} class="service-card-slider">
              <div class="card-img-wrap">
                {typeof svc.image === 'object' ? (
                  <img
                    src={svc.image.src}
                    srcset={svc.image.srcset}
                    sizes="(max-width: 768px) 300px, 800px"
                    alt={svc.title}
                    loading={index === 0 ? "eager" : "lazy"}
                    fetchpriority={index === 0 ? "high" : "auto"}
                    decoding="async"
                    width="800"
                    height="533"
                  />
                ) : (
                  <img
                    src={svc.image}
                    alt={svc.title}
                    loading="lazy"
                    decoding="async"
                    width="800"
                    height="533"
                  />
                )}
                <div class="card-overlay"></div>
                <span class="card-icon" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg></span>
              </div>
              <div class="card-body">
                <h3>{svc.title}</h3>
                <p>{svc.desc}</p>
                <span class="card-link">Learn more <span class="arrow">→</span></span>
              </div>
            </a>
          ))}
        </div>

        <button class="slider-btn slider-next" aria-label="Next service">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M9 18l6-6-6-6"/>
          </svg>
        </button>
      </div>

      <div class="slider-dots"></div>
    </div>
  </section>

  <section class="section">
    <div class="container about-grid">
      <div class="about-imgs">
        <div class="img-box tall">
          <img
            src="/images/arquitectura-600.webp"
            srcset="/images/arquitectura-400.webp 400w, /images/arquitectura-600.webp 600w"
            sizes="(max-width: 768px) 400px, 600px"
            alt="Modern residential architecture"
            loading="lazy"
            decoding="async"
            width="600"
            height="800"
          />
        </div>
        <div class="img-box small">
          <img
            src="/images/equipo-600.webp"
            srcset="/images/equipo-400.webp 400w, /images/equipo-600.webp 600w"
            sizes="(max-width: 768px) 400px, 600px"
            alt="Professional remodeling team at work"
            loading="lazy"
            decoding="async"
            width="600"
            height="400"
          />
        </div>
      </div>
      <div class="about-text">
        <span class="tag">About Us</span>
        <h2 class="section-title">European experience,<br/>local execution without improvisation</h2>
        <p>RemodelaT was founded in Spain with over 23 years of remodeling experience. In Venezuela we work under a clear standard: technical diagnosis, proper material specification, direct supervision and documented warranties.</p>
        <ul class="check-list">
          <li>Whole-home remodeling with planning, site control and warranty</li>
          <li>Electrical and plumbing work tested before closing</li>
          <li>Custom designs with materials compatible with each use</li>
          <li>Final finishes reviewed with the property owner before handover</li>
        </ul>
        <a href="/en/our-method" class="btn-premium btn-primary-premium">
          <span class="btn-content">Discover our standard</span>
          <span class="btn-border"></span>
          <span class="btn-shine"></span>
          <span class="btn-arrow">→</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section process-section deferred-section">
    <div class="container">
      <div class="section-header" data-reveal>
        <span class="tag">A method designed to avoid improvisation</span>
        <h2 class="section-title">A process designed to avoid improvisation</h2>
        <p class="section-desc">Demanding clients do not only buy finishes: they buy peace of mind. That is why each phase has diagnosis, specification, supervised execution and documented review.</p>
      </div>
      <div class="process-grid">
        {processSteps.map((s, i) => (
          <article class="process-step" data-reveal data-reveal-delay={String((i % 5) + 1)}>
            <span class="step-num">{s.step}</span>
            <h3>{s.title}</h3>
            <p>{s.desc}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section bg-light fit-section deferred-section">
    <div class="container fit-grid">
      <div data-reveal>
        <span class="tag">Who we work with</span>
        <h2 class="section-title">For homeowners who value precision, warranty and durability</h2>
        <p class="section-desc">We are not the option to get any job done. We are the option for those who prefer a serious process, correct materials and finishes at the level of their home.</p>
      </div>
      <ul class="check-list" data-reveal>
        {fitItems.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </section>

  <section class="section testimonials-section deferred-section">
    <div class="container">
      <div class="section-header" data-reveal>
        <span class="tag">Client feedback</span>
        <h2 class="section-title">What demanding homeowners value most</h2>
        <p class="section-desc">The peace of mind of knowing what is being done, why it is done that way and how the final result is guaranteed.</p>
      </div>
      <div class="testimonials-grid">
        {testimonials.map((t, i) => (
          <blockquote class="testimonial" data-reveal data-reveal-delay={String((i % 3) + 1)}>
            <p>"{t.text}"</p>
            <footer>
              <strong>{t.name}</strong>
              <span>{t.location}</span>
            </footer>
          </blockquote>
        ))}
      </div>
    </div>
  </section>

  <section class="cta-section">
    <div class="cta-wrapper">
      <h2 class="cta-title">Does your project require a flawless finish?</h2>
      <p class="cta-text">Send us your area, property type and desired finish level. We will review whether the project fits our standard and guide you through a technical assessment.</p>
      <a href="/en/contact" class="btn-premium btn-white-premium">
        <span class="btn-content">Request technical assessment</span>
        <span class="btn-border"></span>
        <span class="btn-shine"></span>
        <span class="btn-arrow">→</span>
      </a>
    </div>
  </section>

  <section class="section bg-light" id="quick-contact">
    <div class="container contact-grid">
      <div class="contact-info">
        <h2 class="section-title">Let's Talk About Your Project</h2>
        <p>We are here to listen, advise, and build alongside you. We serve the entire Caracas metropolitan area and key zones across Carabobo.</p>
        <div class="info-item">
          <h4>Location</h4>
          <p>Valencia, San Diego, Carabobo and Caracas</p>
        </div>
        <div class="info-item">
          <h4>Phone</h4>
          <p><a href="tel:+584227997043" style="color: var(--gold); text-decoration: none;">0422 799 7043</a></p>
        </div>
      </div>
      <form class="contact-form" action="https://formsubmit.co/contacto@remodelat.net" method="POST">
        <input type="hidden" name="_subject" value="New inquiry from English website">
        <input type="hidden" name="_captcha" value="false">
        <input type="text" name="_honey" style="display:none" tabindex="-1" autocomplete="off">

        <div class="form-row">
          <input type="text" id="nombre" name="nombre" placeholder="Full Name" required aria-label="Your full name" />
          <input type="tel" id="telefono" name="telefono" placeholder="Phone Number" required aria-label="Your phone number" />
        </div>
        <input type="email" id="email" name="email" placeholder="Email Address" required aria-label="Your email address" />
        <select id="proyecto" name="proyecto" required aria-label="Project type">
          <option value="" disabled selected>Project type</option>
          <option value="cocina">Designer kitchen</option>
          <option value="bano">Spa-style bathroom</option>
          <option value="integral">Whole-home remodeling</option>
          <option value="electricidad">Electrical Services</option>
          <option value="fontaneria">Plumbing Services</option>
        </select>
        <textarea id="mensaje" name="mensaje" placeholder="Tell us about your project" rows="4" required aria-label="Project details"></textarea>
        <button type="submit" class="btn-premium btn-primary-premium full-width">
          <span class="btn-content">Request technical assessment</span>
          <span class="btn-border"></span>
          <span class="btn-shine"></span>
          <span class="btn-arrow">→</span>
        </button>
      </form>
    </div>
  </section>

</BaseLayout>

<style>
  /* ---------- HERO DIOS con video preservado ---------- */
  .hero {
    position: relative; width: 100%;
    min-height: 100vh; min-height: 100svh;
    overflow: hidden;
    background: var(--ink);
    display: flex; align-items: center; justify-content: center;
    text-align: center; color: var(--white);
    isolation: isolate;
  }
  .hero-poster,
  .hero-video {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    object-position: center;
  }
  .hero-poster { z-index: 1 !important; filter: contrast(1.08) brightness(0.88) saturate(0.96); }
  .hero-video { z-index: 2 !important; border: 0; background: transparent; pointer-events: none; }
  .hero .god-glow {
    position: absolute; top: -22%; right: -10%; width: 72vw; height: 72vw;
    background: radial-gradient(circle, rgba(201,169,97,0.32) 0%, rgba(201,169,97,0.10) 36%, transparent 70%);
    filter: blur(88px); pointer-events: none; z-index: 2;
  }
  .hero .god-watermark {
    position: absolute; bottom: -0.06em; left: 50%; transform: translateX(-50%);
    font-family: var(--font-serif); font-size: 18vw; font-weight: 700; line-height: 0.8;
    letter-spacing: -0.05em; color: transparent; -webkit-text-stroke: 1px rgba(201,169,97,0.11);
    pointer-events: none; z-index: 2; white-space: nowrap;
  }
  .hero-overlay {
    position: absolute; inset: 0; z-index: 3 !important;
    background:
      linear-gradient(to top, rgba(10,8,6,0.96) 0%, rgba(10,8,6,0.58) 52%, rgba(10,8,6,0.18) 100%),
      linear-gradient(100deg, rgba(10,8,6,0.62) 0%, transparent 60%),
      radial-gradient(circle at 50% 42%, rgba(0,0,0,.10), rgba(0,0,0,.55) 60%, rgba(0,0,0,.88) 100%);
  }
  .hero .god-hairline {
    position: absolute; bottom: 0; left: 0; right: 0; height: 1px;
    background: linear-gradient(to right, transparent, rgba(201,169,97,0.28), transparent);
    z-index: 6;
  }
  .hero-content { position: relative; z-index: 5 !important; max-width: 760px; padding: 110px 20px 0; }
  .god-eyebrow {
    display: inline-flex; align-items: center; gap: 12px;
    font-size: .72rem; letter-spacing: 0.18em; text-transform: uppercase; font-weight: 800;
    color: var(--gold-light); margin-bottom: 18px;
  }
  .god-eyebrow::before { content: ""; width: 26px; height: 1px; background: var(--gold); display: block; }
  .hero-title {
    font-family: var(--font-serif);
    font-size: clamp(2.4rem, 5.4vw, 4.9rem);
    font-weight: 400; line-height: 0.94;
    letter-spacing: -0.03em;
    margin-bottom: 20px;
  }
  .hero-title .line { display: block; }
  .hero-title .gold { color: var(--gold); }
  .hero-sub {
    font-size: 1.08rem; color: rgba(255,255,255,.84);
    margin: 0 auto 32px; max-width: 560px; line-height: 1.65;
  }
  .hero-btns { display: flex; gap: 18px; justify-content: center; flex-wrap: wrap; }
  .hero-proof {
    display: inline-flex; align-items: center; justify-content: center; flex-wrap: wrap;
    gap: 12px; margin: 26px auto 0;
    color: rgba(255,255,255,.62); font-size: .78rem;
    letter-spacing: .12em; text-transform: uppercase; font-weight: 600;
  }
  .hero-proof i { display: block; width: 4px; height: 4px; border-radius: 50%; background: var(--gold); opacity: .85; }
  .hero-proof span { white-space: nowrap; }
  .god-scroll {
    position: absolute; bottom: 28px; left: 50%; transform: translateX(-50%);
    z-index: 6; display: flex; flex-direction: column; align-items: center; gap: 10px;
    color: rgba(255,255,255,0.48); font-size: 0.68rem; letter-spacing: 0.16em; text-transform: uppercase;
  }
  .god-scroll i { display: block; width: 1px; height: 36px; background: linear-gradient(to bottom, var(--gold), transparent); animation: godScrollLine 2.2s ease-in-out infinite; }
  @keyframes godScrollLine {
    0% { transform: scaleY(0); transform-origin: top; opacity: 0; }
    50% { transform: scaleY(1); opacity: 1; }
    100% { transform: scaleY(0); transform-origin: bottom; opacity: 0; }
  }
  .btn-outline-premium { background: transparent; color: var(--white); border: 1px solid rgba(255,255,255,0.4); backdrop-filter: blur(5px); }
  .btn-outline-premium:hover { transform: translateY(-3px); border-color: var(--gold); color: var(--gold); }
  .btn-white-premium { background: var(--white); color: var(--bg); box-shadow: 0 4px 15px rgba(0,0,0,0.2); }
  .btn-white-premium .btn-border { border: 2px solid var(--white); }
  .btn-white-premium:hover { transform: translateY(-3px); background: var(--gold); box-shadow: 0 8px 30px rgba(201, 169, 97, 0.5); }
  .btn-white-premium:hover .btn-arrow { transform: translateX(8px); }
  .btn-white-premium:hover .btn-shine { left: 150%; }

  .section { padding: 100px 0; }
  .bg-light { background: var(--gray); }
  .section-header { text-align: center; max-width: 700px; margin: 0 auto 60px; }
  .section-title { font-family: var(--font-serif); font-size: clamp(2rem, 5vw, 3.5rem); margin-bottom: 20px; font-weight: 400; }
  .tag { display: inline-block; color: #8B6914; font-size: 0.85rem; letter-spacing: 2px; text-transform: uppercase; margin-bottom: 15px; font-weight: 600; }
  .section-desc { color: var(--gray-text); font-size: 1.1rem; line-height: 1.8; font-weight: 400; }


  .method-strip { background: var(--white); }
  .method-strip-grid { display: grid; grid-template-columns: .95fr 1.05fr; gap: var(--s-5); align-items: center; }
  .method-strip p { color: var(--text-muted); font-size: 1.06rem; line-height: 1.85; margin-bottom: 20px; }
  .method-link { color: var(--gold-ink-strong); font-weight: 800; text-transform: uppercase; letter-spacing: .08em; font-size: .82rem; }
  .method-link span { display: inline-block; transition: transform var(--dur-base) var(--ease-out); }
