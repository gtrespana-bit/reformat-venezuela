  .gu-sep { color: var(--sand); margin: 0 2px; }
  .gu-current { color: var(--text); font-weight: 600; }

  /* ==========================================================
     SCROLL REVEAL (applied by JS)
     ========================================================== */
  .reveal {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.9s var(--ease-out), transform 0.9s var(--ease-out);
    will-change: opacity, transform;
  }
  .reveal.is-in {
    opacity: 1;
    transform: translateY(0);
  }

  /* ==========================================================
     OVERVIEW + FIGURES
     ========================================================== */
  .gu-summary { background: var(--white); scroll-margin-top: 118px; }
  .gu-summary .section-header { max-width: 760px; }
  .gu-summary-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
    max-width: 1080px;
    margin: 0 auto;
  }
  .gu-summary-card {
    position: relative;
    padding: 46px 40px 42px;
    border-radius: var(--r-lg);
    background: linear-gradient(180deg, var(--white), var(--bone));
    border: 1px solid var(--sand);
    box-shadow: var(--e-1);
    overflow: hidden;
    transition: transform var(--dur-base) var(--ease-out), box-shadow var(--dur-base) var(--ease-out);
  }
  .gu-summary-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--e-2);
  }
  .gu-summary-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 40px;
    right: 40px;
    height: 2px;
    background: linear-gradient(90deg, transparent, rgba(201, 169, 97, 0.55), transparent);
  }
  .gu-summary-index {
    display: inline-block;
    color: var(--gold-ink-strong);
    font-size: 0.74rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin-bottom: 16px;
  }
  .gu-summary-card h3 {
    font-family: var(--font-serif);
    font-size: clamp(1.6rem, 2.6vw, 2.05rem);
    font-weight: 500;
    line-height: 1.14;
    color: var(--ink);
    margin-bottom: 18px;
  }
  .gu-summary-card p {
    margin: 0;
    color: var(--text-muted);
    font-size: 1.01rem;
    line-height: 1.82;
  }
  .gu-dropcap::first-letter {
    font-family: var(--font-serif);
    font-size: 3.6em;
    font-weight: 600;
    line-height: 0.82;
    float: left;
    padding: 0.06em 0.14em 0 0;
    color: var(--gold-ink);
  }
  .gu-stats {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 0;
    max-width: 1080px;
    margin: 56px auto 0;
    border: 1px solid rgba(201, 169, 97, 0.25);
    border-radius: var(--r-lg);
    overflow: hidden;
    background: var(--ink);
    box-shadow: var(--e-2);
  }
  .gu-stat {
    padding: 30px 18px 28px;
    text-align: center;
    border-right: 1px solid rgba(201, 169, 97, 0.18);
  }
  .gu-stat:last-child { border-right: 0; }
  .gu-stat dd {
    margin: 0 0 8px;
    font-family: var(--font-serif);
    font-size: clamp(2.2rem, 4vw, 3.1rem);
    font-weight: 500;
    line-height: 1;
    color: var(--gold);
  }
  .gu-stat dt {
    color: rgba(255, 255, 255, 0.68);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    line-height: 1.5;
  }

  /* ==========================================================
     RESULT SHOWCASE
     ========================================================== */
  .gu-showcase {
    background: linear-gradient(180deg, var(--bone), var(--white));
    border-top: 1px solid var(--sand);
    scroll-margin-top: 118px;
  }
  .gu-showcase .section-header { max-width: 760px; }
  .gu-showcase-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 26px;
    max-width: 1160px;
    margin: 0 auto;
  }
  .gu-showcase-card {
    margin: 0;
    display: flex;
    flex-direction: column;
    border-radius: 26px;
    overflow: hidden;
    background: var(--white);
    border: 1px solid rgba(201, 169, 97, 0.16);
    box-shadow: var(--e-2);
    cursor: zoom-in;
    transition: transform var(--dur-base) var(--ease-out), box-shadow var(--dur-base) var(--ease-out), border-color var(--dur-base) var(--ease-out);
  }
  .gu-showcase-card:hover {
    transform: translateY(-5px);
    box-shadow: var(--e-3);
    border-color: rgba(201, 169, 97, 0.4);
  }
  .gu-showcase-media {
    position: relative;
    padding: 18px;
    background:
      radial-gradient(circle at top, rgba(201, 169, 97, 0.14), transparent 42%),
      var(--ink-soft);
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 400px;
  }
  .gu-showcase-media img {
    max-width: 100%;
    max-height: 500px;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 8px;
    box-shadow: 0 20px 44px rgba(0, 0, 0, 0.32);
    transition: transform var(--dur-slow) var(--ease-out);
  }
  .gu-showcase-card:hover .gu-showcase-media img { transform: scale(1.02); }
  .gu-media-chip {
    position: absolute;
    right: 16px;
    bottom: 16px;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    min-height: 34px;
    padding: 0 13px;
    border-radius: var(--r-full);
    background: rgba(20, 18, 14, 0.82);
    border: 1px solid rgba(201, 169, 97, 0.3);
    color: rgba(255, 255, 255, 0.92);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    backdrop-filter: blur(10px);
    pointer-events: none;
  }
  .gu-showcase-card figcaption {
    padding: 28px 30px 32px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .gu-showcase-badge {
    display: inline-flex;
    align-items: center;
    padding: 5px 13px;
    border-radius: var(--r-full);
    background: var(--gold);
    color: var(--ink);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 14px;
  }
  .gu-showcase-card figcaption h3 {
    font-family: var(--font-serif);
    font-size: clamp(1.55rem, 2.4vw, 2rem);
    font-weight: 500;
    line-height: 1.12;
    color: var(--ink);
    margin-bottom: 12px;
  }
  .gu-showcase-card figcaption p {
    margin: 0 0 18px;
    color: var(--text-muted);
    font-size: 0.98rem;
    line-height: 1.76;
  }

  /* ==========================================================
     PULL QUOTE
     ========================================================== */
  .gu-quote {
    padding: 96px 24px;
    background:
      radial-gradient(circle at 50% 110%, rgba(201, 169, 97, 0.16), transparent 55%),
      var(--ink);
    color: var(--white);
    border-top: 1px solid rgba(201, 169, 97, 0.18);
    border-bottom: 1px solid rgba(201, 169, 97, 0.18);
  }
  .gu-quote-inner {
    max-width: 900px;
    margin: 0 auto;
    text-align: center;
  }
  .gu-quote-mark {
    display: block;
    font-family: var(--font-serif);
    font-size: 7rem;
    line-height: 0.6;
    color: var(--gold);
    margin-bottom: 6px;
  }
  .gu-quote blockquote {
    margin: 0 0 26px;
    font-family: var(--font-serif);
    font-size: clamp(1.7rem, 3.6vw, 2.9rem);
    font-weight: 500;
    line-height: 1.22;
    letter-spacing: var(--track-tight);
    font-style: italic;
  }
  .gu-quote cite {
    font-style: normal;
    color: rgba(255, 255, 255, 0.6);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  /* ==========================================================
     STEP BY STEP — editorial flow with side navigator
     ========================================================== */
  .gu-timeline-section {
    background: var(--white);
    border-top: 1px solid var(--sand);
    scroll-margin-top: 118px;
  }
  .gu-timeline-section .section-header { max-width: 800px; }
  .gu-timeline-meta {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 26px;
    color: var(--gold-ink-strong);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .gu-timeline-meta-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--gold);
  }
  .gu-flow {
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr);
    gap: 48px;
    max-width: 1180px;
    margin: 0 auto;
    align-items: start;
  }
  .gu-flow-nav {
    position: sticky;
    top: 200px;
    padding: 26px 22px;
    border-radius: var(--r-lg);
    background: linear-gradient(180deg, var(--white), var(--bone));
    border: 1px solid var(--sand);
    box-shadow: var(--e-1);
  }
  .gu-flow-nav-title {
    display: block;
    color: var(--gold-ink-strong);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin-bottom: 16px;
    padding-left: 6px;
  }
  .gu-flow-nav ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 4px;
  }
  .gu-flow-nav a {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 9px 8px;
    border-radius: var(--r-sm);
    color: var(--text-muted);
    text-decoration: none;
    transition: background var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out);
  }
  .gu-flow-nav a:hover { background: rgba(201, 169, 97, 0.1); color: var(--ink); }
  .gu-flow-nav-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: 1px solid rgba(201, 169, 97, 0.35);
    color: var(--gold-ink-strong);
    font-family: var(--font-serif);
    font-size: 1rem;
    font-weight: 600;
    flex-shrink: 0;
    transition: background var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out), border-color var(--dur-fast) var(--ease-out);
  }
  .gu-flow-nav-label {
    font-size: 0.86rem;
    font-weight: 600;
  }
  .gu-flow-nav a.is-active {
    background: var(--ink);
    color: var(--white);
  }
  .gu-flow-nav a.is-active .gu-flow-nav-num {
    background: var(--gold);
    border-color: var(--gold);
    color: var(--ink);
  }
  .gu-flow-nav-progress {
    display: block;
    height: 3px;
    margin-top: 18px;
    border-radius: 2px;
    background: var(--sand);
    overflow: hidden;
  }
  .gu-flow-nav-progress span {
    display: block;
    height: 100%;
    background: linear-gradient(90deg, var(--gold-ink), var(--gold));
    transform: scaleY(0.16);
    transform-origin: top;
    transition: transform 0.4s var(--ease-out);
  }
  .gu-flow-main { min-width: 0; }
  .gu-fase {
    scroll-margin-top: 170px;
    padding: 46px 0 52px;
    border-top: 1px solid var(--sand);
  }
  .gu-fase:first-child { border-top: 0; padding-top: 8px; }
  .gu-fase-head {
    display: grid;
    grid-template-columns: 132px minmax(0, 1fr);
    gap: 30px;
    margin-bottom: 30px;
  }
  .gu-fase-numside {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }
  .gu-fase-num {
    font-family: var(--font-serif);
    font-size: clamp(3.6rem, 6vw, 5.2rem);
    font-weight: 500;
    line-height: 0.9;
    color: transparent;
    -webkit-text-stroke: 1.2px rgba(201, 169, 97, 0.8);
  }
  @supports not (-webkit-text-stroke: 1px black) {
    .gu-fase-num { color: rgba(201, 169, 97, 0.55); }
  }
  .gu-fase-numline {
    flex: 1;
    width: 1px;
    background: linear-gradient(to bottom, rgba(201, 169, 97, 0.55), transparent);
  }
  .gu-fase-copy { min-width: 0; max-width: 780px; }
  .gu-fase-kicker {
    display: inline-flex;
    align-items: center;
    width: fit-content;
    margin-bottom: 15px;
    padding: 7px 15px;
    border-radius: var(--r-full);
    background: rgba(201, 169, 97, 0.13);
    color: var(--gold-ink-strong);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .gu-fase-copy h3 {
    font-family: var(--font-serif);
    font-size: clamp(1.75rem, 3vw, 2.4rem);
    font-weight: 500;
    line-height: 1.08;
    letter-spacing: var(--track-tight);
    color: var(--ink);
    margin-bottom: 16px;
  }
  .gu-fase-copy > p {
    color: var(--text-muted);
    font-size: 1.03rem;
    line-height: 1.84;
    margin-bottom: 22px;
  }
  .gu-fase-checks {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px 22px;
  }
  .gu-fase-checks li {
    position: relative;
    padding-left: 30px;
    color: var(--text);
    font-size: 0.92rem;
    line-height: 1.55;
    font-weight: 500;
  }
  .gu-fase-checks li::before {
    content: '✓';
    position: absolute;
    left: 0;
    top: 1px;
    width: 19px;
    height: 19px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: rgba(201, 169, 97, 0.16);
    color: var(--gold-ink-strong);
    font-size: 0.68rem;
    font-weight: 800;
  }

  /* --- per-phase photo essay galleries --- */
  .gu-fg {
    display: grid;
    gap: 20px;
    margin-left: 0;
    padding-left: 162px;
  }
  .gu-fg-item {
    margin: 0;
    min-width: 0;
    cursor: zoom-in;
  }
  .gu-fg-media {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 300px;
    padding: 16px;
    border-radius: 20px;
    background:
      radial-gradient(circle at top, rgba(201, 169, 97, 0.13), transparent 40%),
      var(--ink-soft);
    overflow: hidden;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.03);
    transition: transform var(--dur-base) var(--ease-out), box-shadow var(--dur-base) var(--ease-out);
  }
  .gu-fg-item:hover .gu-fg-media {
    transform: translateY(-4px);
    box-shadow: var(--e-3);
  }
  .gu-fg-media img {
    max-width: 100%;
    max-height: 400px;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 6px;
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.3);
  }
  .gu-fg-badge {
    position: absolute;
    top: 14px;
    left: 14px;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    min-height: 30px;
    padding: 0 12px;
    border-radius: var(--r-full);
    background: var(--gold);
    color: var(--ink);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .gu-fg-item figcaption {
    padding: 13px 8px 0;
    color: var(--text-muted);
    font-size: 0.9rem;
    line-height: 1.65;
  }
  .gu-fg--1 {
    grid-template-columns: minmax(0, 1fr);
    max-width: 620px;
  }
  .gu-fg--1 .gu-fg-media { min-height: 460px; }
  .gu-fg--1 .gu-fg-media img { max-height: 560px; }
  .gu-fg--2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .gu-fg--3 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .gu-fg--3 .gu-fg-item--featured { grid-column: 1 / -1; }
  .gu-fg--3 .gu-fg-item--featured .gu-fg-media { min-height: 380px; }
  .gu-fg--3 .gu-fg-item--featured .gu-fg-media img { max-height: 460px; }
  .gu-fg--6 { grid-template-columns: repeat(6, minmax(0, 1fr)); }
  .gu-fg--6 .gu-fg-item { grid-column: span 2; }
  .gu-fg--6 .gu-fg-item--featured { grid-column: 1 / -1; }
  .gu-fg--6 .gu-fg-item--featured .gu-fg-media { min-height: 400px; }
  .gu-fg--6 .gu-fg-item--featured .gu-fg-media img { max-height: 480px; }

  /* ==========================================================
     BEFORE / AFTER COMPARATOR (drag)
     ========================================================== */
  .gu-compare-section {
    background: linear-gradient(180deg, var(--bone), var(--white));
    border-top: 1px solid var(--sand);
    scroll-margin-top: 118px;
  }
  .gu-compare-section .section-header { max-width: 780px; }
  .gu-ba {
    max-width: 1080px;
    margin: 0 auto;
  }
  .gu-ba-stage {
    position: relative;
    aspect-ratio: 4 / 3;
    border-radius: 26px;
    overflow: hidden;
    box-shadow: var(--e-3);
    border: 1px solid rgba(201, 169, 97, 0.25);
    cursor: ew-resize;
    touch-action: pan-y;
    user-select: none;
    background: var(--ink-soft);
  }
  .gu-ba-stage:focus-visible {
    outline: 3px solid var(--gold);
    outline-offset: 3px;
  }
  .gu-ba-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
  }
  .gu-ba-before {
    position: absolute;
    inset: 0;
    clip-path: inset(0 50% 0 0);
  }
  .gu-ba-chip {
    position: absolute;
    top: 18px;
    z-index: 3;
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    padding: 0 16px;
    border-radius: var(--r-full);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    pointer-events: none;
  }
  .gu-ba-chip--before {
    left: 18px;
    background: rgba(20, 18, 14, 0.85);
    color: var(--white);
    border: 1px solid rgba(255, 255, 255, 0.14);
  }
  .gu-ba-chip--after {
    right: 18px;
    background: var(--gold);
    color: var(--ink);
  }
  .gu-ba-handle {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    z-index: 4;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    transform: translateX(-50%);
    pointer-events: none;
  }
  .gu-ba-handle-line {
    flex: 1;
    width: 2px;
    background: linear-gradient(to bottom, transparent, var(--white) 18%, var(--white) 82%, transparent);
    box-shadow: 0 0 14px rgba(0, 0, 0, 0.4);
  }
  .gu-ba-handle-knob {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 58px;
    height: 58px;
    border-radius: 50%;
    background: var(--gold);
    color: var(--ink);
    box-shadow: 0 10px 26px rgba(20, 18, 14, 0.4), 0 0 0 5px rgba(255, 255, 255, 0.28);
    flex-shrink: 0;
  }
  .gu-ba-captions {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 26px;
    margin-top: 26px;
  }
  .gu-ba-captions strong {
    display: block;
    font-family: var(--font-serif);
    font-size: 1.4rem;
    font-weight: 600;
    color: var(--ink);
    margin-bottom: 8px;
  }
  .gu-ba-captions p {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.7;
  }

  /* ==========================================================
     SPECIFICATIONS
     ========================================================== */
  .gu-specs {
    background: var(--white);
    border-top: 1px solid var(--sand);
    scroll-margin-top: 118px;
  }
  .gu-specs .section-header { max-width: 760px; }
  .gu-highlights {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 18px;
    max-width: 1160px;
    margin: 0 auto 34px;
  }
  .gu-highlight-card {
    padding: 28px 24px 26px;
    border-radius: var(--r-lg);
    background: linear-gradient(180deg, var(--white), var(--bone));
    border: 1px solid rgba(201, 169, 97, 0.18);
    box-shadow: var(--e-1);
    transition: transform var(--dur-base) var(--ease-out), box-shadow var(--dur-base) var(--ease-out), border-color var(--dur-base) var(--ease-out);
  }
  .gu-highlight-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--e-2);
    border-color: rgba(201, 169, 97, 0.4);
  }
  .gu-highlight-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 18px;
  }
  .gu-highlight-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: var(--ink);
    color: var(--gold);
  }
  .gu-highlight-index {
    font-family: var(--font-serif);
    font-size: 1.7rem;
    line-height: 1;
    color: rgba(201, 169, 97, 0.6);
  }
  .gu-highlight-card h3 {
