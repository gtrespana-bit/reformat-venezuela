---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import GuaranteeMatrix from '../../../components/GuaranteeMatrix.astro';
import ProjectLightbox from '../../../components/ProjectLightbox.astro';
import ProjectQuickNav from '../../../components/ProjectQuickNav.astro';
import ProjectBeforeAfterSlider from '../../../components/ProjectBeforeAfterSlider.astro';
import ProjectPhaseGallery from '../../../components/ProjectPhaseGallery.astro';

const project = {
  title: 'Luxury Kitchen in Guataparo',
  kicker: 'Real case study · High-standard kitchens',
  location: 'Residential quinta · Guataparo, Valencia, Carabobo',
  excerpt:
    'A full kitchen relocation that once lived closed and separate: we moved it into the day zone, sealed its old doorway, rebuilt electrics and plumbing, replaced the electric water heater with solar thermal panels, poured a seamless white epoxy floor and installed a linear base-cabinet composition with a backlit floating shelf and Siemens appliances.',
  heroImage: '/images/proyectos/cocina-lujo-guataparo/resultado-final-cocina-lineal.webp',
};

const heroFacts = [
  { label: 'Location', value: 'Guataparo · Valencia' },
  { label: 'Scope', value: 'Full relocation' },
  { label: 'Floor', value: 'Seamless white epoxy' },
  { label: 'Appliances', value: 'Siemens · 90 cm fridge' },
  { label: 'Real photos', value: '16 images' },
];

const quickNavItems = [
  { href: '#resumen', label: 'Overview' },
  { href: '#resultado', label: 'Result' },
  { href: '#paso-a-paso', label: 'Step by step' },
  { href: '#comparativa', label: 'Before & after' },
  { href: '#especificaciones', label: 'Specifications' },
  { href: '#galeria', label: 'Gallery' },
];

const whatsappText =
  'Hello, I would like a technical assessment for a kitchen similar to the Guataparo quinta project.';
const whatsappHref = `https://wa.me/584227997043?text=${encodeURIComponent(whatsappText)}`;

const resultadoShowcase = [
  {
    src: '/images/proyectos/cocina-lujo-guataparo/resultado-final-cocina-lineal.webp',
    alt: 'Finished linear kitchen with white base cabinets, floating shelf and Siemens refrigerator in a Guataparo quinta',
    badge: 'Linear kitchen',
    title: 'A single line of base cabinets, crowned by concealed light',
    caption:
      'Base cabinets only —no wall units— for a clean, minimalist reading, with the backlit floating shelf running the full length of the kitchen and the 90 cm Siemens refrigerator closing the composition.',
  },
  {
    src: '/images/proyectos/cocina-lujo-guataparo/resultado-final-comedor-abierto.webp',
    alt: 'Unified day zone with seamless white epoxy floor, dining area and open kitchen in a Guataparo quinta',
    badge: 'Unified day zone',
    title: 'Kitchen, dining and living read as one single space',
    caption:
      'The jointless white epoxy floor visually ties the whole level: the once-closed kitchen becomes the open heart of the day zone, filled with natural light.',
  },
];

const phases = [
  {
    number: '01',
    kicker: 'Phase 01 · Assessment',
    title: 'The starting point: a closed kitchen that cut the house in two',
    body:
      'The original kitchen was completely independent, separated from the living and dining areas, and accessed through a large double doorway. A closed compartment with aged ceramic and cabinetry that fragmented the day zone of the quinta. The decision was not to renovate it in place — but to relocate it entirely.',
    checks: [
      'Assessment of cabinetry, ceramic surfaces and utilities condition',
      'Complete re-planning of the day zone layout',
      'New location defined, integrated with living and dining areas',
    ],
    image: {
      src: '/images/proyectos/cocina-lujo-guataparo/antes-acceso-doble-sala.webp',
      alt: 'Original double doorway into the closed kitchen seen from the living area, before the Guataparo remodel',
      badge: 'Before',
      caption:
        'The original double doorway, seen from the living area. This opening would be sealed and the kitchen relocated.',
    },
  },
  {
    number: '02',
    kicker: 'Phase 02 · Controlled demolition',
    title: 'Full dismantling and removal of the electric water heater',
    body:
      'The kitchen was completely dismantled: cabinets, countertop and equipment. The electric water heater serving the old kitchen was also removed and decommissioned — from this intervention onward, the home’s hot water is produced by solar thermal panels, removing permanent electric consumption and gaining efficiency.',
    checks: [
      'Complete dismantling of cabinetry, countertop and equipment',
      'Electric water heater removed and decommissioned',
      'Hot water system prepared for solar thermal panels',
    ],
    image: {
      src: '/images/proyectos/cocina-lujo-guataparo/obra-desmontaje-termo-electrico.webp',
      alt: 'Old kitchen fully dismantled with the electric water heater still visible before removal',
      badge: 'Demolition',
      caption:
        'The old kitchen fully emptied. The electric water heater was removed and retired in favor of the solar thermal system.',
    },
  },
  {
    number: '03',
    kicker: 'Phase 03 · Blockwork & utilities',
    title: 'Sealing the old doorway, wiring the new location',
    body:
      'The old kitchen doorway was sealed with a 20 cm blockwork wall, rendered with cement mortar and fine-finished until it vanished into the wall. New chases were then opened in walls and floors to carry electrics and plumbing to the new location, with flexible corrugated conduit protecting all the wiring.',
    checks: [
      '20 cm blockwork wall with fine-finish cement render',
      'New chases in walls and floors for the new routes',
      'Wiring protected with flexible corrugated conduit',
      'Plumbing fully rerouted to the new location',
    ],
    image: {
      src: '/images/proyectos/cocina-lujo-guataparo/obra-tabique-ranuras-electricas.webp',
      alt: 'Blockwork wall sealing the old doorway and new electrical chases opened in the walls',
      badge: 'Utilities',
      caption:
        'The original doorway already sealed with 20 cm blockwork, and the new electrical chases traced across the walls.',
    },
  },
  {
    number: '04',
    kicker: 'Phase 04 · The floor',
    title: 'Self-leveling, primer and a seamless white epoxy finish',
    body:
      'The project called for an exclusive design: a continuous floor unifying kitchen, dining and living areas. First, self-leveling compound brought the plane to a perfect level; then the bonding primer; finally, an all-white epoxy finish. The result is a jointless surface that multiplies the light and delivers a sense of perfect continuity.',
    checks: [
      'Plane leveled with self-leveling mortar',
      'Bonding primer across the entire surface',
      'White epoxy finish with total continuity, no joints',
    ],
    image: {
      src: '/images/proyectos/cocina-lujo-guataparo/suelo-autonivelante-aplicado.webp',
      alt: 'Freshly poured self-leveling compound in the new kitchen location of the quinta',
      badge: 'Floor',
      caption:
        'The freshly poured self-leveling layer: the perfectly flat base onto which primer and the final epoxy were applied.',
    },
  },
  {
    number: '05',
    kicker: 'Phase 05 · Assembly',
    title: 'Base cabinets only, with a floating shelf of concealed light',
    body:
      'With utilities and flooring complete came the assembly: a linear composition of base cabinets only —no wall units— for a clean, minimalist result, crowned by a floating shelf running the full length of the kitchen with LED strips above and below, completely invisible to the eye.',
    checks: [
      'Base modules installed with plumb, level and joint control',
      'Continuous floating shelf along the entire kitchen',
      'Integrated LED lighting, invisible from any angle',
    ],
    image: {
      src: '/images/proyectos/cocina-lujo-guataparo/montaje-estante-flotante-lineal.webp',
      alt: 'Assembly of the linear white base-cabinet kitchen with the floating shelf in progress',
      badge: 'Assembly',
      caption:
        'The linear composition taking shape: aligned base modules and the floating shelf with its integrated lighting.',
    },
  },
  {
    number: '06',
    kicker: 'Phase 06 · Handover',
    title: 'Commissioning: Siemens appliances and final review',
    body:
      'The installation was completed with a Siemens oven and dishwasher and an imported 90 cm refrigerator of the same brand. The once-closed kitchen is now an open space that reads as a single piece: continuous white floor, low furniture line, and light flowing across the entire day zone of the quinta.',
    checks: [
      'Siemens oven and dishwasher integrated',
      'Imported 90 cm refrigerator incorporated into the composition',
      'Final review of finishes, lighting and operation',
    ],
    image: {
      src: '/images/proyectos/cocina-lujo-guataparo/resultado-final-cocina-lineal.webp',
      alt: 'Finished luxury kitchen in Guataparo with base cabinets, backlit shelf and Siemens appliances',
      badge: 'Handover',
      caption:
        'The finished kitchen: white linear composition, backlit shelf and integrated Siemens appliances.',
    },
  },
];

const highlights = [
  {
    title: 'Seamless white epoxy floor',
    text: 'Self-leveling, primer and a pure-white epoxy finish: a single jointless surface uniting kitchen, dining and living areas.',
  },
  {
    title: 'Floating shelf, concealed light',
    text: 'Running the full length of the kitchen, it hides two LED strips —above and below— washing wall and countertop invisibly.',
  },
  {
    title: 'Solar hot water',
    text: 'The electric heater was retired: hot water is now produced by solar thermal panels — more efficient and sustainable.',
  },
  {
    title: 'Siemens equipment',
    text: 'Integrated oven and dishwasher plus an imported 90 cm refrigerator: German-spec appliances for intensive daily use.',
  },
];

const specs = [
  { label: 'Location', value: 'Residential quinta in Guataparo, Valencia, Carabobo' },
  { label: 'Scope', value: 'Full kitchen relocation into the day zone' },
  { label: 'Initial state', value: 'Closed independent kitchen with double doorway access' },
  { label: 'Blockwork', value: 'Doorway sealed with 20 cm block and fine-finish render' },
  { label: 'Electrical', value: 'New wall and floor chases, flexible corrugated conduit' },
  { label: 'Plumbing', value: 'Fully rerouted to the new kitchen location' },
  { label: 'Hot water', value: 'Electric heater retired; solar thermal panels' },
  { label: 'Floor', value: 'Self-leveling + primer + continuous white epoxy' },
  { label: 'Cabinetry', value: 'Linear base-cabinet composition, minimalist style' },
  { label: 'Shelving', value: 'Full-length floating shelf, concealed LED above and below' },
  { label: 'Appliances', value: 'Siemens oven and dishwasher; imported 90 cm refrigerator' },
];

const galleryPhases = [
  {
    id: 'resultado',
    label: 'Final result',
    description: 'The finished kitchen: a continuous line of base cabinets, the backlit floating shelf and the white epoxy floor uniting the day zone.',
  },
  {
    id: 'montaje',
    label: 'Assembly',
    description: 'Base module alignment, joints and the floating shelf with its integrated lighting during the process.',
  },
  {
    id: 'suelo',
    label: 'The floor',
    description: 'Self-leveling, primer and epoxy finish: the three layers that build the pavement’s perfect continuity.',
  },
  {
    id: 'obra',
    label: 'Blockwork & utilities',
    description: 'Dismantling, the 20 cm blockwork seal and the new electrical and plumbing installations.',
  },
  {
    id: 'antes',
    label: 'Original state',
    description: 'The real starting point: the closed kitchen, its double doorway and the dining area where the new space now reads.',
  },
];

const gallery = [
  {
    src: '/images/proyectos/cocina-lujo-guataparo/resultado-final-cocina-lineal.webp',
    alt: 'Finished linear white kitchen with backlit floating shelf and Siemens refrigerator in Guataparo',
    title: 'Finished linear composition',
    caption: 'White base cabinets, a floating shelf with concealed light and the 90 cm Siemens refrigerator closing the line.',
    category: 'resultado',
    categoryLabel: 'Final Result',
    badge: 'Finished',
    orientation: 'landscape',
  },
  {
    src: '/images/proyectos/cocina-lujo-guataparo/resultado-final-comedor-abierto.webp',
    alt: 'Open dining area and kitchen with seamless white epoxy floor in a Guataparo quinta',
    title: 'The unified day zone',
    caption: 'The continuous white epoxy connects kitchen, dining and living into a single reading filled with light.',
    category: 'resultado',
