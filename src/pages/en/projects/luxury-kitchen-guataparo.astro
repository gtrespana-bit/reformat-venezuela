    title: 'Floating shelf in adjustment',
    caption: 'The continuous floating shelf, with LED lighting already integrated along its top and bottom edges.',
    category: 'montaje',
    categoryLabel: 'Assembly',
    badge: 'Shelving',
    orientation: 'portrait',
  },
  {
    src: '/images/proyectos/cocina-lujo-guataparo/montaje-estante-flotante-lateral.webp',
    alt: 'Side view of the linear kitchen under assembly with the large window behind in Guataparo',
    title: 'The low line facing the window',
    caption: 'No wall units: the whole composition stays below the sightline and lets the window breathe.',
    category: 'montaje',
