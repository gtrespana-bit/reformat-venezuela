<BaseLayout
  title="Luxury Kitchen in Guataparo, Valencia | Step-by-Step Case Study | RemodelaT"
  description={project.excerpt}
  image={project.heroImage}
  activePage="projects"
>
  <!-- Reading progress bar -->
  <div class="gu-progress" aria-hidden="true" data-progress><span></span></div>

  <!-- ============ CINEMATIC HERO ============ -->
  <header class="gu-hero">
    <img
      src={project.heroImage}
      alt="Finished luxury kitchen in a Guataparo quinta, Valencia: white base-cabinet line, backlit floating shelf and seamless epoxy floor"
      class="gu-hero-img"
      fetchpriority="high"
      loading="eager"
      decoding="async"
    />
    <div class="gu-hero-overlay" aria-hidden="true"></div>
    <div class="container gu-hero-content">
      <a href="/en/projects" class="gu-back" data-hero="0">← Back to projects</a>
      <span class="gu-eyebrow" data-hero="1">Real case study · High-standard kitchens · Site diary</span>
      <h1 data-hero="2">{project.title}</h1>
      <p class="gu-lead" data-hero="3">{project.excerpt}</p>

      <dl class="gu-facts" aria-label="Project facts" data-hero="4">
