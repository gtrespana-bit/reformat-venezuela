---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GodHero from '../../components/GodHero.astro';
import GodMarquee from '../../components/GodMarquee.astro';
import GuaranteeMatrix from '../../components/GuaranteeMatrix.astro';
import MethodComparison from '../../components/MethodComparison.astro';

const whatsappText = 'Hello, I would like a technical assessment and more information about the RemodelaT Method for my remodeling project.';

const methodSteps = [
  { number: '01', title: 'Real technical diagnosis', text: 'We review measurements, existing utilities, moisture, substrates, slopes, access and logistics before promising a solution.' },
  { number: '02', title: 'Scope definition', text: 'Clear inclusions and exclusions prevent surprises: trades, priorities, areas, finish level and special conditions.' },
  { number: '03', title: 'Material specification', text: 'Every material is selected for its use. Same adhesive is not suitable for every tile format or substrate.' },
  { number: '04', title: 'Itemized proposal', text: 'Organized proposal: demolition, utilities, waterproofing, masonry, coverings, carpentry and warranty.' },
  { number: '05', title: 'Site planning', text: 'Coordination of purchases, access, condominium permits, protection of common areas and schedule.' },
  { number: '06', title: 'Property protection', text: 'Protection of floors, elevators, corridors and furniture. Site should not become chaos.' },
  { number: '07', title: 'Supervised execution', text: 'Supervision of layouts, plumbs, levels, slopes, cuts, joints and critical points.' },
  { number: '08', title: 'Testing before closing', text: 'Pipes, drains, waterproofing and electrical points tested before final finishes.' },
  { number: '09', title: 'Finish control', text: 'Joints, silicone, corners, baseboards, fixtures, lighting and cleanliness reviewed.' },
  { number: '10', title: 'Documented handover', text: 'Joint inspection, punch list, final cleaning and written warranty by scope.' }
];

const technicalChecks = [
  { area: 'Bathrooms and wet areas', items: ['Waterproofing before tiling', 'Slopes toward drains', 'Flood testing', 'Seals reviewed'] },
  { area: 'Kitchens', items: ['Electrical and water points coordinated', 'Leveling for cabinetry', 'Hardware checked', 'Task and ambient lighting'] },
  { area: 'Floors and coverings', items: ['Clean and stable substrate', 'Compatible adhesive', 'Joints and plumbs controlled', 'Large-format proper technique'] },
  { area: 'Hidden utilities', items: ['Pipes tested before closing', 'Circuits protected', 'Maintenance access', 'Photo record of critical phases'] }
];

const comparisonRows = [
  ['Decisions improvised during construction', 'Execution plan defined before starting'],
  ['Material selected only by price', 'Material selected for compatibility and durability'],
  ['Walls closed without prior testing', 'Testing and documentation before covering'],
  ['Finishes checked only at the very end', 'Finish control throughout the process'],
  ['Vague or verbal warranty', 'Written warranty tied to specific scopes']
];
---

<BaseLayout
  title="The RemodelaT Method | Luxury Remodeling with Technical Precision"
  description="Discover the RemodelaT Method: technical diagnosis, specified materials, supervised execution, testing before closing, finish control and warranty by scope."
  image="/images/integrales-proyecto-completo.webp"
  activePage="metodo"
>
  <GodHero
    eyebrow="The RemodelaT Method"
    title="Luxury remodeling"
    titleGold="without improvisation"
    lead="A work protocol for homeowners who value technical precision, proper materials, flawless finishes and documented warranties."
    image="/images/integrales-proyecto-completo.webp"
    imageAlt="Luxury remodeling executed with the RemodelaT Method"
    badges={["10 stages", "Testing before closing", "Warranty by scope"]}
    watermark="METHOD"
  >
    <div class="god-hero-actions">
      <a href="/en/contact" class="btn-premium btn-primary-premium"><span class="btn-content">Request technical assessment</span><span class="btn-arrow">→</span></a>
      <a href="/en/projects" class="btn-premium btn-outline-premium"><span class="btn-content">View real projects</span><span class="btn-arrow">→</span></a>
    </div>
  </GodHero>

  <GodMarquee />

  <section class="section" data-reveal>
    <div class="container intro-grid-god">
      <div>
        <span class="eyebrow-god on-light">The standard</span>
        <h2>It is not enough for a project to look good. It has to be built correctly.</h2>
      </div>
      <div class="intro-copy-god">
        <p>The final finish matters, but in high-end remodeling the true difference happens before that: diagnosis, substrate preparation, material specification, technical testing and supervision.</p>
      </div>
    </div>
  </section>

  <section class="section bg-light">
    <div class="container">
      <div class="section-header" data-reveal>
        <span class="eyebrow-god on-light">Work protocol</span>
        <h2>10 stages to control a demanding remodel</h2>
      </div>
      <div class="method-steps-grid-god">
        {methodSteps.map((s) => (
          <article class="method-step-card-god" data-reveal><span>{s.number}</span><h3>{s.title}</h3><p>{s.text}</p></article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container checks-grid-god">
      <div class="checks-heading-god" data-reveal>
        <span class="eyebrow-god on-light">Technical control</span>
        <h2>What we check before the finish hides it</h2>
        <p>Porcelain, shower screen or custom kitchen can look spectacular but if behind there is moisture or poor leveling, it is not luxury: it is risk.</p>
      </div>
      <div class="checks-list-god">
        {technicalChecks.map(c => (
          <article class="check-card-god" data-reveal><h3>{c.area}</h3><ul>{c.items.map(i => <li>{i}</li>)}</ul></article>
        ))}
      </div>
    </div>
  </section>

  <section class="section comparison-god">
    <div class="container">
      <div class="section-header on-dark" data-reveal>
        <span class="eyebrow-god">The difference</span>
        <h2>Improvised work vs. work with a method</h2>
      </div>
      <MethodComparison rows={comparisonRows} leftLabel="Without a method" rightLabel="The RemodelaT Method" />
    </div>
  </section>

  <GuaranteeMatrix lang="en" variant="light" />

  <section class="god-cta">
    <div class="container method-cta-inner">
      <span class="eyebrow-god">Next step</span>
      <h2>If you are looking for the lowest price, we may not be your fit. If you want it done correctly, let’s talk.</h2>
      <a href={`https://wa.me/584227997043?text=${encodeURIComponent(whatsappText)}`} class="btn-premium btn-primary-premium" target="_blank"><span class="btn-content">Talk on WhatsApp</span><span class="btn-arrow">→</span></a>
    </div>
  </section>
</BaseLayout>

<style>
  .container{max-width:1160px;margin:0 auto;padding:0 24px}.section{padding:clamp(72px,10vw,112px) 0}.bg-light{background:var(--bone)}
  .section-header{text-align:center;max-width:720px;margin:0 auto clamp(36px,6vw,64px)}.section-header h2{font-family:var(--font-serif);font-size:clamp(2rem,4vw,2.9rem);line-height:1.08;letter-spacing:-.02em;font-weight:500;margin:12px 0 14px}
  .god-hero-actions{display:flex;gap:14px;flex-wrap:wrap;margin-top:28px}
  .intro-grid-god{display:grid;grid-template-columns:.85fr 1.15fr;gap:48px;align-items:start}.intro-grid-god h2{font-family:var(--font-serif);font-size:clamp(2.1rem,4.4vw,3.3rem);line-height:1.08;letter-spacing:-.02em;font-weight:500}.intro-copy-god p{color:var(--text-muted);font-size:1.06rem;line-height:1.8;margin-bottom:16px}
  .method-steps-grid-god{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}.method-step-card-god{padding:28px 22px;border-radius:var(--r-md);border:var(--hairline-ink);background:var(--white);box-shadow:var(--e-1)}.method-step-card-god span{font-family:var(--font-serif);font-size:2.1rem;color:rgba(201,169,97,.56);display:block;margin-bottom:14px}.method-step-card-god h3{font-family:var(--font-serif);font-size:1.22rem;margin-bottom:8px;color:var(--ink)}.method-step-card-god p{color:var(--text-muted);font-size:.9rem;line-height:1.62}
  .checks-grid-god{display:grid;grid-template-columns:.9fr 1.1fr;gap:48px;align-items:start}.checks-heading-god{position:sticky;top:120px}.checks-heading-god h2{font-family:var(--font-serif);font-size:clamp(2rem,4vw,3.2rem);line-height:1.08;letter-spacing:-.02em;font-weight:500;margin:12px 0 14px}.checks-list-god{display:grid;gap:16px}.check-card-god{padding:28px;border-radius:var(--r-md);background:linear-gradient(180deg,var(--white),var(--bone));border:var(--hairline-ink);box-shadow:var(--e-1)}.check-card-god h3{font-family:var(--font-serif);font-size:1.35rem;margin-bottom:14px}.check-card-god ul{list-style:none;display:grid;gap:10px}.check-card-god li{position:relative;padding-left:26px;color:var(--text-muted);line-height:1.6}.check-card-god li::before{content:"";position:absolute;left:0;top:.62em;width:8px;height:8px;border-radius:50%;background:var(--gold-ink);box-shadow:0 0 0 5px rgba(201,169,97,.12)}
  .comparison-god{background:var(--ink);border-top:var(--hairline);border-bottom:var(--hairline)}.method-cta-inner{max-width:900px;margin:0 auto;text-align:center}.method-cta-inner h2{font-family:var(--font-serif);font-size:clamp(2rem,4.5vw,3.4rem);line-height:1.08;letter-spacing:-.02em;font-weight:500;color:var(--white);margin:14px 0 16px}
  @media(max-width:1100px){.method-steps-grid-god{grid-template-columns:repeat(2,1fr)}.intro-grid-god,.checks-grid-god{grid-template-columns:1fr;gap:32px}.checks-heading-god{position:static}}
  @media(max-width:680px){.method-steps-grid-god{grid-template-columns:1fr}.god-hero-actions{flex-direction:column}}
</style>
