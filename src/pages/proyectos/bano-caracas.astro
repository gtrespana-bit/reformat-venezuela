    {
      src: '/images/proyectos/bano-caracas/bano-principal-finalizado-2.webp',
      alt: 'Detalle de acabados premium en baño principal: mueble ROCA, poceta e iluminación LED',
      title: 'Detalle de Acabados Premium y Perfilería Negra',
      caption: 'Detalle de acabados en la confluencia entre la zona de lavabo con mueble ROCA de 100 cm, el inodoro de doble descarga y el panel fijo de ducha en cristal templado.',
      category: 'principal',
      categoryLabel: 'Baño Principal',
      badge: 'Resultado Final',
      orientation: 'portrait'
    },
    {
      src: '/images/proyectos/bano-caracas/bano-principal-finalizado-3.webp',
      alt: 'Perspectiva integral del baño principal renovado con luces LED 6500K',
      title: 'Perspectiva Integral del Baño Principal Renovado',
      caption: 'Vista general que muestra la amplitud visual, la iluminación por capas con tono blanco 6500K y la elegancia del revestimiento cerámico español con juntas milimétricas.',
      category: 'principal',
      categoryLabel: 'Baño Principal',
      badge: 'Resultado Final',
      orientation: 'portrait'
    },
    {
      src: '/images/proyectos/bano-caracas/bano-principal-mampara-mas-ducha-instalada.webp',
      alt: 'Ducha walk-in instalada con grifería ROCA efecto lluvia negro mate y mampara de cristal templado',
      title: 'Ducha con Grifería ROCA Negro Mate y Mampara Templada',
      caption: 'Zona de ducha con rociador efecto lluvia y teléfono mural en negro mate marca ROCA, separada con mampara de cristal de seguridad templado y perfilería minimalista en aluminio negro.',
      category: 'principal',
      categoryLabel: 'Baño Principal',
      badge: 'Ducha Walk-In',
