  scope: [
    'Demolición completa de cerámica antigua y armario empotrado original',
    'Sustitución integral de plomería por tubería multicapa PEX-Al-PEX',
    'Canalización subterránea de desagües (110mm / 40mm) y agua hacia el nuevo aseo',
    'Construcción de cerramientos en Drywall hidrófugo RH de 13mm en dormitorio',
    'Instalación de porcelanato español gris cemento 60x60 y suelo efecto madera',
    'Técnica premium de doble encolado con cuñas autonivelantes',
    'Griferías ROCA negro mate con sistema de lluvia y mampara de cristal templado',
    'Puerta corredera flotante para accesibilidad de persona mayor con movilidad reducida'
  ],
  specs: [
    { label: 'Revestimiento Paredes', value: 'Porcelanato español importado 60x60 cm (Gris Cemento)' },
    { label: 'Revestimiento Suelos', value: 'Porcelanato efecto madera antideslizante' },
    { label: 'Técnica de Instalación', value: 'Doble encolado + sistema de cuñas autonivelantes' },
    { label: 'Red de Fontanería', value: 'Multicapa PEX-Al-PEX para agua fría y caliente' },
    { label: 'Red de Desagües', value: 'PVC de alta capacidad (110 mm poceta / 40 mm lavabo)' },
    { label: 'Estructura Aseo Adaptado', value: 'Drywall hidrófugo RH 13 mm + perfiles acero 60 mm' },
    { label: 'Mobiliario y Sanitarios', value: 'Mueble 100 cm (baño) y 45 cm (aseo) con grifería ROCA' },
    { label: 'Zona de Ducha', value: 'Rociador lluvia + teléfono mural en negro mate ROCA' },
    { label: 'Mampara de Baño', value: 'Cristal templado de seguridad + perfilería aluminio negro' },
    { label: 'Iluminación', value: 'Espejos LED perimetrales + downlights LED tono 6500K' },
    { label: 'Accesibilidad', value: 'Puerta corredera flotante sin obstáculos de giro' }
  ],
  gallery: [
    // 1. BAÑO PRINCIPAL FINALIZADO
    {
      src: '/images/proyectos/bano-caracas/bano-principal-finalizado-1.webp',
      alt: 'Baño principal finalizado con porcelanato gris cemento 60x60 y suelo efecto madera',
      title: 'Baño Principal Finalizado: Armonía Arquitectónica',
      caption: 'Vista principal del baño terminado. Perfecta combinación entre porcelanato español gris cemento en 60x60, suelo cálido efecto madera antideslizante y luminarias LED 6500K.',
      category: 'principal',
      categoryLabel: 'Baño Principal',
      badge: 'Resultado Final',
      orientation: 'portrait'
