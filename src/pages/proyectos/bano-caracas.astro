const heroImage = project.heroImage;
---

<BaseLayout 
  title={`${project.title} | Caso de Estudio | ReformaT Venezuela`} 
  description={project.description}
  image={heroImage}
  activePage="proyectos"
>
  <!-- 1. EDITORIAL LUXURY HERO -->
  <header class="project-hero">
    <div class="hero-backdrop" aria-hidden="true"></div>
    <div class="container">
      <div class="hero-content">
        <div class="hero-kicker">
          <span class="kicker-badge">CASO DE ESTUDIO</span>
          <span class="kicker-line"></span>
          <span class="kicker-sub">ARQUITECTURA INTERIOR · CARACAS</span>
        </div>

        <h1 class="hero-title">Remodelación de Baño Principal y Creación de Aseo Adaptado</h1>
        
        <p class="hero-subtitle">
          Transformación integral con fontanería multicapa PEX-Al-PEX y reconversión inteligente de un armario empotrado en un aseo accesible con puerta corredera flotante para movilidad reducida.
        </p>

        <!-- Quick Executive Ribbon -->
        <div class="hero-stats-ribbon">
          <div class="stat-item">
            <span class="stat-label">Ubicación</span>
            <span class="stat-value">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="var(--gold)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                <circle cx="12" cy="10" r="3"/>
              </svg>
              Caracas, Venezuela
            </span>
          </div>
          <div class="stat-divider" aria-hidden="true"></div>
          <div class="stat-item">
            <span class="stat-label">Alcance Espacial</span>
            <span class="stat-value">2 Baños (Principal + Aseo Adaptado)</span>
          </div>
          <div class="stat-divider" aria-hidden="true"></div>
          <div class="stat-item">
            <span class="stat-label">Plazo de Obra</span>
            <span class="stat-value">2 Semanas</span>
          </div>
          <div class="stat-divider" aria-hidden="true"></div>
          <div class="stat-item">
            <span class="stat-label">Revestimiento Premium</span>
            <span class="stat-value">Porcelanato Español 60x60</span>
          </div>
          <div class="stat-divider" aria-hidden="true"></div>
          <div class="stat-item">
            <span class="stat-label">Accesibilidad</span>
            <span class="stat-value">Puerta Corredera Flotante</span>
          </div>
        </div>
      </div>
    </div>
  </header>

  <!-- BREADCRUMBS TRAS EL HERO -->
  <nav class="breadcrumb-after-hero" aria-label="Breadcrumb">
    <div class="container">
      <div class="breadcrumb-inner">
        <a href="/">Inicio</a>
        <span class="separator">/</span>
        <a href="/proyectos">Proyectos</a>
        <span class="separator">/</span>
        <span class="current">Baño Principal y Aseo Adaptado</span>
      </div>
    </div>
  </nav>

  <!-- 2. DUAL-SHOWCASE: LOS DOS ESPACIOS DEL PROYECTO (ZERO CROPPING) -->
  <section class="dual-showcase-section">
    <div class="container">
      <div class="section-heading">
        <span class="eyebrow-text">VISTA DOBLE DEL PROYECTO</span>
        <h2 class="editorial-title">Un Reto Arquitectónico en Dos Espacios</h2>
        <p class="editorial-subtitle">
          El proyecto resolvió dos necesidades en paralelo: la modernización total de un baño principal de residencia y la creación de un nuevo aseo accesible en el dormitorio para garantizar proximidad a una persona mayor con movilidad reducida.
        </p>
      </div>

      <div class="showcase-grid">
        <!-- Card 1: Baño Principal -->
        <article class="showcase-card">
          <div class="showcase-image-frame">
            <span class="showcase-badge">Baño Principal · Reforma Integral</span>
            <img 
              src="/images/proyectos/bano-caracas/bano-principal-finalizado-1.webp" 
              alt="Baño principal finalizado con porcelanato español gris cemento 60x60 y suelo efecto madera" 
              loading="eager"
              decoding="async"
            />
          </div>
          <div class="showcase-content">
            <h3 class="showcase-title">Baño Principal Renovado</h3>
            <p class="showcase-desc">
              Reforma integral de suelo a techo con porcelanato español en tono gris cemento (60x60 cm) en paredes, suelo efecto madera cálido, mueble de 100 cm con grifería ROCA, inodoro ecológico de doble descarga y espejo con iluminación LED 6500K.
            </p>
            <ul class="showcase-highlights">
              <li>• Ducha walk-in con grifería ROCA en negro mate efecto lluvia</li>
              <li>• Mampara de cristal templado de seguridad con perfilería negra</li>
              <li>• Tuberías de alimentación nuevas en multicapa PEX-Al-PEX</li>
            </ul>
          </div>
        </article>

        <!-- Card 2: Aseo Adaptado -->
        <article class="showcase-card">
          <div class="showcase-image-frame">
            <span class="showcase-badge">Aseo Adaptado · Ex-Armario Empotrado</span>
            <img 
              src="/images/proyectos/bano-caracas/bano-2-finalizado-1.webp" 
              alt="Nuevo aseo adaptado en antiguo armario empotrado con lavabo de 45 cm y puerta corredera flotante" 
              loading="eager"
              decoding="async"
            />
          </div>
          <div class="showcase-content">
            <h3 class="showcase-title">Aseo Adaptado en Antiguo Armario</h3>
            <p class="showcase-desc">
              Creación desde cero de un aseo compacto en el espacio que ocupaba un armario empotrado. Diseñado para ofrecer la máxima cercanía en el dormitorio a una persona mayor, aprovechando cada centímetro con precisión milimétrica.
            </p>
            <ul class="showcase-highlights">
              <li>• Puerta corredera flotante para facilitar el acceso sin obstáculos</li>
              <li>• Cerramiento hidrófugo en Drywall RH 13 mm altamente resistente</li>
              <li>• Mueble lavabo compacto de 45 cm e inodoro en continuidad estética</li>
            </ul>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- 3. DETAILED TECHNICAL NARRATIVE & SPECS (2-COLUMN EDITORIAL GRID) -->
  <section class="technical-narrative-section">
    <div class="container">
      <div class="narrative-layout">
        <!-- Main Editorial Narrative -->
        <div class="narrative-main">
          <span class="eyebrow-text">MEMORIA TÉCNICA DEL PROYECTO</span>
          <h2 class="editorial-title">Ingeniería, Accesibilidad y Acabados de Alta Especificación</h2>

          <div class="editorial-chapter">
            <h3 class="chapter-title">01. El Reto Espacial y la Prioridad de Accesibilidad</h3>
            <p class="chapter-text">
              Este proyecto supuso una intervención de alta complejidad técnica y humana en una residencia de Caracas. El encargo no se limitaba a modernizar el baño principal existente; la prioridad absoluta del cliente era garantizar autonomía y comodidad para una persona mayor con movilidad reducida que residía en la vivienda.
            </p>
            <p class="chapter-text">
              Para evitar desplazamientos largos, se decidió transformar un antiguo armario empotrado situado dentro del dormitorio en un aseo privado equipado con inodoro y lavabo. Al tratarse de un dormitorio de dimensiones acotadas, el equipo técnico de <strong>ReformaT Venezuela</strong> realizó un estudio milimétrico de la planta para aprovechar cada centímetro disponible sin comprometer la ergonomía ni el paso libre.
            </p>
          </div>

          <div class="editorial-chapter">
            <h3 class="chapter-title">02. Armonía Estética: Porcelanato Español y Suelo Madera</h3>
            <p class="chapter-text">
              Para dotar a la vivienda de una coherencia visual elegante y contemporánea, se implementó exactamente el mismo lenguaje de materiales en ambos espacios:
            </p>
            <ul class="editorial-list">
              <li>
                <strong>Porcelanato español en paredes (60x60 cm):</strong> Se seleccionó una cerámica importada en tono gris cemento que aporta sobriedad arquitectónica, alta resistencia a la humedad y facilidad de mantenimiento.
              </li>
              <li>
                <strong>Porcelanato efecto madera en suelos:</strong> Para contrarrestar el tono neutro de las paredes, se instaló un pavimento porcelánico con textura de madera natural antideslizante, otorgando calidez al tacto visual y máxima seguridad en superficies mojadas.
              </li>
              <li>
                <strong>Técnica de instalación premium:</strong> Toda la cerámica fue colocada utilizando la técnica de <em>doble encolado</em> sobre soporte regularizado, incorporando un <em>sistema de cuñas autonivelantes</em> que elimina cualquier desnivel ("cejas") entre piezas, garantizando juntas milimétricas y perfectamente planas.
              </li>
            </ul>
          </div>

          <div class="editorial-chapter">
            <h3 class="chapter-title">03. Hazaña de Fontanería: Conexión Subterránea y PEX-Al-PEX</h3>
            <p class="chapter-text">
              En el baño principal se ejecutó una demolición completa de todos los revestimientos y soleras antiguas hasta descubrir la albañilería base. Se retiró por completo el sistema de tuberías galvanizadas obsoleto y se rediseñó la infraestructura hidráulica del hogar:
            </p>
            <div class="highlight-callout">
              <span class="callout-badge">SOLUCIÓN INGENIERIL</span>
              <p>
                Como el nuevo aseo (antiguo armario empotrado) no disponía de ninguna toma de agua ni red de saneamiento, durante la remodelación del baño principal <strong>se canalizaron a través del suelo todas las acometidas hacia el nuevo espacio</strong>. Se pasaron conductos de desagüe de PVC de alta capacidad en diámetro de <strong>110 mm (4 pulgadas)</strong> para la poceta e inodoro y de <strong>40 mm (1½ pulgadas)</strong> para el lavabo, además de las líneas de alimentación en tubería multicapa <strong>PEX-Al-PEX</strong> para agua fría y caliente.
              </p>
            </div>
            <p class="chapter-text">
              El uso de tubería multicapa <strong>PEX-Al-PEX</strong> (polietileno reticulado con alma de aluminio) previene corrosiones, fugas e incrustaciones térmicas, garantizando décadas de funcionamiento ininterrumpido. En el baño principal se instaló un inodoro de doble descarga, un mueble de lavabo de 100 cm con grifería ROCA y una zona de ducha con rociador de lluvia y teléfono mural en negro mate marca ROCA, separada por una mampara de cristal de seguridad templado con perfilería negra.
            </p>
          </div>

          <div class="editorial-chapter">
            <h3 class="chapter-title">04. Ingeniería del Aseo Adaptado: Drywall RH y Puerta Corredera Flotante</h3>
            <p class="chapter-text">
              La reconversión del armario en el nuevo aseo requirió una solución estructural ligera, resistente y ultracompacta:
            </p>
            <ul class="editorial-list">
              <li>
                <strong>Cerramiento hidrófugo Drywall RH:</strong> Tras demoler la carpintería del antiguo armario, se montó un cerramiento técnico utilizando perfiles, montantes y canales estructurales de acero galvanizado de <strong>60 mm</strong> y placas de drywall hidrófugo de <strong>13 mm (RH)</strong> especiales para resistir vapor, agua y condiciones prolongadas de humedad.
              </li>
              <li>
                <strong>Puerta corredera flotante:</strong> Para garantizar un acceso sin barreras y no invadir la zona de circulación del dormitorio con el barrido de una puerta abatible tradicional, se diseñó e instaló un sistema de puerta corredera flotante superior. Esta decisión facilitó de forma decisiva el ingreso autónomo de la persona con movilidad reducida.
              </li>
              <li>
                <strong>Optimización de sanitarios:</strong> Se instaló un mueble de lavabo compacto de 45 cm y una poceta ergonómica, logrando un aseo cómodo y visualmente holgado en un espacio donde antes solo existía almacenamiento de ropa.
              </li>
            </ul>
          </div>

          <div class="editorial-chapter">
            <h3 class="chapter-title">05. Iluminación por Capas LED 6500K</h3>
            <p class="chapter-text">
              En ambos baños se prestó especial atención a la iluminación arquitectónica. Se instalaron <strong>espejos con iluminación LED perimetral integrada</strong> y downlights LED de techo en temperatura de color <strong>6500K (blanco puro)</strong>. Esta elección maximiza el confort visual, resalta la textura del porcelanato gris cemento y ofrece una luminosidad clara que evita sombras y previene accidentes de visibilidad en el uso diario.
            </p>
          </div>
        </div>

        <!-- Sticky Sidebar: Technical Specifications & Scope Checklist -->
        <aside class="narrative-sidebar">
          <!-- Card 1: Ficha Técnica -->
          <div class="spec-card">
            <div class="spec-header">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--gold)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                <polyline points="14 2 14 8 20 8"/>
                <line x1="16" y1="13" x2="8" y2="13"/>
                <line x1="16" y1="17" x2="8" y2="17"/>
                <polyline points="10 9 9 9 8 9"/>
              </svg>
              <h3 class="spec-title">Ficha Técnica del Proyecto</h3>
            </div>
            <dl class="spec-list">
              {project.specs.map(item => (
                <div class="spec-row">
                  <dt>{item.label}</dt>
                  <dd>{item.value}</dd>
                </div>
              ))}
            </dl>
          </div>

