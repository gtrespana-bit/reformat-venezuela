      orientation: 'portrait'
    },
    {
      src: '/images/proyectos/bano-caracas/bano-2-armario-convertido-a-bano-con-puerta.webp',
      alt: 'Puerta corredera flotante en aseo adaptado para facilitar el acceso en el dormitorio',
      title: 'Aseo Adaptado: Instalación de Puerta Corredera Flotante',
      caption: 'Solución de accesibilidad para persona mayor con movilidad reducida: puerta corredera flotante que elimina el radio de giro y maximiza la facilidad de acceso en el dormitorio.',
      category: 'aseo',
      categoryLabel: 'Aseo Adaptado',
      badge: 'Accesibilidad',
      orientation: 'portrait'
    },
    // 3. ANTES Y PROCESO DE OBRA
    {
      src: '/images/proyectos/bano-caracas/bano-principal-antes-1.webp',
      alt: 'Baño principal en su estado original antes de la reforma integral',
      title: 'Baño Principal Original: Vista General',
      caption: 'Estado original del baño principal antes de la intervención. Cerámica antigua y distribución convencional que requería una demolición total hasta el soporte.',
      category: 'antes',
      categoryLabel: 'Estado Original',
      badge: 'Estado Original',
      orientation: 'portrait'
    },
    {
      src: '/images/proyectos/bano-caracas/bano-princiapal-antes-2.webp',
      alt: 'Estado original del área de ducha y sanitarios en el baño principal',
      title: 'Baño Principal Original: Zona de Ducha',
      caption: 'Perspectiva anterior del área de ducha y lavabo, con antiguas tuberías galvanizadas y alicatado para reemplazar por red multicapa PEX-Al-PEX.',
      category: 'antes',
      categoryLabel: 'Estado Original',
      badge: 'Estado Original',
      orientation: 'portrait'
    },
    {
      src: '/images/proyectos/bano-caracas/bano-principal-porcelanato-instalacion.webp',
      alt: 'Proceso de instalación de porcelanato 60x60 con cuñas autonivelantes y doble encolado',
      title: 'Instalación de Porcelanato 60x60 con Cuñas Autonivelantes',
      caption: 'Fase de revestimiento utilizando técnica de doble encolado y sistema de cuñas autonivelantes para garantizar planitud absoluta en porcelanato gris cemento (paredes) y efecto madera (suelo).',
      category: 'obra',
      categoryLabel: 'Proceso de Obra',
      badge: 'Proceso de Obra',
      orientation: 'portrait'
    },
    {
      src: '/images/proyectos/bano-caracas/bano-2-armario-convertido-a-bano.webp',
      alt: 'Construcción de estructura en Drywall RH 13mm en antiguo armario empotrado para nuevo aseo',
      title: 'Estructura en Drywall RH: De Armario a Aseo',
      caption: 'Construcción de los cerramientos en Drywall con montantes y canales de 60 mm y placas hidrófugas (RH) de 13 mm sobre el espacio del antiguo armario empotrado del dormitorio.',
      category: 'obra',
      categoryLabel: 'Proceso de Obra',
