---
import BaseLayout from '../../layouts/BaseLayout.astro';

const project = {
  title: 'Remodelación de Baño Principal y Aseo Adaptado',
  location: 'Caracas, Venezuela',
  category: 'Baños & Accesibilidad',
  year: '2024',
  duration: '2 semanas',
  description: 'Reforma integral de baño principal con fontanería multicapa PEX-Al-PEX y conversión arquitectónica de armario empotrado en aseo accesible con puerta corredera flotante para movilidad reducida.',
