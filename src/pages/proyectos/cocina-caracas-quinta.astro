<script>
  function initKitchenGalleryFilters() {
    const filterButtons = document.querySelectorAll<HTMLButtonElement>('.filter-btn[data-filter]');
    const galleryCards = document.querySelectorAll<HTMLElement>('.gallery-card[data-category]');

    if (!filterButtons.length || !galleryCards.length) return;

    filterButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const filter = button.dataset.filter || 'all';

        filterButtons.forEach((btn) => {
          const isActive = btn === button;
          btn.classList.toggle('active', isActive);
          btn.setAttribute('aria-selected', isActive ? 'true' : 'false');
        });

        galleryCards.forEach((card) => {
          const shouldShow = filter === 'all' || card.dataset.category === filter;
          card.classList.toggle('hidden', !shouldShow);
        });
      });
    });
  }

  initKitchenGalleryFilters();
  document.addEventListener('astro:page-load', initKitchenGalleryFilters);
</script>
