---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GuaranteeMatrix from '../../components/GuaranteeMatrix.astro';
import ProjectLightbox from '../../components/ProjectLightbox.astro';
import ProjectReadingGallery from '../../components/ProjectReadingGallery.astro';
import ProjectPhaseGallery from '../../components/ProjectPhaseGallery.astro';
import ProjectBeforeAfterSlider from '../../components/ProjectBeforeAfterSlider.astro';

const project = {
  title: 'Remodelación Integral de Cocina en Quinta',
  location: 'Caracas, Venezuela',
  category: 'Cocinas de Alto Estándar',
  duration: '1 semana',
  heroImage: '/images/proyectos/cocina-caracas-quinta/cocina-finalizada-3.webp',
  excerpt: 'Reforma completa de cocina en quinta de Caracas: desmontaje total, demolición de cerámica existente, actualización eléctrica con cable ignífugo, revestimiento importado rectificado, mobiliario en MDF lacado alto brillo con polímero PVC termoformado, encimera de cuarzo oscuro, inducción y electrodomésticos TEKA.'
};

const technicalHighlights = [
  'Desmontaje completo de muebles existentes y demolición controlada del revestimiento cerámico anterior',
  'Actualización del sistema eléctrico con cable ignífugo de alta calidad para mayor seguridad y durabilidad',
  'Instalación de revestimiento cerámico importado, moderno y rectificado para lograr juntas más limpias y acabado superior',
  'Muebles de cocina con frentes en MDF de 19 mm lacado alto brillo y casco en aglomerado hidrófugo de 16 mm protegido a dos caras',
  'Frentes con foliado de polímero PVC termoformado: acabado continuo, sin juntas visibles y resistente a la humedad en cantos',
  'Encimera de cuarzo en tono oscuro para contraste con el mobiliario blanco y adaptación para fregadero en forma de L',
  'Instalación de placa de inducción, lavavajillas empotrado, columna para microondas, horno y microondas TEKA con garantía de hasta 10 años',
  'Mobiliario con garantía de hasta 25 años según condiciones de fabricante y uso adecuado'
];

const specs = [
  { label: 'Ubicación', value: 'Quinta residencial en Caracas, Venezuela' },
  { label: 'Duración de obra', value: '1 semana de ejecución' },
  { label: 'Alcance', value: 'Desmontaje, demolición, electricidad, revestimiento, muebles, encimera y electrodomésticos' },
  { label: 'Sistema eléctrico', value: 'Actualización con cable ignífugo de alta calidad' },
  { label: 'Revestimiento', value: 'Cerámica importada moderna, tipo rectificado' },
  { label: 'Puertas y frentes', value: 'MDF de 19 mm con acabado lacado alto brillo y polímero PVC termoformado' },
  { label: 'Casco del mueble', value: 'Aglomerado hidrófugo de 16 mm protegido a dos caras' },
  { label: 'Trasera del mueble', value: 'Tablero de 6 mm en color blanco por ambas caras' },
  { label: 'Encimera', value: 'Cuarzo oscuro, adaptado para fregadero en forma de L' },
  { label: 'Electrodomésticos', value: 'Placa de inducción, lavavajillas empotrado, horno y microondas TEKA' },
  { label: 'Garantías', value: 'Hasta 25 años en muebles y hasta 10 años en equipos TEKA según fabricante' }
];

const gallery = [
  {
    src: '/images/proyectos/cocina-caracas-quinta/cocina-finalizada-3.webp',
    alt: 'Cocina finalizada en quinta de Caracas con muebles blancos y encimera oscura',
    title: 'Vista Final: Alto Brillo y Cuarzo Oscuro',
    caption: 'Vista final de la cocina: mobiliario blanco alto brillo, encimera de cuarzo oscuro y composición moderna de alto contraste.',
    category: 'resultado',
    categoryLabel: 'Resultado Final',
    badge: 'Finalizado',
    orientation: 'landscape'
  },
  {
    src: '/images/proyectos/cocina-caracas-quinta/cocina-finalizada-1.webp',
    alt: 'Cocina finalizada con muebles altos y bajos lacados en blanco brillo',
    title: 'Mobiliario Blanco Alto Brillo Instalado',
    caption: 'Muebles terminados con frentes de MDF de 19 mm, acabado lacado alto brillo y foliado PVC termoformado.',
    category: 'resultado',
    categoryLabel: 'Resultado Final',
    badge: 'Mobiliario',
    orientation: 'portrait'
  },
  {
    src: '/images/proyectos/cocina-caracas-quinta/cocina-finalizada-2.webp',
    alt: 'Detalle de cocina terminada con electrodomésticos empotrados',
    title: 'Columna TEKA y Electrodomésticos Integrados',
    caption: 'Integración de electrodomésticos, columna para horno y microondas TEKA, y distribución funcional para uso diario.',
    category: 'resultado',
    categoryLabel: 'Resultado Final',
    badge: 'TEKA',
    orientation: 'portrait'
  },
  {
    src: '/images/proyectos/cocina-caracas-quinta/adaptacion-encimera-fregadero-l.webp',
    alt: 'Adaptación de encimera de cuarzo para fregadero en forma de L',
    title: 'Adaptación de Encimera para Fregadero en L',
    caption: 'Adaptación técnica de encimera de cuarzo oscuro para la instalación de un fregadero en forma de L.',
    category: 'detalles',
    categoryLabel: 'Detalles Técnicos',
    badge: 'Cuarzo',
    orientation: 'landscape'
  },
  {
    src: '/images/proyectos/cocina-caracas-quinta/ultimos-retoques.webp',
    alt: 'Últimos retoques en cocina remodelada de quinta en Caracas',
    title: 'Últimos Retoques y Revisión de Entrega',
    caption: 'Últimos retoques de obra, revisión de ajustes, limpieza visual y preparación para entrega.',
    category: 'detalles',
    categoryLabel: 'Detalles Técnicos',
    badge: 'Entrega',
    orientation: 'portrait'
  },
  {
    src: '/images/proyectos/cocina-caracas-quinta/proceso-montaje-muebles-1.webp',
    alt: 'Proceso de montaje de muebles de cocina en quinta de Caracas',
    title: 'Montaje Inicial de Módulos de Cocina',
    caption: 'Montaje de estructura y módulos de cocina tras actualización de instalaciones y revestimiento.',
    category: 'montaje',
    categoryLabel: 'Montaje de Muebles',
    badge: 'Proceso',
    orientation: 'portrait'
  },
  {
    src: '/images/proyectos/cocina-caracas-quinta/proceso-montaje-muebles-2.webp',
    alt: 'Instalación de módulos y frentes de cocina durante el proceso',
    title: 'Alineación de Módulos y Frentes',
    caption: 'Proceso de instalación de módulos, ajustes y alineación de frentes para lograr una lectura limpia.',
    category: 'montaje',
    categoryLabel: 'Montaje de Muebles',
    badge: 'Proceso',
    orientation: 'portrait'
  },
  {
    src: '/images/proyectos/cocina-caracas-quinta/proceso-montaje-muebles-3.webp',
    alt: 'Montaje de muebles altos y bajos en cocina de Caracas',
    title: 'Muebles Altos y Bajos en Instalación',
    caption: 'Instalación de muebles altos y bajos con control de plomos, niveles y encuentros.',
    category: 'montaje',
    categoryLabel: 'Montaje de Muebles',
    badge: 'Proceso',
    orientation: 'portrait'
  },
  {
    src: '/images/proyectos/cocina-caracas-quinta/proceso-montaje-muebles-4.webp',
    alt: 'Proceso final de montaje de mobiliario de cocina',
    title: 'Ajustes Finales del Mobiliario',
    caption: 'Ajustes finales de mobiliario antes de instalar electrodomésticos, encimera y remates.',
    category: 'montaje',
    categoryLabel: 'Montaje de Muebles',
    badge: 'Proceso',
    orientation: 'portrait'
  },
  {
    src: '/images/proyectos/cocina-caracas-quinta/cocina-antes-1.webp',
    alt: 'Cocina antes de la remodelación completa en quinta de Caracas',
    title: 'Estado Inicial Antes del Desmontaje',
    caption: 'Estado inicial antes del desmontaje completo de muebles y demolición del revestimiento cerámico existente.',
    category: 'antes',
    categoryLabel: 'Antes de Obra',
    badge: 'Antes',
    orientation: 'portrait'
  },
  {
    src: '/images/proyectos/cocina-caracas-quinta/cocina-antes-2.webp',
    alt: 'Estado inicial de cocina antes de reforma en Caracas',
    title: 'Cocina Original: Cerámica y Mobiliario Existente',
    caption: 'Condición previa de la cocina: mobiliario y cerámica existentes antes de la intervención integral.',
    category: 'antes',
    categoryLabel: 'Antes de Obra',
    badge: 'Antes',
    orientation: 'portrait'
  }
];

const featuredFinished = gallery.filter((img) => img.category === 'resultado');

const storyMoments = [
  {
    tag: '01 · Estado previo',
    title: 'La base técnica pedía una intervención completa, no un maquillaje visual',
    body: 'El punto de partida era una cocina con acabados y mobiliario que ya no respondían al estándar de uso, limpieza y lectura visual que pedía la vivienda. Por eso la intervención arrancó con desmontaje total y demolición controlada.',
    image: '/images/proyectos/cocina-caracas-quinta/cocina-antes-1.webp',
    alt: 'Cocina original antes de la reforma completa en una quinta de Caracas',
    caption: 'Mostramos el estado real previo para que el cambio se entienda desde la base y no solo desde la foto final.'
  },
  {
    tag: '02 · Precisión en obra',
    title: 'Revestimiento rectificado y montaje medido para que todo encaje limpio',
    body: 'La mejora premium no depende solo del mueble: empieza en la electricidad, sigue en el replanteo y termina en la alineación visual de piezas, juntas y encuentros. Aquí es donde se construye la sensación de cocina “seria” y bien ejecutada.',
    image: '/images/proyectos/cocina-caracas-quinta/proceso-montaje-muebles-2.webp',
    alt: 'Proceso de montaje y alineación de módulos de cocina durante la obra',
    caption: 'El montaje y la alineación de los frentes determinan la limpieza visual del conjunto.'
  },
  {
    tag: '03 · Entrega final',
    title: 'El contraste entre blanco brillo y cuarzo oscuro le da una lectura mucho más arquitectónica',
    body: 'El resultado final combina frentes blancos continuos, electrodomésticos integrados y una encimera oscura que ordena la composición. La cocina gana presencia, claridad y una percepción claramente más premium desde cualquier ángulo.',
    image: '/images/proyectos/cocina-caracas-quinta/cocina-finalizada-3.webp',
    alt: 'Cocina finalizada con muebles blancos de alto brillo y encimera de cuarzo oscuro',
    caption: 'La composición final equilibra brillo, contraste y funcionalidad sin sobrecargar el espacio.'
  }
];

const galleryPhases = [
  { id: 'resultado', label: 'Resultado final', description: 'Las vistas ya terminadas muestran la composición completa, la integración de equipos y el contraste entre frentes blancos y cuarzo oscuro.' },
  { id: 'detalles', label: 'Detalles técnicos', description: 'Aquí se aprecian los remates, la adaptación de la encimera y las decisiones que elevan el acabado.' },
  { id: 'montaje', label: 'Montaje de muebles', description: 'Fase intermedia donde se ve la alineación de módulos, ajustes y control de encuentros.' },
  { id: 'antes', label: 'Estado previo', description: 'Punto de partida real de la cocina antes del desmontaje y la reforma integral.' }
];

const whatsappText = 'Hola, quiero una valoración técnica para una cocina similar a la quinta en Caracas.';
---

<BaseLayout
  title={`${project.title} en Caracas | Caso de Estudio | RemodelaT Venezuela`}
  description={project.excerpt}
  image={project.heroImage}
  activePage="proyectos"
>
  <header class="case-hero">
    <img src={project.heroImage} alt={project.title} class="case-hero-img" fetchpriority="high" loading="eager" decoding="async" />
    <div class="case-hero-overlay"></div>
    <div class="container case-hero-content">
      <a href="/proyectos" class="back-link">← Volver a Proyectos</a>
      <span class="case-eyebrow">Caso real · {project.category}</span>
      <h1>{project.title} en Caracas</h1>
      <p>{project.excerpt}</p>
      <div class="case-facts" aria-label="Datos del proyecto">
        <span><strong>Ubicación</strong>{project.location}</span>
        <span><strong>Duración</strong>{project.duration}</span>
        <span><strong>Alcance</strong>Reforma completa de cocina</span>
        <span><strong>Fotos reales</strong>{gallery.length} imágenes del caso</span>
      </div>
      <div class="case-hero-actions">
        <a href="#galeria" class="btn-premium btn-primary-premium">
          <span class="btn-content">Ver galería completa</span>
          <span class="btn-border"></span>
          <span class="btn-arrow">→</span>
        </a>
        <a href={`https://wa.me/584227997043?text=${encodeURIComponent(whatsappText)}`} class="btn-premium btn-outline-premium" target="_blank" rel="noopener">
          <span class="btn-content">Solicitar valoración</span>
          <span class="btn-arrow">→</span>
        </a>
      </div>
    </div>
  </header>

  <section class="finished-showcase-section section" id="resultado">
    <div class="container">
      <div class="section-header showcase-header">
        <span class="tag">Resultado final</span>
        <h2 class="section-title">La cocina terminada, visible desde el inicio</h2>
        <p class="section-desc">Antes de entrar en el detalle técnico, mostramos el resultado final: muebles blancos alto brillo, encimera de cuarzo oscuro, columna TEKA y una lectura moderna para una quinta en Caracas.</p>
      </div>
      <div class="finished-showcase-grid">
        {featuredFinished.map((image, index) => (
          <figure class:list={["finished-card", index === 0 && 'is-wide']}>
            <img src={image.src} alt={image.alt} loading={index === 0 ? 'eager' : 'lazy'} decoding="async" />
            <figcaption>
              <span>{image.badge}</span>
              <strong>{image.title}</strong>
              <p>{image.caption}</p>
              <button class="expand-photo-btn" type="button" data-lightbox-open data-src={image.src}>Ampliar foto</button>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="case-overview section">
    <div class="container overview-grid">
      <article>
        <span class="tag">El reto</span>
        <h2>Actualizar una cocina de quinta sin limitarse a un cambio estético</h2>
        <p>La cocina existente requería una intervención completa: desmontaje de muebles, demolición del material cerámico anterior, actualización eléctrica, nuevo revestimiento y montaje de mobiliario moderno con mayor resistencia a humedad, golpes y uso diario.</p>
      </article>
      <article>
        <span class="tag">La solución</span>
        <h2>Una cocina blanca de alto brillo con contraste técnico en cuarzo oscuro</h2>
        <p>Se renovó la base técnica de la cocina, se instaló cerámica importada rectificada y se montó mobiliario con frentes en MDF de 19 mm y polímero PVC termoformado. La encimera de cuarzo oscuro aporta contraste, resistencia y una lectura más elegante del conjunto.</p>
      </article>
    </div>
  </section>

  <ProjectBeforeAfterSlider
    id="comparativa"
    eyebrow="Comparativa principal"
    title="Desliza para ver el salto entre la cocina original y el resultado final"
    text="La mejora no se limita al color o al mobiliario nuevo. El cambio real está en la limpieza visual, la integración técnica y la calidad percibida de toda la composición."
    beforeSrc="/images/proyectos/cocina-caracas-quinta/cocina-antes-1.webp"
    beforeAlt="Cocina original antes de la reforma integral en la quinta de Caracas"
    afterSrc="/images/proyectos/cocina-caracas-quinta/cocina-finalizada-3.webp"
    afterAlt="Cocina finalizada con mobiliario blanco de alto brillo y cuarzo oscuro en Caracas"
    beforeLabel="Antes"
    afterLabel="Después"
    beforeCaption="Estado previo con acabados y mobiliario que ya no daban la presencia ni la funcionalidad que pedía la vivienda."
    afterCaption="La nueva composición gana limpieza visual, mejor integración y una lectura mucho más premium."
    showLightboxButtons={false}
  />

  <ProjectReadingGallery
    eyebrow="Recorrido visual"
    title="La obra explicada por fases clave"
    intro="Este tramo combina relato e imagen para que el visitante entienda qué se transformó, cómo se ejecutó y por qué el resultado se percibe mucho más sólido y elegante."
    items={storyMoments}
    galleryGroup="kitchen-story"
  />

  <section class="case-technical section bg-light" id="tecnica">
    <div class="container technical-grid">
      <div class="technical-copy">
        <span class="tag">Ejecución técnica</span>
        <h2>Detalles que explican por qué esta cocina está pensada para durar</h2>
        <p>El resultado final depende de lo visible y de lo oculto: electricidad segura, revestimiento bien instalado, muebles resistentes a humedad, cantos sellados, electrodomésticos integrados y una encimera adaptada con precisión.</p>
      </div>
      <div class="technical-list">
        {technicalHighlights.map((item) => (
          <div class="technical-item">{item}</div>
        ))}
      </div>
    </div>
  </section>

  <section class="material-section section">
    <div class="container material-grid">
      <div>
        <span class="tag">Mobiliario</span>
        <h2>Polímero PVC termoformado: brillo, continuidad y resistencia</h2>
        <p>El acabado exterior visible de los frentes es un foliado de polímero PVC termoformado. El PVC se moldea con calor directamente sobre el MDF, cubriendo frente y bordes en una sola pieza continua.</p>
      </div>
      <div class="benefit-card-grid">
        <article><h3>Sin juntas visibles</h3><p>El polímero termosellado cubre frente y cantos, reduciendo puntos por donde podría penetrar humedad.</p></article>
        <article><h3>Fácil limpieza</h3><p>Es un material impermeable, de baja absorción y muy práctico para el uso diario de cocina.</p></article>
        <article><h3>Resistencia cotidiana</h3><p>Soporta mejor golpes y roces habituales frente a un lacado directo sobre madera.</p></article>
      </div>
    </div>
  </section>

  <section class="induction-section section bg-light">
    <div class="container induction-grid">
      <div class="induction-card">
        <span class="tag">Equipamiento</span>
        <h2>Placa de inducción, lavavajillas integrado y columna TEKA</h2>
        <p>La placa de inducción mejora la eficiencia, calienta más rápido, reduce pérdidas de energía y aporta una superficie más segura y fácil de limpiar. Además, al generar calor directamente en el recipiente, permite mayor control de temperatura y una cocina más cómoda para el uso diario.</p>
        <p>Se integró lavavajillas empotrado y una columna para horno y microondas TEKA, con garantía de hasta 10 años según fabricante.</p>
      </div>
      <div class="image-card">
        <img src="/images/proyectos/cocina-caracas-quinta/cocina-finalizada-2.webp" alt="Columna de horno y microondas TEKA en cocina remodelada" loading="lazy" decoding="async" />
      </div>
    </div>
  </section>

  <section class="case-specs section" id="ficha">
    <div class="container specs-grid">
      <div>
        <span class="tag">Especificaciones</span>
        <h2>Materiales, sistemas y garantías del proyecto</h2>
      </div>
      <div class="spec-list">
        {specs.map((spec) => (
          <div class="spec-row">
            <strong>{spec.label}</strong>
            <span>{spec.value}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <ProjectPhaseGallery
    eyebrow="Archivo fotográfico completo"
    title={`Galería ordenada por fases (${gallery.length} fotos reales)`}
    intro="La galería ya no mezcla todo en una sola rejilla: cada fase se presenta como un bloque propio para que el proyecto se lea mejor y las fotos respiren más."
    items={gallery}
    phases={galleryPhases}
    id="galeria"
  />

  <GuaranteeMatrix compact />

  <section class="case-cta">
    <div class="container case-cta-inner">
      <span class="tag tag-on-dark">Valoración técnica</span>
      <h2>¿Quieres una cocina ejecutada con este nivel de control?</h2>
      <p>Cuéntanos ubicación, tipo de vivienda, alcance, nivel de acabado y fecha estimada. Revisamos si el proyecto encaja con nuestro estándar y te orientamos con una valoración técnica.</p>
      <a href={`https://wa.me/584227997043?text=${encodeURIComponent(whatsappText)}`} class="btn-premium btn-primary-premium" target="_blank" rel="noopener">
        <span class="btn-content">Solicitar valoración técnica</span>
        <span class="btn-border"></span>
        <span class="btn-arrow">→</span>
      </a>
    </div>
  </section>
  <ProjectLightbox />
</BaseLayout>

<style>
  .case-hero { position: relative; min-height: 86vh; display: flex; align-items: flex-end; color: var(--white); background: var(--ink); overflow: hidden; padding: 145px 0 85px; }
  .case-hero-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: .78; }
  .case-hero-overlay { position: absolute; inset: 0; background: linear-gradient(90deg, rgba(20,18,14,.96), rgba(20,18,14,.72) 48%, rgba(20,18,14,.26)), linear-gradient(to top, rgba(20,18,14,.95), transparent 58%); }
  .case-hero-content { position: relative; z-index: 2; max-width: 980px; }
  .back-link { display: inline-block; color: var(--gold); font-weight: 700; letter-spacing: .08em; text-transform: uppercase; font-size: .82rem; margin-bottom: 24px; }
  .case-eyebrow { display: inline-block; color: var(--gold-light); font-size: .78rem; text-transform: uppercase; letter-spacing: .16em; font-weight: 800; margin-bottom: 18px; }
  .case-hero h1 { font-family: var(--font-serif); font-size: clamp(2.75rem, 6vw, 5.7rem); line-height: 1; letter-spacing: var(--track-tight); font-weight: 500; max-width: 900px; margin: 0 0 22px; }
  .case-hero p { max-width: 800px; color: rgba(255,255,255,.84); font-size: clamp(1.06rem, 2vw, 1.25rem); line-height: 1.72; margin: 0 0 32px; }
  .case-facts { display: flex; flex-wrap: wrap; border: 1px solid rgba(201,169,97,.28); border-radius: var(--r-lg); overflow: hidden; background: rgba(255,255,255,.06); backdrop-filter: blur(12px); max-width: 920px; }
  .case-facts span { padding: 18px 24px; min-width: 210px; border-right: 1px solid rgba(201,169,97,.18); color: rgba(255,255,255,.9); }
  .case-facts span:last-child { border-right: 0; }
  .case-facts strong { display: block; color: var(--gold); font-size: .72rem; letter-spacing: .13em; text-transform: uppercase; margin-bottom: 6px; }
  .case-hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 26px;
  }
  .case-hero-actions .btn-premium {
    min-height: 54px;
  }

  .finished-showcase-section { background: var(--white); padding-bottom: var(--s-5); }
  .showcase-header { max-width: 820px; }
  .finished-showcase-grid {
    display: grid;
    grid-template-columns: 1.35fr .82fr .82fr;
    gap: 22px;
    align-items: stretch;
  }
  .finished-card {
    margin: 0;
    position: relative;
    overflow: hidden;
    border-radius: var(--r-lg);
    background: var(--ink);
    min-height: 520px;
    box-shadow: var(--e-3);
    border: 1px solid rgba(201,169,97,.22);
  }
  .finished-card.is-wide { min-height: 520px; }
  .finished-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    opacity: .94;
    transition: transform var(--dur-slow) var(--ease-out);
  }
  .finished-card:hover img { transform: scale(1.035); }
  .finished-card figcaption {
    position: absolute;
    inset: auto 0 0;
