  },
  {
    src: '/images/proyectos/cocina-lujo-guataparo/proceso-entrada-cerrada-tabique.webp',
    alt: 'Antiguo acceso condenado con bloque y tabique',
    title: 'Antiguo Acceso Condenado',
    caption: 'Condenado del antiguo acceso a la cocina con bloque de 20 cm y enfoscado de mortero de cemento con acabado fino.',
