---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GuaranteeMatrix from '../../components/GuaranteeMatrix.astro';
import ProjectLightbox from '../../components/ProjectLightbox.astro';
import ProjectReadingGallery from '../../components/ProjectReadingGallery.astro';
import ProjectPhaseGallery from '../../components/ProjectPhaseGallery.astro';
import ProjectBeforeAfterSlider from '../../components/ProjectBeforeAfterSlider.astro';

const project = {
  title: 'Remodelación de Cocina de Lujo con Cambio de Ubicación',
  location: 'Guataparo, Valencia, Carabobo',
  category: 'Cocinas de Alto Estándar',
  duration: '2 semanas',
  heroImage: '/images/proyectos/cocina-lujo-guataparo/cocina-finalizada-2.webp',
  excerpt: 'Reforma integral de cocina en quinta de lujo en Guataparo con cambio total de ubicación: desmontaje, condenado del antiguo acceso con bloque de 20 cm, renovación eléctrica y de plomería, sustitución del termo eléctrico por placas solares térmicas, suelo autonivelante con epoxi blanco, estantería flotante con tira LED y muebles bajos minimalistas con nevera importada de 90 cm Siemens.'
};

const technicalHighlights = [
  'Cambio de ubicación de la cocina a una nueva habitación y desmontaje completo del mobiliario original',
  'Renovación integral de la parte eléctrica y de la fontanería / plomería para adaptarse a la nueva distribución',
  'Desmontaje y condenado del termo eléctrico anterior, sustituido por placas solares térmicas para el calentamiento de agua',
  'Condenado del antiguo acceso a la cocina con bloque de 20 cm y enfoscado de mortero de cemento con acabado fino',
  'Nuevas ranuras en paredes y suelos con tubería corrugada flexible para la instalación de los cables',
  'Suelo nivelado con autonivelante, imprimación y acabado en epoxi totalmente blanco para una sensación de continuidad perfecta',
  'Estantería flotante a todo lo largo de la cocina con tira LED inferior y superior invisible a la vista',
  'Composición minimalista con solo muebles bajos, lavavajillas, horno y nevera importada de 90 cm de la marca Siemens'
];

const specs = [
  { label: 'Ubicación', value: 'Quinta de lujo en Guataparo, Valencia, Carabobo' },
  { label: 'Duración de obra', value: '2 semanas de ejecución' },
  { label: 'Alcance', value: 'Cambio de ubicación, desmontaje, electricidad, plomería, suelo y montaje de cocina' },
  { label: 'Agua caliente', value: 'Placas solares térmicas (termo eléctrico desmontado y condenado)' },
  { label: 'Antiguo acceso', value: 'Condenado con bloque de 20 cm y enfoscado de cemento con acabado fino' },
  { label: 'Instalaciones', value: 'Nuevas ranuras en paredes y suelos con tubería corrugada flexible para cables' },
  { label: 'Suelo', value: 'Autonivelante + imprimación + epoxi blanco para continuidad perfecta' },
  { label: 'Mobiliario', value: 'Solo muebles bajos, estética minimalista' },
  { label: 'Estantería', value: 'Flotante a todo lo largo con tira LED inferior y superior invisible' },
  { label: 'Electrodomésticos', value: 'Lavavajillas, horno y nevera importada de 90 cm de la marca Siemens' }
];

const gallery = [
  {
    src: '/images/proyectos/cocina-lujo-guataparo/cocina-finalizada-2.webp',
    alt: 'Cocina de lujo finalizada en quinta de Guataparo con estantería flotante y muebles bajos blancos',
