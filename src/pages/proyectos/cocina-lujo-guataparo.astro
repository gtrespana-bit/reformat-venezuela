---

<BaseLayout
  title="Cocina de Lujo en Guataparo, Valencia | Caso Real Paso a Paso | RemodelaT"
  description={project.excerpt}
  image={project.heroImage}
  activePage="proyectos"
>
  <!-- ============ HERO EDITORIAL ============ -->
  <header class="gu-hero">
    <img
      src={project.heroImage}
      alt="Cocina de lujo terminada en quinta de Guataparo, Valencia: línea de muebles bajos blancos, estantería flotante iluminada y suelo epóxico continuo"
      class="gu-hero-img"
      fetchpriority="high"
      loading="eager"
      decoding="async"
    />
    <div class="gu-hero-overlay" aria-hidden="true"></div>
    <div class="container gu-hero-content">
      <a href="/proyectos" class="gu-back">← Volver a proyectos</a>
      <span class="gu-eyebrow">{project.kicker}</span>
      <h1>{project.title}</h1>
      <p class="gu-lead">{project.excerpt}</p>

      <dl class="gu-facts" aria-label="Ficha del proyecto">
        {heroFacts.map((fact) => (
          <div class="gu-fact">
            <dt>{fact.label}</dt>
            <dd>{fact.value}</dd>
          </div>
        ))}
      </dl>

      <div class="gu-hero-actions">
        <a href="#paso-a-paso" class="btn-premium btn-primary-premium">
          <span class="btn-content">Ver el paso a paso</span>
          <span class="btn-border"></span>
          <span class="btn-arrow">→</span>
        </a>
        <a href={whatsappHref} class="btn-premium btn-outline-premium" target="_blank" rel="noopener">
          <span class="btn-content">Solicitar valoración</span>
          <span class="btn-arrow">→</span>
        </a>
      </div>
    </div>
  </header>

  <!-- ============ NAVEGACIÓN RÁPIDA STICKY ============ -->
  <ProjectQuickNav
    items={quickNavItems}
    ctaHref={whatsappHref}
    ctaLabel="Solicitar valoración"
    summary="Reubicación integral de cocina en quinta de Guataparo, documentada fase a fase."
  />

  <!-- ============ MIGAS DE PAN ============ -->
  <nav class="gu-breadcrumb" aria-label="Breadcrumb">
    <div class="container gu-breadcrumb-inner">
      <a href="/">Inicio</a>
      <span class="gu-sep">/</span>
      <a href="/proyectos">Proyectos</a>
      <span class="gu-sep">/</span>
      <span class="gu-current">Cocina de Lujo en Guataparo</span>
    </div>
  </nav>

  <!-- ============ 01 · RESUMEN ============ -->
  <section class="section gu-summary" id="resumen">
    <div class="container">
      <div class="section-header">
        <span class="tag">En síntesis</span>
        <h2 class="section-title">De cocina cerrada a corazón abierto de la quinta</h2>
        <p class="section-desc">
          Una intervención que no se limitó a cambiar acabados: la cocina cambió de habitación,
          de concepto y de relación con el resto de la vivienda.
        </p>
      </div>

      <div class="gu-summary-grid">
        <article class="gu-summary-card">
