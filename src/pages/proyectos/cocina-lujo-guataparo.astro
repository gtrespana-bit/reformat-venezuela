    category: 'antes',
    categoryLabel: 'Estado Previo',
    badge: 'Antes',
    orientation: 'portrait'
  },
  {
    src: '/images/proyectos/cocina-lujo-guataparo/antes-nueva-ubicacion.webp',
    alt: 'Nueva ubicación prevista para la cocina',
    title: 'La Nueva Ubicación de la Cocina',
    caption: 'Espacio que albergaría la nueva cocina, requiriendo una renovación eléctrica y de plomería completa.',
    category: 'antes',
    categoryLabel: 'Estado Previo',
    badge: 'Antes',
    orientation: 'landscape'
  },
  {
    src: '/images/proyectos/cocina-lujo-guataparo/antes-ubicacion-1.webp',
    alt: 'Ubicación anterior de la cocina antes de la reforma',
    title: 'Cocina Original en su Antigua Ubicación',
    caption: 'Estado previo de la cocina original, totalmente independiente y separada de la sala de estar y el comedor.',
    category: 'antes',
    categoryLabel: 'Estado Previo',
    badge: 'Antes',
    orientation: 'portrait'
  },
  {
    src: '/images/proyectos/cocina-lujo-guataparo/antes-ubicacion-2.webp',
    alt: 'Otra vista de la ubicación anterior de la cocina',
    title: 'Vista de la Cocina Original',
    caption: 'Otra vista de la cocina original separada del resto de la vivienda antes de la intervención integral.',
    category: 'antes',
    categoryLabel: 'Estado Previo',
    badge: 'Antes',
    orientation: 'portrait'
  },
  {
    src: '/images/proyectos/cocina-lujo-guataparo/antes-ubicacion-3.webp',
    alt: 'Vista de la antigua cocina antes de la reforma',
    title: 'Lectura Visual del Espacio Original',
    caption: 'Lectura visual del espacio original antes del desmontaje y el cambio de ubicación.',
    category: 'antes',
    categoryLabel: 'Estado Previo',
    badge: 'Antes',
    orientation: 'portrait'
  },
  {
    src: '/images/proyectos/cocina-lujo-guataparo/antes-ubicacion-4.webp',
    alt: 'Detalle de la antigua cocina antes de la reforma',
    title: 'Detalle del Estado Previo',
    caption: 'Detalle del estado previo de la cocina antes del cambio de ubicación y la reforma integral.',
    category: 'antes',
    categoryLabel: 'Estado Previo',
    badge: 'Antes',
    orientation: 'landscape'
  }
];

const featuredFinished = gallery.filter((img) => img.category === 'resultado');

const storyMoments = [
  {
    tag: '01 · Estado previo',
    title: 'La cocina estaba separada y aislada; el cambio exigía intervenir en toda la vivienda',
    body: 'El punto de partida era una cocina totalmente independiente, separada de la sala de estar y el comedor y conectada por una puerta doble de gran tamaño. Para ganar una lectura integrada y abierta, la cocina se trasladó a una nueva ubicación, lo que obligó a rehacer instalaciones y obra por completo.',
    image: '/images/proyectos/cocina-lujo-guataparo/antes-ubicacion-1.webp',
    alt: 'Cocina original en su antigua ubicación, separada del resto de la vivienda',
    caption: 'Mostramos el estado real previo para que el cambio se entienda desde la base y no solo desde la foto final.'
  },
  {
    tag: '02 · Obra e instalaciones',
    title: 'Electricidad, plomería y suelo se rehicieron por completo para la nueva ubicación',
    body: 'Se condenó el antiguo acceso con bloque de 20 cm, se renovaron las instalaciones eléctricas y de fontanería con nuevas ranuras y tubería corrugada, se sustituyó el termo eléctrico por placas solares térmicas y se niveló el suelo con autonivelante, imprimación y epoxi blanco para una continuidad perfecta.',
    image: '/images/proyectos/cocina-lujo-guataparo/proceso-autonivelante-suelo.webp',
    alt: 'Aplicación de autonivelante para nivelar el suelo de la nueva cocina',
    caption: 'El suelo, los acabados y las instalaciones ocultas son la base del resultado final.'
  },
  {
    tag: '03 · Montaje y resultado',
    title: 'Una sola estantería flotante ordena toda la cocina con una lectura minimalista',
    body: 'El resultado combina una estantería flotante a todo lo largo con tira LED inferior y superior invisible, solo muebles bajos y electrodomésticos Siemens integrados. La composición final es limpia, luminosa y totalmente integrada con el resto de la vivienda.',
    image: '/images/proyectos/cocina-lujo-guataparo/cocina-finalizada-2.webp',
    alt: 'Cocina finalizada en su nueva ubicación con estantería flotante y muebles bajos',
    caption: 'La composición final equilibra iluminación, continuidad y funcionalidad sin sobrecargar el espacio.'
  }
];

const galleryPhases = [
  { id: 'resultado', label: 'Resultado final', description: 'Las vistas ya terminadas muestran la composición minimalista, la estantería flotante y la integración de los equipos Siemens.' },
  { id: 'montaje', label: 'Montaje de cocina', description: 'Fase intermedia donde se ve la instalación de la estantería flotante, los muebles bajos y su iluminación oculta.' },
  { id: 'proceso', label: 'Proceso de instalaciones', description: 'Desmontaje, condenado del antiguo acceso, ranuras, tubería corrugada y la preparación del suelo autonivelante.' },
  { id: 'antes', label: 'Estado previo', description: 'Punto de partida real de la cocina original, separada y aislada del resto de la vivienda.' }
];

const whatsappText = 'Hola, quiero una valoración técnica para una cocina similar a la de la quinta en Guataparo.';
---

<BaseLayout
  title={`${project.title} en Guataparo | RemodelaT`}
  description={project.excerpt}
  image={project.heroImage}
  activePage="proyectos"
>
  <header class="case-hero">
    <img src={project.heroImage} alt={project.title} class="case-hero-img" fetchpriority="high" loading="eager" decoding="async" />
    <div class="case-hero-overlay"></div>
    <div class="container case-hero-content">
      <a href="/proyectos" class="back-link">← Volver a Proyectos</a>
      <span class="case-eyebrow">Caso real · {project.category}</span>
      <h1>{project.title} en Guataparo</h1>
      <p>{project.excerpt}</p>
      <div class="case-facts" aria-label="Datos del proyecto">
        <span><strong>Ubicación</strong>{project.location}</span>
        <span><strong>Duración</strong>{project.duration}</span>
        <span><strong>Alcance</strong>Cambio de ubicación y reforma completa</span>
        <span><strong>Fotos reales</strong>{gallery.length} imágenes del caso</span>
      </div>
      <div class="case-hero-actions">
        <a href="#galeria" class="btn-premium btn-primary-premium">
          <span class="btn-content">Ver galería completa</span>
          <span class="btn-border"></span>
          <span class="btn-arrow">→</span>
        </a>
        <a href={`https://wa.me/584227997043?text=${encodeURIComponent(whatsappText)}`} class="btn-premium btn-outline-premium" target="_blank" rel="noopener">
          <span class="btn-content">Solicitar valoración</span>
          <span class="btn-arrow">→</span>
        </a>
      </div>
      <p class="case-hero-proof">{gallery.length} fotos reales · recorrido por fases · ampliación detallada en cada imagen</p>
    </div>
  </header>

  <nav class="breadcrumb-after-hero" aria-label="Breadcrumb">
    <div class="container">
      <div class="breadcrumb-inner">
        <a href="/">Inicio</a>
        <span class="separator">/</span>
        <a href="/proyectos">Proyectos</a>
        <span class="separator">/</span>
        <span class="current">Cocina de Lujo Guataparo</span>
      </div>
    </div>
  </nav>

  <section class="finished-showcase-section section" id="resultado">
    <div class="container">
      <div class="section-header showcase-header">
        <span class="tag">Resultado final</span>
        <h2 class="section-title">La cocina terminada, visible desde el inicio</h2>
        <p class="section-desc">Antes de entrar en el detalle técnico, mostramos el resultado final: estantería flotante a todo lo largo, muebles bajos, epoxi blanco y equipamiento Siemens en la nueva ubicación.</p>
      </div>
      <div class="finished-showcase-grid">
        {featuredFinished.map((image, index) => (
          <figure class:list={["finished-card", index === 0 && 'is-wide']}>
            <img src={image.src} alt={image.alt} loading={index === 0 ? 'eager' : 'lazy'} decoding="async" />
            <figcaption>
              <span>{image.badge}</span>
              <strong>{image.title}</strong>
              <p>{image.caption}</p>
              <button class="expand-photo-btn" type="button" data-lightbox-open data-src={image.src}>Ampliar foto</button>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="case-overview section">
    <div class="container overview-grid">
      <article>
        <span class="tag">El reto</span>
        <h2>Trasladar una cocina separada y aislada a una ubicación integrada</h2>
        <p>La cocina original era independiente y estaba separada de la sala de estar y el comedor por una puerta doble de gran tamaño. El reto no era solo renovar acabados: había que mover la cocina en su totalidad, rehacer la electricidad y la plomería, condenar el antiguo acceso y ganar una lectura abierta e integrada de toda la vivienda.</p>
      </article>
      <article>
        <span class="tag">La solución</span>
        <h2>Una cocina minimalista con estantería flotante y epoxi blanco continuo</h2>
        <p>Se desmontó la cocina completa, se condenó el antiguo acceso con bloque de 20 cm, se renovaron las instalaciones y se sustituyó el termo eléctrico por placas solares térmicas. El suelo se niveló con autonivelante e imprimación y se terminó en epoxi blanco, mientras la estantería flotante con tira LED ordena todo el espacio con una lectura limpia y premium.</p>
      </article>
    </div>
  </section>

  <ProjectBeforeAfterSlider
    id="comparativa"
    eyebrow="Comparativa principal"
    title="De una cocina separada y aislada a un espacio integrado y continuo"
    text="La mejora no se limita al mobiliario nuevo. El cambio real está en la reubicación, la integración técnica, la continuidad del suelo y la lectura arquitectónica de toda la vivienda."
    beforeSrc="/images/proyectos/cocina-lujo-guataparo/antes-ubicacion-1.webp"
    beforeAlt="Cocina original separada y aislada antes de la reforma en Guataparo"
    afterSrc="/images/proyectos/cocina-lujo-guataparo/cocina-finalizada-2.webp"
    afterAlt="Cocina finalizada en su nueva ubicación con estantería flotante y muebles bajos"
    beforeLabel="Antes"
    afterLabel="Después"
    beforeCaption="Estado previo: cocina independiente, separada de la sala de estar y el comedor por una puerta doble."
    afterCaption="La nueva cocina, integrada en la vivienda, gana continuidad, iluminación y una lectura mucho más premium."
    showLightboxButtons={false}
  />

  <ProjectReadingGallery
    eyebrow="Recorrido visual"
    title="La obra explicada por fases clave"
    intro="Este tramo combina relato e imagen para que el visitante entienda qué se transformó, cómo se ejecutó y por qué el resultado se percibe mucho más sólido y elegante."
    items={storyMoments}
    galleryGroup="cocina-guataparo-story"
  />

  <section class="case-technical section bg-light" id="tecnica">
    <div class="container technical-grid">
      <div class="technical-copy">
        <span class="tag">Ejecución técnica</span>
        <h2>Detalles que explican por qué este cambio de cocina transforma la vivienda</h2>
        <p>El resultado final depende de lo visible y de lo oculto: instalaciones renovadas, antiguo acceso condenado, agua caliente con placas solares, suelo epoxi continuo y una estantería flotante con iluminación invisible.</p>
      </div>
      <div class="technical-list">
        {technicalHighlights.map((item) => (
          <div class="technical-item">{item}</div>
        ))}
      </div>
    </div>
  </section>

  <section class="material-section section">
    <div class="container material-grid">
      <div>
        <span class="tag">Mobiliario</span>
        <h2>Estantería flotante: una sola línea que ordena toda la cocina</h2>
        <p>En lugar de muebles altos, la cocina apuesta por una estantería flotante a todo lo largo con tira LED inferior y superior invisible a la vista. Combinada con solo muebles bajos, genera una lectura minimalista, luminosa y continua sin interrumpir el espacio.</p>
      </div>
      <div class="benefit-card-grid">
        <article><h3>Iluminación invisible</h3><p>Tira LED inferior y superior oculta que aporta luz ambiental sin elementos visibles que rompan la línea.</p></article>
        <article><h3>Lectura minimalista</h3><p>Solo muebles bajos y una estantería continua: menos piezas, más amplitud y orden visual.</p></article>
        <article><h3>Continuidad del espacio</h3><p>Al eliminar los muebles altos, la cocina se integra de forma natural con la sala y el comedor.</p></article>
      </div>
    </div>
  </section>

  <section class="induction-section section bg-light">
    <div class="container induction-grid">
      <div class="induction-card">
        <span class="tag">Suelo y equipamiento</span>
        <h2>Suelo autonivelante con epoxi blanco y electrodomésticos Siemens</h2>
        <p>Para una sensación de continuidad perfecta, el suelo se niveló con autonivelante, se aplicó imprimación y se terminó en epoxi totalmente blanco. El resultado es una superficie continua, limpia y fácil de mantener que une visualmente todos los espacios.</p>
        <p>La instalación se completó con lavavajillas, horno y una nevera importada de 90 cm, todo de la marca Siemens, integrados en la composición minimalista de muebles bajos.</p>
      </div>
      <div class="image-card">
        <img src="/images/proyectos/cocina-lujo-guataparo/cocina-finalizada-1.webp" alt="Nevera importada de 90 cm y electrodomésticos Siemens integrados en la cocina" loading="lazy" decoding="async" />
      </div>
    </div>
  </section>

  <section class="case-specs section" id="ficha">
    <div class="container specs-grid">
      <div>
        <span class="tag">Especificaciones</span>
        <h2>Materiales, sistemas y garantías del proyecto</h2>
      </div>
      <div class="spec-list">
        {specs.map((spec) => (
          <div class="spec-row">
            <strong>{spec.label}</strong>
            <span>{spec.value}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <ProjectPhaseGallery
    eyebrow="Archivo fotográfico completo"
    title={`Galería ordenada por fases (${gallery.length} fotos reales)`}
    intro="La galería ya no mezcla todo en una sola rejilla: cada fase se presenta como un bloque propio para que el proyecto se lea mejor y las fotos respiren más."
    items={gallery}
    phases={galleryPhases}
    id="galeria"
  />

  <GuaranteeMatrix compact />

  <section class="case-cta">
    <div class="container case-cta-inner">
      <span class="tag tag-on-dark">Valoración técnica</span>
      <h2>¿Quieres una cocina ejecutada con este nivel de control?</h2>
      <p>Cuéntanos ubicación, tipo de vivienda, alcance, nivel de acabado y fecha estimada. Revisamos si el proyecto encaja con nuestro estándar y te orientamos con una valoración técnica.</p>
      <a href={`https://wa.me/584227997043?text=${encodeURIComponent(whatsappText)}`} class="btn-premium btn-primary-premium" target="_blank" rel="noopener">
        <span class="btn-content">Solicitar valoración técnica</span>
        <span class="btn-border"></span>
        <span class="btn-arrow">→</span>
      </a>
