    alt: 'Montaje de estantería flotante con tira LED en proceso',
    title: 'Estantería Flotante con Tira LED',
    caption: 'Instalación de la estantería flotante a todo lo largo con tira LED inferior y superior invisible a la vista.',
    category: 'montaje',
    categoryLabel: 'Montaje de Cocina',
    badge: 'Estantería',
    orientation: 'portrait'
  },
  {
    src: '/images/proyectos/cocina-lujo-guataparo/proceso-estante-flotante-1.webp',
    alt: 'Detalle del montaje de estante flotante en proceso',
    title: 'Detalle del Montaje del Estante Flotante',
    caption: 'Detalle del montaje del estante flotante: alineación, nivelación y preparación de la iluminación oculta.',
    category: 'montaje',
    categoryLabel: 'Montaje de Cocina',
    badge: 'Proceso',
    orientation: 'portrait'
  },
  {
    src: '/images/proyectos/cocina-lujo-guataparo/proceso-montaje-suelo.webp',
    alt: 'Montaje de cocina y suelo en proceso',
    title: 'Montaje de Muebles Bajos y Suelo',
    caption: 'Fase de montaje: muebles bajos en instalación y suelo en proceso para la nueva cocina.',
