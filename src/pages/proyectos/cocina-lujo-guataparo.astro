    category: 'proceso',
    categoryLabel: 'Proceso de Instalaciones',
    badge: 'Instalaciones',
    orientation: 'portrait'
  },
  {
    src: '/images/proyectos/cocina-lujo-guataparo/proceso-desmontada.webp',
    alt: 'Cocina desmontada durante el proceso de reforma',
    title: 'Desmontaje Total de la Cocina',
