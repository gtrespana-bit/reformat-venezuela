      category: 'ventanal',
      categoryLabel: 'Ventanal y Luz Natural',
      badge: 'Apertura Muro Exterior',
      orientation: 'portrait'
    },
    {
      src: '/images/proyectos/banos-quinta-la-lagunita/bano-demolicion-y-apertura-ventanal-2.webp',
