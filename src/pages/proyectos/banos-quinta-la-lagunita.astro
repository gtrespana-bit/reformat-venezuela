const heroImage = project.heroImage;
---

<BaseLayout 
  title={`${project.title} | Caso de Estudio | RemodelaT Venezuela`} 
  description={project.description}
  image={heroImage}
  activePage="proyectos"
>
  <!-- 1. EDITORIAL LUXURY HERO -->
  <header class="project-hero">
    <div class="hero-backdrop" aria-hidden="true"></div>
    <div class="container">
      <div class="hero-content">
        <div class="hero-kicker">
          <span class="kicker-badge">CASO DE ESTUDIO</span>
          <span class="kicker-line"></span>
          <span class="kicker-sub">ARQUITECTURA E INTERIORISMO · GUATAPARO, VALENCIA</span>
        </div>

        <h1 class="hero-title">Remodelación Integral de Baño de Lujo en Quinta de Guataparo</h1>
        
        <p class="hero-subtitle">
          División arquitectónica de un gran baño en dos áreas independientes con muro de hormigón 15 cm, apertura de fachada para ventanal con rotura térmica, microcemento blanco, piedra volcánica importada y porcelanato metro verde con sanitarios italianos y ROCA.
        </p>

        <!-- Quick Executive Ribbon -->
        <div class="hero-stats-ribbon">
          <div class="stat-item">
            <span class="stat-label">Ubicación</span>
            <span class="stat-value">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="var(--gold)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                <circle cx="12" cy="10" r="3"/>
              </svg>
              Guataparo, Valencia
            </span>
          </div>
          <div class="stat-divider" aria-hidden="true"></div>
          <div class="stat-item">
            <span class="stat-label">Intervención</span>
            <span class="stat-value">1 Baño -> 2 Salas Independientes</span>
          </div>
          <div class="stat-divider" aria-hidden="true"></div>
          <div class="stat-item">
            <span class="stat-label">Plazo de Obra</span>
            <span class="stat-value">2,5 Semanas</span>
          </div>
          <div class="stat-divider" aria-hidden="true"></div>
          <div class="stat-item">
            <span class="stat-label">Revestimiento</span>
            <span class="stat-value">Microcemento + Metro Verde</span>
          </div>
          <div class="stat-divider" aria-hidden="true"></div>
          <div class="stat-item">
            <span class="stat-label">Lujo & Escultura</span>
            <span class="stat-value">Piedra Volcánica + Italia & ROCA</span>
          </div>
        </div>
      </div>
    </div>
  </header>

  <!-- BREADCRUMBS TRAS EL HERO -->
  <nav class="breadcrumb-after-hero" aria-label="Breadcrumb">
    <div class="container">
      <div class="breadcrumb-inner">
        <a href="/">Inicio</a>
        <span class="separator">/</span>
        <a href="/proyectos">Proyectos</a>
        <span class="separator">/</span>
        <span class="current">Baño de Lujo Quinta Guataparo</span>
      </div>
    </div>
  </nav>

  <!-- 2. DUAL-SHOWCASE: DOS AMBIENTES INDEPENDIENTES (ZERO CROPPING) -->
  <section class="dual-showcase-section" id="espacios">
    <div class="container">
      <div class="section-heading">
        <span class="eyebrow-text">VISTA MAESTRA DEL PROYECTO</span>
        <h2 class="editorial-title">Dos Salas Independientes de Lujo en Guataparo</h2>
        <p class="editorial-subtitle">
          El gran baño original se reconfiguró mediante un tabique de bloque de hormigón de 15 cm en dos ambientes privados: un santuario escultórico de ducha y lavabo con ventanal panorámico (Zona 1) y un aseo sanitario privado con lavabo independiente (Zona 2).
        </p>
      </div>

      <div class="showcase-grid">
        <!-- Card 1: Zona 1 Ducha y Piedra Volcánica -->
        <article class="showcase-card">
          <div class="showcase-image-frame">
            <span class="showcase-badge">Zona 1 · Ducha en Microcemento</span>
            <img 
              src="/images/proyectos/banos-quinta-la-lagunita/bano-zona-1-completado-2.webp" 
