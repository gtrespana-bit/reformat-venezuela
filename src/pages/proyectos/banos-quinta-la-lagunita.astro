---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectBeforeAfterSlider from '../../components/ProjectBeforeAfterSlider.astro';

const project = {
  title: 'Remodelación Integral de Baño de Lujo en Quinta de Guataparo',
  location: 'Urbanización Guataparo, Valencia',
  category: 'Baños de Alta Gama & Arquitectura',
  year: '2024',
  duration: '2 semanas y media',
  description: 'Reforma monumental en quinta de lujo en Guataparo, Valencia: división en dos salas independientes, demolición de fachada para ventanal con rotura térmica, microcemento blanco, piedra volcánica y porcelanato metro verde con sanitarios italianos y ROCA.',
  heroImage: '/images/proyectos/banos-quinta-la-lagunita/bano-zona-1-completado-2.webp',
  scope: [
    'Demolición total de baños existentes y tabiques interiores de altura parcial',
    'Demolición estructural en muro exterior para apertura de gran ventanal panorámico',
    'Excavación en solera de hormigón para reubicar desagüe de inodoro 110 mm',
    'Sustitución de red de plomería integral por tubería multicapa PEX-Al-PEX',
    'Construcción de tabique separador independiente en bloque de hormigón 15 cm',
    'Vaciado de 2 encimeras flotantes de hormigón y plato de ducha in situ',
    'Revestimiento integral en microcemento blanco impermeable en paredes y ducha',
    'Colocación de piedra volcánica importada como pieza decorativa junto a la encimera principal',
    'Revestimiento de acento con porcelanato tipo metro en color verde esmaltado',
    'Montaje de ventanal de aluminio a medida con rotura de puente térmico y cristal UV',
    'Instalación de lavabos y grifería sobrepuestos importados de Italia e inodoro ROCA'
  ],
  specs: [
    { label: 'Revestimiento Principal', value: 'Microcemento color blanco sellado impermeable en paredes y suelo' },
    { label: 'Revestimiento de Acento', value: 'Porcelanato tipo metro (subway tile) en color verde esmaltado' },
    { label: 'Elemento Escultórico', value: 'Piedra volcánica importada como pieza decorativa (sin función portante)' },
    { label: 'Encimeras y Ducha', value: 'Hormigón armado en voladizo puro, sin patas ni apoyos, en microcemento' },
    { label: 'Intervención de Luz', value: 'Ventanal a medida en aluminio con rotura térmica y cristal doble UV' },
    { label: 'División de Ambientes', value: 'Tabique de bloque de hormigón 15 cm enfoscado en mortero fino' },
    { label: 'Red de Plomería', value: 'Tubería multicapa PEX-Al-PEX para agua fría y caliente' },
    { label: 'Red de Desagüe', value: 'Canalización subterránea en PVC (110 mm poceta / 40 mm lavabos)' },
    { label: 'Sanitario Principal', value: 'Inodoro importado de alta gama marca ROCA' },
    { label: 'Lavabos y Grifería', value: 'Lavabos sobrepuestos de porcelana y grifería importados de Italia' },
    { label: 'Plato de Ducha', value: 'Plato de hormigón in situ acabado en microcemento antideslizante' }
  ],
  gallery: [
    // 1. BAÑOS TERMINADOS Y LUJO
    {
      src: '/images/proyectos/banos-quinta-la-lagunita/bano-zona-1-completado-2.webp',
      alt: 'Zona de ducha en Guataparo con paredes y suelo de ducha acabados en microcemento blanco',
      title: 'Zona 1 · Ducha en Microcemento',
      caption: 'Zona de ducha con acabados de microcemento blanco en paredes y en el suelo de la ducha.',
      category: 'final',
      categoryLabel: 'Baño Terminado',
      badge: 'Ducha Microcemento',
      orientation: 'portrait'
    },
    {
      src: '/images/proyectos/banos-quinta-la-lagunita/bano-zona-1-completado.webp',
      alt: 'Zona de lavabo con encimera flotante, pared de porcelanato tipo metro verde y piedra volcánica',
      title: 'Lavabo, Encimera Flotante y Porcelanato Metro Verde',
      caption: 'Zona de lavabo con encimera totalmente flotante en microcemento blanco, sin ningún punto de apoyo, pared de porcelanato tipo metro verde esmaltado y piedra volcánica importada como elemento puramente decorativo.',
      category: 'final',
      categoryLabel: 'Baño Terminado',
      badge: 'Porcelanato Verde',
      orientation: 'portrait'
    },
    {
      src: '/images/proyectos/banos-quinta-la-lagunita/bano-zona-1-completado-3.webp',
      alt: 'Zona de lavabo con encimera flotante, porcelanato tipo metro verde y piedra volcánica desde otro ángulo',
      title: 'Zona de Lavabo desde Otro Ángulo',
      caption: 'La misma zona de lavabo vista desde un ángulo ligeramente distinto: encimera flotante, porcelanato tipo metro verde y piedra volcánica.',
      category: 'final',
      categoryLabel: 'Baño Terminado',
      badge: 'Lavabo Italiano',
      orientation: 'portrait'
    },
    {
      src: '/images/proyectos/banos-quinta-la-lagunita/bano-zona-2-completado.webp',
      alt: 'Sala sanitaria independiente con inodoro ROCA importado, microcemento y porcelanato metro verde',
      title: 'Zona 2: Sala Sanitaria Independiente con Inodoro ROCA',
      caption: 'El segundo ambiente independiente, separado por tabique de bloque de hormigón de 15 cm. Equipado con su propio lavabo sobrepuesto, pared en metro verde esmaltado e inodoro importado marca ROCA.',
      category: 'final',
      categoryLabel: 'Baño Terminado',
      badge: 'Inodoro ROCA',
