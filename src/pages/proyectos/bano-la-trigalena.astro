---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectBeforeAfterSlider from '../../components/ProjectBeforeAfterSlider.astro';

const project = {
  title: 'Remodelación Integral de Baño en Townhouse',
  location: 'La Trigaleña, Valencia',
  category: 'Baños de Alta Gama',
  year: '2024',
  duration: '1 semana',
  description: 'Demolición de tabiques divisorios para ampliar el espacio, plomería multicapa PEX-Al-PEX y revestimiento en porcelanato importado rectificado gran formato 60x120 con sanitarios TEKA.',
