  scope: [
    'Demolición total de cerámica, sanitarios y 2 tabiques divisorios antiguos',
    'Sustitución completa de fontanería por red multicapa PEX-Al-PEX',
    'Instalación de porcelanato importado rectificado 60x120 efecto mármol',
    'Pavimento en porcelanato efecto madera con tratamiento antideslizante',
    'Montaje de inodoro TEKA modelo Manacor de alta eficiencia',
    'Instalación de mueble blanco de 80 cm con grifería monomando TEKA',
    'Plato de ducha sólido en polvo de mármol y grifería TEKA efecto lluvia',
    'Mampara fija de cristal templado de seguridad e iluminación Spot Light blanca'
  ],
  specs: [
    { label: 'Revestimiento Paredes', value: 'Porcelanato importado 60x120 cm (Efecto Mármol Rectificado)' },
