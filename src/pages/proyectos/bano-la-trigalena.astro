    .lightbox-close {
      top: 16px;
      right: 16px;
      width: 42px;
      height: 42px;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    /* ==========================================================
       1. GALLERY FILTER TABS
       ========================================================== */
    const filterButtons = document.querySelectorAll('.filter-btn');
    const galleryCards = document.querySelectorAll('.gallery-card');

    filterButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const targetFilter = btn.getAttribute('data-filter');

        // Toggle active button state
        filterButtons.forEach(b => {
          b.classList.remove('active');
          b.setAttribute('aria-selected', 'false');
        });
        btn.classList.add('active');
        btn.setAttribute('aria-selected', 'true');

        // Filter cards
        galleryCards.forEach(card => {
          const category = card.getAttribute('data-category');
          if (targetFilter === 'all' || category === targetFilter) {
            card.classList.remove('hidden');
          } else {
            card.classList.add('hidden');
          }
        });
      });
    });

    /* ==========================================================
       2. INTERACTIVE LIGHTBOX SYSTEM
       ========================================================== */
    const lightbox = document.getElementById('lightbox');
    const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
    const lightboxTitle = document.getElementById('lightbox-title');
    const lightboxCaption = document.getElementById('lightbox-caption');
    const lightboxBadge = document.getElementById('lightbox-badge');
    const lightboxCurrent = document.getElementById('lightbox-current');
    const closeBtn = document.querySelector('.lightbox-close');
    const prevBtn = document.querySelector('.lightbox-prev');
    const nextBtn = document.querySelector('.lightbox-next');

    // Build items list from gallery and comparison pairs
    interface LightboxItem {
      src: string;
      alt: string;
      title: string;
      caption: string;
      badge: string;
    }

    let items: LightboxItem[] = [];
    let currentIndex = 0;

    // Populate items from gallery cards
    const cardElements = document.querySelectorAll('.gallery-card');
    const galleryItems: LightboxItem[] = Array.from(cardElements).map(el => {
      const img = el.querySelector('img');
      const badge = el.querySelector('.card-badge')?.textContent || 'Proyecto';
      return {
        src: el.getAttribute('data-src') || img?.src || '',
        alt: el.getAttribute('data-alt') || img?.alt || '',
        title: el.getAttribute('data-title') || 'Remodelación de Baño',
        caption: el.getAttribute('data-caption') || '',
        badge: badge
      };
    });

    function openLightbox(newItems: LightboxItem[], index: number) {
      if (!lightbox || !lightboxImg) return;
      items = newItems;
      currentIndex = index;
      updateLightbox();
      lightbox.classList.add('active');
      lightbox.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }

    function closeLightbox() {
      if (!lightbox) return;
      lightbox.classList.remove('active');
      lightbox.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    function updateLightbox() {
      if (!lightboxImg || !items[currentIndex]) return;
      const current = items[currentIndex];
      lightboxImg.src = current.src;
      lightboxImg.alt = current.alt;
      if (lightboxTitle) lightboxTitle.textContent = current.title;
      if (lightboxCaption) lightboxCaption.textContent = current.caption;
      if (lightboxBadge) lightboxBadge.textContent = current.badge;
      if (lightboxCurrent) lightboxCurrent.textContent = String(currentIndex + 1);
    }

    function prevImage() {
      if (!items.length) return;
      currentIndex = (currentIndex - 1 + items.length) % items.length;
      updateLightbox();
    }

    function nextImage() {
      if (!items.length) return;
      currentIndex = (currentIndex + 1) % items.length;
      updateLightbox();
    }

    if (closeBtn) closeBtn.addEventListener('click', closeLightbox);
    if (prevBtn) prevBtn.addEventListener('click', prevImage);
    if (nextBtn) nextBtn.addEventListener('click', nextImage);

    if (lightbox) {
      lightbox.addEventListener('click', (e) => {
        if (e.target === lightbox) closeLightbox();
      });
    }

    document.addEventListener('keydown', (e) => {
      if (!lightbox || !lightbox.classList.contains('active')) return;
      if (e.key === 'Escape') closeLightbox();
      if (e.key === 'ArrowLeft') prevImage();
      if (e.key === 'ArrowRight') nextImage();
    });

    // Attach click events to gallery cards
    cardElements.forEach((el, idx) => {
      el.addEventListener('click', () => {
        openLightbox(galleryItems, idx);
      });
    });

    // Attach click events to Before/After comparison items
    document.querySelectorAll('.comparison-item').forEach(el => {
      el.addEventListener('click', () => {
        const img = el.querySelector('img');
        const label = el.querySelector('.comparison-label')?.textContent || 'Comparativa';
        const item: LightboxItem = {
          src: el.getAttribute('data-src') || img?.src || '',
          alt: el.getAttribute('data-alt') || img?.alt || '',
          title: el.getAttribute('data-title') || 'Comparativa Antes vs Después',
          caption: el.querySelector('.comparison-caption')?.textContent || '',
          badge: label
        };
        openLightbox([item], 0);
      });
    });

    // Attach click events to showcase cards
    document.querySelectorAll('.showcase-card').forEach(el => {
      el.addEventListener('click', () => {
        const img = el.querySelector('img');
        const badge = el.querySelector('.showcase-badge')?.textContent || 'Espacio';
        if (!img) return;
        const item: LightboxItem = {
          src: img.src,
          alt: img.alt,
          title: el.querySelector('.showcase-title')?.textContent || 'Espacio del Proyecto',
          caption: el.querySelector('.showcase-desc')?.textContent || '',
          badge: badge
        };
        openLightbox([item], 0);
      });
    });
  });
</script>
