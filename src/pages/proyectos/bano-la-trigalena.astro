  .lightbox-badge {
    padding: 4px 12px;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    background: var(--gold);
    color: var(--ink);
    border-radius: var(--r-sm);
  }

  .lightbox-counter {
    font-size: 0.82rem;
    color: rgba(255,255,255,0.6);
    font-weight: 600;
  }

  .lightbox-title {
    font-family: var(--font-serif);
    font-size: 1.6rem;
    font-weight: 500;
    color: var(--white);
    margin-bottom: 8px;
  }

  .lightbox-caption {
    font-size: 0.96rem;
    line-height: 1.6;
    color: rgba(255,255,255,0.75);
    margin: 0;
  }

  .lightbox-close {
    position: absolute;
    top: 24px;
    right: 28px;
    width: 48px;
    height: 48px;
    border: none;
    background: rgba(255,255,255,0.08);
    color: var(--white);
    font-size: 1.8rem;
    cursor: pointer;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s ease, transform 0.2s ease;
    z-index: 10;
  }

  .lightbox-close:hover {
    background: rgba(255,255,255,0.2);
    transform: scale(1.05);
  }

  .lightbox-prev,
  .lightbox-next {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 52px;
    height: 52px;
    border: none;
    background: rgba(255,255,255,0.08);
    color: var(--white);
    cursor: pointer;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s ease, transform 0.2s ease;
    z-index: 10;
  }

  .lightbox-prev:hover,
  .lightbox-next:hover {
    background: rgba(255,255,255,0.22);
  }

  .lightbox-prev { left: 28px; }
  .lightbox-next { right: 28px; }

  /* ==========================================================
     8. RESPONSIVE BREAKPOINTS
     ========================================================== */
  @media (max-width: 1024px) {
    .narrative-layout {
      grid-template-columns: 1fr;
      gap: 48px;
    }

    .narrative-sidebar {
      position: static;
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 24px;
    }

    .guarantee-card {
      grid-column: span 2;
    }

    .gallery-masonry {
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
    }

    .gallery-card.card-landscape {
      grid-column: span 2;
    }
  }

  @media (max-width: 768px) {
    .project-hero {
      padding: 145px 0 65px;
    }

    .hero-stats-ribbon {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
      padding: 20px;
    }

    .stat-divider {
      width: 100%;
      height: 1px;
    }

    .showcase-grid,
    .comparison-pair {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .showcase-image-frame,
    .comparison-image-wrapper {
      min-height: 340px;
    }

    .narrative-sidebar {
      grid-template-columns: 1fr;
    }

    .guarantee-card {
      grid-column: span 1;
    }

    .gallery-masonry {
      grid-template-columns: 1fr;
    }

    .gallery-card.card-landscape {
      grid-column: span 1;
    }

    .lightbox {
      padding: 20px 14px;
    }

    .lightbox-prev,
    .lightbox-next {
