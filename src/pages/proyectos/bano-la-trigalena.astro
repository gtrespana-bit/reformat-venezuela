---
import BaseLayout from '../../layouts/BaseLayout.astro';

const project = {
  title: 'Remodelación de Baño Residencial',
  location: 'La Trigaleña, Caracas',
  category: 'Baño',
  year: '2024',
  duration: '2 semanas',
  description: 'Renovación integral de baño en residencia de La Trigaleña. El proyecto incluyó cambio completo de porcelanato, instalación de mueble nuevo, grifería moderna y acabados de primera calidad.',
  scope: [
    'Demolición de acabados existentes',
    'Cambio de porcelanato en piso y paredes',
    'Instalación de mueble de baño con lavabo',
    'Grifería y accesorios modernos',
    'Inodoro nuevo de diseño contemporáneo',
    'Iluminación LED optimizada',
    'Ventilación y impermeabilización',
    'Detalles de acabado y sellado'
  ],
  beforeImages: [
    { src: '/images/proyectos/bano-la-trigalena/bano-antes-1.webp', alt: 'Baño antes de la remodelación' },
    { src: '/images/proyectos/bano-la-trigalena/bano-antes-2.webp', alt: 'Estado anterior - detalles' },
    { src: '/images/proyectos/bano-la-trigalena/bano-antes-3.webp', alt: 'Perspectiva anterior' }
  ],
  duringImages: [
    { src: '/images/proyectos/bano-la-trigalena/bano-cambio-de-suelo.webp', alt: 'Cambio de suelo' },
    { src: '/images/proyectos/bano-la-trigalena/bano-porcelanato-instalando.webp', alt: 'Instalación de porcelanato' },
    { src: '/images/proyectos/bano-la-trigalena/bano-porcelanato-instalando-2.webp', alt: 'Porcelanato en paredes' },
    { src: '/images/proyectos/bano-la-trigalena/bano-porcelanato-instalando-3.webp', alt: 'Detalle de instalación' },
    { src: '/images/proyectos/bano-la-trigalena/bano-inodoro-instalado.webp', alt: 'Inodoro instalado' },
    { src: '/images/proyectos/bano-la-trigalena/bano-mueble-instalado.webp', alt: 'Mueble instalado' }
  ],
  afterImages: [
    { src: '/images/proyectos/bano-la-trigalena/bano-final-1.webp', alt: 'Resultado final' },
    { src: '/images/proyectos/bano-la-trigalena/bano-final-2.webp', alt: 'Detalles de acabados' },
    { src: '/images/proyectos/bano-la-trigalena/bano-final-3.webp', alt: 'Perspectiva completa' }
  ]
};

const heroImage = project.afterImages[0].src;
const allImages = [...project.beforeImages, ...project.duringImages, ...project.afterImages];
---

<BaseLayout 
  title={`${project.title} en ${project.location} | ReformaT Venezuela`} 
  description={project.description}
  image={heroImage}
  activePage="proyectos"
>
  <!-- Hero -->
  <header class="project-hero">
    <div class="hero-image">
      <img src={heroImage} alt={project.title} fetchpriority="high" loading="eager" decoding="async" />
    </div>
    <div class="container">
      <div class="hero-content">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/">Inicio</a>
          <span class="separator">/</span>
          <a href="/proyectos">Proyectos</a>
          <span class="separator">/</span>
          <span class="current">{project.title}</span>
        </nav>
        <span class="hero-badge">{project.category}</span>
        <h1 class="hero-title">{project.title}</h1>
        <p class="hero-location">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
            <circle cx="12" cy="10" r="3"/>
          </svg>
          {project.location}
        </p>
      </div>
    </div>
  </header>

  <!-- Project Info -->
  <section class="project-body">
    <div class="container">
      <div class="project-layout">
        <!-- Main Content -->
        <div class="project-main">
          <div class="project-desc">
            <h2 class="section-title">Descripción del Proyecto</h2>
            <p class="section-text">{project.description}</p>
          </div>

          <!-- Before/After -->
          <div class="ba-section">
            <h2 class="section-title">Transformación</h2>
            <div class="ba-grid">
              <div class="ba-item" data-src={project.beforeImages[0].src} data-alt={project.beforeImages[0].alt}>
                <img src={project.beforeImages[0].src} alt={project.beforeImages[0].alt} loading="lazy" />
                <span class="ba-label">Antes</span>
              </div>
              <div class="ba-item" data-src={project.afterImages[0].src} data-alt={project.afterImages[0].alt}>
                <img src={project.afterImages[0].src} alt={project.afterImages[0].alt} loading="lazy" />
                <span class="ba-label">Después</span>
              </div>
            </div>
          </div>

          <!-- Gallery -->
          <div class="gallery-section">
            <h2 class="section-title">Galería</h2>
            <div class="gallery-grid">
              {allImages.map((img, i) => (
                <div class="gallery-item" data-src={img.src} data-alt={img.alt} data-index={i}>
                  <img src={img.src} alt={img.alt} loading="lazy" />
                  <div class="gallery-hover">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <circle cx="11" cy="11" r="8"/>
                      <line x1="21" y1="21" x2="16.65" y2="16.65"/>
                      <line x1="11" y1="8" x2="11" y2="14"/>
                      <line x1="8" y1="11" x2="14" y2="11"/>
                    </svg>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>

        <!-- Sidebar -->
        <aside class="project-sidebar">
          <div class="sidebar-card">
            <h3 class="sidebar-title">Detalles del Proyecto</h3>
            <dl class="details-list">
              <div class="detail-row">
                <dt>Ubicación</dt>
                <dd>{project.location}</dd>
              </div>
              <div class="detail-row">
                <dt>Categoría</dt>
                <dd>{project.category}</dd>
              </div>
              <div class="detail-row">
                <dt>Duración</dt>
                <dd>{project.duration}</dd>
              </div>
              <div class="detail-row">
                <dt>Año</dt>
                <dd>{project.year}</dd>
              </div>
            </dl>
          </div>

          <div class="sidebar-card">
            <h3 class="sidebar-title">Alcance del Trabajo</h3>
            <ul class="scope-list">
              {project.scope.map(item => (
                <li class="scope-item">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--gold)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <polyline points="20 6 9 17 4 12"/>
                  </svg>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="project-cta">
    <div class="container">
      <h2 class="cta-title">¿Listo para Transformar tu Baño?</h2>
      <p class="cta-text">Solicita una consulta gratuita y descubre cómo podemos renovar tu espacio.</p>
      <a href="/contacto" class="btn-premium btn-primary-premium">
        <span class="btn-content">Solicitar Presupuesto</span>
        <span class="btn-border"></span>
        <span class="btn-arrow">→</span>
      </a>
    </div>
  </section>

  <!-- Lightbox -->
  <div id="lightbox" class="lightbox" aria-hidden="true" role="dialog" aria-modal="true">
    <button class="lightbox-close" aria-label="Cerrar">&times;</button>
    <button class="lightbox-prev" aria-label="Anterior">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polyline points="15 18 9 12 15 6"/>
      </svg>
    </button>
    <button class="lightbox-next" aria-label="Siguiente">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polyline points="9 18 15 12 9 6"/>
      </svg>
    </button>
    <div class="lightbox-content">
      <img id="lightbox-img" src="" alt="" />
      <p id="lightbox-caption" class="lightbox-caption"></p>
    </div>
    <div class="lightbox-counter">
      <span id="lightbox-current">1</span> / <span id="lightbox-total">1</span>
    </div>
  </div>
</BaseLayout>

<style>
  /* Hero */
  .project-hero {
    position: relative;
    padding: 60px 0 0;
    background: var(--ink);
  }
  
  .hero-image {
    position: relative;
    width: 100%;
    max-height: 500px;
    overflow: hidden;
  }
  
  .hero-image img {
    width: 100%;
    height: 100%;
    max-height: 500px;
    object-fit: cover;
    object-position: center;
  }
  
  .hero-content {
    padding: 40px 0;
    max-width: 1200px;
    margin: 0 auto;
    padding-left: 24px;
    padding-right: 24px;
  }
  
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.8rem;
    color: rgba(255,255,255,0.5);
    margin-bottom: 16px;
  }
  
  .breadcrumb a {
    color: rgba(255,255,255,0.5);
    text-decoration: none;
    transition: color 0.2s;
  }
  
  .breadcrumb a:hover {
    color: var(--gold);
  }
  
  .breadcrumb .current {
    color: var(--gold);
  }
  
  .separator {
    opacity: 0.4;
  }
  
  .hero-badge {
    display: inline-block;
    padding: 5px 14px;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--bg);
    background: var(--gold);
    border-radius: var(--r-sm);
    margin-bottom: 16px;
  }
  
  .hero-title {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 4vw, 2.8rem);
    font-weight: 500;
    color: var(--white);
    line-height: 1.2;
    margin-bottom: 12px;
  }
  
  .hero-location {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 1rem;
    color: rgba(255,255,255,0.6);
  }

  /* Body Layout */
  .project-body {
    padding: 60px 0 80px;
    background: var(--bone);
  }
  
  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }
  
  .project-layout {
    display: grid;
    grid-template-columns: 1fr 300px;
    gap: 48px;
    align-items: start;
  }
  
  .project-main {
    min-width: 0;
  }
  
  .section-title {
    font-family: var(--font-serif);
    font-size: 1.4rem;
    font-weight: 600;
    color: var(--text);
    margin-bottom: 16px;
  }
  
  .section-text {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--text-light);
  }

  /* Before/After */
  .ba-section {
    margin-top: 48px;
  }
  
  .ba-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  
  .ba-item {
    position: relative;
    border-radius: var(--r-sm);
    overflow: hidden;
    cursor: zoom-in;
    aspect-ratio: 4/3;
    background: var(--sand);
  }
  
  .ba-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  
  .ba-item:hover img {
    transform: scale(1.03);
  }
  
  .ba-label {
    position: absolute;
    bottom: 12px;
    left: 12px;
    padding: 5px 14px;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    border-radius: var(--r-sm);
  }
  
  .ba-item:first-child .ba-label {
    background: rgba(255, 77, 77, 0.9);
    color: white;
  }
  
  .ba-item:last-child .ba-label {
    background: var(--gold);
    color: var(--bg);
  }

  /* Gallery */
  .gallery-section {
    margin-top: 48px;
  }
  
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }
  
  .gallery-item {
    position: relative;
    border-radius: var(--r-sm);
    overflow: hidden;
    cursor: zoom-in;
    aspect-ratio: 1;
    background: var(--sand);
  }
  
  .gallery-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  
  .gallery-item:hover img {
    transform: scale(1.05);
  }
  
  .gallery-hover {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(20,18,14,0);
    transition: background 0.3s ease;
  }
  
  .gallery-item:hover .gallery-hover {
    background: rgba(20,18,14,0.3);
  }
  
  .gallery-hover svg {
    width: 28px;
    height: 28px;
    color: white;
    opacity: 0;
    transform: scale(0.8);
    transition: opacity 0.3s ease, transform 0.3s ease;
  }
  
  .gallery-item:hover .gallery-hover svg {
    opacity: 1;
    transform: scale(1);
  }

  /* Sidebar */
  .project-sidebar {
    position: sticky;
    top: 100px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  
  .sidebar-card {
    padding: 24px;
    background: var(--white);
    border-radius: var(--r-md);
    border: 1px solid var(--sand);
  }
  
  .sidebar-title {
    font-family: var(--font-serif);
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--text);
    margin-bottom: 16px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--sand);
  }
  
  .details-list {
    margin: 0;
  }
  
  .detail-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px 0;
    border-bottom: 1px solid var(--sand);
  }
  
  .detail-row:last-child {
    border-bottom: none;
  }
  
  .detail-row dt {
    font-size: 0.85rem;
    color: var(--text-muted);
  }
  
  .detail-row dd {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--text);
    margin: 0;
  }
  
  .scope-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  
  .scope-item {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--text-light);
  }
  
  .scope-item svg {
    flex-shrink: 0;
    margin-top: 2px;
  }

  /* CTA */
  .project-cta {
    padding: 80px 0;
    background: var(--ink);
    text-align: center;
  }
  
  .project-cta .container {
    max-width: 600px;
  }
  
  .cta-title {
    font-family: var(--font-serif);
    font-size: clamp(1.6rem, 3vw, 2rem);
    font-weight: 500;
    color: var(--white);
    margin-bottom: 12px;
  }
  
  .cta-text {
    font-size: 1rem;
    line-height: 1.6;
    color: rgba(255,255,255,0.6);
    margin-bottom: 28px;
  }

  /* Lightbox */
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: rgba(0,0,0,0.95);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }
  
  .lightbox.active {
    opacity: 1;
    visibility: visible;
  }
  
  .lightbox-content {
    max-width: 90vw;
    max-height: 80vh;
    text-align: center;
    transform: scale(0.95);
    transition: transform 0.3s ease;
  }
  
  .lightbox.active .lightbox-content {
    transform: scale(1);
  }
  
  .lightbox-content img {
    max-width: 100%;
    max-height: 75vh;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 4px;
  }
  
  .lightbox-caption {
    margin-top: 16px;
    font-size: 0.9rem;
    color: rgba(255,255,255,0.7);
  }
  
  .lightbox-close {
    position: absolute;
    top: 20px;
    right: 20px;
    width: 44px;
    height: 44px;
    border: none;
    background: rgba(255,255,255,0.1);
    color: white;
    font-size: 1.5rem;
    cursor: pointer;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s ease;
  }
  
  .lightbox-close:hover {
    background: rgba(255,255,255,0.2);
  }
  
  .lightbox-prev,
  .lightbox-next {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 44px;
    height: 44px;
    border: none;
    background: rgba(255,255,255,0.1);
    color: white;
    cursor: pointer;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s ease;
  }
  
  .lightbox-prev:hover,
  .lightbox-next:hover {
    background: rgba(255,255,255,0.2);
  }
  
  .lightbox-prev { left: 20px; }
  .lightbox-next { right: 20px; }
  
  .lightbox-counter {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    font-size: 0.85rem;
    color: rgba(255,255,255,0.5);
    padding: 6px 14px;
    background: rgba(255,255,255,0.1);
    border-radius: var(--r-full);
  }

  /* Responsive */
  @media (max-width: 900px) {
    .project-layout {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    
    .project-sidebar {
      position: static;
    }
    
    .gallery-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    
    .ba-grid {
      grid-template-columns: 1fr;
    }
  }
  
  @media (max-width: 600px) {
    .project-hero {
      padding-top: 40px;
    }
    
    .hero-image {
      max-height: 300px;
    }
    
    .hero-content {
      padding: 24px 24px 32px;
    }
    
    .project-body {
      padding: 40px 0 60px;
    }
    
    .gallery-grid {
      grid-template-columns: 1fr 1fr;
      gap: 8px;
    }
    
    .lightbox-prev,
    .lightbox-next {
      width: 36px;
      height: 36px;
    }
    
    .lightbox-prev { left: 10px; }
    .lightbox-next { right: 10px; }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const lightbox = document.getElementById('lightbox');
    const lightboxImg = document.getElementById('lightbox-img');
    const lightboxCaption = document.getElementById('lightbox-caption');
    const lightboxCurrent = document.getElementById('lightbox-current');
    const lightboxTotal = document.getElementById('lightbox-total');
    const closeBtn = document.querySelector('.lightbox-close');
    const prevBtn = document.querySelector('.lightbox-prev');
    const nextBtn = document.querySelector('.lightbox-next');
    
    let currentImages = [];
    let currentIndex = 0;
    
    function openLightbox(images, index) {
      currentImages = images;
      currentIndex = index;
      updateLightbox();
      lightbox.classList.add('active');
      lightbox.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }
    
    function closeLightbox() {
      lightbox.classList.remove('active');
      lightbox.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }
    
    function updateLightbox() {
      const img = currentImages[currentIndex];
      lightboxImg.src = img.src;
      lightboxImg.alt = img.alt;
      lightboxCaption.textContent = img.alt;
      lightboxCurrent.textContent = currentIndex + 1;
      lightboxTotal.textContent = currentImages.length;
    }
    
    function prevImage() {
      currentIndex = (currentIndex - 1 + currentImages.length) % currentImages.length;
      updateLightbox();
    }
    
    function nextImage() {
      currentIndex = (currentIndex + 1) % currentImages.length;
      updateLightbox();
    }
    
    if (closeBtn) closeBtn.addEventListener('click', closeLightbox);
    if (prevBtn) prevBtn.addEventListener('click', prevImage);
    if (nextBtn) nextBtn.addEventListener('click', nextImage);
    
    if (lightbox) {
      lightbox.addEventListener('click', (e) => {
        if (e.target === lightbox) closeLightbox();
      });
    }
    
    document.addEventListener('keydown', (e) => {
      if (!lightbox || !lightbox.classList.contains('active')) return;
      if (e.key === 'Escape') closeLightbox();
      if (e.key === 'ArrowLeft') prevImage();
      if (e.key === 'ArrowRight') nextImage();
    });
    
    // Collect all gallery images
    const galleryItems = document.querySelectorAll('.gallery-item');
    const allGalleryImages = Array.from(galleryItems).map(item => ({
      src: item.dataset.src,
      alt: item.dataset.alt
    }));
    
    galleryItems.forEach((el, idx) => {
      el.addEventListener('click', () => {
        openLightbox(allGalleryImages, idx);
      });
    });
    
    // Before/After clicks
    document.querySelectorAll('.ba-item').forEach((el) => {
      el.addEventListener('click', () => {
        const src = el.dataset.src;
        const alt = el.dataset.alt;
        openLightbox([{ src, alt }], 0);
      });
    });
  });
</script>
