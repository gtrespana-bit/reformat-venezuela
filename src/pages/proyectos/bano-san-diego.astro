---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectBeforeAfterSlider from '../../components/ProjectBeforeAfterSlider.astro';

const project = {
  title: 'Remodelación de Baño con Poceta Flotante TEKA',
  location: 'San Diego, Carabobo',
  category: 'Baños & Sanitarios Suspendidos',
  year: '2024',
  duration: '1 semana',
  description: 'Demolición total, anclaje estructural para poceta flotante TEKA Manacor, plomería multicapa PEX-Al-PEX y revestimiento monolítico en porcelanato rectificado de gran formato 120x60 en paredes y 60x60 en suelo beige.',
  heroImage: '/images/proyectos/bano-san-diego/bano-finalizado-1.webp',
  scope: [
    'Demolición completa de cerámica en suelo y paredes hasta la estructura',
    'Sustitución de red hidráulica por tubería multicapa PEX-Al-PEX',
    'Anclaje estructural y montaje de bastidor para poceta flotante TEKA',
    'Revestimiento de paredes en porcelanato rectificado de gran formato 120x60 cm con cuñas autonivelantes',
    'Suelo y paredes en tono beige continuo: gran formato 120x60 y pavimento 60x60',
    'Pavimento porcelánico 60x60 en acabado beige claramente antideslizante',
    'Instalación de mueble blanco de 80 cm con grifería TEKA cromada',
    'Mampara fija de 80 cm cromada, columna efecto lluvia y espejo LED'
  ],
  specs: [
    { label: 'Revestimiento Paredes', value: 'Porcelanato rectificado de gran formato 120x60 cm (Tono Beige Monolítico)' },
    { label: 'Revestimiento Suelo', value: 'Porcelanato rectificado 60x60 cm beige con textura antideslizante' },
    { label: 'Técnica y Juntas', value: 'Cantos cortados a 90° con microjuntas milimétricas' },
    { label: 'Red de Fontanería', value: 'Tubería multicapa PEX-Al-PEX para agua fría y caliente' },
    { label: 'Inodoro Suspendido', value: 'Kit TEKA Manacor con bastidor metálico y cisterna oculta' },
    { label: 'Estructura y Bastidor', value: 'Bastidor autoportante anclado a muro portante y maestreado' },
    { label: 'Mueble de Lavabo', value: 'Mueble suspendido color blanco en tamaño 80 cm' },
    { label: 'Grifería de Lavabo', value: 'Monomando marca TEKA en acabado cromado de alto brillo' },
    { label: 'Columna de Ducha', value: 'Cabezal efecto lluvia + teléfono de ducha en cromo pulido' },
    { label: 'Mampara de Ducha', value: 'Hoja fija de 80 cm, perfil cromado y cristal templado seguridad' },
    { label: 'Iluminación', value: 'Espejo sobre lavabo con iluminación LED perimetral integrada' }
  ],
  gallery: [
    // 1. RESULTADO FINAL
    {
      src: '/images/proyectos/bano-san-diego/bano-finalizado-1.webp',
      alt: 'Baño finalizado en San Diego con poceta flotante TEKA Manacor y porcelanato de gran formato 120x60 en paredes',
      title: 'Baño Terminado: Poceta Flotante TEKA Manacor',
      caption: 'Vista principal de la remodelación concluida. La poceta suspendida TEKA Manacor aporta ligereza visual, integrada en paredes de porcelanato rectificado de gran formato 120x60 y suelo porcelánico 60x60 cm.',
      category: 'final',
      categoryLabel: 'Baño Terminado',
      badge: 'Poceta Flotante TEKA',
      orientation: 'portrait'
    },
    {
      src: '/images/proyectos/bano-san-diego/bano-finalizado-2.webp',
      alt: 'Zona de ducha walk-in con mampara fija de 80 cm, perfil cromado y columna efecto lluvia',
      title: 'Ducha Walk-In: Mampara Fija 80 cm y Columna Lluvia',
      caption: 'Espacio de ducha con mampara fija de 80 cm en cristal templado de seguridad y perfilería cromada, equipada con columna de ducha de rociador efecto lluvia y teléfono de mano.',
      category: 'final',
      categoryLabel: 'Baño Terminado',
      badge: 'Mampara Fija 80 cm',
      orientation: 'portrait'
    },
    {
      src: '/images/proyectos/bano-san-diego/bano-finalizado-3.webp',
      alt: 'Mueble de lavabo blanco de 80 cm con grifería TEKA cromada y espejo LED integrado',
      title: 'Mueble Blanco de 80 cm y Grifería TEKA Cromada',
      caption: 'Zona del lavabo con mueble suspendido en tamaño 80 cm acabado en blanco pulido, grifería monomando TEKA cromada y espejo con iluminación LED integrada en el perímetro.',
      category: 'final',
      categoryLabel: 'Baño Terminado',
      badge: 'Mueble 80 cm Blanco',
      orientation: 'portrait'
    },
    {
      src: '/images/proyectos/bano-san-diego/bano-finalizado-4.webp',
      alt: 'Perspectiva completa del baño residencial en San Diego en porcelanato beige rectificado',
      title: 'Perspectiva Integral: Armonía Monolítica Beige',
      caption: 'Vista general del espacio renovado. El uso de porcelanato rectificado en suelo y paredes elimina las juntas anchas y genera amplitud, luminosidad y fácil limpieza.',
      category: 'final',
      categoryLabel: 'Baño Terminado',
      badge: 'Monolitismo Beige',
      orientation: 'portrait'
    },
    // 2. SISTEMA TEKA Y ALBAÑILERÍA EN PROCESO
    {
      src: '/images/proyectos/bano-san-diego/teka-manacor-flotante-kit.webp',
      alt: 'Kit oficial TEKA Manacor de inodoro suspendido con cisterna empotrada y pulsador',
      title: 'Kit Técnico TEKA Manacor: Bastidor y Poceta Flotante',
      caption: 'Producto oficial instalado en el proyecto: Kit marca TEKA modelo Manacor que incluye bastidor autoportante empotrable, cisterna oculta de doble descarga e inodoro suspendido.',
      category: 'teka',
      categoryLabel: 'Sistema TEKA y Obra',
      badge: 'Kit TEKA Manacor',
      orientation: 'landscape'
    },
    {
      src: '/images/proyectos/bano-san-diego/bano-en-proceso.webp',
      alt: 'Instalación de porcelanato rectificado de gran formato 120x60 sobre soporte y plomería multicapa PEX-Al-PEX',
      title: 'Instalación de Porcelanato 120x60 y Plomería Multicapa',
      caption: 'Fase técnica donde se ejecutaron las nuevas instalaciones hidráulicas en multicapa PEX-Al-PEX y se inició el revestimiento de paredes con porcelanato rectificado de gran formato 120x60 cm tono beige.',
      category: 'teka',
      categoryLabel: 'Sistema TEKA y Obra',
      badge: 'Gran Formato 120x60',
      orientation: 'portrait'
    },
    {
      src: '/images/proyectos/bano-san-diego/bano-en-proceso-2.webp',
      alt: 'Proceso de instalación de porcelanato rectificado beige de gran formato 120x60 en paredes del baño',
      title: 'Colocación de Porcelanato Rectificado 120x60 Beige',
      caption: 'Fase de revestimiento en paredes utilizando técnica de doble encolado y cuñas autonivelantes para asegurar planitud absoluta sobre la nueva estructura del bastidor.',
      category: 'teka',
      categoryLabel: 'Sistema TEKA y Obra',
      badge: 'Gran Formato 120x60',
      orientation: 'portrait'
    },
    {
      src: '/images/proyectos/bano-san-diego/bano-en-proceso-3.webp',
      alt: 'Pavimento de porcelanato beige 60x60 con grado antideslizante en ejecución',
      title: 'Pavimento Porcelánico Beige Antideslizante',
      caption: 'Colocación del pavimento rectificado en formato 60x60 cm con textura antideslizante, garantizando seguridad en zonas húmedas y coherencia visual en todo el baño.',
      category: 'teka',
      categoryLabel: 'Sistema TEKA y Obra',
      badge: 'Suelo Antideslizante',
      orientation: 'portrait'
    }
  ]
};

const heroImage = project.heroImage;
const whatsappText = 'Hola, quiero una valoración técnica para un proyecto similar al baño con poceta flotante de San Diego.';
---

<BaseLayout 
  title={`${project.title} | Caso de Estudio | RemodelaT Venezuela`} 
  description={project.description}
  image={heroImage}
  activePage="proyectos"
>
  <!-- 1. EDITORIAL LUXURY HERO -->
  <header class="project-hero">
    <div class="hero-backdrop" aria-hidden="true"></div>
    <div class="container">
      <div class="hero-content">
        <div class="hero-kicker">
          <span class="kicker-badge">CASO DE ESTUDIO</span>
          <span class="kicker-line"></span>
          <span class="kicker-sub">ARQUITECTURA E INTERIORISMO · SAN DIEGO, CARABOBO</span>
        </div>

        <h1 class="hero-title">Remodelación de Baño con Poceta Flotante TEKA</h1>
        
        <p class="hero-subtitle">
          Demolición total de cerámica original, anclaje estructural para inodoro suspendido TEKA Manacor y revestimiento en porcelanato rectificado de gran formato 120x60 en paredes y 60x60 en suelo, en tono beige.
        </p>

        <!-- Quick Executive Ribbon -->
        <div class="hero-stats-ribbon">
          <div class="stat-item">
            <span class="stat-label">Ubicación</span>
            <span class="stat-value">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="var(--gold)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                <circle cx="12" cy="10" r="3"/>
              </svg>
              San Diego, Carabobo
            </span>
          </div>
          <div class="stat-divider" aria-hidden="true"></div>
          <div class="stat-item">
            <span class="stat-label">Especialidad</span>
            <span class="stat-value">Poceta Flotante TEKA Manacor</span>
          </div>
          <div class="stat-divider" aria-hidden="true"></div>
          <div class="stat-item">
            <span class="stat-label">Plazo de Obra</span>
            <span class="stat-value">1 Semana</span>
          </div>
          <div class="stat-divider" aria-hidden="true"></div>
          <div class="stat-item">
            <span class="stat-label">Revestimiento</span>
            <span class="stat-value">Pared 120x60 · Suelo 60x60</span>
          </div>
          <div class="stat-divider" aria-hidden="true"></div>
          <div class="stat-item">
            <span class="stat-label">Ducha Walk-In</span>
            <span class="stat-value">Mampara Fija 80 cm + Lluvia</span>
          </div>
        </div>
        <div class="hero-actions"><a href="#galeria" class="btn-premium btn-primary-premium"><span class="btn-content">Ver galería completa</span><span class="btn-border"></span><span class="btn-arrow">→</span></a><a href={`https://wa.me/584227997043?text=${encodeURIComponent(whatsappText)}`} class="btn-premium btn-outline-premium" target="_blank" rel="noopener"><span class="btn-content">Solicitar valoración</span><span class="btn-arrow">→</span></a></div><p class="hero-proof">{project.gallery.length} fotos reales · sistema técnico documentado · ampliación en lightbox</p>
      </div>
    </div>
  </header>

  <!-- BREADCRUMBS TRAS EL HERO -->
  <nav class="breadcrumb-after-hero" aria-label="Breadcrumb">
    <div class="container">
      <div class="breadcrumb-inner">
        <a href="/">Inicio</a>
        <span class="separator">/</span>
        <a href="/proyectos">Proyectos</a>
        <span class="separator">/</span>
        <span class="current">Baño Poceta Flotante San Diego</span>
      </div>
    </div>
  </nav>

  <!-- 2. DUAL-SHOWCASE: INNOVACIÓN SANITARIA (ZERO CROPPING) -->
  <section class="dual-showcase-section" id="espacios">
    <div class="container">
      <div class="section-heading">
        <span class="eyebrow-text">VISTA DESTACADA DEL PROYECTO</span>
        <h2 class="editorial-title">Poceta Flotante TEKA y Monolitismo Beige</h2>
        <p class="editorial-subtitle">
          El proyecto en San Diego representó un salto arquitectónico: de un baño convencional a una sala sanitaria suspendida donde el pavimento libre y el porcelanato rectificado de gran formato 120x60 en paredes multiplican el confort y la amplitud.
        </p>
      </div>

      <div class="showcase-grid">
        <!-- Card 1: Sistema TEKA Manacor -->
        <article class="showcase-card">
          <div class="showcase-image-frame">
            <span class="showcase-badge">Sistema Suspendido · TEKA Manacor</span>
            <img 
              src="/images/proyectos/bano-san-diego/teka-manacor-flotante-kit.webp" 
              alt="Kit marca TEKA modelo Manacor de inodoro suspendido con cisterna empotrada y pulsador" 
              loading="eager"
              decoding="async"
            />
          </div>
          <div class="showcase-content">
            <h3 class="showcase-title">Ingeniería de Inodoro Flotante TEKA</h3>
            <p class="showcase-desc">
              El cliente eligió el sistema oficial marca TEKA modelo Manacor. La cisterna y el bastidor metálico se empotran ocultos tras un muro de albañilería especializada, dejando el inodoro suspendido sin contacto con el suelo.
            </p>
            <ul class="showcase-highlights">
              <li>• Bastidor de alta carga con cisterna empotrada de doble descarga</li>
              <li>• Adaptación estructural y anclaje de bastidor metálico autoportante</li>
              <li>• Mantenimiento y acceso frontal sencillo a través del pulsador</li>
            </ul>
          </div>
        </article>

        <!-- Card 2: Baño Terminado Beige -->
        <article class="showcase-card">
          <div class="showcase-image-frame">
            <span class="showcase-badge">Baño Terminado · Gran Formato 120x60</span>
            <img 
              src="/images/proyectos/bano-san-diego/bano-finalizado-1.webp" 
              alt="Baño finalizado en San Diego con poceta flotante TEKA y porcelanato beige rectificado" 
              loading="eager"
              decoding="async"
            />
          </div>
          <div class="showcase-content">
            <h3 class="showcase-title">Integración Monolítica en Beige</h3>
            <p class="showcase-desc">
              El revestimiento en porcelanato rectificado de gran formato 120x60 cm en paredes y 60x60 cm en el suelo, en tono beige, confiere una serenidad atemporal. Al estar la poceta elevada, la limpieza del suelo se realiza en segundos sin rincones inaccesibles.
            </p>
            <ul class="showcase-highlights">
              <li>• Pavimento porcelánico tono beige claramente antideslizante</li>
              <li>• Mueble blanco suspendido de 80 cm con grifería TEKA cromada</li>
              <li>• Red de agua potable sustituida por multicapa PEX-Al-PEX</li>
            </ul>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- 3. DETAILED TECHNICAL NARRATIVE & SPECS (2-COLUMN EDITORIAL GRID) -->
  <section class="technical-narrative-section" id="memoria">
    <div class="container">
      <div class="narrative-layout">
        <!-- Main Editorial Narrative -->
        <div class="narrative-main">
          <span class="eyebrow-text">MEMORIA TÉCNICA DEL PROYECTO</span>
          <h2 class="editorial-title">Albañilería de Cisterna, Porcelanato Rectificado y Acabados TEKA</h2>

          <div class="editorial-chapter">
            <h3 class="chapter-title">01. El Reto del Inodoro Suspendido y Demolición Total</h3>
            <p class="chapter-text">
              En esta residencia de San Diego (Carabobo), el baño original contaba con cerámicas anticuadas y sanitarios apoyados en el suelo que sobrecargaban visualmente el área. El cliente buscaba una estética minimalista europea en la que la zona de inodoro pareciera flotar en el aire.
            </p>
            <p class="chapter-text">
              Como es protocolo de ingeniería en <strong>RemodelaT Venezuela</strong>, se ejecutó una demolición total del pavimento, revestimiento de paredes y sanitarios anteriores hasta llegar a la estructura. Se eliminó por completo la antigua plomería galvanizada/obsoleta para dar paso a un nuevo circuito hidráulico y de drenaje adaptado a las coordenadas milimétricas del bastidor suspendido.
            </p>
          </div>

          <div class="editorial-chapter">
            <h3 class="chapter-title">02. Estructura y Albañilería: Anclaje de Bastidor TEKA</h3>
            <p class="chapter-text">
              La instalación de un inodoro flotante requiere un trabajo conjunto entre fontanería y albañilería estructural:
            </p>
            <ul class="editorial-list">
              <li>
                <strong>Anclaje del bastidor TEKA Manacor:</strong> Se fijó a la pared portante el bastidor de acero del kit <em>TEKA Manacor</em>, ajustando el desagüe y las líneas de agua multicapa <strong>PEX-Al-PEX</strong> que alimentan la cisterna oculta.
              </li>
              <li>
                <strong>Cerramiento y maestreado estructural:</strong> Una vez probada la estanqueidad y presión de la plomería PEX-Al-PEX, se ejecutó el cerramiento técnico del bastidor portante, maestreado con mortero impermeable y regularizado con cuñas autonivelantes para recibir las piezas cerámicas de gran formato 120x60.
              </li>
              <li>
                <strong>Pulsador y acceso técnico:</strong> La única parte visible de la cisterna es el elegante pulsador cromado, desde el cual se opera la doble descarga de ahorro hídrico y se accede con total comodidad al mecanismo interior.
              </li>
            </ul>
          </div>

          <!-- PEDAGOGICAL CALLOUT: PORCELANATO RECTIFICADO BEIGE -->
          <div class="editorial-chapter">
            <h3 class="chapter-title">03. Porcelanato Rectificado Beige: Gran Formato 120x60 y Suelo 60x60</h3>
            <p class="chapter-text">
              Las paredes se revistieron con un elegante <strong>porcelanato rectificado de gran formato 120x60 cm en tono beige</strong> y el suelo con <strong>porcelanato rectificado 60x60 cm</strong> del mismo tono, seleccionando para el pavimento una versión con tratamiento antideslizante certificado.
            </p>
            
            <div class="highlight-callout">
              <span class="callout-badge">¿QUÉ ES EL ACABADO RECTIFICADO Y POR QUÉ USARLO EN PARTE Y SUELO?</span>
              <p>
                El porcelanato rectificado se diferencia de la cerámica tradicional por su proceso posterior de corte computarizado con diamante, logrando cantos rectos a <strong>90° perfectos</strong> y dimensiones milimétricamente exactas sin desviaciones.
              </p>
              <ul class="callout-list">
                <li>
                  <strong>Microjuntas casi invisibles (1 mm):</strong> En lugar de lechadas anchas de 3 a 5 mm que ensucian y fragmentan la pared, el formato rectificado permite una junta mínima que unifica las placas.
                </li>
                <li>
                  <strong>Efecto de caja monolítica beige:</strong> Al mantener el mismo tono beige sereno en paredes y suelo, con piezas de gran formato 120x60 que reducen al mínimo el número de juntas, el baño adquiere la continuidad visual de un spa residencial, transmitiendo paz y una gran amplitud luminosa.
                </li>
                <li>
                  <strong>Máxima facilidad de limpieza:</strong> La lechada es el punto donde el sarro, jabón y moho se adhieren con mayor facilidad. Al minimizar su superficie, el baño se mantiene pulcro con un mantenimiento cotidiano simple.
                </li>
              </ul>
            </div>

            <p class="chapter-text">
              En la zona de paso y ducha, el pavimento antideslizante ofrece tracción segura para toda la familia en presencia de agua y jabón, sin perder el tacto sedoso y el tono beige del conjunto.
            </p>
          </div>

          <div class="editorial-chapter">
            <h3 class="chapter-title">04. Mueble Blanco de 80 cm, Grifería TEKA Cromada y Espejo LED</h3>
            <p class="chapter-text">
              En la zona de lavabo se instaló un mueble contemporáneo suspendido de <strong>80 cm de ancho en color blanco pulido</strong> con lavabo integrado, coronado por una <strong>grifería monomando TEKA en acabado cromado</strong> de alto brillo. Este mueble blanco genera un contraste nítido y refrescante sobre el fondo beige rectificado.
            </p>
            <p class="chapter-text">
              Sobre la encimera se montó un <strong>espejo con iluminación LED integrada</strong> en su perímetro, el cual proporciona luz frontal clara y difusa, ideal para el aseo personal diario eliminando sombras en el rostro.
            </p>
          </div>

          <div class="editorial-chapter">
            <h3 class="chapter-title">05. Ducha Walk-In: Mampara Fija 80 cm y Columna Lluvia</h3>
            <p class="chapter-text">
              El área de ducha se delimitó de manera minimalista mediante un panel de <strong>mampara fija de 80 cm de ancho</strong>, construido con perfilería en cromo pulido y <strong>cristal templado de seguridad</strong> de alta resistencia a impactos.
            </p>
            <p class="chapter-text">
              Como protagonista del confort, se instaló una <strong>columna de ducha en acabado cromado</strong> con rociador superior de <strong>efecto lluvia</strong> y teléfono de ducha de mano mural regulable en altura, completando una experiencia de baño residencial de clase superior.
            </p>
          </div>
        </div>

        <!-- Sticky Sidebar: Technical Specifications & Scope Checklist -->
        <aside class="narrative-sidebar">
          <!-- Card 1: Ficha Técnica -->
          <div class="spec-card">
            <div class="spec-header">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--gold)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                <polyline points="14 2 14 8 20 8"/>
                <line x1="16" y1="13" x2="8" y2="13"/>
                <line x1="16" y1="17" x2="8" y2="17"/>
                <polyline points="10 9 9 9 8 9"/>
              </svg>
              <h3 class="spec-title">Ficha Técnica del Proyecto</h3>
            </div>
            <dl class="spec-list">
              {project.specs.map(item => (
                <div class="spec-row">
                  <dt>{item.label}</dt>
                  <dd>{item.value}</dd>
                </div>
              ))}
            </dl>
          </div>

          <!-- Card 2: Checklist Alcance del Trabajo -->
          <div class="spec-card">
            <div class="spec-header">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--gold)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="9 11 12 14 22 4"/>
                <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/>
              </svg>
              <h3 class="spec-title">Alcance Contratado</h3>
            </div>
            <ul class="scope-list">
              {project.scope.map(item => (
                <li class="scope-item">
                  <span class="check-icon">✓</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Card 3: Sello de Garantía -->
          <div class="guarantee-card">
            <span class="guarantee-eyebrow">ESTÁNDAR REMODELAT VENEZUELA</span>
            <h4 class="guarantee-title">Sanitarios Flotantes con Garantía Estructural</h4>
            <p class="guarantee-text">
              Nuestra ingeniería hidráulica en multicapa y los anclajes de bastidores TEKA están respaldados con garantía por contrato en Carabobo y Caracas.
            </p>
          </div>
        </aside>
      </div>
    </div>
  </section>

