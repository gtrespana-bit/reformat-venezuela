    font-weight: 500;
    color: var(--white);
    margin-bottom: 10px;
  }

  .guarantee-text {
    font-size: 0.88rem;
    line-height: 1.6;
    color: rgba(255,255,255,0.7);
    margin: 0;
  }

  /* ==========================================================
     4. COMPARATIVA VISUAL ANTES VS DESPUÉS (UNCROPPED)
     ========================================================== */
  .before-after-section {
    padding: 85px 0;
    background: var(--bone);
  }

  .comparison-grid {
    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  .comparison-pair {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
    background: var(--white);
    border: 1px solid var(--sand);
    border-radius: var(--r-md);
    padding: 24px;
    box-shadow: var(--e-1);
  }

  .comparison-item {
    display: flex;
    flex-direction: column;
    cursor: zoom-in;
    transition: transform 0.3s ease;
  }

  .comparison-item:hover {
    transform: translateY(-3px);
  }

  .comparison-image-wrapper {
    position: relative;
    background: var(--ink-soft);
    border-radius: var(--r-sm);
    padding: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 360px;
    overflow: hidden;
  }

  .comparison-label {
    position: absolute;
    top: 14px;
    left: 14px;
    z-index: 2;
    padding: 5px 14px;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    border-radius: var(--r-sm);
    box-shadow: var(--e-1);
  }

  .before-label {
    background: #e63946;
    color: #ffffff;
  }

  .after-label {
    background: var(--gold);
    color: var(--ink);
  }

  /* ZERO CROPPING IN COMPARISON IMAGES */
  .comparison-image-wrapper img {
    width: 100%;
    height: auto;
    max-height: 480px;
    object-fit: contain;
    border-radius: 2px;
  }

  .comparison-caption {
    margin-top: 14px;
    font-size: 0.92rem;
    line-height: 1.55;
    color: var(--text-muted);
    text-align: center;
    padding: 0 12px;
  }

  /* ==========================================================
     5. GALLERY WITH FILTER TABS AND ZERO-CROP LAYOUT
     ========================================================== */
  .gallery-section {
    padding: 95px 0 100px;
    background: var(--white);
  }

  .gallery-filters {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 36px;
  }

  .filter-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 22px;
    background: var(--bone);
    border: 1px solid var(--sand);
    border-radius: var(--r-full);
    font-family: var(--font-sans);
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-light);
    cursor: pointer;
    transition: all 0.25s ease;
  }

  .filter-btn:hover {
    background: var(--sand);
    color: var(--text);
  }

  .filter-btn.active {
    background: var(--ink);
    color: var(--white);
    border-color: var(--ink);
  }

  .filter-count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 2px 8px;
    font-size: 0.75rem;
    font-weight: 700;
    background: rgba(201,169,97,0.2);
    color: var(--gold-ink);
    border-radius: 12px;
  }

  .filter-btn.active .filter-count {
    background: var(--gold);
    color: var(--ink);
  }

  /* Zero-Crop Grid Cards */
  .gallery-masonry {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
    align-items: start;
  }

  .gallery-card {
    background: var(--bone);
    border: 1px solid var(--sand);
    border-radius: var(--r-md);
    overflow: hidden;
    transition: transform 0.3s var(--ease-out), box-shadow 0.3s var(--ease-out), opacity 0.3s ease;
    display: flex;
    flex-direction: column;
    cursor: zoom-in;
  }

  .gallery-card.card-landscape {
    grid-column: span 2;
  }

  /* Cada bloque tematico arranca en una fila nueva:
     evita que se mezclen fotos de "antes" y "despues" en la misma linea */
  .gallery-card.group-start {
    grid-column-start: 1;
  }

  .gallery-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--e-2);
    border-color: rgba(201,169,97,0.4);
  }

  .gallery-card.hidden {
    display: none !important;
  }

  .card-image-box {
    position: relative;
    background: var(--ink-soft);
    padding: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 320px;
    overflow: hidden;
  }

  .card-landscape .card-image-box {
    min-height: 340px;
  }

  .card-badge {
    position: absolute;
    top: 14px;
    left: 14px;
    z-index: 2;
    padding: 5px 12px;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    background: var(--gold);
    color: var(--ink);
    border-radius: var(--r-sm);
    box-shadow: var(--e-1);
  }

  /* CRITICAL: NATURAL ASPECT RATIO - ZERO CROPPING */
  .card-image-box img {
    width: 100%;
    height: auto;
    max-height: 520px;
    object-fit: contain;
    border-radius: 2px;
    transition: transform 0.4s var(--ease-out);
  }

  .gallery-card:hover .card-image-box img {
    transform: scale(1.02);
  }

  .card-hover-overlay {
    position: absolute;
    inset: 0;
    background: rgba(20,18,14,0.45);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .gallery-card:hover .card-hover-overlay {
    opacity: 1;
  }

  .hover-zoom-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 20px;
    background: var(--white);
    color: var(--ink);
    font-size: 0.88rem;
    font-weight: 600;
    border-radius: var(--r-full);
    box-shadow: var(--e-2);
    transform: translateY(8px);
    transition: transform 0.3s ease;
  }

  .gallery-card:hover .hover-zoom-btn {
    transform: translateY(0);
  }

  .card-caption-box {
    padding: 22px 24px;
    display: flex;
    flex-direction: column;
  }

  .card-category-tag {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--gold-ink);
    margin-bottom: 8px;
  }

  .card-title {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    font-weight: 600;
    color: var(--text);
    margin-bottom: 10px;
    line-height: 1.3;
  }

  .card-desc {
    font-size: 0.92rem;
    line-height: 1.62;
    color: var(--text-muted);
  }

  /* ==========================================================
     6. LUXURY CTA SECTION
     ========================================================== */
  .project-cta-luxury {
    position: relative;
    padding: 100px 0;
    background: var(--ink);
    color: var(--white);
    text-align: center;
    overflow: hidden;
  }

  .cta-backdrop {
    position: absolute;
    inset: 0;
    background: 
      radial-gradient(ellipse at 50% 10%, rgba(201,169,97,0.15) 0%, transparent 60%),
      radial-gradient(ellipse at 80% 90%, rgba(201,169,97,0.08) 0%, transparent 60%);
    pointer-events: none;
  }

  .cta-inner {
    position: relative;
    z-index: 1;
    max-width: 760px;
    margin: 0 auto;
  }

  .cta-kicker {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 16px;
  }

  .cta-title {
    font-family: var(--font-serif);
    font-size: clamp(2.2rem, 4.5vw, 3.2rem);
    font-weight: 500;
    color: var(--white);
    line-height: 1.15;
    margin-bottom: 18px;
  }

  .cta-text {
    font-size: 1.08rem;
    line-height: 1.72;
    color: rgba(255,255,255,0.75);
    margin-bottom: 36px;
  }

  .cta-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 18px;
  }

  .btn-secondary-luxury {
    display: inline-flex;
    align-items: center;
    padding: 15px 28px;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--white);
    text-decoration: none;
    border: 1px solid rgba(255,255,255,0.25);
    border-radius: var(--r-full);
    transition: all 0.25s ease;
  }

  .btn-secondary-luxury:hover {
    background: rgba(255,255,255,0.1);
    border-color: var(--gold);
    color: var(--gold);
  }

  /* ==========================================================
     7. FULL-SCREEN INTERACTIVE LIGHTBOX (ZERO CROPPING)
     ========================================================== */
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 10000;
    background: rgba(14,12,10,0.96);
    backdrop-filter: blur(12px);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
    padding: 40px;
  }

  .lightbox.active {
    opacity: 1;
    visibility: visible;
  }

  .lightbox-content {
    max-width: 1100px;
    max-height: 90vh;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    transform: scale(0.96);
    transition: transform 0.3s var(--ease-out);
  }

  .lightbox.active .lightbox-content {
    transform: scale(1);
  }

  .lightbox-img-wrapper {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    max-height: 72vh;
    margin-bottom: 24px;
  }

  /* CRITICAL: LIGHTBOX IMAGE COMPLETELY UNCROPPED */
  .lightbox-img-wrapper img {
    max-width: 100%;
    max-height: 72vh;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 4px;
    box-shadow: 0 20px 60px rgba(0,0,0,0.6);
  }

  .lightbox-info {
    text-align: center;
    max-width: 780px;
    color: var(--white);
  }

  .lightbox-meta {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 8px;
  }

  .lightbox-badge {
    padding: 4px 12px;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    background: var(--gold);
    color: var(--ink);
    border-radius: var(--r-sm);
  }

  .lightbox-counter {
    font-size: 0.82rem;
    color: rgba(255,255,255,0.6);
    font-weight: 600;
  }

  .lightbox-title {
    font-family: var(--font-serif);
    font-size: 1.6rem;
    font-weight: 500;
    color: var(--white);
    margin-bottom: 8px;
  }

  .lightbox-caption {
    font-size: 0.96rem;
    line-height: 1.6;
    color: rgba(255,255,255,0.75);
    margin: 0;
  }

  .lightbox-close {
    position: absolute;
    top: 24px;
    right: 28px;
    width: 48px;
    height: 48px;
    border: none;
    background: rgba(255,255,255,0.08);
    color: var(--white);
    font-size: 1.8rem;
    cursor: pointer;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s ease, transform 0.2s ease;
    z-index: 10;
  }

  .lightbox-close:hover {
    background: rgba(255,255,255,0.2);
    transform: scale(1.05);
  }

  .lightbox-prev,
  .lightbox-next {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 52px;
    height: 52px;
    border: none;
    background: rgba(255,255,255,0.08);
    color: var(--white);
    cursor: pointer;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s ease, transform 0.2s ease;
    z-index: 10;
  }

  .lightbox-prev:hover,
  .lightbox-next:hover {
    background: rgba(255,255,255,0.22);
  }

  .lightbox-prev { left: 28px; }
  .lightbox-next { right: 28px; }

  /* ==========================================================
     8. RESPONSIVE BREAKPOINTS
     ========================================================== */
  @media (max-width: 1024px) {
    .narrative-layout {
      grid-template-columns: 1fr;
      gap: 48px;
    }

    .narrative-sidebar {
      position: static;
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 24px;
    }

    .guarantee-card {
      grid-column: span 2;
    }

    .gallery-masonry {
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
    }

    .gallery-card.card-landscape {
      grid-column: span 2;
    }
  }

  @media (max-width: 768px) {
    .project-hero {
      padding: 145px 0 65px;
    }

    .hero-stats-ribbon {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
      padding: 20px;
    }

    .stat-divider {
      width: 100%;
      height: 1px;
    }

    .showcase-grid,
    .comparison-pair {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .showcase-image-frame,
    .comparison-image-wrapper {
      min-height: 340px;
    }

    .narrative-sidebar {
      grid-template-columns: 1fr;
    }

    .guarantee-card {
      grid-column: span 1;
    }

    .gallery-masonry {
      grid-template-columns: 1fr;
    }

    .gallery-card.card-landscape {
      grid-column: span 1;
    }

    .lightbox {
      padding: 20px 14px;
    }

    .lightbox-prev,
    .lightbox-next {
      width: 44px;
      height: 44px;
    }

    .lightbox-prev { left: 12px; }
    .lightbox-next { right: 12px; }

    .lightbox-close {
      top: 16px;
      right: 16px;
      width: 42px;
      height: 42px;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    /* ==========================================================
       1. GALLERY FILTER TABS
       ========================================================== */
    const filterButtons = document.querySelectorAll('.filter-btn');
    const galleryCards = document.querySelectorAll('.gallery-card');

    filterButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const targetFilter = btn.getAttribute('data-filter');

        // Toggle active button state
        filterButtons.forEach(b => {
          b.classList.remove('active');
          b.setAttribute('aria-selected', 'false');
        });
        btn.classList.add('active');
        btn.setAttribute('aria-selected', 'true');

        // Filter cards
        galleryCards.forEach(card => {
          const category = card.getAttribute('data-category');
          if (targetFilter === 'all' || category === targetFilter) {
            card.classList.remove('hidden');
          } else {
            card.classList.add('hidden');
          }
        });
      });
    });

    /* ==========================================================
       2. INTERACTIVE LIGHTBOX SYSTEM
       ========================================================== */
    const lightbox = document.getElementById('lightbox');
    const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
    const lightboxTitle = document.getElementById('lightbox-title');
    const lightboxCaption = document.getElementById('lightbox-caption');
    const lightboxBadge = document.getElementById('lightbox-badge');
    const lightboxCurrent = document.getElementById('lightbox-current');
    const closeBtn = document.querySelector('.lightbox-close');
    const prevBtn = document.querySelector('.lightbox-prev');
    const nextBtn = document.querySelector('.lightbox-next');

    // Build items list from gallery and comparison pairs
    interface LightboxItem {
      src: string;
      alt: string;
      title: string;
      caption: string;
      badge: string;
    }

    let items: LightboxItem[] = [];
    let currentIndex = 0;

    // Populate items from gallery cards
    const cardElements = document.querySelectorAll('.gallery-card');
    const galleryItems: LightboxItem[] = Array.from(cardElements).map(el => {
      const img = el.querySelector('img');
      const badge = el.querySelector('.card-badge')?.textContent || 'Proyecto';
      return {
        src: el.getAttribute('data-src') || img?.src || '',
        alt: el.getAttribute('data-alt') || img?.alt || '',
        title: el.getAttribute('data-title') || 'Remodelación de Baño',
        caption: el.getAttribute('data-caption') || '',
        badge: badge
      };
    });

    function openLightbox(newItems: LightboxItem[], index: number) {
      if (!lightbox || !lightboxImg) return;
      items = newItems;
      currentIndex = index;
      updateLightbox();
      lightbox.classList.add('active');
      lightbox.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }

    function closeLightbox() {
      if (!lightbox) return;
      lightbox.classList.remove('active');
      lightbox.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    function updateLightbox() {
      if (!lightboxImg || !items[currentIndex]) return;
      const current = items[currentIndex];
      lightboxImg.src = current.src;
      lightboxImg.alt = current.alt;
      if (lightboxTitle) lightboxTitle.textContent = current.title;
      if (lightboxCaption) lightboxCaption.textContent = current.caption;
      if (lightboxBadge) lightboxBadge.textContent = current.badge;
      if (lightboxCurrent) lightboxCurrent.textContent = String(currentIndex + 1);
    }

    function prevImage() {
      if (!items.length) return;
      currentIndex = (currentIndex - 1 + items.length) % items.length;
      updateLightbox();
    }

    function nextImage() {
      if (!items.length) return;
      currentIndex = (currentIndex + 1) % items.length;
      updateLightbox();
    }

    if (closeBtn) closeBtn.addEventListener('click', closeLightbox);
    if (prevBtn) prevBtn.addEventListener('click', prevImage);
    if (nextBtn) nextBtn.addEventListener('click', nextImage);

    if (lightbox) {
      lightbox.addEventListener('click', (e) => {
        if (e.target === lightbox) closeLightbox();
      });
    }

    document.addEventListener('keydown', (e) => {
      if (!lightbox || !lightbox.classList.contains('active')) return;
      if (e.key === 'Escape') closeLightbox();
      if (e.key === 'ArrowLeft') prevImage();
      if (e.key === 'ArrowRight') nextImage();
    });

    // Attach click events to gallery cards
    cardElements.forEach((el, idx) => {
      el.addEventListener('click', () => {
        openLightbox(galleryItems, idx);
      });
    });

    // Attach click events to Before/After comparison items
    document.querySelectorAll('.comparison-item').forEach(el => {
      el.addEventListener('click', () => {
        const img = el.querySelector('img');
        const label = el.querySelector('.comparison-label')?.textContent || 'Comparativa';
        const item: LightboxItem = {
          src: el.getAttribute('data-src') || img?.src || '',
          alt: el.getAttribute('data-alt') || img?.alt || '',
          title: el.getAttribute('data-title') || 'Comparativa Antes vs Después',
          caption: el.querySelector('.comparison-caption')?.textContent || '',
          badge: label
        };
        openLightbox([item], 0);
      });
    });

    // Attach click events to showcase cards
    document.querySelectorAll('.showcase-card').forEach(el => {
      el.addEventListener('click', () => {
        const img = el.querySelector('img');
        const badge = el.querySelector('.showcase-badge')?.textContent || 'Espacio';
        if (!img) return;
        const item: LightboxItem = {
          src: img.src,
          alt: img.alt,
          title: el.querySelector('.showcase-title')?.textContent || 'Espacio del Proyecto',
          caption: el.querySelector('.showcase-desc')?.textContent || '',
          badge: badge
        };
        openLightbox([item], 0);
      });
    });
  });
</script>
