---
import BaseLayout from '../layouts/BaseLayout.astro';

const getSrcSet = (baseName, widths, ext = 'webp') => {
  return widths.map(w => `/images/${baseName}-${w}.${ext} ${w}w`).join(', ');
};

const whatsappBudgetText = 'Hola,%20quiero%20solicitar%20una%20valoración%20técnica%20para%20mi%20remodelación.%20Puedo%20enviar%20fotos%20y%20ubicación%20por%20aquí.';

const serviceImages = {
  cocina: { src: '/images/cocina-800.webp', srcset: getSrcSet('cocina', [400, 800, 1600]) },
  bano: { src: '/images/bano-800.webp', srcset: getSrcSet('bano', [400, 800, 1600]) },
  electricidad: { src: '/images/electricidad-800.webp', srcset: getSrcSet('electricidad', [400, 800, 1600]) },
  fontaneria: { src: '/images/fontaneria-800.webp', srcset: getSrcSet('fontaneria', [400, 800, 1600]) },
  revestimientos: { src: '/images/revestimientos-800.webp', srcset: getSrcSet('revestimientos', [400, 800, 1600]) },
  sueloPorcelanato: { src: '/images/suelo-porcelanato-800.webp', srcset: getSrcSet('suelo-porcelanato', [400, 800, 1600]) },
  piscinas: { src: '/images/piscinas-800.webp', srcset: getSrcSet('piscinas', [400, 800, 1600]) },
  integrales: { src: '/images/integrales-800.webp', srcset: getSrcSet('integrales', [400, 800, 1600]) },
  pintura: { src: '/images/pintura-800.webp', srcset: getSrcSet('pintura', [400, 800, 1600]) }
};

const services = [
  { title: "Remodelaciones Integrales", desc: "Viviendas completas con planificación técnica, coordinación de oficios y acabados de alto estándar.", image: serviceImages.integrales, link: "/servicios/remodelacion-integral" },
  { title: "Cocinas de Diseño", desc: "Mobiliario a medida, superficies de alta resistencia, iluminación técnica y herrajes duraderos.", image: serviceImages.cocina, link: "/servicios/remodelacion-cocina" },
  { title: "Baños Tipo Spa", desc: "Impermeabilización documentada, pendientes correctas, grifería de calidad y revestimientos precisos.", image: serviceImages.bano, link: "/servicios/remodelacion-bano" },
  { title: "Pisos y Revestimientos", desc: "Porcelanato, piedra, madera y piezas de gran formato instaladas con el adhesivo y soporte adecuados.", image: serviceImages.sueloPorcelanato, link: "/servicios/instalacion-pisos" },
  { title: "Revestimientos de Pared", desc: "Wall panels, piedra, microcemento y detalles decorativos con cortes limpios y encuentros cuidados.", image: serviceImages.revestimientos, link: "/servicios/revestimientos-pared" },
  { title: "Pintura y Acabados", desc: "Preparación profesional de superficies, corrección de imperfecciones y terminaciones limpias.", image: serviceImages.pintura, link: "/servicios/pintura-acabados" },
  { title: "Instalaciones Eléctricas", desc: "Tableros, cableado, iluminación LED y protecciones dimensionadas dentro de proyectos de remodelación.", image: serviceImages.electricidad, link: "/servicios/instalacion-electrica" },
  { title: "Fontanería y Plomería", desc: "Renovación de tuberías, puntos de agua, pruebas de funcionamiento y soluciones ocultas bien ejecutadas.", image: serviceImages.fontaneria, link: "/servicios/fontaneria-plomeria" },
  { title: "Piscinas y Exteriores", desc: "Revestimientos, filtración, mantenimiento y acabados exteriores para viviendas de alto valor.", image: serviceImages.piscinas, link: "/servicios/piscinas-mantenimiento" }
];

const processSteps = [
  { step: "01", title: "Diagnóstico técnico", desc: "Medimos, revisamos instalaciones, soportes, humedades, pendientes y condiciones reales antes de prometer una solución." },
  { step: "02", title: "Especificación", desc: "Definimos materiales compatibles con cada uso: adhesivos, impermeabilizantes, grifería, iluminación, herrajes y acabados." },
  { step: "03", title: "Presupuesto por partidas", desc: "Recibes una propuesta clara, con alcance, calidades, tiempos, exclusiones y condiciones de garantía por escrito." },
  { step: "04", title: "Ejecución supervisada", desc: "Controlamos obra, proveedores, pruebas técnicas y remates para evitar improvisaciones en las fases críticas." },
  { step: "05", title: "Entrega verificada", desc: "Revisión conjunta, checklist de acabados, limpieza final, documentación fotográfica y garantía aplicable." }
];

const aboutBadges = [
  "Estándares europeos",
  "Supervisión directa",
  "+23 años",
  "Garantía escrita"
];

const testimonials = [
  { text: "Lo que más valoramos fue que explicaron por qué cada material debía usarse en una zona específica. No se trató solo de que se viera bonito, sino de que quedara bien hecho.", name: "Propietario de vivienda", location: "San Diego, Carabobo" },
  { text: "El baño quedó impecable, pero la diferencia estuvo en el proceso: impermeabilización documentada, pruebas antes de cerrar y revisión de cada remate.", name: "Cliente residencial", location: "Valencia, Carabobo" },
  { text: "Buscábamos una remodelación sin improvisaciones. Recibimos cronograma, presupuesto por partidas y seguimiento constante durante toda la obra.", name: "Propietario de apartamento", location: "Caracas" }
];

const serviceAreas = [
  "Valencia", "San Diego", "Naguanagua", "Guacara", "Los Guayos", "Caracas",
  "Chacao", "Baruta", "El Hatillo", "La Guaira", "Puerto Cabello", "Tocuyito"
];

const qualityPillars = [
  { title: "No usamos soluciones genéricas", desc: "Cada adhesivo, impermeabilizante, tubería, protección eléctrica o sellado se elige según soporte, uso, formato y exposición." },
  { title: "Lo oculto se prueba antes de cerrar", desc: "Instalaciones, pendientes, impermeabilización y puntos críticos se revisan antes de cubrirlos con acabados costosos." },
  { title: "Acabados revisados al detalle", desc: "Alineaciones, juntas, cortes, esquinas, siliconas, encuentros y limpieza final forman parte de la entrega, no son extras." }
];

const comparisonRows = [
  ["Material elegido solo por disponibilidad", "Material especificado según soporte, uso y ficha técnica"],
  ["El mismo pego para cualquier cerámica o porcelanato", "Adhesivo compatible con absorción, formato, peso y superficie"],
  ["Instalaciones cerradas sin evidencia de pruebas", "Pruebas y revisión antes de cubrir paredes, pisos o techos"],
  ["Presupuesto global difícil de controlar", "Presupuesto por partidas, alcance definido y condiciones claras"],
  ["El acabado final depende del oficio del día", "Supervisión directa, checklist de remates y garantía por escrito"]
];

const fitItems = [
  "Quieres una remodelación duradera, no solo una obra que se vea bien el día de entrega.",
  "Valoras materiales correctos, supervisión técnica, limpieza, orden y comunicación.",
  "Prefieres invertir una vez en un resultado bien ejecutado antes que corregir retrabajos.",
  "Buscas acabados de alto estándar en una casa, apartamento, quinta o townhouse de valor."
];
---

<BaseLayout 
  title="Remodelaciones de Lujo en Venezuela | RemodelaT" 
  description="Remodelaciones residenciales de alto estándar en Venezuela. Cocinas, baños y reformas integrales con método técnico, materiales adecuados, acabados impecables y garantía por escrito." 
  activePage="inicio"
>

  <header class="hero">
    <!-- IMAGEN LCP EXPLÍCITA: Forzar que PageSpeed mida esto como LCP válido -->
    <img 
      src="/images/hero-lcp.webp" 
      alt="Interior moderno reformado con diseño de lujo" 
      fetchpriority="high"
      loading="eager"
      decoding="async"
      width="2400"
      height="1600"
      class="hero-lcp-img"
    />
    
    <script is:inline>
      (function() {
        var isMobile = window.innerWidth < 1024;
        var videoSrc = isMobile ? '/videos/hero-mobile.mp4' : '/videos/hero-desktop.mp4';
        var posterSrc = '/images/hero-lcp.webp';
        var style = 'position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; z-index: 1; pointer-events: none; opacity: 0; transition: opacity 1s ease-in-out;';
        document.write('<video id="hero-video" class="hero-video" autoplay muted loop playsinline preload="metadata" poster="' + posterSrc + '" src="' + videoSrc + '" onplaying="this.style.opacity=1" style="' + style + '"></video>');
      })();
    </script>
    
    <noscript>
      <video id="hero-video" class="hero-video" autoplay muted loop playsinline preload="metadata" poster="/images/hero-lcp.webp" src="/videos/hero-desktop.mp4" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; z-index: 1;"></video>
    </noscript>

    <div class="hero-overlay"></div>

    <div class="hero-content">
      <span class="hero-tag">Remodelaciones residenciales de alto estándar</span>
      <h1 class="hero-title">
        <span class="line">Remodelaciones de lujo</span>
        <span class="line gold">con precisión técnica</span>
      </h1>
      <p class="hero-sub">Cocinas, baños y reformas integrales para propietarios exigentes: materiales adecuados, supervisión de obra, acabados impecables y garantía por escrito.</p>
      <div class="hero-btns">
        <a href={`https://wa.me/584227997043?text=${whatsappBudgetText}`} target="_blank" rel="noopener" class="btn-premium btn-primary-premium">
          <span class="btn-content">Solicitar valoración técnica</span>
          <span class="btn-border"></span>
          <span class="btn-shine"></span>
          <span class="btn-arrow">→</span>
        </a>
        <a href="/proyectos" class="btn-premium btn-outline-premium">
          <span class="btn-content">Ver proyectos reales</span>
          <span class="btn-border"></span>
          <span class="btn-shine"></span>
          <span class="btn-arrow">→</span>
        </a>
      </div>
      <p class="hero-proof" aria-label="Señales de confianza">
        <span>23+ años</span>
        <i></i>
        <span>Método técnico</span>
        <i></i>
        <span>Garantía por escrito</span>
      </p>
    </div>
  </header>

  <section class="premium-proof-section" aria-label="Confianza y garantías">
    <div class="premium-proof-panel" data-reveal>
      <div class="proof-item">
        <strong>23+</strong>
        <span>Años de experiencia</span>
      </div>
      <div class="proof-item">
        <strong>Método</strong>
        <span>Materiales especificados</span>
      </div>
      <div class="proof-item">
        <strong>Garantía</strong>
        <span>Entrega documentada</span>
      </div>
    </div>
  </section>

  <section class="section positioning-section">
    <div class="container positioning-grid">
      <div class="positioning-copy" data-reveal>
        <span class="tag">Nuestro posicionamiento</span>
        <h2 class="section-title">No competimos por ser la opción más económica. Competimos por hacerlo bien.</h2>
        <p>RemodelaT es para propietarios que no buscan simplemente “hacer una obra”, sino invertir en una remodelación bien ejecutada, con materiales adecuados, supervisión técnica, acabados impecables y garantía real.</p>
        <p>Una remodelación de alto estándar no se define solo por cómo se ve el día de la entrega. Se define por cómo envejece, cómo funcionan sus instalaciones y cómo resisten sus acabados con el uso diario.</p>
      </div>
      <div class="quality-pillars" data-reveal>
        {qualityPillars.map((pillar) => (
          <article class="quality-pillar">
            <h3>{pillar.title}</h3>
            <p>{pillar.desc}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section bg-light">
    <div class="container">
      <div class="section-header" data-reveal>
        <span class="tag">Servicios de alto estándar</span>
        <h2 class="section-title">Remodelaciones para viviendas donde el detalle importa</h2>
        <p class="section-desc">Proyectos integrales, cocinas, baños, pisos y revestimientos ejecutados con planificación, especialidades técnicas coordinadas y acabados pensados para durar.</p>
      </div>
      
      <div class="home-services-grid">
        {services.map((svc, index) => (
          <a href={svc.link} class="home-service-card" data-reveal data-reveal-delay={String((index % 3) + 1)}>
            <div class="home-service-img">
              <img
                src={svc.image.src}
                srcset={svc.image.srcset}
                sizes="(max-width: 768px) 100vw, (max-width: 1100px) 50vw, 33vw"
                alt={svc.title}
                loading={index < 3 ? "eager" : "lazy"}
                fetchpriority={index === 0 ? "high" : "auto"}
                decoding="async"
                width="800"
                height="533"
              />
              <span class="home-service-kicker">Alto estándar</span>
            </div>
            <div class="home-service-body">
              <h3>{svc.title}</h3>
              <p>{svc.desc}</p>
              <span class="card-link">Ver servicio <span class="arrow">→</span></span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section technical-standard-section" id="metodo-reformat">
    <div class="container">
      <div class="section-header" data-reveal>
        <span class="tag">Método RemodelaT</span>
        <h2 class="section-title">Lo que no se ve también debe estar perfecto</h2>
        <p class="section-desc">El lujo real está en las decisiones técnicas: usar el material correcto, preparar bien el soporte, probar antes de cerrar y revisar cada remate antes de entregar.</p>
      </div>
      <div class="comparison-card" data-reveal>
        <div class="comparison-head">
          <span>Obra sin especificación</span>
          <span>Método RemodelaT</span>
        </div>
        {comparisonRows.map(([common, reformat]) => (
          <div class="comparison-row">
            <p>{common}</p>
            <p>{reformat}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container about-grid">
      <div class="about-imgs" data-reveal>
        <div class="img-box tall">
          <img 
            src="/images/arquitectura-600.webp"
            srcset="/images/arquitectura-400.webp 400w, /images/arquitectura-600.webp 600w"
            sizes="(max-width: 768px) 400px, 600px"
            alt="Arquitectura de viviendas modernas" 
            loading="lazy" 
            decoding="async"
            width="600"
            height="800"
          />
        </div>
        <div class="img-box small">
          <img 
            src="/images/equipo-600.webp"
            srcset="/images/equipo-400.webp 400w, /images/equipo-600.webp 600w"
            sizes="(max-width: 768px) 400px, 600px"
            alt="Equipo de profesionales trabajando" 
            loading="lazy" 
            decoding="async"
            width="600"
            height="400"
          />
        </div>
      </div>
      <div class="about-text" data-reveal>
        <span class="tag">Sobre Nosotros</span>
        <h2 class="section-title">Experiencia europea,<br/>ejecución local sin improvisación</h2>
        <p>RemodelaT nace en España con más de 23 años de trayectoria en remodelaciones. En Venezuela trabajamos con un criterio claro: adaptar estándares europeos a la realidad local sin sacrificar precisión, seguridad ni calidad de acabado.</p>
        <ul class="check-list">
          <li>Remodelaciones integrales con planificación, control de obra y garantía</li>
          <li>Instalaciones eléctricas y sanitarias revisadas antes de cerrar</li>
          <li>Diseño personalizado con materiales compatibles con cada aplicación</li>
          <li>Acabados finales revisados junto al propietario antes de entregar</li>
        </ul>
        <div class="about-badges" aria-label="Diferenciales de RemodelaT">
          {aboutBadges.map((badge) => (
            <span>{badge}</span>
          ))}
        </div>
        <a href="/metodo-reformat" class="btn-premium btn-primary-premium">
          <span class="btn-content">Conocer nuestro estándar</span>
          <span class="btn-border"></span>
          <span class="btn-shine"></span>
          <span class="btn-arrow">→</span>
        </a>
      </div>
    </div>
  </section>


  <section class="section process-section">
    <div class="container">
      <div class="section-header" data-reveal>
        <span class="tag">Cómo trabajamos</span>
        <h2 class="section-title">Un método diseñado para evitar improvisaciones</h2>
        <p class="section-desc">El cliente exigente no compra solo acabados: compra tranquilidad. Por eso cada fase tiene diagnóstico, especificación, ejecución supervisada y revisión documentada.</p>
      </div>
      <div class="process-grid">
        {processSteps.map((item) => (
          <article class="process-card" data-reveal>
            <span class="process-number">{item.step}</span>
            <h3>{item.title}</h3>
            <p>{item.desc}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section bg-light fit-section">
    <div class="container fit-grid">
      <div data-reveal>
        <span class="tag">Para quién trabajamos</span>
        <h2 class="section-title">Para propietarios que valoran la perfección, la garantía y la durabilidad</h2>
        <p class="section-desc">No somos la alternativa para resolver una obra de cualquier manera. Somos la alternativa para quienes prefieren un proceso serio, materiales correctos y acabados que estén a la altura de su vivienda.</p>
      </div>
      <ul class="fit-list" data-reveal>
        {fitItems.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section testimonials-section">
    <div class="container">
      <div class="section-header" data-reveal>
        <span class="tag">Confianza</span>
        <h2 class="section-title">Lo que más valoran los propietarios exigentes</h2>
        <p class="section-desc">La tranquilidad de saber qué se está haciendo, por qué se hace así y cómo se garantiza el resultado final.</p>
      </div>
      <div class="testimonials-grid-home">
        {testimonials.map((t) => (
          <figure class="testimonial-home-card" data-reveal>
            <blockquote>“{t.text}”</blockquote>
            <figcaption>
              <strong>{t.name}</strong>
              <span>{t.location}</span>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="section service-areas-section">
    <div class="container areas-grid">
      <div>
        <span class="tag">Zonas de Cobertura</span>
        <h2 class="section-title">Remodelamos viviendas de alto valor en Carabobo, Caracas y La Guaira</h2>
        <p class="section-desc">Atendemos casas, apartamentos, quintas y townhouses en zonas residenciales exigentes. Si tu zona no aparece, revisamos disponibilidad y alcance del proyecto.</p>
      </div>
      <div class="area-chips" data-reveal>
        {serviceAreas.map((area) => (
          <a href={area === 'Caracas' ? '/caracas' : area === 'Valencia' ? '/valencia' : area === 'San Diego' ? '/san-diego' : area === 'La Guaira' ? '/la-guaira' : '/contacto'}>{area}</a>
        ))}
      </div>
    </div>
  </section>

  <section class="cta-section cta-whatsapp-section">
    <div class="cta-wrapper">
      <span class="tag tag-on-dark">Valoración técnica</span>
      <h2 class="cta-title">¿Tu proyecto requiere un acabado impecable?</h2>
      <p class="cta-text">Envíanos fotos, ubicación y alcance aproximado. Revisamos si el proyecto encaja con nuestro estándar y coordinamos una valoración técnica con presupuesto detallado.</p>
      <div class="cta-actions-home">
        <a href={`https://wa.me/584227997043?text=${whatsappBudgetText}`} target="_blank" rel="noopener" class="btn-premium btn-white-premium">
          <span class="btn-content">Solicitar valoración por WhatsApp</span>
          <span class="btn-border"></span>
          <span class="btn-shine"></span>
          <span class="btn-arrow">→</span>
        </a>
        <a href="#contacto-rapido" class="btn-premium btn-outline-premium btn-cta-outline">
          <span class="btn-content">Completar formulario técnico</span>
          <span class="btn-border"></span>
          <span class="btn-shine"></span>
          <span class="btn-arrow">→</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section bg-light" id="contacto-rapido">
    <div class="container contact-grid">
      <div class="contact-info">
        <h2 class="section-title">Cuéntanos tu proyecto con el nivel de detalle que merece</h2>
        <p>Mientras más información tengamos, mejor podremos orientar tu remodelación: zona, tipo de vivienda, alcance, nivel de acabado y fecha estimada de inicio.</p>
        <div class="info-item">
          <h3>Ubicación</h3>
          <p>Valencia, San Diego, Carabobo y Caracas</p>
        </div>
        <div class="info-item">
          <h3>Teléfono</h3>
          <p><a href="tel:+584227997043" style="color: var(--gold-ink-strong); text-decoration: none; font-weight:600;">0422 799 7043</a></p>
        </div>
      </div>
      <form class="contact-form" action="https://formsubmit.co/contacto@remodelat.net" method="POST">
        <input type="hidden" name="_subject" value="Nueva consulta desde la web">
        <input type="hidden" name="_captcha" value="false">
        <input type="text" name="_honey" style="display:none" tabindex="-1" autocomplete="off">
        
        <div class="form-row">
          <input type="text" id="nombre" name="nombre" placeholder="Nombre" required aria-label="Tu nombre completo" />
          <input type="tel" id="telefono" name="telefono" placeholder="Teléfono" required aria-label="Tu número de teléfono" />
        </div>
        <input type="email" id="email" name="email" placeholder="Email" required aria-label="Tu correo electrónico" />
        <select id="proyecto" name="proyecto" required aria-label="Tipo de proyecto">
          <option value="" disabled selected>Tipo de proyecto</option>
          <option value="integral">Remodelación integral</option>
          <option value="cocina">Cocina de diseño</option>
          <option value="bano">Baño tipo spa</option>
          <option value="pisos-revestimientos">Pisos / revestimientos</option>
          <option value="otro">Otro alcance</option>
        </select>
        <div class="form-row">
          <input type="text" id="zona" name="zona" placeholder="Zona / urbanización" required aria-label="Zona o urbanización" />
          <select id="propiedad" name="propiedad" required aria-label="Tipo de propiedad">
            <option value="" disabled selected>Tipo de propiedad</option>
            <option value="casa">Casa / quinta</option>
            <option value="apartamento">Apartamento</option>
            <option value="townhouse">Townhouse</option>
            <option value="local">Local u oficina</option>
          </select>
        </div>
        <div class="form-row">
          <select id="acabado" name="nivel_acabado" required aria-label="Nivel de acabado deseado">
            <option value="" disabled selected>Nivel de acabado</option>
            <option value="alto-estandar">Alto estándar</option>
            <option value="lujo">Lujo</option>
            <option value="signature">Proyecto personalizado / signature</option>
          </select>
          <select id="inicio" name="fecha_inicio" required aria-label="Fecha estimada de inicio">
            <option value="" disabled selected>Inicio estimado</option>
            <option value="inmediato">Lo antes posible</option>
            <option value="1-3-meses">1 a 3 meses</option>
            <option value="3-6-meses">3 a 6 meses</option>
            <option value="sin-fecha">Aún estoy evaluando</option>
          </select>
        </div>
        <textarea id="mensaje" name="mensaje" placeholder="Describe el alcance, metraje aproximado, materiales deseados y si puedes enviar fotos o planos por WhatsApp" rows="4" required aria-label="Detalles de tu proyecto"></textarea>
        <button type="submit" class="btn-premium btn-primary-premium full-width">
