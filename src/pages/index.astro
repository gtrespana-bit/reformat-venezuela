---
import BaseLayout from '../layouts/BaseLayout.astro';

const getSrcSet = (baseName, widths, ext = 'webp') => {
  return widths.map(w => `/images/${baseName}-${w}.${ext} ${w}w`).join(', ');
};

const whatsappBudgetText = 'Hola,%20quiero%20un%20presupuesto%20para%20mi%20remodelación.%20Puedo%20enviar%20fotos%20por%20aquí.';

const serviceImages = {
  cocina: { src: '/images/cocina-800.webp', srcset: getSrcSet('cocina', [400, 800]) },
  bano: { src: '/images/bano-800.webp', srcset: getSrcSet('bano', [400, 800]) },
  electricidad: { src: '/images/electricidad-800.webp', srcset: getSrcSet('electricidad', [400, 800]) },
  fontaneria: { src: '/images/fontaneria-800.webp', srcset: getSrcSet('fontaneria', [400, 800]) },
  revestimientos: { src: '/images/revestimientos-800.webp', srcset: getSrcSet('revestimientos', [400, 800]) },
  sueloPorcelanato: { src: '/images/suelo-porcelanato-800.webp', srcset: getSrcSet('suelo-porcelanato', [400, 800]) },
  piscinas: { src: '/images/piscinas-800.webp', srcset: getSrcSet('piscinas', [400, 800]) },
  integrales: { src: '/images/integrales-800.webp', srcset: getSrcSet('integrales', [400, 800]) },
  pintura: { src: '/images/pintura-800.webp', srcset: getSrcSet('pintura', [400, 800]) }
};

const services = [
  { title: "Reformas de Cocina", desc: "Diseños funcionales, gabinetes premium, iluminación técnica y acabados modernos.", image: serviceImages.cocina, link: "/servicios/remodelacion-cocina" },
  { title: "Reformas de Baño", desc: "Baños tipo spa con impermeabilización, grifería de calidad y revestimientos duraderos.", image: serviceImages.bano, link: "/servicios/remodelacion-bano" },
  { title: "Reformas Integrales", desc: "Transformación completa de viviendas, apartamentos y negocios con planificación profesional.", image: serviceImages.integrales, link: "/servicios/remodelacion-integral" },
  { title: "Servicios Eléctricos", desc: "Tableros, cableado, iluminación LED y soluciones eléctricas seguras.", image: serviceImages.electricidad, link: "/servicios/instalacion-electrica" },
  { title: "Fontanería", desc: "Detección de fugas, cambio de tuberías, grifería, sanitarios y puntos de agua.", image: serviceImages.fontaneria, link: "/servicios/fontaneria-plomeria" },
  { title: "Pintura y Acabados", desc: "Acabados interiores y exteriores con preparación profesional y terminaciones limpias.", image: serviceImages.pintura, link: "/servicios/pintura-acabados" },
  { title: "Revestimientos", desc: "Porcelanato, piedra, wall panels y acabados decorativos para muros con carácter.", image: serviceImages.revestimientos, link: "/servicios/revestimientos-pared" },
  { title: "Suelos", desc: "Cerámica, porcelanato, laminado y madera instalados con nivelación y detalle.", image: serviceImages.sueloPorcelanato, link: "/servicios/instalacion-pisos" },
  { title: "Piscinas", desc: "Construcción, mantenimiento, filtración, revestimientos y control de calidad del agua.", image: serviceImages.piscinas, link: "/servicios/piscinas-mantenimiento" }
];

const trustStats = [
  { number: "20+", label: "Años de experiencia", desc: "Trayectoria europea aplicada a proyectos en Venezuela" },
  { number: "Gratis", label: "Visita técnica", desc: "Evaluamos tu espacio y te orientamos sin compromiso" },
  { number: "Garantía", label: "Por escrito", desc: "Trabajos respaldados con condiciones claras" },
  { number: "WhatsApp", label: "Atención directa", desc: "Envíanos fotos y recibe orientación inicial rápida" }
];

const heroBadges = [
  "Valencia y Caracas",
  "Presupuesto claro",
  "Visita técnica gratis",
  "Garantía por escrito"
];

const processSteps = [
  { step: "01", title: "Visita técnica", desc: "Revisamos medidas, estado actual, instalaciones y objetivos del proyecto." },
  { step: "02", title: "Presupuesto detallado", desc: "Recibes una propuesta clara por partidas, materiales, tiempos y alcance." },
  { step: "03", title: "Planificación", desc: "Definimos acabados, logística, cronograma, compras y permisos si aplican." },
  { step: "04", title: "Ejecución supervisada", desc: "Coordinamos obra, proveedores y avances con seguimiento directo." },
  { step: "05", title: "Entrega con garantía", desc: "Revisamos contigo, limpiamos el espacio y entregamos garantías por escrito." }
];

const aboutBadges = [
  "Estándares europeos",
  "Supervisión directa",
  "+20 años",
  "Garantía escrita"
];

const testimonials = [
  { text: "Nos ayudaron a aterrizar la idea de la cocina, explicaron materiales y mantuvieron comunicación durante la obra. El resultado se siente moderno y bien terminado.", name: "Cliente residencial", location: "San Diego, Carabobo" },
  { text: "Valoramos mucho el presupuesto claro y la organización. Cada etapa tuvo seguimiento y los acabados del baño quedaron como esperábamos.", name: "Cliente residencial", location: "Valencia, Carabobo" },
  { text: "Necesitábamos una reforma integral sin improvisaciones. Nos dieron una ruta de trabajo y soluciones prácticas para instalaciones y acabados.", name: "Cliente de apartamento", location: "Caracas" }
];

const serviceAreas = [
  "Valencia", "San Diego", "Naguanagua", "Guacara", "Los Guayos", "Caracas",
  "Chacao", "Baruta", "El Hatillo", "La Guaira", "Puerto Cabello", "Tocuyito"
];
---

<BaseLayout 
  title="Reformas en Valencia, Carabobo y Caracas | ReformaT" 
  description="Más de 20 años transformando hogares y negocios en Valencia, San Diego, Carabobo y Caracas. Reformas integrales, cocinas, baños, electricidad y fontanería con acabados impecables." 
  activePage="inicio"
>

  <header class="hero">
    <!-- IMAGEN LCP EXPLÍCITA: Forzar que PageSpeed mida esto como LCP válido -->
    <img 
      src="/images/hero-lcp.webp" 
      alt="Interior moderno reformado con diseño de lujo" 
      fetchpriority="high"
      loading="eager"
      decoding="async"
      width="1920"
      height="1080"
      class="hero-lcp-img"
    />
    
    <script is:inline>
      (function() {
        var isMobile = window.innerWidth < 1024;
        var videoSrc = isMobile ? '/videos/hero-mobile.mp4' : '/videos/hero-desktop.mp4';
        var posterSrc = '/images/hero-lcp.webp';
        var style = 'position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; z-index: 1; pointer-events: none; opacity: 0; transition: opacity 1s ease-in-out;';
        document.write('<video id="hero-video" class="hero-video" autoplay muted loop playsinline preload="metadata" poster="' + posterSrc + '" src="' + videoSrc + '" onplaying="this.style.opacity=1" style="' + style + '"></video>');
      })();
    </script>
    
    <noscript>
      <video id="hero-video" class="hero-video" autoplay muted loop playsinline preload="metadata" poster="/images/hero-lcp.webp" src="/videos/hero-desktop.mp4" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; z-index: 1;"></video>
    </noscript>

    <div class="hero-overlay"></div>

    <div class="hero-content">
      <span class="hero-tag">Reformas premium en Valencia, San Diego, Carabobo y Caracas</span>
      <h1 class="hero-title">
        <span class="line">Remodelaciones en Venezuela</span>
        <span class="line gold">con acabados premium</span>
      </h1>
      <p class="hero-sub">Cocinas, baños y reformas integrales con presupuesto claro, supervisión profesional y garantía por escrito.</p>
      <div class="hero-btns">
        <a href={`https://wa.me/584227997043?text=${whatsappBudgetText}`} target="_blank" rel="noopener" class="btn-premium btn-primary-premium">
          <span class="btn-content">Presupuesto por WhatsApp</span>
          <span class="btn-border"></span>
          <span class="btn-shine"></span>
          <span class="btn-arrow">→</span>
        </a>
        <a href="/proyectos" class="btn-premium btn-outline-premium">
          <span class="btn-content">Ver proyectos reales</span>
          <span class="btn-border"></span>
          <span class="btn-shine"></span>
          <span class="btn-arrow">→</span>
        </a>
      </div>
      <p class="hero-proof" aria-label="Señales de confianza">
        <span>20+ años</span>
        <i></i>
        <span>Visita técnica gratis</span>
        <i></i>
        <span>Garantía por escrito</span>
      </p>
    </div>
  </header>

  <section class="premium-proof-section" aria-label="Confianza y garantías">
    <div class="premium-proof-panel">
      <div class="proof-item">
        <strong>20+</strong>
        <span>Años de experiencia</span>
      </div>
      <div class="proof-item">
        <strong>Gratis</strong>
        <span>Visita técnica inicial</span>
      </div>
      <div class="proof-item">
        <strong>Garantía</strong>
        <span>Trabajos por escrito</span>
      </div>
    </div>
  </section>

  <section class="section bg-light">
    <div class="container">
      <div class="section-header">
        <span class="tag">Nuestros Servicios</span>
        <h2 class="section-title">Remodelaciones que Dan Vida a Tus Espacios</h2>
        <p class="section-desc">Reformas integrales, cocinas, baños, electricidad y fontanería. Ejecución rápida, técnicas avanzadas y acabados impecables en Valencia, San Diego y Caracas.</p>
      </div>
      
      <div class="home-services-grid">
        {services.map((svc, index) => (
          <a href={svc.link} class="home-service-card">
            <div class="home-service-img">
              <img
                src={svc.image.src}
                srcset={svc.image.srcset}
                sizes="(max-width: 768px) 100vw, (max-width: 1100px) 50vw, 33vw"
                alt={svc.title}
                loading={index < 3 ? "eager" : "lazy"}
                fetchpriority={index === 0 ? "high" : "auto"}
                decoding="async"
                width="800"
                height="533"
              />
              <span class="home-service-kicker">Servicio premium</span>
            </div>
            <div class="home-service-body">
              <h3>{svc.title}</h3>
              <p>{svc.desc}</p>
              <span class="card-link">Ver servicio <span class="arrow">→</span></span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container about-grid">
      <div class="about-imgs">
        <div class="img-box tall">
          <img 
            src="/images/arquitectura-600.webp"
            srcset="/images/arquitectura-400.webp 400w, /images/arquitectura-600.webp 600w"
            sizes="(max-width: 768px) 400px, 600px"
            alt="Arquitectura de viviendas modernas" 
            loading="lazy" 
            decoding="async"
            width="600"
            height="800"
          />
        </div>
        <div class="img-box small">
          <img 
            src="/images/equipo-600.webp"
            srcset="/images/equipo-400.webp 400w, /images/equipo-600.webp 600w"
            sizes="(max-width: 768px) 400px, 600px"
            alt="Equipo de profesionales trabajando" 
            loading="lazy" 
            decoding="async"
            width="600"
            height="400"
          />
        </div>
      </div>
      <div class="about-text">
        <span class="tag">Sobre Nosotros</span>
        <h2 class="section-title">Experiencia Europea en Reformas,<br/>Ejecución Local en Venezuela</h2>
        <p>ReformaT nace en España con más de 20 años de trayectoria. Desde hace casi 2 años operamos en Venezuela, llevando estándares europeos a proyectos en <strong>Valencia, San Diego, Carabobo y Caracas</strong>. Adaptamos técnicas avanzadas a la arquitectura local para garantizar resultados duraderos.</p>
        <ul class="check-list">
          <li>Reformas integrales que transforman cada rincón con excelencia</li>
          <li>Servicios eléctricos y de fontanería con máxima seguridad</li>
          <li>Diseños personalizados que unen funcionalidad y estilo</li>
          <li>Asesoramiento experto y ejecución eficiente sin sorpresas</li>
        </ul>
        <div class="about-badges" aria-label="Diferenciales de ReformaT">
          {aboutBadges.map((badge) => (
            <span>{badge}</span>
          ))}
        </div>
        <a href="/contacto" class="btn-premium btn-primary-premium">
          <span class="btn-content">Comenzar Conversación</span>
          <span class="btn-border"></span>
          <span class="btn-shine"></span>
          <span class="btn-arrow">→</span>
        </a>
      </div>
    </div>
  </section>


  <section class="section process-section">
    <div class="container">
      <div class="section-header">
        <span class="tag">Cómo Trabajamos</span>
        <h2 class="section-title">Un Proceso Claro de Principio a Fin</h2>
        <p class="section-desc">Remodelar debe sentirse organizado, no improvisado. Por eso cada proyecto se divide en etapas claras, con comunicación directa y decisiones documentadas.</p>
      </div>
      <div class="process-grid">
        {processSteps.map((item) => (
          <article class="process-card">
            <span class="process-number">{item.step}</span>
            <h3>{item.title}</h3>
            <p>{item.desc}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section bg-light testimonials-section">
    <div class="container">
      <div class="section-header">
        <span class="tag">Confianza</span>
        <h2 class="section-title">Lo Que Más Valoran Nuestros Clientes</h2>
        <p class="section-desc">Comunicación clara, presupuesto organizado y acabados cuidados son las señales que convierten una remodelación en una experiencia tranquila.</p>
      </div>
      <div class="testimonials-grid-home">
        {testimonials.map((t) => (
          <figure class="testimonial-home-card">
            <blockquote>“{t.text}”</blockquote>
            <figcaption>
              <strong>{t.name}</strong>
              <span>{t.location}</span>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="section service-areas-section">
    <div class="container areas-grid">
      <div>
        <span class="tag">Zonas de Cobertura</span>
        <h2 class="section-title">Remodelamos en Carabobo, Caracas y La Guaira</h2>
        <p class="section-desc">Atendemos viviendas, apartamentos y negocios en las principales zonas residenciales y comerciales. Si tu zona no aparece, escríbenos y revisamos disponibilidad.</p>
      </div>
      <div class="area-chips">
        {serviceAreas.map((area) => (
          <a href={area === 'Caracas' ? '/caracas' : area === 'Valencia' ? '/valencia' : area === 'San Diego' ? '/san-diego' : area === 'La Guaira' ? '/la-guaira' : '/contacto'}>{area}</a>
        ))}
      </div>
    </div>
  </section>

  <section class="cta-section cta-whatsapp-section">
    <div class="cta-wrapper">
      <span class="tag tag-on-dark">Presupuesto rápido</span>
      <h2 class="cta-title">¿Quieres saber cuánto podría costar tu remodelación?</h2>
      <p class="cta-text">Envíanos fotos por WhatsApp y te damos una orientación inicial. Si el proyecto encaja, coordinamos una visita técnica y presupuesto detallado.</p>
      <div class="cta-actions-home">
        <a href={`https://wa.me/584227997043?text=${whatsappBudgetText}`} target="_blank" rel="noopener" class="btn-premium btn-white-premium">
          <span class="btn-content">Enviar fotos por WhatsApp</span>
          <span class="btn-border"></span>
          <span class="btn-shine"></span>
          <span class="btn-arrow">→</span>
        </a>
        <a href="#contacto-rapido" class="btn-premium btn-outline-premium btn-cta-outline">
          <span class="btn-content">Usar formulario</span>
          <span class="btn-border"></span>
          <span class="btn-shine"></span>
          <span class="btn-arrow">→</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section bg-light" id="contacto-rapido">
    <div class="container contact-grid">
      <div class="contact-info">
        <h2 class="section-title">Hablemos de Tu Proyecto de Remodelación</h2>
        <p>Estamos aquí para escuchar, asesorar y crear junto a ti. Cubrimos toda el área metropolitana de Caracas y las principales zonas de Carabobo.</p>
        <div class="info-item">
          <h3>Ubicación</h3>
          <p>Valencia, San Diego, Carabobo y Caracas</p>
        </div>
        <div class="info-item">
          <h3>Teléfono</h3>
          <p><a href="tel:+584227997043" style="color: var(--gold); text-decoration: none;">0422 799 7043</a></p>
        </div>
      </div>
      <form class="contact-form" action="https://formsubmit.co/contacto@reformat-venezuela.online" method="POST">
        <input type="hidden" name="_subject" value="Nueva consulta desde la web">
        <input type="hidden" name="_captcha" value="false">
        <input type="text" name="_honey" style="display:none" tabindex="-1" autocomplete="off">
        
        <div class="form-row">
          <input type="text" id="nombre" name="nombre" placeholder="Nombre" required aria-label="Tu nombre completo" />
          <input type="tel" id="telefono" name="telefono" placeholder="Teléfono" required aria-label="Tu número de teléfono" />
        </div>
        <input type="email" id="email" name="email" placeholder="Email" required aria-label="Tu correo electrónico" />
        <select id="proyecto" name="proyecto" required aria-label="Tipo de proyecto">
          <option value="" disabled selected>Tipo de Proyecto</option>
          <option value="cocina">Reforma de Cocina</option>
          <option value="bano">Reforma de Baño</option>
          <option value="integral">Reforma Integral</option>
          <option value="electricidad">Servicios Eléctricos</option>
          <option value="fontaneria">Fontanería</option>
        </select>
        <textarea id="mensaje" name="mensaje" placeholder="Tu Mensaje" rows="4" required aria-label="Detalles de tu proyecto"></textarea>
        <button type="submit" class="btn-premium btn-primary-premium full-width">
          <span class="btn-content">Enviar Mensaje</span>
          <span class="btn-border"></span>
          <span class="btn-shine"></span>
          <span class="btn-arrow">→</span>
        </button>
      </form>
    </div>
  </section>

</BaseLayout>

<style>
  .hero { position: relative; width: 100%; min-height: 100vh; min-height: 100svh; overflow: hidden; background: #111 url('/images/hero-lcp.webp') center/cover no-repeat; display: flex; align-items: center; justify-content: center; text-align: center; color: var(--white); }
  
  /* Imagen LCP: capa inferior, siempre visible mientras video carga */
  .hero-lcp-img {
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    z-index: 0;
  }
  
  .hero-video { z-index: 1; } 
  .hero-overlay { position: absolute; inset: 0; background: linear-gradient(to bottom, rgba(0,0,0,0.45), rgba(0,0,0,0.55) 50%, rgba(0,0,0,0.85)); z-index: 2; }
  .hero-content { position: relative; z-index: 3; max-width: 900px; padding: 100px 20px 0; }
  .hero-tag { display: block; font-size: 0.85rem; letter-spacing: 2.5px; text-transform: uppercase; color: var(--gold); margin-bottom: 12px; }
  .hero-title { font-family: var(--font-serif); font-size: clamp(2.8rem, 7vw, 6rem); font-weight: 400; margin-bottom: 18px; line-height: 1.05; }
  .hero-title .line { display: block; }
  .hero-title .gold { color: var(--gold); }
  .hero-sub { font-size: 1.15rem; color: rgba(255, 255, 255, 0.95); margin: 0 auto 28px; max-width: 600px; line-height: 1.55; }
  .hero-btns { display: flex; gap: 18px; justify-content: center; flex-wrap: wrap; }
  .btn-outline-premium { background: transparent; color: var(--white); border: 1px solid rgba(255,255,255,0.4); backdrop-filter: blur(5px); }
  .btn-outline-premium:hover { transform: translateY(-3px); border-color: var(--gold); color: var(--gold); }
  .btn-white-premium { background: var(--white); color: var(--bg); box-shadow: 0 4px 15px rgba(0,0,0,0.2); }
  .btn-white-premium .btn-border { border: 2px solid var(--white); }
  .btn-white-premium:hover { transform: translateY(-3px); background: var(--gold); box-shadow: 0 8px 30px rgba(201, 169, 97, 0.5); }
  .btn-white-premium:hover .btn-arrow { transform: translateX(8px); }
  .btn-white-premium:hover .btn-shine { left: 150%; }

  .section { padding: 100px 0; }
  .bg-light { background: var(--gray); }
  .section-header { text-align: center; max-width: 700px; margin: 0 auto 60px; }
  .section-title { font-family: var(--font-serif); font-size: clamp(2rem, 5vw, 3.5rem); margin-bottom: 20px; font-weight: 400; }
  .tag { display: inline-block; color: #8B6914; font-size: 0.85rem; letter-spacing: 2px; text-transform: uppercase; margin-bottom: 15px; font-weight: 600; }
  .section-desc { color: var(--gray-text); font-size: 1.1rem; line-height: 1.8; font-weight: 400; }
  
  .stats-section { padding: 60px 0; background: var(--bg); color: var(--white); }
  .stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 30px; text-align: center; }
  .stat-num { font-family: var(--font-serif); font-size: 3.5rem; color: var(--gold); line-height: 1; margin-bottom: 10px; font-weight: 400; }
  .stat-label { font-size: 0.9rem; text-transform: uppercase; letter-spacing: 1px; opacity: 0.8; }
  
  .services-slider-wrapper { position: relative; display: flex; align-items: center; gap: 20px; }
  .services-slider { display: flex; gap: 30px; overflow-x: auto; scroll-snap-type: x mandatory; scroll-behavior: smooth; -webkit-overflow-scrolling: touch; scrollbar-width: none; -ms-overflow-style: none; padding: 20px 10px; flex: 1; }
  .services-slider::-webkit-scrollbar { display: none; }
  .service-card-slider { flex: 0 0 calc(33.333% - 20px); min-width: 300px; display: block; background: var(--white); border-radius: 8px; overflow: hidden; box-shadow: 0 5px 20px rgba(0,0,0,0.05); transition: 0.4s; text-decoration: none; color: inherit; scroll-snap-align: start; }
  .service-card-slider:hover { transform: translateY(-10px); box-shadow: 0 20px 50px rgba(0,0,0,0.12); }
  .card-img-wrap { position: relative; height: 280px; overflow: hidden; }
  .card-img-wrap img { width: 100%; height: 100%; object-fit: cover; transition: 0.6s; }
  .service-card-slider:hover .card-img-wrap img { transform: scale(1.08); }
  .card-overlay { position: absolute; inset: 0; background: linear-gradient(to top, rgba(0,0,0,0.4) 0%, transparent 50%); }
  .card-icon { position: absolute; bottom: 15px; right: 15px; width: 45px; height: 45px; background: var(--gold); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 1.2rem; color: var(--bg); transition: 0.4s; }
  .service-card-slider:hover .card-icon { transform: scale(1.15) rotate(15deg); }
  .card-body { padding: 30px 25px; }
  .card-body h3 { font-family: var(--font-serif); font-size: 1.5rem; margin-bottom: 12px; font-weight: 500; }
  .card-body p { color: var(--gray-text); font-size: 0.95rem; line-height: 1.7; margin-bottom: 20px; font-weight: 400; }
