    .process-grid { grid-template-columns: repeat(3, 1fr); }
    .areas-grid, .positioning-grid, .fit-grid { grid-template-columns: 1fr; gap: 34px; }
    .testimonials-grid-home { grid-template-columns: 1fr 1fr; }
