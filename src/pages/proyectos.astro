---
import BaseLayout from '../layouts/BaseLayout.astro';

const projects = [
  { 
    title: "Remodelación de Baño Principal y Aseo Adaptado", 
    category: "Baños & Accesibilidad", 
    location: "Caracas, Venezuela", 
    image: "/images/proyectos/bano-caracas/bano-principal-finalizado-1.webp", 
    desc: "Reforma integral con fontanería multicapa PEX-Al-PEX, porcelanato español 60x60 y transformación de armario empotrado en un aseo accesible con puerta corredera flotante.",
    slug: "bano-caracas",
    duration: "3 semanas",
    specs: ["Porcelanato Español 60x60", "Multicapa PEX-Al-PEX", "Drywall RH & Puerta Flotante"]
  },
  { 
    title: "Remodelación Integral de Baño en Townhouse", 
    category: "Baños de Alta Gama", 
    location: "La Trigaleña, Valencia", 
    image: "/images/proyectos/bano-la-trigalena/bano-final-1.webp", 
    desc: "Demolición de tabiques divisorios para duplicar la amplitud, plomería multicapa PEX-Al-PEX y revestimiento en porcelanato rectificado 60x120 con sanitarios TEKA.",
    slug: "bano-la-trigalena",
    duration: "2 semanas",
    specs: ["Porcelanato Rectificado 60x120", "Sanitarios TEKA Manacor", "Sin Tabiques Divisorios"]
  },
  { 
    title: "Remodelación de Baño con Poceta Flotante TEKA", 
    category: "Baños & Sanitarios Suspendidos", 
    location: "San Diego, Carabobo", 
    image: "/images/proyectos/bano-san-diego/bano-finalizado-1.webp", 
    desc: "Albañilería especializada en ladrillo rasillón para poceta flotante TEKA Manacor, plomería multicapa PEX-Al-PEX y porcelanato rectificado 60x60 beige.",
    slug: "bano-san-diego",
    duration: "2 semanas",
    specs: ["Poceta Flotante TEKA", "Porcelanato Beige 60x60", "Ladrillo Rasillón & Multicapa"]
  },
  { 
    title: "Remodelación Integral de Baño de Lujo en Quinta", 
    category: "Baños de Alta Gama & Arquitectura", 
    location: "Guataparo, Valencia, Carabobo", 
    image: "/images/proyectos/banos-quinta-la-lagunita/bano-zona-1-completado-2.webp", 
    desc: "Reforma monumental con división en dos salas independientes, ventanal panorámico con rotura térmica, piedra volcánica, microcemento blanco y porcelanato metro verde.",
    slug: "banos-quinta-la-lagunita",
    duration: "4 semanas",
    specs: ["Microcemento & Piedra Volcánica", "Ventanal Rotura Térmica", "Italia & ROCA"]
  }
];
---

<BaseLayout 
  title="Proyectos | Portafolio de Reformas de Lujo | ReformaT Venezuela" 
  description="Galería de proyectos reales de remodelación en Caracas, Valencia y áreas premium. Baños, cocinas y reformas integrales con acabados garantizados." 
  activePage="proyectos"
>
  <!-- Hero Section -->
  <header class="projects-hero">
    <div class="hero-backdrop" aria-hidden="true"></div>
    <div class="container">
      <div class="hero-inner">
        <span class="hero-eyebrow">PORTAFOLIO DE OBRAS REALES</span>
        <h1 class="hero-title">Proyectos Realizados</h1>
        <p class="hero-lead">Cada proyecto representa rigor técnico, ingeniería de detalle y acabados de especificación premium en residencias de Caracas y Valencia.</p>
      </div>
    </div>
  </header>

  <!-- Projects Section -->
  <section class="projects-section">
    <div class="container">
      <div class="projects-list">
        {projects.map((p) => (
          <article class="project-card">
            <a href={`/proyectos/${p.slug}`} class="project-card-image-link" aria-label={`Ver caso de estudio de ${p.title}`}>
              <div class="project-card-image">
                <span class="project-card-badge">{p.category}</span>
                <img src={p.image} alt={`${p.title} en ${p.location}`} loading="lazy" decoding="async" />
              </div>
            </a>
            <div class="project-card-content">
              <div class="project-card-meta">
                <span class="project-card-location">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="var(--gold)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                    <circle cx="12" cy="10" r="3"/>
                  </svg>
                  {p.location}
                </span>
                <span class="project-card-duration">Duración: {p.duration}</span>
              </div>
              <h2 class="project-card-title">
                <a href={`/proyectos/${p.slug}`}>{p.title}</a>
              </h2>
              <p class="project-card-desc">{p.desc}</p>
              
              <ul class="project-card-specs">
                {p.specs.map(spec => (
                  <li class="spec-tag">{spec}</li>
                ))}
              </ul>

              <div class="project-card-footer">
                <a href={`/proyectos/${p.slug}`} class="project-card-cta">
                  <span>Explorar caso de estudio</span>
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <line x1="5" y1="12" x2="19" y2="12"/>
                    <polyline points="12 5 19 12 12 19"/>
                  </svg>
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
  
  <!-- CTA Section -->
  <section class="cta-section">
    <div class="container">
      <div class="cta-inner">
        <span class="cta-kicker">INGENIERÍA Y DISEÑO PARA TU HOGAR</span>
        <h2 class="cta-title">¿Tienes un proyecto en mente?</h2>
        <p class="cta-text">Cuéntanos tu visión y revisaremos el alcance técnico, materiales, tiempos y nivel de acabado necesario para ejecutar una obra a la altura de tu vivienda.</p>
        <a href="/contacto" class="btn-premium btn-primary-premium">
          <span class="btn-content">Solicitar valoración técnica</span>
          <span class="btn-border"></span>
          <span class="btn-arrow">→</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero */
  .projects-hero {
    position: relative;
    padding: 185px 0 95px;
    background: var(--ink);
    color: var(--white);
    overflow: hidden;
    border-bottom: 1px solid rgba(201,169,97,0.2);
  }
  
  .hero-backdrop {
    position: absolute;
    inset: 0;
    background: 
      radial-gradient(circle at 75% 30%, rgba(201,169,97,0.12) 0%, transparent 60%),
      radial-gradient(circle at 25% 75%, rgba(201,169,97,0.06) 0%, transparent 50%);
    pointer-events: none;
  }
  
  .projects-hero .container {
    position: relative;
    z-index: 1;
  }
  
  .hero-inner {
    max-width: 680px;
  }
  
  .hero-eyebrow {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 16px;
  }
  
  .hero-title {
    font-family: var(--font-serif);
    font-size: clamp(2.4rem, 5vw, 3.6rem);
    font-weight: 500;
    color: var(--white);
    line-height: 1.1;
    margin-bottom: 18px;
  }
  
  .hero-lead {
    font-size: 1.12rem;
    line-height: 1.7;
    color: rgba(255,255,255,0.72);
  }

  /* Projects Section */
  .projects-section {
    padding: 85px 0 100px;
    background: var(--bone);
  }
  
  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }
  
  .projects-list {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }
  
  .project-card {
    display: grid;
    grid-template-columns: 380px 1fr;
    gap: 40px;
    padding: 32px;
    background: var(--white);
    border-radius: var(--r-md);
    border: 1px solid var(--sand);
    transition: box-shadow 0.35s var(--ease-out), transform 0.35s var(--ease-out), border-color 0.35s ease;
  }
  
  .project-card:hover {
    box-shadow: var(--e-2);
    transform: translateY(-3px);
    border-color: rgba(201,169,97,0.4);
  }
  
  .project-card-image-link {
    display: block;
    border-radius: var(--r-sm);
    overflow: hidden;
  }

  /* CRITICAL: PORTRAIT ASPECT RATIO TO ELIMINATE CROPPING */
  .project-card-image {
    position: relative;
    border-radius: var(--r-sm);
    overflow: hidden;
    aspect-ratio: 4 / 5;
    background: var(--ink-soft);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .project-card-image img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform 0.45s var(--ease-out);
  }
  
  .project-card:hover .project-card-image img {
    transform: scale(1.03);
  }
  
  .project-card-badge {
    position: absolute;
    top: 14px;
    left: 14px;
    z-index: 2;
    padding: 5px 14px;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--ink);
    background: var(--gold);
    border-radius: var(--r-sm);
    box-shadow: var(--e-1);
  }
  
  .project-card-content {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  
  .project-card-meta {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-bottom: 12px;
  }
  
  .project-card-location {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--text-light);
  }
  
  .project-card-duration {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--gold-ink);
    padding: 4px 12px;
    background: var(--bone);
    border: 1px solid var(--sand);
    border-radius: var(--r-sm);
  }
  
  .project-card-title {
    font-family: var(--font-serif);
    font-size: 1.8rem;
    font-weight: 600;
    line-height: 1.25;
    margin-bottom: 14px;
  }

  .project-card-title a {
    color: var(--text);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .project-card-title a:hover {
    color: var(--gold-ink);
  }
  
  .project-card-desc {
    font-size: 1.02rem;
    line-height: 1.7;
    color: var(--text-light);
    margin-bottom: 22px;
  }

  .project-card-specs {
    list-style: none;
    margin: 0 0 28px;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .spec-tag {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-muted);
    background: var(--bone);
    border: 1px solid var(--sand);
    padding: 5px 14px;
    border-radius: var(--r-full);
  }
  
  .project-card-footer {
    margin-top: auto;
    padding-top: 20px;
    border-top: 1px solid var(--sand);
  }

  .project-card-cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--gold-ink);
    text-decoration: none;
    transition: gap 0.3s ease, color 0.2s ease;
  }
  
  .project-card:hover .project-card-cta {
    gap: 12px;
    color: var(--ink);
  }

  /* CTA Section */
  .cta-section {
    padding: 100px 0;
    background: var(--ink);
    color: var(--white);
  }
  
  .cta-inner {
    max-width: 680px;
    margin: 0 auto;
    text-align: center;
  }

  .cta-kicker {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 14px;
  }
  
  .cta-title {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 4vw, 2.8rem);
    font-weight: 500;
    color: var(--white);
    margin-bottom: 16px;
  }
  
  .cta-text {
    font-size: 1.08rem;
    line-height: 1.72;
    color: rgba(255,255,255,0.72);
    margin-bottom: 36px;
  }

  /* Responsive */
  @media (max-width: 900px) {
    .projects-hero {
      padding: 155px 0 80px;
    }

    .project-card {
      grid-template-columns: 1fr;
      gap: 24px;
      padding: 24px;
    }
    
    .project-card-image {
      aspect-ratio: 16 / 10;
    }
    
    .project-card-title {
      font-size: 1.5rem;
    }
    
    .projects-section {
      padding: 60px 0 80px;
    }
  }

  @media (max-width: 600px) {
    .projects-hero {
      padding: 140px 0 65px;
    }

    .project-card-image {
      aspect-ratio: 4 / 3;
    }

    .project-card-meta {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
    }
  }
</style>
