---
import BaseLayout from '../layouts/BaseLayout.astro';

const projects = [
  { 
    title: "Remodelación Baño Principal", 
    category: "Baño", 
    location: "Caracas", 
    image: "/images/proyectos/bano-caracas/baño principal finalizado 1.webp", 
    desc: "Transformación completa con porcelanato premium, mampara de vidrio templado y acabados de lujo.",
    slug: "bano-caracas",
    duration: "3 semanas"
  },
  { 
    title: "Remodelación Baño Residencial", 
    category: "Baño", 
    location: "La Trigaleña", 
    image: "/images/proyectos/bano-la-trigalena/baño final 1.webp", 
    desc: "Renovación integral con cambio de porcelanato, mueble nuevo y grifería moderna.",
    slug: "bano-la-trigalena",
    duration: "2 semanas"
  },
  { 
    title: "Remodelación Baño San Diego", 
    category: "Baño", 
    location: "San Diego, Carabobo", 
    image: "/images/proyectos/bano-san-diego/baño finalizado 1.webp", 
    desc: "Transformación completa de baño con diseño contemporáneo y acabados premium.",
    slug: "bano-san-diego",
    duration: "2 semanas"
  },
  { 
    title: "Remodelación Baños Quinta", 
    category: "Baño", 
    location: "Quinta La Lagunita", 
    image: "/images/proyectos/banos-quinta-la-lagunita/Baño Zona 1 Completado 2 (1).webp", 
    desc: "Remodelación completa de baños en quinta con demolición, nueva distribución y acabados de lujo.",
    slug: "banos-quinta-la-lagunita",
    duration: "4 semanas"
  }
];
---

<BaseLayout 
  title="Proyectos | Portafolio de Reformas | ReformaT Venezuela" 
  description="Galería de proyectos reales de remodelación en Caracas, Valencia y áreas. Baños, cocinas y reformas integrales con acabados premium." 
  activePage="proyectos"
>
  <!-- Hero Section -->
  <header class="projects-hero">
    <div class="hero-backdrop"></div>
    <div class="container">
      <div class="hero-inner">
        <span class="hero-eyebrow">Portafolio</span>
        <h1 class="hero-title">Proyectos Realizados</h1>
        <p class="hero-lead">Cada proyecto es una historia de transformación. Descubre nuestras remodelaciones completadas con acabados premium.</p>
      </div>
    </div>
  </header>

  <!-- Projects Section -->
  <section class="projects-section">
    <div class="container">
      <div class="projects-list">
        {projects.map((p, index) => (
          <a href={`/proyectos/${p.slug}`} class="project-card">
            <div class="project-card-image">
              <img src={p.image} alt={p.title} loading="lazy" />
              <span class="project-card-badge">{p.category}</span>
            </div>
            <div class="project-card-content">
              <h3 class="project-card-title">{p.title}</h3>
              <p class="project-card-desc">{p.desc}</p>
              <div class="project-card-meta">
                <span class="project-card-location">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                    <circle cx="12" cy="10" r="3"/>
                  </svg>
                  {p.location}
                </span>
                <span class="project-card-duration">{p.duration}</span>
              </div>
              <span class="project-card-cta">
                Ver proyecto
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <line x1="5" y1="12" x2="19" y2="12"/>
                  <polyline points="12 5 19 12 12 19"/>
                </svg>
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
  
  <!-- CTA Section -->
  <section class="cta-section">
    <div class="container">
      <div class="cta-inner">
        <h2 class="cta-title">¿Tienes un proyecto en mente?</h2>
        <p class="cta-text">Cuéntanos tu visión y hagamos realidad la transformación de tu espacio.</p>
        <a href="/contacto" class="btn-premium btn-primary-premium">
          <span class="btn-content">Solicitar Presupuesto</span>
          <span class="btn-border"></span>
          <span class="btn-arrow">→</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero */
  .projects-hero {
    position: relative;
    padding: 120px 0 80px;
    background: var(--ink);
    overflow: hidden;
  }
  
  .hero-backdrop {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 30% 50%, rgba(201,169,97,0.08) 0%, transparent 60%),
                radial-gradient(ellipse at 70% 80%, rgba(201,169,97,0.05) 0%, transparent 50%);
  }
  
  .projects-hero .container {
    position: relative;
    z-index: 1;
  }
  
  .hero-inner {
    max-width: 640px;
  }
  
  .hero-eyebrow {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 16px;
  }
  
  .hero-title {
    font-family: var(--font-serif);
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    font-weight: 500;
    color: var(--white);
    line-height: 1.1;
    margin-bottom: 20px;
  }
  
  .hero-lead {
    font-size: 1.1rem;
    line-height: 1.7;
    color: rgba(255,255,255,0.6);
  }

  /* Projects Section */
  .projects-section {
    padding: 80px 0 100px;
    background: var(--bone);
  }
  
  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }
  
  .projects-list {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  
  .project-card {
    display: grid;
    grid-template-columns: 320px 1fr;
    gap: 32px;
    padding: 24px;
    background: var(--white);
    border-radius: var(--r-md);
    border: 1px solid var(--sand);
    text-decoration: none;
    color: inherit;
    transition: box-shadow 0.3s ease, transform 0.3s ease, border-color 0.3s ease;
  }
  
  .project-card:hover {
    box-shadow: var(--e-2);
    transform: translateY(-2px);
    border-color: rgba(201,169,97,0.3);
  }
  
  .project-card-image {
    position: relative;
    border-radius: var(--r-sm);
    overflow: hidden;
    aspect-ratio: 4/3;
    background: var(--sand);
  }
  
  .project-card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  
  .project-card:hover .project-card-image img {
    transform: scale(1.04);
  }
  
  .project-card-badge {
    position: absolute;
    top: 12px;
    left: 12px;
    padding: 5px 12px;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--bg);
    background: var(--gold);
    border-radius: var(--r-sm);
  }
  
  .project-card-content {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  
  .project-card-title {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--text);
    margin-bottom: 10px;
    line-height: 1.3;
  }
  
  .project-card-desc {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--text-muted);
    margin-bottom: 20px;
  }
  
  .project-card-meta {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-bottom: 24px;
  }
  
  .project-card-location {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.85rem;
    color: var(--text-light);
  }
  
  .project-card-duration {
    font-size: 0.85rem;
    color: var(--text-muted);
    padding: 4px 10px;
    background: var(--bone);
    border-radius: var(--r-sm);
  }
  
  .project-card-cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--gold-ink);
    transition: gap 0.3s ease;
  }
  
  .project-card:hover .project-card-cta {
    gap: 12px;
  }

  /* CTA Section */
  .cta-section {
    padding: 100px 0;
    background: var(--ink);
  }
  
  .cta-inner {
    max-width: 600px;
    margin: 0 auto;
    text-align: center;
  }
  
  .cta-title {
    font-family: var(--font-serif);
    font-size: clamp(1.8rem, 4vw, 2.5rem);
    font-weight: 500;
    color: var(--white);
    margin-bottom: 16px;
  }
  
  .cta-text {
    font-size: 1.05rem;
    line-height: 1.7;
    color: rgba(255,255,255,0.6);
    margin-bottom: 32px;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .projects-hero {
      padding: 80px 0 60px;
    }
    
    .project-card {
      grid-template-columns: 1fr;
      gap: 20px;
      padding: 16px;
    }
    
    .project-card-image {
      aspect-ratio: 16/10;
    }
    
    .project-card-title {
      font-size: 1.3rem;
    }
    
    .projects-section {
      padding: 60px 0 80px;
    }
  }
</style>
