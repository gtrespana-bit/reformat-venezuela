---
import '../styles/global.css';
import Analytics from '../components/Analytics.astro';
import SEO from '../components/SEO.astro';

interface Props {
  title: string;
  description: string;
  image?: string;
  activePage?: 'inicio' | 'servicios' | 'proyectos' | 'blog' | 'contacto' | 'home' | 'services' | 'projects' | 'contact';
  articleType?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  articleSection?: string;
  tags?: string[];
}

const { 
  title, 
  description, 
  image = '', 
  activePage = '',
  articleType = 'website',
  publishedTime,
  modifiedTime,
  author,
  articleSection,
  tags
} = Astro.props;

const currentPath = Astro.url.pathname;
const isEnglish = currentPath.startsWith('/en');
const lang = isEnglish ? 'en' : 'es';

// Hreflang route mapping ES <-> EN
const esToEnMap: Record<string, string> = {
  '/': '/en/',
  '/servicios/': '/en/services/',
  '/servicios/remodelacion-cocina/': '/en/services/kitchens/',
  '/servicios/remodelacion-bano/': '/en/services/bathrooms/',
  '/servicios/instalacion-electrica/': '/en/services/electrical/',
  '/servicios/fontaneria-plomeria/': '/en/services/plumbing/',
  '/servicios/revestimientos-pared/': '/en/services/wall-coverings/',
  '/servicios/instalacion-pisos/': '/en/services/flooring/',
  '/servicios/piscinas-mantenimiento/': '/en/services/pools/',
  '/servicios/remodelacion-integral/': '/en/services/whole-home/',
  '/servicios/pintura-acabados/': '/en/services/painting/',
  '/contacto/': '/en/contact/',
  '/proyectos/': '/en/projects/',
  '/blog/': '/en/blog/',
  '/sobre-nosotros/': '/en/about-us/',
};
const enToEsMap: Record<string, string> = Object.fromEntries(
  Object.entries(esToEnMap).map(([es, en]) => [en, es])
);
const siteBase = 'https://reformat-venezuela.online';
const esHref = isEnglish ? `${siteBase}${enToEsMap[currentPath] || '/'}` : `${siteBase}${currentPath}`;
const enHref = isEnglish ? `${siteBase}${currentPath}` : `${siteBase}${esToEnMap[currentPath] || '/en/'}`;

const whatsappText = isEnglish
  ? 'Hello,%20I%20am%20interested%20in%20a%20consultation%20for%20my%20project'
  : 'Hola,%20me%20interesa%20una%20consulta%20para%20mi%20proyecto';

const skipLinkText = isEnglish ? 'Skip to main content' : 'Saltar al contenido principal';
const menuLabel = isEnglish ? 'Open navigation menu' : 'Abrir menú de navegación';
const footerDesc = isEnglish
  ? 'Transforming spaces with excellence since 2005.'
  : 'Transformando espacios con excelencia desde 2005.';
const footerRights = isEnglish
  ? 'All rights reserved.'
  : 'Todos los derechos reservados.';
const footerLocations = isEnglish
  ? 'Valencia, San Diego, Carabobo and Caracas.'
  : 'Valencia, San Diego, Carabobo y Caracas.';

const navItems = isEnglish
  ? [
      { label: 'Home', href: '/en', key: 'home' },
      { label: 'Services', href: '/en/services', key: 'services' },
      { label: 'Projects', href: '/en/projects', key: 'projects' },
      { label: 'Blog', href: '/en/blog', key: 'blog' },
      { label: 'Contact', href: '/en/contact', key: 'contact', premium: true }
    ]
  : [
      { label: 'Inicio', href: '/', key: 'inicio' },
      { label: 'Servicios', href: '/servicios', key: 'servicios' },
      { label: 'Proyectos', href: '/proyectos', key: 'proyectos' },
      { label: 'Blog', href: '/blog', key: 'blog' },
      { label: 'Contacto', href: '/contacto', key: 'contacto', premium: true }
    ];
---

<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Preload fuentes críticas (woff2 self-hosted) -->
  <link rel="preload" href="/fonts/manrope-v15-latin-400.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/manrope-v15-latin-600.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/cormorant-garamond-v21-latin-600.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/cormorant-garamond-v21-latin-700.woff2" as="font" type="font/woff2" crossorigin />
<!-- Canonical + hreflang: emitidos por SEO.astro (fuente unica) -->

  
  <SEO 
    title={title}
    description={description}
    image={image}
    type={articleType}
    publishedTime={publishedTime}
    modifiedTime={modifiedTime}
    author={author}
    articleSection={articleSection}
    tags={tags}
    activePage={activePage}
  />

  <Analytics />
</head>

<body>
  <a href="#main-content" class="skip-link">{skipLinkText}</a>

  <nav id="navbar" class="nav" role="navigation" aria-label={isEnglish ? 'Main navigation' : 'Menú principal'}>
    <div class="nav-container">
      <a href={isEnglish ? '/en' : '/'} class="logo">
        <img
          src="/images/logo-header.webp"
          alt={isEnglish ? 'ReformaT Venezuela - Home Remodeling' : 'ReformaT Venezuela - Remodelación de Viviendas'}
          width="200"
          height="55"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </a>

      <ul class="nav-links">
        {navItems.map((item) => (
          <li>
            <a
              href={item.href}
              class={[
                activePage === item.key ? 'active' : '',
                item.premium ? 'btn-nav-premium' : ''
              ].filter(Boolean).join(' ')}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>

      <button
        type="button"
        class="lang-switch-visible"
        data-current-lang={lang}
        aria-label={isEnglish ? 'Cambiar a español' : 'Switch to English'}
      >
        {isEnglish ? 'ES' : 'EN'}
      </button>

      <button id="menu-btn" class="menu-btn" aria-label={menuLabel} aria-expanded="false">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
    </div>
  </nav>

  <main id="main-content">
<slot />
</main>

  <a href={`https://wa.me/584227997043?text=${whatsappText}`} target="_blank" class="whatsapp-float" aria-label={isEnglish ? 'Contact via WhatsApp' : 'Contactar por WhatsApp'}>
    <svg viewBox="0 0 24 24" fill="white" width="28" height="28"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
  </a>

  <footer class="footer">
    <div class="container">
      <div class="footer-grid">
        <div class="footer-col footer-brand">
          <div class="footer-logo">
            <img
              src="/images/logo-footer.webp"
              alt={isEnglish ? 'ReformaT Venezuela - Home Remodeling' : 'ReformaT Venezuela - Remodelación de Viviendas'}
              width="500"
              height="137"
              loading="lazy"
              decoding="async"
            />
          </div>
          <p class="footer-desc">{footerDesc}</p>
        </div>

        <div class="footer-col">
          <h3 class="footer-heading">{isEnglish ? 'Services' : 'Servicios'}</h3>
          <ul class="footer-links">
            {[
              { es: 'Remodelación de Cocinas', en: 'Kitchen Remodeling', href: isEnglish ? '/en/services/kitchens' : '/servicios/remodelacion-cocina' },
              { es: 'Remodelación de Baños', en: 'Bathroom Remodeling', href: isEnglish ? '/en/services/bathrooms' : '/servicios/remodelacion-bano' },
              { es: 'Remodelación Integral', en: 'Full Home Remodeling', href: isEnglish ? '/en/services/whole-home' : '/servicios/remodelacion-integral' },
              { es: 'Instalación de Pisos', en: 'Flooring Installation', href: isEnglish ? '/en/services/flooring' : '/servicios/instalacion-pisos' },
              { es: 'Fontanería / Plomería', en: 'Plumbing', href: isEnglish ? '/en/services/plumbing' : '/servicios/fontaneria-plomeria' },
              { es: 'Piscinas', en: 'Pools', href: isEnglish ? '/en/services/pools' : '/servicios/piscinas-mantenimiento' },
            ].map((l) => (
              <li><a href={l.href}>{isEnglish ? l.en : l.es}</a></li>
            ))}
          </ul>
        </div>

        <div class="footer-col">
          <h3 class="footer-heading">{isEnglish ? 'Service Areas' : 'Zonas de Servicio'}</h3>
          <ul class="footer-links footer-links-2col">
            {[
              { es: 'Caracas', en: 'Caracas', href: '/caracas' },
              { es: 'Valencia', en: 'Valencia', href: '/valencia' },
              { es: 'San Diego', en: 'San Diego', href: '/san-diego' },
              { es: 'La Guaira', en: 'La Guaira', href: '/la-guaira' },
              { es: 'Chacao', en: 'Chacao', href: '/remodelacion-integral-chacao' },
              { es: 'Las Mercedes', en: 'Las Mercedes', href: '/remodelacion-integral-las-mercedes' },
              { es: 'El Hatillo', en: 'El Hatillo', href: '/remodelacion-integral-el-hatillo' },
              { es: 'La Lagunita', en: 'La Lagunita', href: '/remodelacion-integral-la-lagunita' },
              { es: 'Altamira', en: 'Altamira', href: '/remodelacion-integral-altamira' },
              { es: 'El Viñedo', en: 'El Viñedo', href: '/remodelacion-integral-el-vinedo' },
              { es: 'Guataparo', en: 'Guataparo', href: '/remodelacion-integral-guataparo' },
            ].map((l) => (
              <li><a href={l.href}>{isEnglish ? l.en : l.es}</a></li>
            ))}
          </ul>
        </div>

        <div class="footer-col">
          <h3 class="footer-heading">{isEnglish ? 'Company' : 'Empresa'}</h3>
          <ul class="footer-links">
            {[
              { es: 'Inicio', en: 'Home', href: isEnglish ? '/en' : '/' },
              { es: 'Proyectos', en: 'Projects', href: isEnglish ? '/en/projects' : '/proyectos' },
              { es: 'Blog', en: 'Blog', href: isEnglish ? '/en/blog' : '/blog' },
              { es: 'Contacto', en: 'Contact', href: isEnglish ? '/en/contact' : '/contacto' },
            ].map((l) => (
              <li><a href={l.href}>{isEnglish ? l.en : l.es}</a></li>
            ))}
            <li>
              <a href={`https://wa.me/584227997043?text=${whatsappText}`} target="_blank" rel="noopener">
                {isEnglish ? 'WhatsApp: +58 422-7997043' : 'WhatsApp: +58 422-7997043'}
              </a>
            </li>
          </ul>
        </div>
      </div>

      <p class="footer-bottom">&copy; {new Date().getFullYear()} ReformaT Venezuela. {footerRights} | {footerLocations}</p>
    </div>
  </footer>
<!-- Mobile Sticky CTA Bar -->
<div class="mobile-cta-bar">
  <a href="tel:+584227997043" class="mobile-cta-btn mobile-cta-call" aria-label={isEnglish ? 'Call us' : 'Llamar'}>
    <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20"><path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/></svg>
    <span>{isEnglish ? 'Call' : 'Llamar'}</span>
  </a>
  <a href={`https://wa.me/584227997043?text=${whatsappText}`} target="_blank" class="mobile-cta-btn mobile-cta-wa" aria-label={isEnglish ? 'WhatsApp' : 'WhatsApp'}>
    <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
    <span>WhatsApp</span>
  </a>
</div>

  <script>
    const routeMap = {
      '/': '/en',
      '/en': '/',
      '/servicios': '/en/services',
      '/en/services': '/servicios',
      '/servicios/remodelacion-cocina': '/en/services/kitchens',
      '/en/services/kitchens': '/servicios/remodelacion-cocina',
      '/servicios/remodelacion-bano': '/en/services/bathrooms',
      '/en/services/bathrooms': '/servicios/remodelacion-bano',
      '/servicios/remodelacion-integral': '/en/services/whole-home',
      '/en/services/whole-home': '/servicios/remodelacion-integral',
      '/servicios/instalacion-electrica': '/en/services/electrical',
      '/en/services/electrical': '/servicios/instalacion-electrica',
      '/servicios/fontaneria-plomeria': '/en/services/plumbing',
      '/en/services/plumbing': '/servicios/fontaneria-plomeria',
      '/servicios/pintura-acabados': '/en/services/painting',
      '/en/services/painting': '/servicios/pintura-acabados',
      '/servicios/revestimientos-pared': '/en/services/wall-coverings',
      '/en/services/wall-coverings': '/servicios/revestimientos-pared',
      '/servicios/instalacion-pisos': '/en/services/flooring',
      '/en/services/flooring': '/servicios/instalacion-pisos',
      '/servicios/piscinas-mantenimiento': '/en/services/pools',
      '/en/services/pools': '/servicios/piscinas-mantenimiento',
      '/sobre-nosotros': '/en/about-us',
      '/en/about-us': '/sobre-nosotros',
      '/proyectos': '/en/projects',
      '/en/projects': '/proyectos',
      '/contacto': '/en/contact',
      '/en/contact': '/contacto',
      '/blog': '/en/blog',
      '/en/blog': '/blog',
      '/blog/cuanto-cuesta-reforma-cocina-valencia': '/en/blog/kitchen-remodel-cost-caracas-valencia-2026',
      '/blog/porcelanato-vs-ceramica': '/en/blog/porcelain-tile-vs-ceramic-tile-guide',
      '/blog/presupuesto-reforma-errores': '/en/blog/remodel-budget-mistakes-avoid',
      '/blog/reformas-banos-carabobo': '/en/blog/bathroom-remodel-carabobo-guide',
      '/blog/tendencias-cocinas-2025': '/en/blog/kitchen-design-trends-2026',
      '/en/blog/kitchen-remodel-cost-caracas-valencia-2026': '/blog/cuanto-cuesta-reforma-cocina-valencia',
      '/en/blog/porcelain-tile-vs-ceramic-tile-guide': '/blog/porcelanato-vs-ceramica',
      '/en/blog/remodel-budget-mistakes-avoid': '/blog/presupuesto-reforma-errores',
      '/en/blog/bathroom-remodel-carabobo-guide': '/blog/reformas-banos-carabobo',
      '/en/blog/kitchen-design-trends-2026': '/blog/tendencias-cocinas-2025',
      '/blog/antes-despues-reforma-cocina-caso-real': '/en/blog/kitchen-remodel-before-after-case-study',
      '/en/blog/kitchen-remodel-before-after-case-study': '/blog/antes-despues-reforma-cocina-caso-real',
      '/blog/como-elegir-empresa-reformas-venezuela': '/en/blog/how-to-choose-remodeling-company-venezuela',
      '/en/blog/how-to-choose-remodeling-company-venezuela': '/blog/como-elegir-empresa-reformas-venezuela',
      '/blog/cuanto-cuesta-remodelar-bano-caracas': '/en/blog/bathroom-remodel-cost-caracas',
      '/en/blog/bathroom-remodel-cost-caracas': '/blog/cuanto-cuesta-remodelar-bano-caracas',
      '/blog/cuanto-tarda-reforma-integral-plazos': '/en/blog/how-long-full-remodel-takes',
      '/en/blog/how-long-full-remodel-takes': '/blog/cuanto-tarda-reforma-integral-plazos',
      '/blog/errores-remodelar-zonas-premium-caracas': '/en/blog/remodeling-mistakes-premium-areas-caracas',
      '/en/blog/remodeling-mistakes-premium-areas-caracas': '/blog/errores-remodelar-zonas-premium-caracas',
      '/blog/fontaneria-plomeria-precios-caracas': '/en/blog/plumbing-prices-caracas',
      '/en/blog/plumbing-prices-caracas': '/blog/fontaneria-plomeria-precios-caracas',
      '/blog/fugas-agua-tuberias-como-detectar': '/en/blog/how-to-detect-water-leaks',
      '/en/blog/how-to-detect-water-leaks': '/blog/fugas-agua-tuberias-como-detectar',
      '/blog/guia-pisos-porcelanato-marmol-madera': '/en/blog/flooring-guide-porcelain-marble-wood',
      '/en/blog/flooring-guide-porcelain-marble-wood': '/blog/guia-pisos-porcelanato-marmol-madera',
      '/blog/instalacion-electrica-precios-venezuela': '/en/blog/electrical-installation-prices-venezuela',
      '/en/blog/electrical-installation-prices-venezuela': '/blog/instalacion-electrica-precios-venezuela',
      '/blog/mantenimiento-piscinas-venezuela': '/en/blog/pool-maintenance-venezuela',
      '/en/blog/pool-maintenance-venezuela': '/blog/mantenimiento-piscinas-venezuela',
      '/blog/microcemento-vs-pintura-acabados': '/en/blog/microcement-vs-paint-finishes',
      '/en/blog/microcement-vs-paint-finishes': '/blog/microcemento-vs-pintura-acabados',
      '/blog/permisos-reforma-apartamento-condominio': '/en/blog/remodel-permits-apartment-condominium',
      '/en/blog/remodel-permits-apartment-condominium': '/blog/permisos-reforma-apartamento-condominio',
      '/blog/pintura-interior-precios-m2-venezuela': '/en/blog/interior-painting-prices-m2-venezuela',
      '/en/blog/interior-painting-prices-m2-venezuela': '/blog/pintura-interior-precios-m2-venezuela',
      '/blog/remodelacion-apartamentos-caracas': '/en/blog/apartment-remodeling-caracas',
      '/en/blog/apartment-remodeling-caracas': '/blog/remodelacion-apartamentos-caracas',
      '/blog/remodelacion-integral-que-incluye': '/en/blog/full-home-remodel-what-it-includes',
      '/en/blog/full-home-remodel-what-it-includes': '/blog/remodelacion-integral-que-incluye',
      '/blog/revestimiento-piedra-madera-pared-precios': '/en/blog/stone-wood-wall-cladding-prices',
      '/en/blog/stone-wood-wall-cladding-prices': '/blog/revestimiento-piedra-madera-pared-precios',
      '/blog/senales-reinstalacion-electrica-casa': '/en/blog/signs-electrical-rewiring-needed',
      '/en/blog/signs-electrical-rewiring-needed': '/blog/senales-reinstalacion-electrica-casa'
    };

    const langSwitchBtn = document.querySelector('.lang-switch-visible');
    if (langSwitchBtn) {
      langSwitchBtn.addEventListener('click', () => {
        const currentPath = window.location.pathname.replace(/\/$/, '') || '/';
        const newPath = routeMap[currentPath];
        
        if (newPath) {
          const newLang = currentPath.startsWith('/en') ? 'es' : 'en';
          localStorage.setItem('reformat-lang', newLang);
          window.location.href = newPath;
        } else {
          if (currentPath.startsWith('/en')) {
            localStorage.setItem('reformat-lang', 'es');
            window.location.href = currentPath.replace(/^\/en/, '') || '/';
          } else {
            localStorage.setItem('reformat-lang', 'en');
            window.location.href = '/en' + currentPath;
          }
        }
      });
    }

    

    window.addEventListener('scroll', () => {
      const navbar = document.getElementById('navbar');
      if (navbar) {
        navbar.classList.toggle('scrolled', window.scrollY > 80);
      }
    });

    const menuBtn = document.getElementById('menu-btn');
    const navLinks = document.querySelector('.nav-links');
    if (menuBtn && navLinks) {
      menuBtn.addEventListener('click', () => {
        const isOpen = navLinks.style.display === 'flex';
        navLinks.style.display = isOpen ? 'none' : 'flex';
        navLinks.style.flexDirection = 'column';
        navLinks.style.position = 'absolute';
        navLinks.style.top = '100%';
        navLinks.style.left = '0';
        navLinks.style.width = '100%';
        navLinks.style.background = '#0a0a0a';
        navLinks.style.padding = '20px';
        navLinks.style.textAlign = 'center';
        navLinks.style.zIndex = '99';
        menuBtn.setAttribute('aria-expanded', (!isOpen).toString());
      });
    }

    window.shareArticle = (platform) => {
      const url = window.location.href;
      const title = document.title;
      const links = {
        whatsapp: `https://wa.me/?text=${encodeURIComponent(title + ' ' + url)}`,
        facebook: `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}`
      };
      if (links[platform]) {
        window.open(links[platform], '_blank', 'width=600,height=400');
      }
    };
  </script>
</body>
</html>

