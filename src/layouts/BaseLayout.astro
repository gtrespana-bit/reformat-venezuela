---
import '../styles/global.css';
import Analytics from '../components/Analytics.astro';
import SEO from '../components/SEO.astro';

interface Props {
  title: string;
  description: string;
  image?: string;
  activePage?: 'inicio' | 'servicios' | 'metodo' | 'proyectos' | 'blog' | 'contacto' | 'home' | 'services' | 'projects' | 'contact';
  articleType?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  articleSection?: string;
  tags?: string[];
  noindex?: boolean;
}

const { 
  title, 
  description, 
  image = '', 
  activePage = '',
  articleType = 'website',
  publishedTime,
  modifiedTime,
  author,
  articleSection,
  tags,
  noindex = false
} = Astro.props;

const currentPath = Astro.url.pathname;
const isEnglish = currentPath.startsWith('/en');
const lang = isEnglish ? 'en' : 'es';

/* Páginas que arrancan con fondo claro: la barra transparente con texto blanco
   quedaba invisible sobre blanco hasta hacer scroll. Ahí se pinta sólida desde el inicio. */
const lightHeaderRoutes = ['/privacidad', '/terminos', '/en/privacy', '/en/terms', '/404', '/en/404'];
const normalizedPath = currentPath.replace(/\/$/, '') || '/';
const needsSolidNav = lightHeaderRoutes.includes(normalizedPath);

const whatsappText = isEnglish
  ? 'Hello,%20I%20would%20like%20a%20technical%20assessment%20for%20my%20remodeling%20project'
  : 'Hola,%20quiero%20solicitar%20una%20valoración%20técnica%20para%20mi%20proyecto%20de%20remodelación';

const skipLinkText = isEnglish ? 'Skip to main content' : 'Saltar al contenido principal';
const menuLabel = isEnglish ? 'Open navigation menu' : 'Abrir menú de navegación';
const footerDesc = isEnglish
  ? 'Transforming spaces with excellence since 2003.'
  : 'Transformando espacios con excelencia desde 2003.';
const footerRights = isEnglish
  ? 'All rights reserved.'
  : 'Todos los derechos reservados.';
const footerLocations = isEnglish
  ? 'Valencia, San Diego, Carabobo and Caracas.'
  : 'Valencia, San Diego, Carabobo y Caracas.';

const navItems = isEnglish
  ? [
      { label: 'Home', href: '/en', key: 'home' },
      { label: 'Services', href: '/en/services', key: 'services' },
      { label: 'Method', href: '/en/our-method', key: 'metodo' },
      { label: 'Projects', href: '/en/projects', key: 'projects' },
      { label: 'About Us', href: '/en/about-us', key: 'nosotros' },
      { label: 'Blog', href: '/en/blog', key: 'blog' },
      { label: 'Contact', href: '/en/contact', key: 'contact', premium: true }
    ]
  : [
      { label: 'Inicio', href: '/', key: 'inicio' },
      { label: 'Servicios', href: '/servicios', key: 'servicios' },
      { label: 'Método', href: '/metodo-remodelat', key: 'metodo' },
      { label: 'Proyectos', href: '/proyectos', key: 'proyectos' },
      { label: 'Nosotros', href: '/sobre-nosotros', key: 'nosotros' },
      { label: 'Blog', href: '/blog', key: 'blog' },
      { label: 'Contacto', href: '/contacto', key: 'contacto', premium: true }
    ];
---

<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <!-- Las fuentes no se precargan globalmente: cada plantilla usa pesos
       distintos y un preload incondicional generaba avisos de recursos no
       utilizados. @font-face + font-display:swap solicita solo los pesos que
       cada página realmente necesita. -->
  <!-- Canonical + hreflang: emitidos por SEO.astro (fuente única) -->

  
  <SEO 
    title={title}
    description={description}
    image={image}
    type={articleType}
    publishedTime={publishedTime}
    modifiedTime={modifiedTime}
    author={author}
    articleSection={articleSection}
    tags={tags}
    activePage={activePage}
    noindex={noindex}
  />

  <Analytics />
</head>

<body>
  <a href="#main-content" class="skip-link">{skipLinkText}</a>

  <nav id="navbar" class={`nav${needsSolidNav ? ' nav-solid' : ''}`} role="navigation" aria-label={isEnglish ? 'Main navigation' : 'Menú principal'}>
