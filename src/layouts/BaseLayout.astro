              { es: 'La Lagunita', en: 'La Lagunita', href: isEnglish ? '/en/remodelacion-integral-la-lagunita' : '/remodelacion-integral-la-lagunita' },
              { es: 'Altamira', en: 'Altamira', href: isEnglish ? '/en/remodelacion-integral-altamira' : '/remodelacion-integral-altamira' },
              { es: 'El Viñedo', en: 'El Viñedo', href: isEnglish ? '/en/remodelacion-integral-el-vinedo' : '/remodelacion-integral-el-vinedo' },
              { es: 'Guataparo', en: 'Guataparo', href: isEnglish ? '/en/remodelacion-integral-guataparo' : '/remodelacion-integral-guataparo' },
            ].map((l) => (
              <li><a href={l.href}>{isEnglish ? l.en : l.es}</a></li>
            ))}
          </ul>
        </div>

        <div class="footer-col">
          <h3 class="footer-heading">{isEnglish ? 'Company' : 'Empresa'}</h3>
          <ul class="footer-links">
            {[
              { es: 'Inicio', en: 'Home', href: isEnglish ? '/en' : '/' },
              { es: 'Sobre Nosotros', en: 'About Us', href: isEnglish ? '/en/about-us' : '/sobre-nosotros' },
              { es: 'Método RemodelaT', en: 'Our Method', href: isEnglish ? '/en/our-method' : '/metodo-remodelat' },
              { es: 'Proyectos', en: 'Projects', href: isEnglish ? '/en/projects' : '/proyectos' },
