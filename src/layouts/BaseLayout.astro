    <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
    <span>WhatsApp</span>
  </a>
</div>

  <!-- Fuente única de verdad para el switcher de idioma en cliente: src/data/routeMap.ts -->
  <script id="__routemap__" type="application/json" set:html={routeMapJson}></script>
  <script id="__untranslated_es__" type="application/json" set:html={untranslatedEsPathsJson}></script>
  <script id="__untranslated_en__" type="application/json" set:html={untranslatedEnPathsJson}></script>
  <script is:inline>
    window.__ROUTEMAP__ = JSON.parse(document.getElementById('__routemap__').textContent);
    window.__UNTRANSLATED_ES__ = JSON.parse(document.getElementById('__untranslated_es__').textContent);
    window.__UNTRANSLATED_EN__ = JSON.parse(document.getElementById('__untranslated_en__').textContent);
  </script>
  <script>
    // El routeMap se inyecta desde Astro en window.__ROUTEMAP para que el
    // switcher de idioma y el resto del JS de cliente estén siempre en sincronía
    // con src/data/routeMap.ts (fuente única de verdad).
    const routeMap = window.__ROUTEMAP || {};
    const untranslatedEs = new Set(window.__UNTRANSLATED_ES__ || []);
    const untranslatedEn = new Set(window.__UNTRANSLATED_EN__ || []);

    function getClientAltPath(path) {
      if (routeMap[path]) return routeMap[path];
      if (path.startsWith('/en')) return path.replace(/^\/en/, '') || '/';
      if (path === '/') return '/en';
      if (untranslatedEs.has(path)) return null;
      return '/en' + path;
    }


    const langSwitchBtn = document.querySelector('.lang-switch-visible');
    if (langSwitchBtn) {
      langSwitchBtn.addEventListener('click', () => {
        const currentPath = window.location.pathname.replace(/\/$/, '') || '/';
        const newPath = getClientAltPath(currentPath);
        if (!newPath) return; // ruta no traducida: no cambiar de idioma
        const newLang = currentPath.startsWith('/en') ? 'es' : 'en';
        localStorage.setItem('remodelat-lang', newLang);
        window.location.href = newPath;
      });
    }

    

    const navbar = document.getElementById('navbar');
    if (navbar) {
      let isScrolled = window.scrollY > 80;
      navbar.classList.toggle('scrolled', isScrolled);

      let navTicking = false;
      const syncNavbarState = () => {
        const nextScrolled = window.scrollY > 80;
        if (nextScrolled !== isScrolled) {
          navbar.classList.toggle('scrolled', nextScrolled);
          isScrolled = nextScrolled;
        }
        navTicking = false;
      };

      window.addEventListener('scroll', () => {
        if (navTicking) return;
        navTicking = true;
        window.requestAnimationFrame(syncNavbarState);
      }, { passive: true });
    }

    /* Menú móvil: panel deslizante.
       Antes se abría inyectando 11 estilos inline desde JS: sin animación,
       no cerraba al pulsar fuera ni con Escape, no atrapaba el foco y
       dejaba la página desplazable por detrás. */
    const menuBtn = document.getElementById('menu-btn');
    const navLinks = document.querySelector('.nav-links');
    const navOverlay = document.querySelector('.nav-overlay');
    if (menuBtn && navLinks) {
      const navAnchors = Array.from(navLinks.querySelectorAll('a'));
      const menuFocusables = [...navAnchors, langSwitchBtn, menuBtn]
        .filter((item): item is HTMLElement => item instanceof HTMLElement);

      const closeMenu = (restoreFocus = false) => {
        document.body.classList.remove('nav-open');
        menuBtn.setAttribute('aria-expanded', 'false');
        if (restoreFocus) menuBtn.focus({ preventScroll: true });
      };
      const toggleMenu = () => {
        const open = document.body.classList.toggle('nav-open');
        menuBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
        if (open) {
          /* El panel conserva su scroll entre aperturas; devolverlo al inicio
             garantiza que siempre se vea el menú completo. */
          navLinks.scrollTop = 0;
          navAnchors[0]?.focus({ preventScroll: true });
        }
      };

      menuBtn.addEventListener('click', toggleMenu);
      /* Cerrar al navegar. No se previene el evento: el enlace debe seguir su curso. */
      navAnchors.forEach((anchor) => anchor.addEventListener('click', () => closeMenu()));
      if (navOverlay) navOverlay.addEventListener('click', () => closeMenu(true));
      document.addEventListener('keydown', (event) => {
        if (!document.body.classList.contains('nav-open')) return;
        if (event.key === 'Escape') {
          event.preventDefault();
          closeMenu(true);
          return;
        }
        if (event.key !== 'Tab' || !menuFocusables.length) return;

        const first = menuFocusables[0];
        const last = menuFocusables[menuFocusables.length - 1];
        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first.focus();
        }
      });
      window.addEventListener('resize', () => { if (window.innerWidth > 900) closeMenu(); });
    }

    /* Las tablas editoriales conservan sus encabezados en escritorio y se
       convierten progresivamente en tarjetas etiquetadas en móvil. */
    document.querySelectorAll('.article-body table').forEach((table) => {
      const headers = Array.from(table.querySelectorAll('thead th'))
        .map((header) => header.textContent?.trim() || '');
      if (!headers.length) return;

      table.querySelectorAll('tbody tr').forEach((row) => {
        Array.from(row.children).forEach((cell, index) => {
          if (headers[index]) cell.setAttribute('data-label', headers[index]);
        });
      });
      table.classList.add('responsive-table');
      table.setAttribute('data-mobile-table', 'true');
    });

    /* PWA: solo se registra en la compilación de producción para no dejar
       cachés persistentes durante el desarrollo local. */
    if (import.meta.env.PROD && 'serviceWorker' in navigator) {
      window.addEventListener('load', () => {
        navigator.serviceWorker.register('/sw.js', { scope: '/' }).catch(() => {
          /* La web sigue siendo totalmente funcional si el registro falla. */
        });
      });
    }

    /* Lightboxes heredados de las páginas de proyectos.
       Algunos casos de estudio montaron su propio visor antes del componente
       compartido. Esta mejora progresiva les añade navegación táctil sin
       reescribir toda la página: deslizar a izquierda/derecha avanza o retrocede. */
    const initLegacyProjectLightboxSwipe = () => {
      document.querySelectorAll('.lightbox:not([data-project-lightbox])').forEach((lightbox) => {
        const root = lightbox as HTMLElement;
        if (root.dataset.swipeBound === 'true') return;
        root.dataset.swipeBound = 'true';

        const swipeZone = (root.querySelector('.lightbox-content') || root.querySelector('.lightbox-img-wrapper') || root) as HTMLElement | null;
        const prevBtn = root.querySelector('.lightbox-prev') as HTMLButtonElement | null;
        const nextBtn = root.querySelector('.lightbox-next') as HTMLButtonElement | null;
        if (!swipeZone || !prevBtn || !nextBtn) return;

        let startX = 0;
        let startY = 0;

        swipeZone.addEventListener('touchstart', (event) => {
          const touch = event.changedTouches[0];
          startX = touch.clientX;
          startY = touch.clientY;
        }, { passive: true });

        swipeZone.addEventListener('touchend', (event) => {
          if (!root.classList.contains('active')) return;
          const touch = event.changedTouches[0];
          const deltaX = touch.clientX - startX;
          const deltaY = touch.clientY - startY;
          if (Math.abs(deltaX) < 48 || Math.abs(deltaX) < Math.abs(deltaY)) return;
          if (deltaX < 0) nextBtn.click();
          if (deltaX > 0) prevBtn.click();
        }, { passive: true });
      });
    };

    initLegacyProjectLightboxSwipe();
    document.addEventListener('astro:page-load', initLegacyProjectLightboxSwipe);

    /* Progress bar oro Dios */
    const godProgress = document.getElementById('god-progress');
    if (godProgress) {
      let godTick = false;
      const updateGodProgress = () => {
        const doc = document.documentElement;
        const scrollTop = doc.scrollTop;
        const height = doc.scrollHeight - doc.clientHeight;
        const progress = height > 0 ? scrollTop / height : 0;
        godProgress.style.transform = `scaleX(${progress})`;
        godTick = false;
      };
      window.addEventListener('scroll', () => {
        if (godTick) return;
        godTick = true;
        requestAnimationFrame(updateGodProgress);
      }, { passive: true });
      updateGodProgress();
    }

    window.shareArticle = (platform) => {
      const url = window.location.href;
      const title = document.title;
      const links = {
        whatsapp: `https://wa.me/?text=${encodeURIComponent(title + ' ' + url)}`,
        facebook: `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}`
      };
      if (links[platform]) {
        window.open(links[platform], '_blank', 'width=600,height=400');
      }
    };
  </script>
</body>
</html>

