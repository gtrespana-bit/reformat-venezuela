---
import '../styles/global.css';
import Analytics from '../components/Analytics.astro';
import SEO from '../components/SEO.astro';
import { routeMap as routeMapData, untranslatedEsPaths, untranslatedEnPaths } from '../data/routeMap';
const routeMapJson = JSON.stringify(routeMapData);
const untranslatedEsPathsJson = JSON.stringify([...untranslatedEsPaths]);
const untranslatedEnPathsJson = JSON.stringify([...untranslatedEnPaths]);

interface Props {
  title: string;
  description: string;
  image?: string;
  activePage?: 'inicio' | 'servicios' | 'metodo' | 'proyectos' | 'blog' | 'contacto' | 'home' | 'services' | 'projects' | 'contact';
  articleType?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  articleSection?: string;
  tags?: string[];
  noindex?: boolean;
}

const { 
  title, 
  description, 
  image = '', 
  activePage = '',
  articleType = 'website',
  publishedTime,
  modifiedTime,
  author,
  articleSection,
  tags,
  noindex = false
} = Astro.props;

const currentPath = Astro.url.pathname;
const isEnglish = currentPath.startsWith('/en');
const lang = isEnglish ? 'en' : 'es';

/* Páginas que arrancan con fondo claro: la barra transparente con texto blanco
   quedaba invisible sobre blanco hasta hacer scroll. Ahí se pinta sólida desde el inicio. */
const lightHeaderRoutes = ['/privacidad', '/terminos', '/en/privacy', '/en/terms', '/404', '/en/404'];
const normalizedPath = currentPath.replace(/\/$/, '') || '/';
const needsSolidNav = lightHeaderRoutes.includes(normalizedPath);
const isHomePage = normalizedPath === '/' || normalizedPath === '/en';

const whatsappText = isEnglish
  ? 'Hello,%20I%20would%20like%20a%20technical%20assessment%20for%20my%20remodeling%20project'
  : 'Hola,%20quiero%20solicitar%20una%20valoración%20técnica%20para%20mi%20proyecto%20de%20remodelación';

const skipLinkText = isEnglish ? 'Skip to main content' : 'Saltar al contenido principal';
const menuLabel = isEnglish ? 'Open navigation menu' : 'Abrir menú de navegación';
const footerDesc = isEnglish
  ? 'Transforming spaces with excellence since 2003.'
  : 'Transformando espacios con excelencia desde 2003.';
const footerRights = isEnglish
  ? 'All rights reserved.'
  : 'Todos los derechos reservados.';
const footerLocations = isEnglish
  ? 'Valencia, San Diego, Carabobo and Caracas.'
  : 'Valencia, San Diego, Carabobo y Caracas.';

const navItems = isEnglish
  ? [
      { label: 'Home', href: '/en', key: 'home' },
      { label: 'Services', href: '/en/services', key: 'services' },
      { label: 'Method', href: '/en/our-method', key: 'metodo' },
      { label: 'Projects', href: '/en/projects', key: 'projects' },
      { label: 'About Us', href: '/en/about-us', key: 'nosotros' },
      { label: 'Blog', href: '/en/blog', key: 'blog' },
      { label: 'Contact', href: '/en/contact', key: 'contact', premium: true }
    ]
  : [
      { label: 'Inicio', href: '/', key: 'inicio' },
      { label: 'Servicios', href: '/servicios', key: 'servicios' },
      { label: 'Método', href: '/metodo-remodelat', key: 'metodo' },
      { label: 'Proyectos', href: '/proyectos', key: 'proyectos' },
      { label: 'Nosotros', href: '/sobre-nosotros', key: 'nosotros' },
      { label: 'Blog', href: '/blog', key: 'blog' },
      { label: 'Contacto', href: '/contacto', key: 'contacto', premium: true }
    ];
---

<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <!-- Las fuentes no se precargan globalmente: cada plantilla usa pesos
       distintos y un preload incondicional generaba avisos de recursos no
       utilizados. En la home sí adelantamos los 4 pesos realmente críticos
       para reducir la cadena CSS -> fuentes sobre el hero. -->
  {isHomePage && (
    <>
      <link rel="preload" href="/fonts/cormorant-garamond-v21-latin-400.v2.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
      <link rel="preload" href="/fonts/cormorant-garamond-v21-latin-600.v2.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
      <link rel="preload" href="/fonts/manrope-v15-latin-400.v2.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
      <link rel="preload" href="/fonts/manrope-v15-latin-600.v2.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
      {/* Póster del hero = fotograma 0 del vídeo. Es el LCP real, así que se
          adelanta con la prioridad más alta.
          OJO: aquí NO se precarga el vídeo. `as="video"` no está implementado
          en ningún navegador (Chrome avisa «<link rel=preload> uses an
          unsupported `as` value» y descarta la línea), y `as="fetch"` lo
          descargaría dos veces porque la caché de fetch no se comparte con la
          del elemento <video>. El vídeo se adelanta con preload="auto" en el
          propio elemento. */}
      <link rel="preload" href="/images/hero-poster-mobile.webp" as="image" type="image/webp" media="(max-width: 1023.98px)" fetchpriority="high" />
      <link rel="preload" href="/images/hero-poster-desktop.webp" as="image" type="image/webp" media="(min-width: 1023.99px)" fetchpriority="high" />
    </>
  )}
  <!-- Canonical + hreflang: emitidos por SEO.astro (fuente única) -->

  
  <SEO 
    title={title}
    description={description}
    image={image}
    type={articleType}
    publishedTime={publishedTime}
    modifiedTime={modifiedTime}
    author={author}
    articleSection={articleSection}
    tags={tags}
    activePage={activePage}
    noindex={noindex}
  />

  <Analytics />
</head>

<body>
  <div class="god-progress" id="god-progress" aria-hidden="true"></div>
  <a href="#main-content" class="skip-link">{skipLinkText}</a>

  <nav id="navbar" class={`nav${needsSolidNav ? ' nav-solid' : ''}`} role="navigation" aria-label={isEnglish ? 'Main navigation' : 'Menú principal'}>
    <div class="nav-container">
      <a href={isEnglish ? '/en' : '/'} class="logo">
        <img
          src="/images/logo-header-280.webp"
          srcset="/images/logo-header-180.webp 180w, /images/logo-header-280.webp 280w, /images/logo-header-560.webp 560w"
          sizes="(max-width: 480px) 182px, (max-width: 768px) 200px, 283px"
          alt="RemodelaT Venezuela"
          width="280"
          height="75"
          loading="eager"
          decoding="async"
        />
      </a>

      <ul class="nav-links" id="primary-nav">
        {navItems.map((item) => (
          <li>
            <a
              href={item.href}
              class={[
                activePage === item.key ? 'active' : '',
                item.premium ? 'btn-nav-premium' : ''
              ].filter(Boolean).join(' ')}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>

      <button
        type="button"
        class="lang-switch-visible"
        data-current-lang={lang}
        aria-label={isEnglish ? 'Cambiar a español' : 'Switch to English'}
      >
        {isEnglish ? 'ES' : 'EN'}
      </button>

      <button id="menu-btn" class="menu-btn" aria-label={menuLabel} aria-expanded="false" aria-controls="primary-nav">
        <svg class="icon-open" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
        <svg class="icon-close" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
          <line x1="6" y1="6" x2="18" y2="18"></line>
          <line x1="18" y1="6" x2="6" y2="18"></line>
        </svg>
      </button>
    </div>
  </nav>

  <div class="nav-overlay" aria-hidden="true"></div>

  <main id="main-content">
<slot />
</main>

  <a href={`https://wa.me/584227997043?text=${whatsappText}`} target="_blank" rel="noopener" class="whatsapp-float" aria-label={isEnglish ? 'Contact via WhatsApp' : 'Contactar por WhatsApp'}>
    <svg viewBox="0 0 24 24" fill="white" width="28" height="28"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
  </a>

