  @media (max-width: 900px) {
    /* Panel deslizante desde la derecha */
    /* En móvil se elimina el backdrop-filter del nav: aplicado al ancestro
       convierte a sus descendientes position:fixed en relativos a la barra.
       Al abrir el menú después de hacer scroll, el panel quedaba limitado a
       la altura del navbar y solo mostraba sus últimos enlaces. */
    .nav.scrolled,
    .nav-solid { backdrop-filter: none; }

    .nav-links {
      display: flex;
      position: fixed;
      inset: 0 0 auto auto;
      width: min(320px, 82vw);
