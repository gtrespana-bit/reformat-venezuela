---
interface Props {
  items?: string[];
}
const defaultZones = [
  "San Diego", "Valencia", "Guacara", "Altamira", "Naguanagua",
  "Las Mercedes", "Guataparo", "El Viñedo", "La Lagunita", "Prebo",
  "El Parral", "Mañongo", "Los Naranjos", "San Joaquín", "Chacao"
];
const { items = defaultZones } = Astro.props;
const doubled = [...items, ...items];
---
<div class="god-marquee" aria-hidden="true">
  <div class="god-marquee-track">
    {doubled.map((z) => (
      <span class="god-marquee-item">{z} <i></i></span>
    ))}
  </div>
</div>
