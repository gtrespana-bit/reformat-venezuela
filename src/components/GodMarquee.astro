---
interface Props {
  items?: string[];
}
const defaultZones = [
  "San Diego", "Valencia", "Naguanagua", "Guacara", "El Viñedo",
  "Guataparo", "Manongo", "El Trigal", "Prebo", "El Parral",
  "Los Guayos", "Puerto Cabello", "Caracas", "Altamira", "Chacao"
];
const { items = defaultZones } = Astro.props;
const doubled = [...items, ...items];
---
<div class="god-marquee" aria-hidden="true">
  <div class="god-marquee-track">
    {doubled.map((z) => (
      <span class="god-marquee-item">{z} <i></i></span>
    ))}
  </div>
</div>
