---
interface Props {
  eyebrow?: string;
  title?: string;
  description?: string;
  variant?: 'light' | 'dark';
  compact?: boolean;
  lang?: 'es' | 'en';
}

const { variant = 'light', compact = false, lang = 'es' } = Astro.props;
const isEnglish = lang === 'en';

const eyebrow = Astro.props.eyebrow ?? (isEnglish ? 'Warranty by scope' : 'Garantías por partidas');
const title = Astro.props.title ?? (isEnglish
  ? 'Every warranty is tied to a specific trade or scope of work'
  : 'Cada garantía queda vinculada a una partida concreta');
const description = Astro.props.description ?? (isEnglish
  ? 'We do not offer a vague blanket promise without explaining what is covered. Coverage is documented in writing according to the scope, installed materials, site conditions and manufacturer warranties.'
  : 'No prometemos una garantía genérica sin explicar qué cubre. La cobertura se documenta por escrito según el alcance, los materiales instalados, las condiciones de uso y la garantía del fabricante.');

const guaranteeRows = isEnglish ? [
  {
    part: 'Waterproofing',
    coverage: 'Up to 5 years depending on system applied',
    evidence: 'Flood testing, process photos and documented wet areas before closing walls or floors.'
  },
  {
    part: 'Plumbing / sanitary utilities',
    coverage: 'Up to 2 years on installation labor',
    evidence: 'Pressure tests, drain checks, water points and final operating tests.'
  },
  {
    part: 'Electrical installation',
    coverage: 'Up to 2 years on installation labor',
    evidence: 'Identified circuits, checked protections, installed points and functional testing.'
  },
  {
    part: 'Flooring and wall coverings',
    coverage: 'Up to 2 years on installation labor',
    evidence: 'Prepared substrate, compatible adhesive, leveling, joints, cuts and bond reviewed.'
  },
  {
    part: 'Carpentry and cabinetry',
    coverage: 'Coverage according to fabrication, hardware and adjustment',
    evidence: 'Doors, drawers, hinges, edges, anchors, plumbs and operation checked.'
  },
  {
    part: 'Paint, microcement and finishes',
    coverage: 'Coverage according to product and surface preparation',
    evidence: 'Surface preparation, coats, sealers, texture and final finish checked.'
  },
  {
    part: 'Fixtures, sanitaryware and equipment',
    coverage: 'Manufacturer warranty + installation labor',
    evidence: 'Product reference or invoice, correct installation, operating test and handover.'
  },
  {
    part: 'Final handover',
    coverage: 'Finish checklist and handover record',
    evidence: 'Joint inspection, final cleaning, adjustment list and documented conditions.'
  }
] : [
  {
    part: 'Impermeabilización',
    coverage: 'Hasta 5 años según sistema aplicado',
    evidence: 'Prueba de estanqueidad, fotos del proceso y zonas cubiertas antes de cerrar.'
  },
  {
    part: 'Instalaciones hidrosanitarias',
    coverage: 'Hasta 2 años en instalación',
    evidence: 'Pruebas de presión, revisión de desagües, puntos de agua y funcionamiento final.'
  },
  {
    part: 'Instalación eléctrica',
    coverage: 'Hasta 2 años en mano de obra',
    evidence: 'Circuitos identificados, protecciones revisadas, puntos instalados y pruebas de funcionamiento.'
  },
  {
    part: 'Pisos y revestimientos',
    coverage: 'Hasta 2 años en instalación',
    evidence: 'Soporte preparado, adhesivo compatible, nivelación, juntas, cortes y adherencia revisados.'
  },
  {
    part: 'Carpintería y mobiliario',
    coverage: 'Cobertura según fabricación, herrajes y ajuste',
    evidence: 'Revisión de puertas, cajones, bisagras, cantos, anclajes, plomos y funcionamiento.'
  },
  {
    part: 'Pintura, microcemento y acabados',
    coverage: 'Cobertura según producto y preparación',
    evidence: 'Preparación de superficie, aplicación por capas, sellados, textura y terminación final.'
  },
  {
    part: 'Griferías, sanitarios y equipos',
    coverage: 'Garantía del fabricante + instalación',
    evidence: 'Factura o referencia de producto, montaje correcto, prueba de uso y entrega funcionando.'
  },
  {
    part: 'Entrega final de obra',
    coverage: 'Checklist de remates y acta de entrega',
    evidence: 'Revisión conjunta, limpieza final, lista de ajustes y condiciones documentadas.'
  }
];

const labels = isEnglish
  ? { part: 'Scope', coverage: 'Indicative coverage', evidence: 'How it is supported', note: 'Final coverage is established in each project estimate/contract. Warranty does not replace normal maintenance, proper use or manufacturer warranty terms.' }
  : { part: 'Partida', coverage: 'Cobertura orientativa', evidence: 'Cómo se respalda', note: 'La cobertura definitiva se establece en el presupuesto/contrato de cada proyecto. La garantía no sustituye el mantenimiento normal, el buen uso ni las garantías propias de fabricantes.' };
---

<section class:list={["guarantee-matrix-section", `guarantee-${variant}`, compact && 'is-compact']}>
  <div class="container guarantee-container">
    <div class="guarantee-intro">
      <span class="tag">{eyebrow}</span>
      <h2>{title}</h2>
      <p>{description}</p>
    </div>

    <div class="guarantee-table" role="table" aria-label={isEnglish ? 'RemodelaT warranty by scope' : 'Garantías por partidas RemodelaT'}>
      <div class="guarantee-row guarantee-head" role="row">
        <span role="columnheader">{labels.part}</span>
        <span role="columnheader">{labels.coverage}</span>
        <span role="columnheader">{labels.evidence}</span>
      </div>
      {guaranteeRows.map((row) => (
        <div class="guarantee-row" role="row">
          <strong role="cell">
            <span class="guarantee-mobile-label">{labels.part}</span>
            {row.part}
          </strong>
          <span role="cell">
            <span class="guarantee-mobile-label">{labels.coverage}</span>
            {row.coverage}
          </span>
          <p role="cell">
            <span class="guarantee-mobile-label">{labels.evidence}</span>
            {row.evidence}
          </p>
        </div>
      ))}
    </div>

    <p class="guarantee-note">
      {labels.note}
    </p>
  </div>
</section>

<style>
  .guarantee-matrix-section {
    padding: var(--s-6) 0;
    background: var(--bone);
    color: var(--text);
  }
  .guarantee-matrix-section.is-compact { padding: var(--s-5) 0; }
  .guarantee-dark {
    background:
      radial-gradient(circle at 20% 10%, rgba(201,169,97,.14), transparent 34%),
      var(--ink);
    color: var(--white);
  }
  .guarantee-container { max-width: 1160px; }
  .guarantee-intro {
    max-width: 780px;
    margin: 0 auto var(--s-4);
    text-align: center;
  }
  .guarantee-intro h2 {
    font-family: var(--font-serif);
    font-size: clamp(2.1rem, 4.5vw, 3.45rem);
    line-height: 1.08;
    letter-spacing: var(--track-tight);
    font-weight: 500;
    margin: 0 0 18px;
    color: inherit;
  }
  .guarantee-intro p {
    color: var(--text-muted);
    line-height: 1.75;
    font-size: 1.05rem;
  }
  .guarantee-dark .guarantee-intro p { color: rgba(255,255,255,.76); }
  .guarantee-dark .tag { color: var(--gold); }

  .guarantee-table {
    overflow: hidden;
    border-radius: var(--r-lg);
    border: 1px solid var(--sand);
    background: rgba(255,255,255,.92);
    box-shadow: var(--e-2);
  }
  .guarantee-dark .guarantee-table {
    border-color: rgba(201,169,97,.26);
    background: rgba(255,255,255,.045);
    box-shadow: var(--e-3);
  }
  .guarantee-row {
    display: grid;
    grid-template-columns: .82fr .86fr 1.45fr;
    gap: 0;
    align-items: stretch;
    border-top: 1px solid var(--sand);
  }
  .guarantee-row:first-child { border-top: 0; }
  .guarantee-head {
    background: var(--ink);
    color: var(--gold-light);
    border-top: 0;
  }
  .guarantee-dark .guarantee-head { background: rgba(201,169,97,.14); }
  .guarantee-row > * {
    padding: 18px 20px;
    border-left: 1px solid var(--sand);
    margin: 0;
  }
  .guarantee-row > *:first-child { border-left: 0; }
  .guarantee-head span {
    font-size: .78rem;
    font-weight: 700;
    letter-spacing: .12em;
    text-transform: uppercase;
  }
  .guarantee-row strong {
    font-family: var(--font-serif);
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--ink-soft);
  }
  .guarantee-row span {
    color: var(--gold-ink-strong);
    font-weight: 700;
    line-height: 1.55;
  }
  .guarantee-row p {
    color: var(--text-muted);
    line-height: 1.65;
    font-size: .95rem;
  }
  .guarantee-dark .guarantee-row { border-top-color: rgba(242,237,228,.12); }
  .guarantee-dark .guarantee-row > * { border-left-color: rgba(242,237,228,.12); }
  .guarantee-dark .guarantee-row strong { color: var(--white); }
  .guarantee-dark .guarantee-row span { color: var(--gold-light); }
  .guarantee-dark .guarantee-row p { color: rgba(255,255,255,.72); }

  .guarantee-note {
    max-width: 900px;
    margin: 22px auto 0;
    text-align: center;
    color: var(--text-muted);
    font-size: .92rem;
    line-height: 1.65;
  }
  .guarantee-dark .guarantee-note { color: rgba(255,255,255,.62); }
  .guarantee-mobile-label { display: none; }

  @media (max-width: 820px) {
    .guarantee-row,
    .guarantee-head {
      grid-template-columns: 1fr;
    }
    .guarantee-head { display: none; }
    .guarantee-row {
      padding: 18px 20px;
      gap: 8px;
    }
    .guarantee-row > * {
      padding: 0;
      border-left: 0;
    }
    .guarantee-row strong { font-size: 1.3rem; }
    .guarantee-mobile-label,
    .guarantee-row .guarantee-mobile-label {
      display: block;
      margin-bottom: 4px;
      color: var(--text-muted);
      font-family: var(--font-sans);
      font-size: .7rem;
      font-weight: 800;
      letter-spacing: .1em;
      line-height: 1.4;
      text-transform: uppercase;
    }
    .guarantee-dark .guarantee-row .guarantee-mobile-label {
      color: rgba(255,255,255,.56);
    }
  }
</style>
