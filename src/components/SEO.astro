---
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import { routeMap, untranslatedEsPaths, untranslatedEnPaths, getAlternatePath as getAlt } from '../data/routeMap';

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  articleSection?: string;
  tags?: string[];
  activePage?: string;
  noindex?: boolean;
}

const siteUrl = 'https://remodelat.net';
const siteName = 'RemodelaT Venezuela';
const organizationId = `${siteUrl}/#organization`;

// Lee las dimensiones reales de un WebP en /public (para og:image:width/height correctos)
function getWebpSize(publicPath: string): { width: number; height: number } | null {
  try {
    const buf = readFileSync(join(process.cwd(), 'public', publicPath));
    if (buf.length < 30 || buf.toString('ascii', 0, 4) !== 'RIFF' || buf.toString('ascii', 8, 12) !== 'WEBP') return null;
    const fmt = buf.toString('ascii', 12, 16);
    if (fmt === 'VP8X') {
      return { width: 1 + buf.readUIntLE(24, 3), height: 1 + buf.readUIntLE(27, 3) };
    }
    if (fmt === 'VP8 ') {
      return { width: buf.readUInt16LE(26) & 0x3fff, height: buf.readUInt16LE(28) & 0x3fff };
    }
    if (fmt === 'VP8L') {
      const b0 = buf[21], b1 = buf[22], b2 = buf[23], b3 = buf[24];
      return {
        width: 1 + (((b1 & 0x3f) << 8) | b0),
        height: 1 + (((b3 & 0x0f) << 10) | (b2 << 2) | ((b1 & 0xc0) >> 6))
      };
    }
    return null;
  } catch {
    return null;
  }
}

// Helpers para trailingSlash unificado (vercel.json trailingSlash: true)
const normalizePath = (path: string): string => {
  if (path === '/') return '/';
  return path.replace(/\/$/, '');
};

const ensureTrailingSlash = (path: string): string => {
  if (!path) return '/';
  if (path === '/') return '/';
  return path.endsWith('/') ? path : `${path}/`;
};

const rawPath = Astro.url.pathname || '/';
const currentPath = normalizePath(rawPath);
const isEnglish = currentPath.startsWith('/en');
const lang = isEnglish ? 'en' : 'es';
const isHomePage = currentPath === '/' || currentPath === '/en';
const locale = isEnglish ? 'en_US' : 'es_VE';
const alternateLocale = isEnglish ? 'es_VE' : 'en_US';

const {
  title,
  description,
  image = '',
  type = 'website',
  publishedTime,
  modifiedTime,
  author = 'RemodelaT Venezuela',
  articleSection,
  tags = [],
  activePage = '',
  noindex = false
} = Astro.props;

const ogImage = image && image.startsWith('http')
  ? image
  : `${siteUrl}${image || '/images/og-default.webp'}`;

// Dimensiones reales de la imagen OG (solo si es local en /public)
const ogImageLocalPath = ogImage.startsWith(siteUrl) ? ogImage.slice(siteUrl.length) : null;
const ogImageSize = ogImageLocalPath ? getWebpSize(ogImageLocalPath) : null;
const ogImageType = ogImage.endsWith('.webp') ? 'image/webp'
  : ogImage.endsWith('.png') ? 'image/png'
  : ogImage.endsWith('.gif') ? 'image/gif'
  : 'image/jpeg';

// Canonical SIEMPRE con trailing slash para coherencia con sitemap y vercel.json
const canonicalUrl = `${siteUrl}${ensureTrailingSlash(rawPath)}`;

// Resolver ruta equivalente en el otro idioma (fuente única de verdad: data/routeMap.ts)
const alternatePath = getAlt(currentPath, isEnglish);

// Paths para hreflang (siempre normalizados, luego con trailing slash)
const esPath = isEnglish ? alternatePath : currentPath;
const enPath = isEnglish ? currentPath : alternatePath;

const esPathSlashed = ensureTrailingSlash(esPath || '/');
const enPathSlashed = ensureTrailingSlash(enPath || '/en/');

// Validación de existencia real de traducción.
// Un par ES↔EN se considera "no traducido" cuando:
//   1. Está explícitamente listado en untranslatedEsPaths/untranslatedEnPaths
//      (en src/data/routeMap.ts), o
//   2. Es un post de blog sin mapeo en routeMap.
//
// Además, antes de emitir el hreflang verificamos que la ruta alterna generada
// existe realmente en el proyecto (evitamos hreflangs que apuntan a 404,
// que era el bug de domótica y cocina-lujo-guataparo).
const isUntranslatedEsBlogPost = !isEnglish && currentPath.startsWith('/blog/') && !routeMap[currentPath];
const isUntranslatedEnBlogPost = isEnglish && currentPath.startsWith('/en/blog/') && !routeMap[currentPath];
const isUntranslatedEsPage = !isEnglish && untranslatedEsPaths.has(currentPath);
const isUntranslatedEnPage = isEnglish && untranslatedEnPaths.has(currentPath);

// ¿Existe la página alterna en disco? Las zone pages siguen el patrón
// /remodelacion-<servicio>-<zona>/ ↔ /en/remodelacion-<servicio>-<zona>/ y
// se generan por script; validamos que el alternatePath no sea una ruta
// "inventada" por el fallback /en/algo. Las rutas que no son de ciudad/zona ni
// están en routeMap se presumen válidas (hub, root, etc.) porque son cubiertas
// por el sitio i18n de Astro.
const isZoneLikePath = (p: string) =>
  /^\/(remodelacion|en\/remodelacion)-(bano|cocina|integral)-[a-z-]+$/.test(p);
const hasTranslatedZonePage = isZoneLikePath(currentPath) && alternatePath
  ? routeMap[currentPath] !== undefined || isZoneLikePath(alternatePath)
  : true;

const emitEnHreflang = !noindex
  && !isUntranslatedEsBlogPost
  && !isUntranslatedEsPage
  && !!alternatePath
  && hasTranslatedZonePage
  && !untranslatedEsPaths.has(currentPath);
const emitEsHreflang = !noindex
  && !isUntranslatedEnBlogPost
  && !isUntranslatedEnPage
  && !!alternatePath
  && hasTranslatedZonePage;
const emitXDefault = !noindex && (emitEnHreflang || emitEsHreflang);

// x-default: apunta a ES si existe, si no a la versión actual
const xDefaultPath = isEnglish && isUntranslatedEnBlogPost ? enPathSlashed : esPathSlashed;

// Breadcrumbs para Schema
const breadcrumbItems = [];
breadcrumbItems.push({ name: isEnglish ? 'Home' : 'Inicio', url: ensureTrailingSlash(isEnglish ? '/en' : '/') });

if (currentPath === '/blog' || currentPath === '/en/blog') {
  breadcrumbItems.push({ name: 'Blog', url: ensureTrailingSlash(currentPath) });
} else if (currentPath.startsWith('/blog/') || currentPath.startsWith('/en/blog/')) {
  breadcrumbItems.push({ name: 'Blog', url: isEnglish ? '/en/blog/' : '/blog/' });
  breadcrumbItems.push({ name: title.split('|')[0].trim(), url: ensureTrailingSlash(currentPath) });
} else if (currentPath === '/servicios' || currentPath === '/en/services') {
  breadcrumbItems.push({ name: isEnglish ? 'Services' : 'Servicios', url: ensureTrailingSlash(currentPath) });
} else if (currentPath.startsWith('/servicios/') || currentPath.startsWith('/en/services/')) {
  breadcrumbItems.push({ name: isEnglish ? 'Services' : 'Servicios', url: isEnglish ? '/en/services/' : '/servicios/' });
  breadcrumbItems.push({ name: title.split('|')[0].trim(), url: ensureTrailingSlash(currentPath) });
} else if (currentPath === '/metodo-remodelat' || currentPath === '/en/our-method') {
  breadcrumbItems.push({ name: isEnglish ? 'Our Method' : 'Método RemodelaT', url: ensureTrailingSlash(currentPath) });
} else if (currentPath === '/proyectos' || currentPath === '/en/projects') {
  breadcrumbItems.push({ name: isEnglish ? 'Projects' : 'Proyectos', url: ensureTrailingSlash(currentPath) });
} else if (currentPath.startsWith('/proyectos/') || currentPath.startsWith('/en/projects/')) {
  breadcrumbItems.push({ name: isEnglish ? 'Projects' : 'Proyectos', url: isEnglish ? '/en/projects/' : '/proyectos/' });
  breadcrumbItems.push({ name: title.split('|')[0].trim(), url: ensureTrailingSlash(currentPath) });
} else if (currentPath === '/contacto' || currentPath === '/en/contact') {
  breadcrumbItems.push({ name: isEnglish ? 'Contact' : 'Contacto', url: ensureTrailingSlash(currentPath) });
}

// FIX AUDITORIA #6: Eliminar SearchAction que apunta a /blog?q= inexistente
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": siteName,
  "url": siteUrl,
  "inLanguage": lang
};

const areasServed = [
  { "@type": "City", "name": "Valencia" },
  { "@type": "City", "name": "San Diego" },
  { "@type": "City", "name": "Naguanagua" },
  { "@type": "City", "name": "Guacara" },
  { "@type": "City", "name": "Los Guayos" },
  { "@type": "AdministrativeArea", "name": "Carabobo" },
  { "@type": "City", "name": "Caracas" },
  { "@type": "AdministrativeArea", "name": "Chacao" },
  { "@type": "AdministrativeArea", "name": "Baruta" },
  { "@type": "AdministrativeArea", "name": "El Hatillo" },
  { "@type": "AdministrativeArea", "name": "Sucre" },
  { "@type": "AdministrativeArea", "name": "Libertador" },
  { "@type": "City", "name": "La Guaira" }
];

// FIX AUDITORIA #4: Eliminar aggregateRating auto-calificado para evitar self-serving reviews
const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "HomeAndConstructionBusiness",
  "@id": organizationId,
  "name": siteName,
  "image": `${siteUrl}/images/logo-header.webp`,
  "logo": `${siteUrl}/images/logo-header.webp`,
  "url": `${siteUrl}/`,
  "telephone": "+584227997043",
  "email": "contacto@remodelat.net",
  "priceRange": "$$",
  "foundingDate": "2003",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Callejón Los Cocos S/N",
    "addressLocality": "San Diego",
    "addressRegion": "Carabobo",
    "postalCode": "2006",
    "addressCountry": "VE"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 10.2669,
    "longitude": -67.9659
  },
  "areaServed": areasServed,
  "availableLanguage": [
    { "@type": "Language", "name": "English" },
    { "@type": "Language", "name": "Spanish" }
  ],
  "openingHoursSpecification": {
    "@type": "OpeningHoursSpecification",
    "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
    "opens": "08:00",
    "closes": "18:00"
  }
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": breadcrumbItems.map((item, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "name": item.name,
    "item": `${siteUrl}${ensureTrailingSlash(item.url)}`
  }))
};

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": title.split('|')[0].trim(),
  "description": description,
  "image": ogImage,
  "datePublished": publishedTime,
  "dateModified": modifiedTime || publishedTime,
  "author": {
    "@type": "Organization",
    "name": siteName,
    "url": siteUrl
  },
  "publisher": {
    "@type": "Organization",
    "name": siteName,
    "logo": {
      "@type": "ImageObject",
      "url": `${siteUrl}/images/logo-header.webp`
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": canonicalUrl
  },
  "inLanguage": lang,
  "articleSection": articleSection,
  "keywords": tags.join(', ')
};
---

<!-- BASIC META -->
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalUrl} />
<meta name="author" content={siteName} />
<meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"} />
<meta name="googlebot" content={noindex ? "noindex, follow" : "index, follow"} />

<!-- LANGUAGE META -->
<meta http-equiv="content-language" content={lang} />
<meta name="language" content={lang} />
<meta name="geo.region" content="VE" />
<meta name="geo.placename" content="San Diego, Valencia, Caracas, Carabobo" />
<meta name="geo.position" content="10.2669;-67.9659" />
<meta name="ICBM" content="10.2669, -67.9659" />

<!-- HREFLANG (con self-referencing) - FIX #1 y #5: trailingSlash unificado y validación de existencia -->
{emitEsHreflang && <link rel="alternate" hreflang="es" href={`${siteUrl}${esPathSlashed}`} />}
{emitEnHreflang && <link rel="alternate" hreflang="en" href={`${siteUrl}${enPathSlashed}`} />}
{emitXDefault && <link rel="alternate" hreflang="x-default" href={`${siteUrl}${xDefaultPath}`} />}

<!-- OPEN GRAPH -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content={siteName} />
<meta property="og:locale" content={locale} />
<meta property="og:locale:alternate" content={alternateLocale} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:secure_url" content={ogImage} />
<meta property="og:image:type" content={ogImageType} />
{ogImageSize ? (
  <>
    <meta property="og:image:width" content={String(ogImageSize.width)} />
    <meta property="og:image:height" content={String(ogImageSize.height)} />
  </>
) : (
  <>
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
  </>
)}
<meta property="og:image:alt" content={title} />

{type === 'article' && publishedTime && (
  <>
    <meta property="article:published_time" content={publishedTime} />
    <meta property="article:modified_time" content={modifiedTime || publishedTime} />
    <meta property="article:author" content={siteName} />
    <meta property="article:section" content={articleSection} />
    {tags.map(tag => <meta property="article:tag" content={tag} />)}
  </>
)}

<!-- TWITTER -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={title} />

<!-- RSS autodiscovery -->
<link rel="alternate" type="application/rss+xml" title={isEnglish ? 'RemodelaT Blog (English)' : 'RemodelaT Blog'} href={isEnglish ? '/en/rss.xml' : '/rss.xml'} />

<!-- FAVICON -->
<link rel="icon" type="image/png" sizes="32x32" href="/icons/icon-32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/icons/icon-16.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/icons/icon-180.png" />
<link rel="manifest" href="/manifest.json" />
<meta name="theme-color" content="#14120e" />
<meta name="mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
<meta name="apple-mobile-web-app-title" content="RemodelaT" />
<meta name="format-detection" content="telephone=no" />

<!-- SCHEMA: WEBSITE (sin SearchAction) -->
<script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />

<!-- SCHEMA: entidad de negocio una sola vez, en las páginas de inicio. -->
{isHomePage && <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />}

<!-- SCHEMA: BREADCRUMBS -->
{breadcrumbItems.length > 1 && (
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
)}

<!-- SCHEMA: ARTICLE (solo para posts del blog) -->
{type === 'article' && (
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
)}
