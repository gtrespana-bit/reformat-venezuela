---
interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  articleSection?: string;
  tags?: string[];
  activePage?: string;
}

const siteUrl = 'https://reformat-venezuela.online';
const siteName = 'ReformaT Venezuela';

// Helpers para trailingSlash unificado (vercel.json trailingSlash: true)
const normalizePath = (path: string): string => {
  if (path === '/') return '/';
  return path.replace(/\/$/, '');
};

const ensureTrailingSlash = (path: string): string => {
  if (!path) return '/';
  if (path === '/') return '/';
  return path.endsWith('/') ? path : `${path}/`;
};

const rawPath = Astro.url.pathname || '/';
const currentPath = normalizePath(rawPath);
const isEnglish = currentPath.startsWith('/en');
const lang = isEnglish ? 'en' : 'es';
const locale = isEnglish ? 'en_US' : 'es_VE';
const alternateLocale = isEnglish ? 'es_VE' : 'en_US';

const {
  title,
  description,
  image = '',
  type = 'website',
  publishedTime,
  modifiedTime,
  author = 'ReformaT Venezuela',
  articleSection,
  tags = [],
  activePage = ''
} = Astro.props;

const ogImage = image && image.startsWith('http')
  ? image
  : `${siteUrl}${image || '/images/og-default.webp'}`;

// Canonical SIEMPRE con trailing slash para coherencia con sitemap y vercel.json
const canonicalUrl = `${siteUrl}${ensureTrailingSlash(rawPath)}`;

// Mapa de traducción de rutas para hreflang (sin trailing slash)
const routeMap: Record<string, string> = {
  '/': '/en',
  '/en': '/',
  '/servicios': '/en/services',
  '/en/services': '/servicios',
  '/servicios/remodelacion-cocina': '/en/services/kitchens',
  '/en/services/kitchens': '/servicios/remodelacion-cocina',
  '/servicios/remodelacion-bano': '/en/services/bathrooms',
  '/en/services/bathrooms': '/servicios/remodelacion-bano',
  '/servicios/remodelacion-integral': '/en/services/whole-home',
  '/en/services/whole-home': '/servicios/remodelacion-integral',
  '/servicios/remodelacion-vivienda': '/en/services/whole-home',
  '/servicios/remodelacion-apartamentos': '/en/services/whole-home',
  '/servicios/remodelacion-casas': '/en/services/whole-home',
  '/servicios/instalacion-electrica': '/en/services/electrical',
  '/en/services/electrical': '/servicios/instalacion-electrica',
  '/servicios/fontaneria-plomeria': '/en/services/plumbing',
  '/en/services/plumbing': '/servicios/fontaneria-plomeria',
  '/servicios/pintura-acabados': '/en/services/painting',
  '/en/services/painting': '/servicios/pintura-acabados',
  '/servicios/revestimientos-pared': '/en/services/wall-coverings',
  '/en/services/wall-coverings': '/servicios/revestimientos-pared',
  '/servicios/instalacion-pisos': '/en/services/flooring',
  '/en/services/flooring': '/servicios/instalacion-pisos',
  '/servicios/piscinas-mantenimiento': '/en/services/pools',
  '/en/services/pools': '/servicios/piscinas-mantenimiento',
  '/proyectos': '/en/projects',
  '/en/projects': '/proyectos',
  '/contacto': '/en/contact',
  '/en/contact': '/contacto',
  '/sobre-nosotros': '/en/about-us',
  '/en/about-us': '/sobre-nosotros',
  '/blog': '/en/blog',
  '/en/blog': '/blog',
  '/blog/cuanto-cuesta-reforma-cocina-valencia': '/en/blog/kitchen-remodel-cost-caracas-valencia-2026',
  '/blog/porcelanato-vs-ceramica': '/en/blog/porcelain-tile-vs-ceramic-tile-guide',
  '/blog/presupuesto-reforma-errores': '/en/blog/remodel-budget-mistakes-avoid',
  '/blog/reformas-banos-carabobo': '/en/blog/bathroom-remodel-carabobo-guide',
  '/blog/tendencias-cocinas-2025': '/en/blog/kitchen-design-trends-2026',
  '/en/blog/kitchen-remodel-cost-caracas-valencia-2026': '/blog/cuanto-cuesta-reforma-cocina-valencia',
  '/en/blog/porcelain-tile-vs-ceramic-tile-guide': '/blog/porcelanato-vs-ceramica',
  '/en/blog/remodel-budget-mistakes-avoid': '/blog/presupuesto-reforma-errores',
  '/en/blog/bathroom-remodel-carabobo-guide': '/blog/reformas-banos-carabobo',
  '/en/blog/kitchen-design-trends-2026': '/blog/tendencias-cocinas-2025',
  '/blog/antes-despues-reforma-cocina-caso-real': '/en/blog/kitchen-remodel-before-after-case-study',
  '/en/blog/kitchen-remodel-before-after-case-study': '/blog/antes-despues-reforma-cocina-caso-real',
  '/blog/como-elegir-empresa-reformas-venezuela': '/en/blog/how-to-choose-remodeling-company-venezuela',
  '/en/blog/how-to-choose-remodeling-company-venezuela': '/blog/como-elegir-empresa-reformas-venezuela',
  '/blog/cuanto-cuesta-remodelar-bano-caracas': '/en/blog/bathroom-remodel-cost-caracas',
  '/en/blog/bathroom-remodel-cost-caracas': '/blog/cuanto-cuesta-remodelar-bano-caracas',
  '/blog/cuanto-tarda-reforma-integral-plazos': '/en/blog/how-long-full-remodel-takes',
  '/en/blog/how-long-full-remodel-takes': '/blog/cuanto-tarda-reforma-integral-plazos',
  '/blog/errores-remodelar-zonas-premium-caracas': '/en/blog/remodeling-mistakes-premium-areas-caracas',
  '/en/blog/remodeling-mistakes-premium-areas-caracas': '/blog/errores-remodelar-zonas-premium-caracas',
  '/blog/fontaneria-plomeria-precios-caracas': '/en/blog/plumbing-prices-caracas',
  '/en/blog/plumbing-prices-caracas': '/blog/fontaneria-plomeria-precios-caracas',
  '/blog/fugas-agua-tuberias-como-detectar': '/en/blog/how-to-detect-water-leaks',
  '/en/blog/how-to-detect-water-leaks': '/blog/fugas-agua-tuberias-como-detectar',
  '/blog/guia-pisos-porcelanato-marmol-madera': '/en/blog/flooring-guide-porcelain-marble-wood',
  '/en/blog/flooring-guide-porcelain-marble-wood': '/blog/guia-pisos-porcelanato-marmol-madera',
  '/blog/instalacion-electrica-precios-venezuela': '/en/blog/electrical-installation-prices-venezuela',
  '/en/blog/electrical-installation-prices-venezuela': '/blog/instalacion-electrica-precios-venezuela',
  '/blog/mantenimiento-piscinas-venezuela': '/en/blog/pool-maintenance-venezuela',
  '/en/blog/pool-maintenance-venezuela': '/blog/mantenimiento-piscinas-venezuela',
  '/blog/microcemento-vs-pintura-acabados': '/en/blog/microcement-vs-paint-finishes',
  '/en/blog/microcement-vs-paint-finishes': '/blog/microcemento-vs-pintura-acabados',
  '/blog/permisos-reforma-apartamento-condominio': '/en/blog/remodel-permits-apartment-condominium',
  '/en/blog/remodel-permits-apartment-condominium': '/blog/permisos-reforma-apartamento-condominio',
  '/blog/pintura-interior-precios-m2-venezuela': '/en/blog/interior-painting-prices-m2-venezuela',
  '/en/blog/interior-painting-prices-m2-venezuela': '/blog/pintura-interior-precios-m2-venezuela',
  '/blog/remodelacion-apartamentos-caracas': '/en/blog/apartment-remodeling-caracas',
  '/en/blog/apartment-remodeling-caracas': '/blog/remodelacion-apartamentos-caracas',
  '/blog/remodelacion-integral-que-incluye': '/en/blog/full-home-remodel-what-it-includes',
  '/en/blog/full-home-remodel-what-it-includes': '/blog/remodelacion-integral-que-incluye',
  '/blog/revestimiento-piedra-madera-pared-precios': '/en/blog/stone-wood-wall-cladding-prices',
  '/en/blog/stone-wood-wall-cladding-prices': '/blog/revestimiento-piedra-madera-pared-precios',
  '/blog/senales-reinstalacion-electrica-casa': '/en/blog/signs-electrical-rewiring-needed',
  '/en/blog/signs-electrical-rewiring-needed': '/blog/senales-reinstalacion-electrica-casa',
  '/privacidad': '/en/privacy',
  '/en/privacy': '/privacidad',
  '/terminos': '/en/terms',
  '/en/terms': '/terminos'
};

// Obtener path alternativo (otro idioma) - lógica robusta
const getAlternatePath = (): string => {
  if (routeMap[currentPath]) {
    return routeMap[currentPath];
  }
  if (isEnglish) {
    const withoutEn = currentPath.replace(/^\/en/, '') || '/';
    return withoutEn;
  } else {
    return currentPath === '/' ? '/en' : `/en${currentPath}`;
  }
};

const alternatePath = getAlternatePath();

// Paths para hreflang (siempre normalizados, luego con trailing slash)
const esPath = isEnglish ? alternatePath : currentPath;
const enPath = isEnglish ? currentPath : alternatePath;

const esPathSlashed = ensureTrailingSlash(esPath || '/');
const enPathSlashed = ensureTrailingSlash(enPath || '/en/');

// Validación de existencia real de traducción
// Zone pages y ciudades y servicios tienen contraparte EN con mismo slug o mapeado
// Solo los blog posts pueden no tener traducción
const isUntranslatedEsBlogPost = !isEnglish && currentPath.startsWith('/blog/') && !routeMap[currentPath];
const isUntranslatedEnBlogPost = isEnglish && currentPath.startsWith('/en/blog/') && !routeMap[currentPath];

const emitEnHreflang = !isUntranslatedEsBlogPost;
const emitEsHreflang = !isUntranslatedEnBlogPost;

// x-default: apunta a ES si existe, si no a la versión actual
const xDefaultPath = isEnglish && isUntranslatedEnBlogPost ? enPathSlashed : esPathSlashed;

// Breadcrumbs para Schema
const breadcrumbItems = [];
breadcrumbItems.push({ name: isEnglish ? 'Home' : 'Inicio', url: ensureTrailingSlash(isEnglish ? '/en' : '/') });

if (currentPath === '/blog' || currentPath === '/en/blog') {
  breadcrumbItems.push({ name: 'Blog', url: ensureTrailingSlash(currentPath) });
} else if (currentPath.startsWith('/blog/') || currentPath.startsWith('/en/blog/')) {
  breadcrumbItems.push({ name: 'Blog', url: isEnglish ? '/en/blog/' : '/blog/' });
  breadcrumbItems.push({ name: title.split('|')[0].trim(), url: ensureTrailingSlash(currentPath) });
} else if (currentPath === '/servicios' || currentPath === '/en/services') {
  breadcrumbItems.push({ name: isEnglish ? 'Services' : 'Servicios', url: ensureTrailingSlash(currentPath) });
} else if (currentPath.startsWith('/servicios/') || currentPath.startsWith('/en/services/')) {
  breadcrumbItems.push({ name: isEnglish ? 'Services' : 'Servicios', url: isEnglish ? '/en/services/' : '/servicios/' });
  breadcrumbItems.push({ name: title.split('|')[0].trim(), url: ensureTrailingSlash(currentPath) });
} else if (currentPath === '/proyectos' || currentPath === '/en/projects') {
  breadcrumbItems.push({ name: isEnglish ? 'Projects' : 'Proyectos', url: ensureTrailingSlash(currentPath) });
} else if (currentPath === '/contacto' || currentPath === '/en/contact') {
  breadcrumbItems.push({ name: isEnglish ? 'Contact' : 'Contacto', url: ensureTrailingSlash(currentPath) });
}

// FIX AUDITORIA #6: Eliminar SearchAction que apunta a /blog?q= inexistente
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": siteName,
  "url": siteUrl,
  "inLanguage": lang
};

const areasServed = [
  { "@type": "City", "name": "Valencia" },
  { "@type": "City", "name": "San Diego" },
  { "@type": "City", "name": "Naguanagua" },
  { "@type": "City", "name": "Guacara" },
  { "@type": "City", "name": "Los Guayos" },
  { "@type": "AdministrativeArea", "name": "Carabobo" },
  { "@type": "City", "name": "Caracas" },
  { "@type": "AdministrativeArea", "name": "Chacao" },
  { "@type": "AdministrativeArea", "name": "Baruta" },
  { "@type": "AdministrativeArea", "name": "El Hatillo" },
  { "@type": "AdministrativeArea", "name": "Sucre" },
  { "@type": "AdministrativeArea", "name": "Libertador" },
  { "@type": "City", "name": "La Guaira" }
];

// FIX AUDITORIA #4: Eliminar aggregateRating auto-calificado para evitar self-serving reviews
const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "HomeAndConstructionBusiness",
  "name": siteName,
  "image": `${siteUrl}/images/logo-header.webp`,
  "url": isEnglish ? `${siteUrl}/en/` : `${siteUrl}/`,
  "telephone": "+584227997043",
  "email": "contacto@reformat-venezuela.online",
  "priceRange": "$$",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Callejón Los Cocos S/N",
    "addressLocality": "San Diego",
    "addressRegion": "Carabobo",
    "postalCode": "2006",
    "addressCountry": "VE"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 10.2669,
    "longitude": -67.9659
  },
  "areaServed": areasServed,
  "availableLanguage": [
    { "@type": "Language", "name": "English" },
    { "@type": "Language", "name": "Spanish" }
  ],
  "openingHoursSpecification": {
    "@type": "OpeningHoursSpecification",
    "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
    "opens": "08:00",
    "closes": "18:00"
  },
  "sameAs": [siteUrl, 'https://www.google.com/search?kgmid=/g/11nthq0r0m&q=ReformaT+-+Remodelaciones&hl=es-419']
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": breadcrumbItems.map((item, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "name": item.name,
    "item": `${siteUrl}${ensureTrailingSlash(item.url)}`
  }))
};

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": title.split('|')[0].trim(),
  "description": description,
  "image": ogImage,
  "datePublished": publishedTime,
  "dateModified": modifiedTime || publishedTime,
  "author": {
    "@type": "Organization",
    "name": siteName,
    "url": siteUrl
  },
  "publisher": {
    "@type": "Organization",
    "name": siteName,
    "logo": {
      "@type": "ImageObject",
      "url": `${siteUrl}/images/logo-header.webp`
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": canonicalUrl
  },
  "inLanguage": lang,
  "articleSection": articleSection,
  "keywords": tags.join(', ')
};
---

<!-- BASIC META -->
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalUrl} />
<meta name="author" content={siteName} />
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
<meta name="googlebot" content="index, follow" />

<!-- LANGUAGE META -->
<meta http-equiv="content-language" content={lang} />
<meta name="language" content={lang} />
<meta name="geo.region" content="VE" />
<meta name="geo.placename" content="San Diego, Valencia, Caracas, Carabobo" />
<meta name="geo.position" content="10.2669;-67.9659" />
<meta name="ICBM" content="10.2669, -67.9659" />

<!-- HREFLANG (con self-referencing) - FIX #1 y #5: trailingSlash unificado y validación de existencia -->
{emitEsHreflang && <link rel="alternate" hreflang="es" href={`${siteUrl}${esPathSlashed}`} />}
{emitEnHreflang && <link rel="alternate" hreflang="en" href={`${siteUrl}${enPathSlashed}`} />}
<link rel="alternate" hreflang="x-default" href={`${siteUrl}${xDefaultPath}`} />

<!-- OPEN GRAPH -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content={siteName} />
<meta property="og:locale" content={locale} />
<meta property="og:locale:alternate" content={alternateLocale} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:secure_url" content={ogImage} />
<meta property="og:image:type" content="image/webp" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={title} />

{type === 'article' && publishedTime && (
  <>
    <meta property="article:published_time" content={publishedTime} />
    <meta property="article:modified_time" content={modifiedTime || publishedTime} />
    <meta property="article:author" content={siteName} />
    <meta property="article:section" content={articleSection} />
    {tags.map(tag => <meta property="article:tag" content={tag} />)}
  </>
)}

<!-- TWITTER -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={title} />

<!-- FAVICON -->
<link rel="icon" type="image/png" sizes="32x32" href="/icons/icon-32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/icons/icon-16.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/icons/icon-180.png" />
<link rel="manifest" href="/manifest.json" />
<meta name="theme-color" content="#0a0a0a" />

<!-- SCHEMA: WEBSITE (sin SearchAction) -->
<script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />

<!-- SCHEMA: LOCAL BUSINESS (sin aggregateRating) -->
<script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />

<!-- SCHEMA: BREADCRUMBS -->
{breadcrumbItems.length > 1 && (
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
)}

<!-- SCHEMA: ARTICLE (solo para posts del blog) -->
{type === 'article' && (
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
)}
