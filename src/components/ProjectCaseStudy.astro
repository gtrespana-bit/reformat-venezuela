---
import BaseLayout from '../layouts/BaseLayout.astro';
import GuaranteeMatrix from './GuaranteeMatrix.astro';
import ProjectLightbox from './ProjectLightbox.astro';
import ProjectPhaseGallery from './ProjectPhaseGallery.astro';
import ProjectQuickNav from './ProjectQuickNav.astro';

interface Fact {
  label: string;
  value: string;
}

interface QuickNavItem {
  href: string;
  label: string;
}

interface Stat {
  value: string;
  label: string;
}

interface ShowcaseItem {
  src: string;
  alt: string;
  badge: string;
  title: string;
  caption: string;
}

interface PhaseImage {
  src: string;
  alt: string;
  caption: string;
  badge: string;
  orientation?: 'portrait' | 'landscape';
}

interface Phase {
  number: string;
  kicker: string;
  title: string;
  body: string;
  checks: string[];
  images: PhaseImage[];
}

interface Highlight {
  icon: string;
  title: string;
  text: string;
}

interface Spec {
  label: string;
  value: string;
}

interface GalleryItem {
  src: string;
  alt: string;
  title: string;
  caption: string;
  badge: string;
  category: string;
  categoryLabel: string;
  orientation?: 'portrait' | 'landscape';
}

interface GalleryPhase {
  id: string;
  label: string;
  description?: string;
}

interface SummaryCard {
  index: string;
  title: string;
  body: string;
  dropcap?: boolean;
}

interface Props {
  seoTitle: string;
  seoDescription: string;
  heroImage: string;
  heroImageAlt: string;
  kicker: string;
  heroTitle: string;
  lead: string;
  heroFacts: Fact[];
  quickNavItems: QuickNavItem[];
  whatsappHref: string;
  ctaLabel?: string;
  quickNavMenuLabel?: string;
  breadcrumbCurrent: string;
  summaryTag: string;
  summaryTitle: string;
  summaryDesc: string;
  summaryCards: SummaryCard[];
  stats: Stat[];
  resultadoTag: string;
  resultadoTitle: string;
  resultadoDesc: string;
  resultadoShowcase: ShowcaseItem[];
  quote: { text: string; cite: string };
  timelineTag: string;
  timelineTitle: string;
  timelineDesc: string;
  phases: Phase[];
  compareTag: string;
  compareTitle: string;
  compareDesc: string;
  compare: {
    beforeSrc: string;
    beforeAlt: string;
    afterSrc: string;
    afterAlt: string;
    beforeCaption: string;
    afterCaption: string;
  };
  specsTag: string;
  specsTitle: string;
  specsDesc: string;
  highlights: Highlight[];
  specs: Spec[];
  galleryEyebrow?: string;
  galleryTitle: string;
  galleryIntro: string;
  gallery: GalleryItem[];
  galleryPhases: GalleryPhase[];
  ctaTag: string;
  ctaTitle: string;
  ctaText: string;
  ctaPrimaryLabel?: string;
  ctaSecondaryHref?: string;
  ctaSecondaryLabel?: string;
}

const {
  seoTitle,
  seoDescription,
  heroImage,
  heroImageAlt,
  kicker,
  heroTitle,
  lead,
  heroFacts,
  quickNavItems,
  whatsappHref,
  ctaLabel = 'Solicitar valoración',
  quickNavMenuLabel,
  breadcrumbCurrent,
  summaryTag,
  summaryTitle,
  summaryDesc,
  summaryCards,
  stats,
  resultadoTag,
  resultadoTitle,
  resultadoDesc,
  resultadoShowcase,
  quote,
  timelineTag,
  timelineTitle,
  timelineDesc,
  phases,
  compareTag,
  compareTitle,
  compareDesc,
  compare,
  specsTag,
  specsTitle,
  specsDesc,
  highlights,
  specs,
  galleryEyebrow = 'Archivo fotográfico completo',
  galleryTitle,
  galleryIntro,
  gallery,
  galleryPhases,
  ctaTag,
  ctaTitle,
  ctaText,
  ctaPrimaryLabel = 'Solicitar valoración técnica',
  ctaSecondaryHref = '/proyectos',
  ctaSecondaryLabel = 'Ver más proyectos →',
} = Astro.props;

const icons: Record<string, string> = {
  layers: '<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>',
  light: '<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18h6"/><path d="M10 22h4"/><path d="M12 2a7 7 0 0 0-4 12.7c.6.5 1 1.3 1 2.1V17h6v-.2c0-.8.4-1.6 1-2.1A7 7 0 0 0 12 2z"/></svg>',
  sun: '<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>',
  appliance: '<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="2" width="18" height="20" rx="2"/><circle cx="12" cy="13" r="5"/><circle cx="12" cy="13" r="1.6"/><path d="M6 5.5h.01M9 5.5h6"/></svg>',
  droplet: '<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2.7S6.5 8.9 6.5 13.4a5.5 5.5 0 0 0 11 0C17.5 8.9 12 2.7 12 2.7z"/></svg>',
  ruler: '<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 17l14-14 4 4L7 21z"/><path d="M7 13l2 2M11 9l2 2M15 5l2 2"/></svg>',
  shield: '<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-3.5 8-10V5l-8-3-8 3v7c0 6.5 8 10 8 10z"/></svg>',
  sparkle: '<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9z"/><path d="M19 15l.9 2.1L22 18l-2.1.9L19 21l-.9-2.1L16 18l2.1-.9z"/></svg>',
};
---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  image={heroImage}
  activePage="proyectos"
>
  <!-- Barra de progreso de lectura -->
  <div class="gu-progress" aria-hidden="true" data-progress><span></span></div>

  <!-- ============ HERO CINEMATOGRÁFICO ============ -->
  <header class="gu-hero">
    <img
      src={heroImage}
      alt={heroImageAlt}
      class="gu-hero-img"
      fetchpriority="high"
      loading="eager"
      decoding="async"
    />
    <div class="gu-hero-overlay" aria-hidden="true"></div>
    <div class="container gu-hero-content">
      <a href="/proyectos" class="gu-back" data-hero="0">← Volver a proyectos</a>
      <span class="gu-eyebrow" data-hero="1">{kicker}</span>
      <h1 data-hero="2">{heroTitle}</h1>
      <p class="gu-lead" data-hero="3">{lead}</p>

      <dl class="gu-facts" aria-label="Ficha del proyecto" data-hero="4">
        {heroFacts.map((fact) => (
          <div class="gu-fact">
            <dt>{fact.label}</dt>
            <dd>{fact.value}</dd>
          </div>
        ))}
      </dl>

      <div class="gu-hero-actions" data-hero="5">
        <a href="#paso-a-paso" class="btn-premium btn-primary-premium">
          <span class="btn-content">Ver el paso a paso</span>
          <span class="btn-border"></span>
          <span class="btn-arrow">→</span>
        </a>
        <a href={whatsappHref} class="btn-premium btn-outline-premium" target="_blank" rel="noopener">
          <span class="btn-content">{ctaLabel}</span>
          <span class="btn-arrow">→</span>
        </a>
      </div>
    </div>
    <div class="gu-scrollcue" aria-hidden="true">
      <span class="gu-scrollcue-text">Desliza para leer la obra</span>
      <span class="gu-scrollcue-line"></span>
    </div>
  </header>

  <!-- ============ NAVEGACIÓN RÁPIDA STICKY ============ -->
  <ProjectQuickNav
    items={quickNavItems}
    ctaHref={whatsappHref}
    ctaLabel={ctaLabel}
    menuLabel={quickNavMenuLabel}
  />

  <!-- ============ MIGAS DE PAN ============ -->
  <nav class="gu-breadcrumb" aria-label="Breadcrumb">
    <div class="container gu-breadcrumb-inner">
      <a href="/">Inicio</a>
      <span class="gu-sep">/</span>
      <a href="/proyectos">Proyectos</a>
      <span class="gu-sep">/</span>
      <span class="gu-current">{breadcrumbCurrent}</span>
    </div>
  </nav>

  <!-- ============ 01 · RESUMEN ============ -->
  <section class="section gu-summary" id="resumen">
    <div class="container">
      <div class="section-header" data-reveal>
        <span class="tag">{summaryTag}</span>
        <h2 class="section-title">{summaryTitle}</h2>
        <p class="section-desc">{summaryDesc}</p>
      </div>

      <div class="gu-summary-grid">
        {summaryCards.map((card) => (
          <article class="gu-summary-card" data-reveal>
            <span class="gu-summary-index">{card.index}</span>
            <h3>{card.title}</h3>
            <p class:list={['', card.dropcap && 'gu-dropcap']}>{card.body}</p>
          </article>
        ))}
      </div>

      <!-- Banda de cifras -->
      <dl class="gu-stats" aria-label="El proyecto en cifras" data-reveal>
        {stats.map((stat) => (
          <div class="gu-stat">
            <dt>{stat.label}</dt>
            <dd>{stat.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- ============ 02 · RESULTADO FINAL ============ -->
  <section class="section gu-showcase" id="resultado">
    <div class="container">
      <div class="section-header" data-reveal>
        <span class="tag">{resultadoTag}</span>
        <h2 class="section-title">{resultadoTitle}</h2>
        <p class="section-desc">{resultadoDesc}</p>
      </div>

      <div class="gu-showcase-grid">
        {resultadoShowcase.map((item, index) => (
          <figure
            class="gu-showcase-card"
            data-reveal
            data-lightbox-item
            data-lightbox-group="caso-resultado"
            data-src={item.src}
            data-alt={item.alt}
            data-title={item.title}
            data-caption={item.caption}
            data-badge={item.badge}
          >
            <div class="gu-showcase-media">
              <img src={item.src} alt={item.alt} loading={index === 0 ? 'eager' : 'lazy'} decoding="async" />
              <span class="gu-media-chip" aria-hidden="true">Ampliar</span>
            </div>
            <figcaption>
              <span class="gu-showcase-badge">{item.badge}</span>
              <h3>{item.title}</h3>
              <p>{item.caption}</p>
              <button
                class="expand-photo-btn"
                type="button"
                data-lightbox-open
                data-group="caso-resultado"
                data-src={item.src}
              >Ver en grande</button>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ PULL QUOTE ============ -->
  <section class="gu-quote" aria-label="Cita del proyecto">
    <div class="container gu-quote-inner" data-reveal>
      <span class="gu-quote-mark" aria-hidden="true">“</span>
      <blockquote>{quote.text}</blockquote>
      <cite>{quote.cite}</cite>
    </div>
  </section>

  <!-- ============ 03 · PASO A PASO ============ -->
  <section class="section gu-timeline-section" id="paso-a-paso">
    <div class="container">
      <div class="section-header" data-reveal>
        <span class="tag">{timelineTag}</span>
        <h2 class="section-title">{timelineTitle}</h2>
        <p class="section-desc" set:html={timelineDesc}></p>
        <div class="gu-timeline-meta" aria-hidden="true">
          <span>{String(phases.length).padStart(2, '0')} fases</span>
          <span class="gu-timeline-meta-dot"></span>
          <span>{gallery.length} fotografías</span>
          <span class="gu-timeline-meta-dot"></span>
          <span>{heroFacts.find((f) => f.label === 'Duración')?.value ?? 'Obra documentada'}</span>
        </div>
      </div>

      <div class="gu-flow">
        <!-- Navegador lateral de fases -->
        <aside class="gu-flow-nav" aria-label="Índice de fases">
          <span class="gu-flow-nav-title">Fases</span>
          <ol>
            {phases.map((item) => (
              <li>
                <a href={`#fase-${item.number}`} data-fase-link={item.number}>
                  <span class="gu-flow-nav-num">{item.number}</span>
                  <span class="gu-flow-nav-label">{item.kicker.replace(/^Fase \d+ · /, '')}</span>
                </a>
              </li>
            ))}
          </ol>
          <span class="gu-flow-nav-progress" aria-hidden="true"><span data-flow-progress></span></span>
        </aside>

        <!-- Fases -->
        <div class="gu-flow-main">
          {phases.map((phase, phaseIndex) => (
            <article class="gu-fase" id={`fase-${phase.number}`} data-fase={phase.number} data-reveal>
              <div class="gu-fase-head">
                <div class="gu-fase-numside" aria-hidden="true">
                  <span class="gu-fase-num">{phase.number}</span>
                  {phaseIndex < phases.length - 1 && <span class="gu-fase-numline"></span>}
                </div>
                <div class="gu-fase-copy">
                  <span class="gu-fase-kicker">{phase.kicker}</span>
                  <h3>{phase.title}</h3>
                  <p>{phase.body}</p>
                  <ul class="gu-fase-checks">
                    {phase.checks.map((check) => (
                      <li>{check}</li>
                    ))}
                  </ul>
                </div>
              </div>

              <div class:list={['gu-fg', `gu-fg--${phase.images.length}`]}>
                {phase.images.map((image, imageIndex) => (
                  <figure
                    class:list={['gu-fg-item', imageIndex === 0 && 'gu-fg-item--featured']}
                    data-lightbox-item
                    data-lightbox-group={`gu-fase-${phase.number}`}
                    data-src={image.src}
                    data-alt={image.alt}
                    data-title={`${phase.kicker} · ${image.badge}`}
                    data-caption={image.caption}
                    data-badge={phase.kicker}
                  >
                    <div class="gu-fg-media">
                      <img src={image.src} alt={image.alt} loading="lazy" decoding="async" />
                      <span class="gu-fg-badge">{image.badge}</span>
                      <span class="gu-media-chip" aria-hidden="true">Ampliar</span>
                    </div>
                    <figcaption>{image.caption}</figcaption>
                  </figure>
                ))}
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ============ 04 · ANTES / DESPUÉS INTERACTIVO ============ -->
  <section class="gu-compare-section section" id="comparativa">
    <div class="container">
      <div class="section-header" data-reveal>
        <span class="tag">{compareTag}</span>
        <h2 class="section-title">{compareTitle}</h2>
        <p class="section-desc">{compareDesc}</p>
      </div>

      <div class="gu-ba" data-ba data-reveal>
        <div class="gu-ba-stage" data-ba-stage role="slider" tabindex="0" aria-label="Comparador antes y después: arrastra para comparar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="50">
          <img
            class="gu-ba-img gu-ba-img--after"
            src={compare.afterSrc}
            alt={compare.afterAlt}
            loading="lazy"
            decoding="async"
            draggable="false"
          />
          <div class="gu-ba-before" data-ba-before>
            <img
              class="gu-ba-img"
              src={compare.beforeSrc}
              alt={compare.beforeAlt}
              loading="lazy"
              decoding="async"
              draggable="false"
            />
          </div>
          <span class="gu-ba-chip gu-ba-chip--before">Antes</span>
          <span class="gu-ba-chip gu-ba-chip--after">Después</span>
          <div class="gu-ba-handle" data-ba-handle aria-hidden="true">
            <span class="gu-ba-handle-line"></span>
            <span class="gu-ba-handle-knob">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="8 7 3 12 8 17"/><polyline points="16 7 21 12 16 17"/></svg>
            </span>
            <span class="gu-ba-handle-line"></span>
          </div>
        </div>
        <div class="gu-ba-captions">
          <div>
            <strong>Antes</strong>
            <p>{compare.beforeCaption}</p>
          </div>
          <div>
            <strong>Después</strong>
            <p>{compare.afterCaption}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ 05 · ESPECIFICACIONES ============ -->
  <section class="section gu-specs" id="especificaciones">
    <div class="container">
      <div class="section-header" data-reveal>
        <span class="tag">{specsTag}</span>
        <h2 class="section-title">{specsTitle}</h2>
        <p class="section-desc">{specsDesc}</p>
      </div>

      <div class="gu-highlights">
        {highlights.map((item, index) => (
          <article class="gu-highlight-card" data-reveal>
            <div class="gu-highlight-top">
              <span class="gu-highlight-icon" set:html={icons[item.icon]} />
              <span class="gu-highlight-index">{String(index + 1).padStart(2, '0')}</span>
            </div>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>

      <div class="gu-spec-table" role="table" aria-label="Ficha técnica del proyecto" data-reveal>
        {specs.map((spec) => (
          <div class="gu-spec-row" role="row">
            <strong role="cell">{spec.label}</strong>
            <span role="cell">{spec.value}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ 06 · GALERÍA COMPLETA ============ -->
  <ProjectPhaseGallery
    eyebrow={galleryEyebrow}
    title={galleryTitle}
    intro={galleryIntro}
    items={gallery}
    phases={galleryPhases}
    id="galeria"
  />

  <!-- ============ GARANTÍAS ============ -->
  <GuaranteeMatrix compact />

  <!-- ============ CTA FINAL ============ -->
  <section class="gu-cta">
    <div class="container gu-cta-inner" data-reveal>
      <span class="tag tag-on-dark">{ctaTag}</span>
      <h2>{ctaTitle}</h2>
      <p>{ctaText}</p>
      <div class="gu-cta-actions">
        <a href={whatsappHref} class="btn-premium btn-primary-premium" target="_blank" rel="noopener">
          <span class="btn-content">{ctaPrimaryLabel}</span>
          <span class="btn-border"></span>
          <span class="btn-arrow">→</span>
        </a>
        <a href={ctaSecondaryHref} class="gu-cta-secondary">{ctaSecondaryLabel}</a>
      </div>
    </div>
  </section>

  <ProjectLightbox />
</BaseLayout>

<script>
  (function () {
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    /* ---------- Barra de progreso de lectura ---------- */
    const progressBar = document.querySelector('[data-progress] span');
    if (progressBar) {
      const updateProgress = () => {
        const doc = document.documentElement;
        const max = doc.scrollHeight - doc.clientHeight;
        const ratio = max > 0 ? Math.min(1, window.scrollY / max) : 0;
        progressBar.style.transform = `scaleX(${ratio})`;
      };
      updateProgress();
      window.addEventListener('scroll', updateProgress, { passive: true });
      window.addEventListener('resize', updateProgress, { passive: true });
    }

    /* ---------- Revelado al hacer scroll ---------- */
    const revealTargets = document.querySelectorAll('[data-reveal]');
    if (revealTargets.length && 'IntersectionObserver' in window && !prefersReduced) {
      revealTargets.forEach((el) => el.classList.add('reveal'));
      const revealObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-in');
              revealObserver.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.12, rootMargin: '0px 0px -6% 0px' }
      );
      revealTargets.forEach((el) => revealObserver.observe(el));
    }

    /* ---------- Navegador de fases (sticky) ---------- */
    const faseSections = document.querySelectorAll('[data-fase]');
    const faseLinks = document.querySelectorAll('[data-fase-link]');
    const flowProgress = document.querySelector('[data-flow-progress]');
    if (faseSections.length && faseLinks.length && 'IntersectionObserver' in window) {
      const setActive = (num) => {
        faseLinks.forEach((link) => {
          const active = link.getAttribute('data-fase-link') === num;
          link.classList.toggle('is-active', active);
          if (active) link.setAttribute('aria-current', 'true');
          else link.removeAttribute('aria-current');
        });
        if (flowProgress) {
          const index = Math.max(0, Array.from(faseSections).findIndex((s) => s.getAttribute('data-fase') === num));
          flowProgress.style.transform = `scaleY(${(index + 1) / faseSections.length})`;
        }
      };
      const phaseObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) setActive(entry.target.getAttribute('data-fase'));
          });
        },
        { rootMargin: '-38% 0px -52% 0px', threshold: 0 }
      );
      faseSections.forEach((section) => phaseObserver.observe(section));
      if (faseSections[0]) setActive(faseSections[0].getAttribute('data-fase'));
    }

    /* ---------- Comparador antes / después ---------- */
    const ba = document.querySelector('[data-ba]');
    if (ba) {
      const stage = ba.querySelector('[data-ba-stage]');
      const before = ba.querySelector('[data-ba-before]');
      const handle = ba.querySelector('[data-ba-handle]');
      let pos = 50;
      let dragging = false;

      const render = () => {
        const clamped = Math.max(2, Math.min(98, pos));
        before.style.clipPath = `inset(0 ${100 - clamped}% 0 0)`;
        handle.style.left = `${clamped}%`;
        stage.setAttribute('aria-valuenow', String(Math.round(clamped)));
      };
      const fromEvent = (clientX) => {
        const rect = stage.getBoundingClientRect();
        pos = ((clientX - rect.left) / rect.width) * 100;
        render();
      };

      render();

      stage.addEventListener('pointerdown', (event) => {
        dragging = true;
        stage.setPointerCapture(event.pointerId);
        fromEvent(event.clientX);
      });
      stage.addEventListener('pointermove', (event) => {
        if (dragging) fromEvent(event.clientX);
      });
      ['pointerup', 'pointercancel'].forEach((type) =>
        stage.addEventListener(type, () => { dragging = false; })
      );
      stage.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowLeft' || event.key === 'ArrowRight') {
          event.preventDefault();
          pos += event.key === 'ArrowRight' ? 3 : -3;
          render();
        }
      });
    }
  })();
</script>

