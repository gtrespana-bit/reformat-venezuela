---
interface Props {
  name: string;
  description: string;
  serviceType: string;
  areaServed?: string[];
  image?: string;
}

const { name, description, serviceType, areaServed = ['Valencia', 'San Diego', 'Carabobo', 'Caracas'], image } = Astro.props;

const schema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": serviceType,
  "name": name,
  "description": description,
  // Referencia la entidad principal declarada en la home. Evita crear negocios
  // locales contradictorios (antes ServiceSchema situaba al proveedor en Valencia).
  "provider": {
    "@id": "https://remodelat.net/#organization"
  },
  "areaServed": areaServed.map(city => ({
    "@type": "City",
    "name": city
  })),
  "url": `https://remodelat.net${Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`}`,
  ...(image && { "image": `https://remodelat.net${image}` })
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
