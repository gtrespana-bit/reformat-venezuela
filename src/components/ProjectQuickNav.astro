---
interface Item {
  href: string;
  label: string;
}

interface Props {
  items: Item[];
  ctaHref?: string;
  ctaLabel?: string;
  menuLabel?: string;
  ariaLabel?: string;
}

const {
  items,
  ctaHref = '',
  ctaLabel = '',
  menuLabel = 'Secciones del caso',
  ariaLabel = 'Navegación rápida del caso de estudio',
} = Astro.props;
---

<nav class="project-quicknav" aria-label={ariaLabel}>
  <div class="project-quicknav-pill">
    <!-- Móvil: un único botón que despliega las secciones en vertical.
         Nada de carruseles laterales ni chips apretados. -->
    <button
      type="button"
      class="project-quicknav-toggle"
      aria-expanded="false"
      aria-controls="qn-sections-panel"
    >
      <svg class="project-quicknav-toggle-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="4" y1="7" x2="20" y2="7"></line>
        <line x1="4" y1="12" x2="20" y2="12"></line>
        <line x1="4" y1="17" x2="14" y2="17"></line>
      </svg>
      <span class="project-quicknav-toggle-label">{menuLabel}</span>
      <svg class="project-quicknav-toggle-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polyline points="6 9 12 15 18 9"></polyline>
      </svg>
    </button>

    <!-- Escritorio: píldora con las secciones a la vista + CTA -->
    <div class="project-quicknav-links">
      {items.map((item) => (
        <a href={item.href} class="project-quicknav-link">{item.label}</a>
      ))}
    </div>

    {ctaHref && ctaLabel && (
      <a href={ctaHref} class="project-quicknav-cta" target="_blank" rel="noopener">
        <svg class="project-quicknav-wa" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        <span>{ctaLabel}</span>
        <span class="project-quicknav-arrow" aria-hidden="true">→</span>
      </a>
    )}
  </div>

  <!-- Panel móvil: las secciones en lista vertical, numeradas -->
  <div class="project-quicknav-panel" id="qn-sections-panel" role="region" aria-label={menuLabel}>
    {items.map((item, index) => (
      <a href={item.href} class="project-quicknav-panel-link">
        <span class="project-quicknav-panel-num" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
        <span class="project-quicknav-panel-label">{item.label}</span>
        <span class="project-quicknav-panel-arrow" aria-hidden="true">→</span>
      </a>
    ))}
  </div>
</nav>

<script>
  (function () {
    const nav = document.querySelector('.project-quicknav');
    if (!nav) return;

    const toggle = nav.querySelector('.project-quicknav-toggle');
    const panel = nav.querySelector('.project-quicknav-panel');
    const links = Array.from(nav.querySelectorAll('.project-quicknav-link, .project-quicknav-panel-link'));

    /* ---------- Objetivos de anclaje (secciones de la página) ---------- */
    const targets = links
      .map((link) => {
        const id = (link.getAttribute('href') || '').replace(/^#/, '');
        const el = document.getElementById(id);
        return el ? { link, el } : null;
      })
      .filter(Boolean)
      .sort((a, b) => a.el.getBoundingClientRect().top - b.el.getBoundingClientRect().top);

    /* ---------- Ocultar al bajar / mostrar al subir ---------- */
    const showThreshold = 140;
    let lastY = window.scrollY;

    const onScroll = () => {
      const y = window.scrollY;
      const delta = y - lastY;

      if (y <= showThreshold) {
        nav.classList.remove('is-hidden');
      } else if (delta > 8) {
        nav.classList.add('is-hidden');
      } else if (delta < -8) {
        nav.classList.remove('is-hidden');
      }

      lastY = y;
    };

    /* ---------- Panel móvil: abrir / cerrar ---------- */
    const setPanel = (open) => {
      nav.classList.toggle('is-open', open);
      if (toggle) toggle.setAttribute('aria-expanded', String(open));
    };
    const closePanel = () => setPanel(false);

    if (toggle && panel) {
      toggle.addEventListener('click', (e) => {
        e.stopPropagation();
        setPanel(!nav.classList.contains('is-open'));
      });

      // Se cierra al elegir una sección
      panel.querySelectorAll('a').forEach((a) => {
        a.addEventListener('click', () => closePanel());
      });

      // Se cierra al tocar fuera de la barra
      document.addEventListener('click', (e) => {
        if (nav.classList.contains('is-open') && !nav.contains(e.target)) closePanel();
      });

      // Se cierra con Escape
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && nav.classList.contains('is-open')) {
          closePanel();
          toggle.focus();
        }
      });

      // Se cierra si el usuario hace scroll
      window.addEventListener('scroll', () => {
        if (nav.classList.contains('is-open')) closePanel();
      }, { passive: true });
    }

    /* ---------- Offset de anclaje: las secciones no quedan tapadas
       por la barra fija del encabezado + la barra sticky ---------- */
    const computeOffset = () => {
      const header = document.getElementById('navbar');
      const headerH = header ? header.getBoundingClientRect().height : 0;
      const barTop = parseFloat(getComputedStyle(nav).top) || 100;
      return Math.ceil(headerH + barTop + nav.offsetHeight + 14);
    };

    const applyAnchorOffset = () => {
      const offset = computeOffset();
      targets.forEach((t) => { t.el.style.scrollMarginTop = offset + 'px'; });
    };

    /* ---------- Scroll-spy: resalta la sección en pantalla ---------- */
    const updateSpy = () => {
      if (!targets.length) return;
      const trigger = computeOffset() + 8;
      let current = null;
      for (const t of targets) {
        if (t.el.getBoundingClientRect().top <= trigger) current = t.link;
        else break;
      }
      links.forEach((l) => l.classList.toggle('is-active', l === current));
    };

    /* ---------- Disparadores (throttle por requestAnimationFrame) ---------- */
    let rafId = 0;
    const schedule = (fn) => {
      if (rafId) return;
      rafId = requestAnimationFrame(() => { rafId = 0; fn(); });
    };

    const refresh = () => schedule(() => { onScroll(); updateSpy(); });
    const refreshLayout = () => { refresh(); applyAnchorOffset(); };

    window.addEventListener('scroll', refresh, { passive: true });
    window.addEventListener('resize', refreshLayout, { passive: true });
    if (document.fonts && document.fonts.ready) {
      document.fonts.ready.then(refresh);
    }
    window.addEventListener('load', refreshLayout);

    refreshLayout();
  })();
</script>

<style>
  /* Barra compacta flotante: ocupa solo el ancho de su contenido
     y deja visible el resto de la página a su alrededor. */
  .project-quicknav {
    position: sticky;
    top: 100px;
    z-index: 40;
    padding: 0 12px 10px;
    pointer-events: none;
    transition: transform 0.35s var(--ease-out), opacity 0.35s var(--ease-out);
  }
  .project-quicknav.is-hidden {
    transform: translateY(-170%);
    opacity: 0;
    pointer-events: none;
  }
  .project-quicknav-pill {
    position: relative;
    pointer-events: auto;
    width: fit-content;
    max-width: 100%;
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 6px;
    border-radius: var(--r-full);
    background: rgba(250, 248, 244, 0.92);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(201, 169, 97, 0.3);
    box-shadow: 0 12px 32px rgba(20, 18, 14, 0.14);
  }

  /* Botón de menú: solo visible en móvil */
  .project-quicknav-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    min-height: 44px;
    padding: 6px 16px;
    border-radius: var(--r-md);
    border: 1px solid rgba(201, 169, 97, 0.4);
    background: var(--white);
    color: var(--text);
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background var(--dur-fast) var(--ease-out), border-color var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out);
  }
  .project-quicknav-toggle:hover,
  .project-quicknav-toggle:focus-visible {
    border-color: rgba(201, 169, 97, 0.7);
    color: var(--gold-ink-strong);
  }
  .project-quicknav-toggle[aria-expanded="true"] {
    background: rgba(201, 169, 97, 0.14);
    border-color: rgba(201, 169, 97, 0.7);
    color: var(--gold-ink-strong);
  }
  .project-quicknav-toggle-icon {
    width: 17px;
    height: 17px;
    flex-shrink: 0;
  }
  .project-quicknav-toggle-chevron {
    width: 15px;
    height: 15px;
    flex-shrink: 0;
    margin-left: auto;
    transition: transform var(--dur-base) var(--ease-out);
  }
  .project-quicknav-toggle[aria-expanded="true"] .project-quicknav-toggle-chevron {
    transform: rotate(180deg);
  }

  /* Panel móvil con las secciones en vertical */
  .project-quicknav-panel {
    display: none;
  }

  .project-quicknav-links {
    display: flex;
    align-items: center;
    flex-wrap: nowrap;
    gap: 3px;
  }

  .project-quicknav-link,
  .project-quicknav-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    white-space: nowrap;
    min-height: 34px;
    padding: 5px 14px;
    border-radius: var(--r-full);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    transition: transform var(--dur-fast) var(--ease-out), background var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out), border-color var(--dur-fast) var(--ease-out), box-shadow var(--dur-fast) var(--ease-out);
  }
  .project-quicknav-link {
    background: var(--white);
    border: 1px solid rgba(201, 169, 97, 0.24);
    color: var(--text);
    flex-shrink: 0;
  }
  .project-quicknav-link:hover {
    transform: translateY(-1px);
    border-color: rgba(201, 169, 97, 0.5);
    color: var(--gold-ink-strong);
    box-shadow: 0 8px 16px rgba(20, 18, 14, 0.08);
  }
  /* Sección en pantalla: sutil realce dorado. */
  .project-quicknav-link.is-active {
    background: rgba(201, 169, 97, 0.18);
    border-color: rgba(201, 169, 97, 0.6);
    color: var(--gold-ink-strong);
    box-shadow: inset 0 0 0 1px rgba(201, 169, 97, 0.25);
  }
  .project-quicknav-link.is-active:hover { color: var(--gold-ink-strong); }

  .project-quicknav-cta {
    gap: 7px;
    margin-left: 3px;
    flex-shrink: 0;
    background: var(--ink);
    border: 1px solid var(--ink);
    color: var(--white);
  }
  .project-quicknav-cta:hover {
    transform: translateY(-1px);
    background: var(--gold);
    border-color: var(--gold);
    color: var(--ink);
    box-shadow: var(--e-gold);
  }
  .project-quicknav-wa {
    display: none;
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }
  .project-quicknav-arrow {
    font-size: 0.95rem;
    line-height: 1;
  }

  /* ---------- Móvil ----------
     La píldora se reduce a UN solo botón: «Secciones del caso», que
     despliega la lista completa en vertical. Sin carrusel lateral,
     sin chips apretados y sin CTA duplicado (el WhatsApp ya vive en la
     barra inferior fija del móvil). */
  @media (max-width: 768px) {
    .project-quicknav { top: 86px; padding: 0 8px 8px; }
    .project-quicknav-pill {
      width: 100%;
      padding: 6px;
      border-radius: var(--r-lg);
    }
    .project-quicknav-links,
    .project-quicknav-cta { display: none; }
    .project-quicknav-toggle { display: flex; }

    .project-quicknav-panel {
      display: block;
      position: absolute;
      top: calc(100% + 8px);
      left: 0;
      right: 0;
      z-index: 5;
      pointer-events: auto;
      max-height: 0;
      overflow: hidden;
      opacity: 0;
      visibility: hidden;
      background: rgba(250, 248, 244, 0.98);
      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);
      border: 1px solid rgba(201, 169, 97, 0.32);
      border-radius: var(--r-lg);
      box-shadow: 0 24px 60px rgba(20, 18, 14, 0.22);
      transition: max-height 0.32s var(--ease-out), opacity 0.22s var(--ease-out), visibility 0.22s;
    }
    .project-quicknav.is-open .project-quicknav-panel {
      max-height: 400px;
      opacity: 1;
      visibility: visible;
    }

    .project-quicknav-panel-link {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 13px 16px;
      color: var(--text);
      transition: background var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out);
    }
    .project-quicknav-panel-link + .project-quicknav-panel-link {
      border-top: 1px solid rgba(201, 169, 97, 0.14);
    }
    .project-quicknav-panel-link:hover,
    .project-quicknav-panel-link.is-active {
      background: rgba(201, 169, 97, 0.1);
      color: var(--gold-ink-strong);
    }
    .project-quicknav-panel-num {
      flex-shrink: 0;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 30px;
      height: 30px;
      border-radius: var(--r-full);
      background: rgba(201, 169, 97, 0.18);
      border: 1px solid rgba(201, 169, 97, 0.38);
      color: var(--gold-ink-strong);
      font-size: 0.72rem;
      font-weight: 800;
      letter-spacing: 0.04em;
    }
    .project-quicknav-panel-label {
      flex: 1;
      font-size: 0.84rem;
      font-weight: 700;
    }
    .project-quicknav-panel-arrow {
      color: var(--gold-ink);
      font-size: 1rem;
      transition: transform var(--dur-fast) var(--ease-out);
    }
    .project-quicknav-panel-link:hover .project-quicknav-panel-arrow,
    .project-quicknav-panel-link.is-active .project-quicknav-panel-arrow {
      transform: translateX(3px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-quicknav { transition: none; }
    .project-quicknav-toggle-chevron { transition: none; }
    .project-quicknav-panel { transition: none; }
  }
</style>
