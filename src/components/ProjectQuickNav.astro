---
interface Item {
  href: string;
  label: string;
}

interface Props {
  items: Item[];
  ctaHref?: string;
  ctaLabel?: string;
  summary?: string;
}

const { items, ctaHref = '', ctaLabel = '', summary = '' } = Astro.props;
---

<nav class="project-quicknav" aria-label="Navegación rápida del caso de estudio">
  <div class="container project-quicknav-inner">
    <div class="project-quicknav-links">
      {items.map((item) => (
        <a href={item.href} class="project-quicknav-link">{item.label}</a>
      ))}
    </div>

    {(summary || (ctaHref && ctaLabel)) && (
      <div class="project-quicknav-side">
        {summary && <p class="project-quicknav-summary">{summary}</p>}
        {ctaHref && ctaLabel && <a href={ctaHref} class="project-quicknav-cta">{ctaLabel}</a>}
      </div>
    )}
  </div>
</nav>

<style>
  .project-quicknav {
    position: sticky;
    top: 94px;
    z-index: 40;
    background: rgba(250,248,244,.84);
    backdrop-filter: blur(16px);
    border-bottom: 1px solid rgba(201,169,97,.16);
    box-shadow: 0 14px 30px rgba(20,18,14,.05);
  }
  .project-quicknav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding-top: 16px;
    padding-bottom: 16px;
  }
  .project-quicknav-links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .project-quicknav-link,
  .project-quicknav-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 10px 16px;
    border-radius: var(--r-full);
    font-size: .82rem;
    font-weight: 800;
    letter-spacing: .06em;
    text-transform: uppercase;
    transition: transform var(--dur-fast) var(--ease-out), background var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out), border-color var(--dur-fast) var(--ease-out), box-shadow var(--dur-fast) var(--ease-out);
  }
  .project-quicknav-link {
    background: var(--white);
    border: 1px solid rgba(201,169,97,.24);
    color: var(--text);
  }
  .project-quicknav-link:hover {
    transform: translateY(-2px);
    border-color: rgba(201,169,97,.5);
    color: var(--gold-ink-strong);
    box-shadow: 0 10px 18px rgba(20,18,14,.06);
  }
  .project-quicknav-side {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-left: auto;
  }
  .project-quicknav-summary {
    color: var(--text-muted);
    font-size: .92rem;
    line-height: 1.6;
    max-width: 360px;
    margin: 0;
  }
  .project-quicknav-cta {
    background: var(--ink);
    border: 1px solid var(--ink);
    color: var(--white);
    white-space: nowrap;
  }
  .project-quicknav-cta:hover {
    transform: translateY(-2px);
    background: var(--gold);
    border-color: var(--gold);
    color: var(--ink);
    box-shadow: var(--e-gold);
  }

  @media (max-width: 1080px) {
    .project-quicknav {
      top: 82px;
    }
    .project-quicknav-inner {
      flex-direction: column;
      align-items: flex-start;
    }
    .project-quicknav-side {
      width: 100%;
      justify-content: space-between;
      margin-left: 0;
    }
    .project-quicknav-summary {
      max-width: none;
    }
  }

  @media (max-width: 680px) {
    .project-quicknav {
      top: 72px;
    }
    .project-quicknav-inner {
      gap: 14px;
      padding-top: 12px;
      padding-bottom: 12px;
    }
    .project-quicknav-side {
      flex-direction: column;
      align-items: stretch;
    }
    .project-quicknav-cta {
      width: 100%;
    }
  }
</style>
