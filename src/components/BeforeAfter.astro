---
interface Props {
  service?: 'cocina' | 'bano' | 'integral';
}

const { service = 'integral' } = Astro.props;

// Intentar usar fotos correspondientes si existen, si no usar el pool general
const beforeImage = service === 'cocina' 
  ? '/images/cocina-proceso-demolicion.webp' 
  : service === 'bano' 
  ? '/images/bano-revestimiento-paredes.webp' 
  : '/images/integrales-antes.webp';

const afterImage = service === 'cocina' 
  ? '/images/cocina-terminada-final.webp' 
  : service === 'bano' 
  ? '/images/bano-terminado-final.webp' 
  : '/images/integrales-despues.webp';

const labelBefore = service === 'cocina' ? 'Cocina Vieja' : service === 'bano' ? 'Baño Antiguo' : 'Antes de la Reforma';
const labelAfter = service === 'cocina' ? 'Cocina Moderna' : service === 'bano' ? 'Baño Spa' : 'Proyecto Terminado';
---

<div class="before-after-card">
  <h3 class="ba-card-title">Garantía de Transformación: Antes y Después</h3>
  <p class="ba-card-subtitle">Desliza para ver el cambio real y la calidad del acabado que logramos en cada obra.</p>
  
  <div class="ba-container" data-ba-container>
    <div class="ba-image-wrapper">
      <img src={beforeImage} alt={`${labelBefore} - Estado previo`} class="ba-image before-img" loading="lazy" />
      <span class="ba-badge before-badge">{labelBefore}</span>
      
      <div class="ba-after-clip" data-after-clip>
        <img src={afterImage} alt={`${labelAfter} - Resultado final`} class="ba-image after-img" loading="lazy" />
        <span class="ba-badge after-badge">{labelAfter}</span>
      </div>
      
      <div class="ba-handle" data-ba-handle>
        <div class="ba-handle-line"></div>
        <div class="ba-handle-button">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="8 5 1 12 8 19"/>
            <polyline points="16 5 23 12 16 19"/>
          </svg>
        </div>
        <div class="ba-handle-line"></div>
      </div>
      
      <input 
        type="range" 
        min="0" 
        max="100" 
        value="50" 
        class="ba-slider" 
        data-ba-slider 
        aria-label="Deslizador interactivo de antes y después" 
      />
    </div>
  </div>
</div>

<style>
  .before-after-card {
    background: var(--white);
    padding: 30px;
    border-radius: var(--r-md);
    box-shadow: var(--e-1);
    border: 1px solid var(--sand);
    margin: 3.5rem 0;
  }
  
  .ba-card-title {
    font-family: var(--font-serif);
    font-size: 1.8rem;
    color: var(--text);
    margin-bottom: 0.5rem;
    font-weight: 500;
  }
  
  .ba-card-subtitle {
    color: var(--text-muted);
    font-size: 0.95rem;
    margin-bottom: 1.5rem;
  }
  
  .ba-container {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: var(--r-md);
    user-select: none;
    -webkit-user-select: none;
  }
  
  .ba-image-wrapper {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }
  
  .ba-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    pointer-events: none;
  }
  
  .ba-after-clip {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    clip-path: inset(0 0 0 50%);
  }
  
  .ba-badge {
    position: absolute;
    bottom: 20px;
    background: rgba(20, 18, 14, 0.85);
    color: var(--white);
    padding: 6px 14px;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 1px;
    text-transform: uppercase;
    border-radius: var(--r-sm);
    z-index: 4;
    backdrop-filter: blur(4px);
    pointer-events: none;
  }
  
  .before-badge {
    left: 20px;
    border-left: 3px solid #ff4d4d;
  }
  
  .after-badge {
    right: 20px;
    border-right: 3px solid var(--gold);
  }
  
  .ba-handle {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    z-index: 5;
    pointer-events: none;
    transform: translateX(-50%);
  }
  
  .ba-handle-line {
    flex-grow: 1;
    width: 2px;
    background: var(--gold);
    box-shadow: 0 0 8px rgba(20, 18, 14, 0.4);
  }
  
  .ba-handle-button {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--ink);
    border: 2px solid var(--gold);
    color: var(--gold);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 10px rgba(0,0,0,0.3);
    margin: 10px 0;
  }
  
  .ba-slider {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    cursor: col-resize;
    z-index: 10;
  }
  
  @media (max-width: 600px) {
    .before-after-card {
      padding: 15px;
    }
    .ba-badge {
      bottom: 10px;
      padding: 4px 8px;
      font-size: 0.7rem;
    }
    .before-badge { left: 10px; }
    .after-badge { right: 10px; }
    .ba-handle-button {
      width: 36px;
      height: 36px;
    }
  }
</style>

<script>
  function initBeforeAfter() {
    document.querySelectorAll('[data-ba-container]').forEach((container) => {
      const slider = container.querySelector('[data-ba-slider]') as HTMLInputElement;
      const clip = container.querySelector('[data-after-clip]') as HTMLElement;
      const handle = container.querySelector('[data-ba-handle]') as HTMLElement;
      
      if (!slider || !clip || !handle) return;
      
      const updateValue = (value: string) => {
        clip.style.clipPath = `inset(0 0 0 ${value}%)`;
        handle.style.left = `${value}%`;
      };
      
      slider.addEventListener('input', (e) => {
        const value = (e.target as HTMLInputElement).value;
        updateValue(value);
      });
      
      // Asegurar que el cambio inicial se vea reflejado
      updateValue(slider.value);
    });
  }

  // Inicializar en carga inicial
  initBeforeAfter();
  // Compatible con transiciones de página
  document.addEventListener('astro:page-load', initBeforeAfter);
</script>
