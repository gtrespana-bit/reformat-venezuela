---
interface StoryItem {
  tag: string;
  title: string;
  body: string;
  image: string;
  alt: string;
  caption?: string;
}

interface Props {
  eyebrow: string;
  title: string;
  intro: string;
  items: StoryItem[];
  galleryGroup?: string;
  buttonLabel?: string;
}

const {
  eyebrow,
  title,
  intro,
  items,
  galleryGroup = 'gallery',
  buttonLabel = 'Ampliar foto'
} = Astro.props;
---

<section class="project-reading-gallery section" id="recorrido">
  <div class="container">
    <div class="project-reading-gallery-header">
      <span class="tag">{eyebrow}</span>
      <h2 class="section-title">{title}</h2>
      <p class="section-desc">{intro}</p>
    </div>

    <div class="project-reading-gallery-list">
      {items.map((item, index) => (
        <article class:list={["project-reading-card", index % 2 === 1 && 'is-reversed']}>
          <div class="project-reading-copy">
            <span class="project-reading-step">{item.tag}</span>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
            {item.caption && <p class="project-reading-caption">{item.caption}</p>}
          </div>

          <figure
            class="project-reading-figure"
            data-lightbox-item
            data-lightbox-group={galleryGroup}
            data-src={item.image}
            data-alt={item.alt}
            data-title={item.title}
            data-caption={item.caption || item.body}
            data-badge={item.tag}
          >
            <div class="project-reading-figure-box">
              <img src={item.image} alt={item.alt} loading="lazy" decoding="async" />
              <div class="gallery-zoom-overlay">
                <button class="expand-photo-btn" type="button" data-lightbox-open data-group={galleryGroup} data-src={item.image}>{buttonLabel}</button>
              </div>
            </div>
          </figure>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .project-reading-gallery {
    background: linear-gradient(180deg, var(--white), var(--bone));
    border-top: 1px solid var(--sand);
    border-bottom: 1px solid var(--sand);
  }
  .project-reading-gallery-header {
    max-width: 840px;
    margin: 0 auto 52px;
    text-align: center;
  }
  .project-reading-gallery-list {
    display: grid;
    gap: 30px;
  }
  .project-reading-card {
    display: grid;
    grid-template-columns: .88fr 1.12fr;
    gap: 30px;
    align-items: stretch;
    padding: 32px;
    background: rgba(255,255,255,.82);
    border: 1px solid rgba(201,169,97,.18);
    border-radius: 30px;
    box-shadow: 0 22px 44px rgba(20,18,14,.05);
  }
  .project-reading-card.is-reversed {
    grid-template-columns: 1.12fr .88fr;
  }
  .project-reading-card.is-reversed .project-reading-copy {
    order: 2;
  }
  .project-reading-card.is-reversed .project-reading-figure {
    order: 1;
  }
  .project-reading-copy {
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .project-reading-step {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    width: fit-content;
    margin-bottom: 16px;
    padding: 8px 15px;
    border-radius: var(--r-full);
    background: rgba(201,169,97,.13);
    color: var(--gold-ink-strong);
    font-size: .76rem;
    font-weight: 800;
    letter-spacing: .12em;
    text-transform: uppercase;
  }
  .project-reading-copy h3 {
    font-family: var(--font-serif);
    font-size: clamp(1.9rem, 3.3vw, 2.55rem);
    line-height: 1.04;
    color: var(--ink);
    margin: 0 0 16px;
  }
  .project-reading-copy p {
    color: var(--text-muted);
    font-size: 1.02rem;
    line-height: 1.82;
    margin: 0;
  }
  .project-reading-caption {
    margin-top: 18px !important;
    padding-top: 18px;
    border-top: 1px solid rgba(201,169,97,.14);
    font-size: .93rem !important;
  }
  .project-reading-figure {
    margin: 0;
    min-width: 0;
  }
  .project-reading-figure-box {
    position: relative;
    min-height: 470px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    border-radius: 26px;
    background:
      radial-gradient(circle at top, rgba(201,169,97,.14), transparent 40%),
      var(--ink-soft);
    overflow: hidden;
    box-shadow: inset 0 0 0 1px rgba(255,255,255,.03);
  }
  .project-reading-figure-box img {
    max-width: 100%;
    max-height: 680px;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 8px;
    box-shadow: 0 22px 46px rgba(0,0,0,.3);
  }

  @media (max-width: 960px) {
    .project-reading-card,
    .project-reading-card.is-reversed {
      grid-template-columns: 1fr;
    }
    .project-reading-card.is-reversed .project-reading-copy,
    .project-reading-card.is-reversed .project-reading-figure {
      order: initial;
    }
  }

  @media (max-width: 640px) {
    .project-reading-card {
      padding: 22px;
      border-radius: 22px;
      gap: 20px;
    }
    .project-reading-figure-box {
      min-height: 330px;
      padding: 14px;
      border-radius: 18px;
    }
    .project-reading-copy h3 {
      font-size: clamp(1.55rem, 7vw, 2rem);
    }
  }
</style>
